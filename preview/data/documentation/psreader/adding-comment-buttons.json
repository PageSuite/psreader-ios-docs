ifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting#Customizing-the-Button","kind":"section","title":"Customizing the Button"},"doc://com.pagesuite.PSReader/documentation/PSReader/PSEScrollCollapseController":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEScrollCollapseController","navigatorTitle":[{"kind":"identifier","text":"PSEScrollCollapseController"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PSEScrollCollapseController"}],"title":"PSEScrollCollapseController","abstract":[{"type":"text","text":"Drives collapse-on-scroll chrome (navigation bars, toolbars) from one or"},{"type":"text","text":" "},{"type":"text","text":"more scroll views."}],"role":"symbol","url":"\/documentation\/psreader\/psescrollcollapsecontroller","kind":"symbol"},"doc://com.pagesuite.PSReader/documentation/PSReader/Commenting#Localization":{"abstract":[],"url":"\/documentation\/psreader\/commenting#Localization","type":"topic","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting#Localization","title":"Localization","kind":"section"},"doc://com.pagesuite.PSReader/documentation/PSReader/Adding-a-Bookmark-Button":{"role":"collectionGroup","kind":"article","title":"Adding a Bookmark Button","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","url":"\/documentation\/psreader\/adding-a-bookmark-button","abstract":[{"type":"text","text":"Add a bookmark button to your own reader screen that saves the page or article in view, then list and reopen what the user saved."}],"type":"topic"},"doc://com.pagesuite.PSReader/documentation/PSReader/Building-a-Page-Browser":{"role":"collectionGroup","title":"Building a Page Browser","kind":"article","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Page-Browser","url":"\/documentation\/psreader\/building-a-page-browser","type":"top