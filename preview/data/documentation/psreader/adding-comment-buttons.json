{"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"metadata":{"modules":[{"name":"PSReader"}],"roleHeading":"Guide","title":"Adding Comment Buttons","role":"article"},"kind":"article","seeAlsoSections":[{"generated":true,"title":"Adding Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Advert-Pages","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics"],"anchor":"Adding-Features"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/adding-comment-buttons"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/adding-comment-buttons"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Show comment buttons and counts on the articles in your own reader screen, with the SDK’s commenting provider.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The reader draws comment buttons itself. On an article page,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController","type":"reference","isActive":true},{"text":" pins a comment button to the foot of the","type":"text"},{"text":" ","type":"text"},{"text":"page, adds one to the byline where the article’s template has a","type":"text"},{"text":" ","type":"text"},{"text":"commenting widget, labels them with the comment count, and introduces","type":"text"},{"text":" ","type":"text"},{"text":"them with a tooltip. It asks its commenting delegate for each of these,","type":"text"},{"text":" ","type":"text"},{"text":"so your reader screen becomes that delegate and forwards each call to a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultCommentingProvider","type":"reference","isActive":true},{"text":", as the prebuilt reader does.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Using the prebuilt UI? See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Add the provider to ","type":"text"},{"code":"ReaderScreenViewController","type":"codeVoice"},{"text":", the reader screen from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader"},{"text":", as a stored property, so it lives as long as","type":"text"},{"text":" ","type":"text"},{"text":"the screen does:","type":"text"}],"type":"paragraph"},{"copyToClipboard":true,"syntax":"swift","showLineNumbers":false,"code":["private let commenting = DefaultCommentingProvider(","    service: CoralCommentingService(domain: \"talk.example.com\"),","    accentColor: .systemBlue,","    fontFamily: .systemFont(ofSize: 16),","    onCommentButtonTapped: { article, page, source, viewController in","        \/\/ Present the article's comment thread from viewController.","    }",")"],"lineAnnotations":[],"wrap":0,"type":"codeListing"},{"inlineContent":[{"text":"The provider is the prebuilt UI’s own: it counts comments through a","type":"text"},{"text":" ","type":"text"},{"text":"service, caches the counts, styles the button in your accent color and","type":"text"},{"text":" ","type":"text"},{"text":"font, and shows each tooltip once. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting"},{"text":" explains the provider","type":"text"},{"text":" ","type":"text"},{"text":"and the Coral service, and how to write a service for another backend.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting#Presenting-the-Comment-Thread"},{"text":" shows what the tap closure","type":"text"},{"text":" ","type":"text"},{"text":"receives.","type":"text"}],"type":"paragraph"},{"text":"Forwarding the Reader’s Commenting Delegate","level":2,"type":"heading","anchor":"Forwarding-the-Readers-Commenting-Delegate"},{"inlineContent":[{"text":"In ","type":"text"},{"code":"hostReader()","type":"codeVoice"},{"text":", with the other delegates, make the screen the reader’s","type":"text"},{"text":" ","type":"text"},{"text":"commenting delegate:","type":"text"}],"type":"paragraph"},{"code":["reader.commentingDelegate = self"],"syntax":"swift","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"inlineContent":[{"text":"The reader holds its commenting delegate weakly, which is why the screen,","type":"text"},{"text":" ","type":"text"},{"text":"owner of both the reader and the provider, is the delegate. The reader’s","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController\/CommentingDelegate-swift.protocol"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"smaller protocol than the prebuilt UI’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CommentingDelegate"},{"text":": it has no","type":"text"},{"text":" ","type":"text"},{"text":"edition parameter, and a count is optional. Conform in an extension, in","type":"text"},{"text":" ","type":"text"},{"text":"the same file as the class, and forward each call to the provider with","type":"text"},{"text":" ","type":"text"},{"text":"the screen’s ","type":"text"},{"code":"source","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["extension ReaderScreenViewController: PSEditionReaderViewController.CommentingDelegate {","","    func isCommentingEnabled(article: PSEArticle) -> Bool {","        guard let source else {","            return false","        }","        return commenting.isCommentingEnabled(article: article, inEdition: source)","    }","","    func commentButtonView(forArticle article: PSEArticle, onTap: @escaping () -> Void) -> UIView? {","        guard let source else {","            return nil","        }","        return commenting.commentButton(forArticle: article, inEdition: source, onTap: onTap)","    }","","    func commentButtonTapped(forArticle article: PSEArticle, onPage page: PSEPage, from viewController: UIViewController) {","        guard let source else {","            return","        }","        commenting.commentButtonTapped(forArticle: article, onPage: page, inEdition: source, from: viewController)","    }","","    func fetchCommentCount(forArticle article: PSEArticle, completion: @escaping (Int?) -> Void) {","        guard let source else {","            return completion(nil)","        }","        commenting.fetchCommentCount(forArticle: article, inEdition: source, cacheStrategy: .preferNetwork) { result in","            completion(try? result.get())","        }","    }","","    func articleCommentTooltipViewController() -> UIViewController? {","        guard let source else {","            return nil","        }","        return commenting.articleCommentTooltipViewController(inEdition: source)","    }","}"],"syntax":"swift","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"inlineContent":[{"text":"The reader asks only once an edition is open, so ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" is always set","type":"text"},{"text":" ","type":"text"},{"text":"by then. In Swift 6 language mode, mark the conformance","type":"text"},{"type":"text","text":" "},{"code":"@preconcurrency","type":"codeVoice"},{"type":"text","text":"; see "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Swift-6-Language-Mode","type":"reference"},{"type":"text","text":". The buttons’ counts use "},{"code":".preferNetwork","type":"codeVoice"},{"text":", as in the prebuilt","type":"text"},{"text":" ","type":"text"},{"text":"reader, so the count on the page is fresh; if the fetch fails, the","type":"text"},{"text":" ","type":"text"},{"text":"provider falls back to the count it cached.","type":"text"}],"type":"paragraph"},{"text":"Prefetching Counts","level":2,"type":"heading","anchor":"Prefetching-Counts"},{"inlineContent":[{"type":"text","text":"The prebuilt reader clears the provider’s cache and prefetches the"},{"type":"text","text":" "},{"type":"text","text":"edition’s counts each time it opens an edition. In "},{"type":"codeVoice","code":"show(_:at:)"},{"type":"text","text":", add:"}],"type":"paragraph"},{"code":["commenting.clearCache()","let articles = (source.edition.pages ?? []).flatMap { $0.articles ?? [] }","commenting.prefetchCommentCounts(forArticles: articles, inEdition: source, completion: nil)"],"lineAnnotations":[],"syntax":"swift","type":"codeListing","wrap":0,"copyToClipboard":true,"showLineNumbers":false},{"inlineContent":[{"type":"text","text":"The provider passes its service only the articles that take comments, in"},{"type":"text","text":" "},{"type":"text","text":"one call. The cache it fills answers your page browser at once (see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons#Showing-Counts-in-Your-Page-Browser","isActive":true},{"type":"text","text":"); the buttons on the page"},{"type":"text","text":" "},{"type":"text","text":"fetch their own counts either way."}],"type":"paragraph"},{"text":"What the Reader Draws","anchor":"What-the-Reader-Draws","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The reader offers commenting for the first article on each templated page"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"isCommentingEnabled(article:)"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":". PDF pages show no"},{"type":"text","text":" "},{"type":"text","text":"buttons."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The footer button"}],"type":"strong"},{"text":" is the view your delegate returns. The reader pins","type":"text"},{"text":" ","type":"text"},{"text":"it full width to the bottom of the page and insets the page above it.","type":"text"},{"text":" ","type":"text"},{"text":"With a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEScrollCollapseController","type":"reference"},{"text":" attached, it slides away with your","type":"text"},{"text":" ","type":"text"},{"text":"chrome; see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Collapsing-Chrome-on-Scroll","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The byline button"}],"type":"strong"},{"text":" appears in templates with a commenting widget. The","type":"text"},{"text":" ","type":"text"},{"text":"template draws it, and the reader sets its text.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The labels"}],"type":"strong"},{"text":" change as each count arrives, through the commenting","type":"text"},{"text":" ","type":"text"},{"text":"localization keys (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting#Localization","type":"reference"},{"text":"). The reader","type":"text"},{"text":" ","type":"text"},{"text":"relabels the footer button only if it adopts ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CommentingButtonView","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultCommentingButton","type":"reference"},{"text":" does.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The tooltip"}],"type":"strong"},{"text":" appears as a popover above the footer button once the","type":"text"},{"text":" ","type":"text"},{"text":"page is in view. The provider returns it only until it has been seen.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A tap on either button reaches "},{"code":"commentButtonTapped","type":"codeVoice"},{"type":"text","text":", and through it the"},{"type":"text","text":" "},{"type":"text","text":"provider’s "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultCommentingProvider\/onCommentButtonTapped","isActive":true},{"type":"text","text":". To change"},{"type":"text","text":" "},{"type":"text","text":"the button or the tooltip, pass a subclass of the provider; see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting#Customizing-the-Button","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting#Tooltips","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"Showing-Counts-in-Your-Page-Browser","level":2,"text":"Showing Counts in Your Page Browser"},{"inlineContent":[{"type":"text","text":"The prebuilt content browser lists each article’s comment count, with a"},{"type":"text","text":" "},{"type":"text","text":"trending icon once the count reaches the provider’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultCommentingProvider\/trendingThreshold","isActive":true},{"type":"text","text":". To do the same in your"},{"type":"text","text":" "},{"type":"text","text":"page browser (see "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Page-Browser","isActive":true},{"type":"text","text":"), ask the same provider"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":".preferCache","type":"codeVoice"},{"type":"text","text":", which answers from the prefetched counts at once:"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","code":["extension ReaderScreenViewController {","","    func showCommentCount(of article: PSEArticle, in cell: ArticleCell) {","        cell.article = article","        cell.commentsView.isHidden = true","","        guard let source, commenting.isCommentingEnabled(article: article, inEdition: source) else {","            return","        }","","        let threshold = commenting.trendingThreshold","        commenting.fetchCommentCount(forArticle: article, inEdition: source, cacheStrategy: .preferCache) { result in","            \/\/ A count that wasn't cached arrives later, maybe after the cell was reused.","            guard cell.article === article, let count = try? result.get() else {","                return","            }","            cell.countLabel.text = \"\\(count)\"","            cell.trendingIcon.isHidden = count < threshold","            cell.commentsView.isHidden = false","        }","    }","}"],"showLineNumbers":false,"type":"codeListing","wrap":0,"copyToClipboard":true},{"inlineContent":[{"code":"ArticleCell","type":"codeVoice"},{"type":"text","text":" stands for your page browser’s cell. The prebuilt content"},{"type":"text","text":" "},{"type":"text","text":"browser introduces its counts with a second tooltip, above the first count"},{"type":"text","text":" "},{"type":"text","text":"fully in view once the list comes to rest. Present the provider’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CommentingDelegate\/contentBrowserCommentTooltipViewController(inEdition:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"the same way; like the article tooltip, it returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" once seen. A"},{"type":"text","text":" "},{"type":"text","text":"popover adapts to a sheet in compact widths, so keep it a popover through"},{"type":"text","text":" "},{"type":"text","text":"its delegate:"}],"type":"paragraph"},{"code":["extension ReaderScreenViewController: UIPopoverPresentationControllerDelegate {","","    func showCommentTooltip(above countView: UIView) {","        guard let source,","              let tooltip = commenting.contentBrowserCommentTooltipViewController(inEdition: source) else {","            return","        }","","        tooltip.modalPresentationStyle = .popover","        if let popover = tooltip.popoverPresentationController {","            popover.sourceView = countView","            popover.sourceRect = countView.bounds","            popover.permittedArrowDirections = .down","            popover.delegate = self","        }","        present(tooltip, animated: true)","    }","","    func adaptivePresentationStyle(for controller: UIPresentationController,","                                   traitCollection: UITraitCollection) -> UIModalPresentationStyle {","        .none","    }","}"],"syntax":"swift","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"type":"heading","anchor":"Linking-Back-to-an-Article","level":2,"text":"Linking Back to an Article"},{"inlineContent":[{"text":"To bring the user back to an article later, from a comment history or a","type":"text"},{"text":" ","type":"text"},{"text":"notification about a reply, save ","type":"text"},{"code":"source.published.editionGUID","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"page.pageguid","type":"codeVoice"},{"text":" when they open the thread. Resolve the edition GUID with","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/published(forEditionGUID:)"},{"text":", and open your reader","type":"text"},{"text":" ","type":"text"},{"text":"screen with ","type":"text"},{"code":"ReaderScreenViewController(published:openingPageGUID:)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition#Routing-Links-and-Notifications"},{"text":" shows the code.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Commenting-Without-the-Provider","level":2,"text":"Commenting Without the Provider"},{"inlineContent":[{"text":"The reader’s protocol doesn’t need the SDK’s provider. To use your own","type":"text"},{"text":" ","type":"text"},{"text":"backend and views throughout, implement its five methods directly:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Return a view adopting "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CommentingButtonView","isActive":true,"type":"reference"},{"type":"text","text":" from"},{"type":"text","text":" "},{"code":"commentButtonView(forArticle:onTap:)","type":"codeVoice"},{"type":"text","text":", and call "},{"code":"onTap","type":"codeVoice"},{"type":"text","text":" when it’s"},{"type":"text","text":" "},{"type":"text","text":"tapped, so the reader can relabel it with counts. Any other view keeps"},{"type":"text","text":" "},{"type":"text","text":"its own text. Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for no footer button."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Call the "},{"code":"fetchCommentCount","type":"codeVoice"},{"type":"text","text":" completion with "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when there’s no"},{"type":"text","text":" "},{"type":"text","text":"count, from any queue; the reader moves to the main queue itself."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" from "},{"code":"articleCommentTooltipViewController()","type":"codeVoice"},{"type":"text","text":" for no"},{"type":"text","text":" "},{"type":"text","text":"tooltip, and keep returning "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" once the user has seen yours: the"},{"type":"text","text":" "},{"type":"text","text":"reader asks each time an article page with a button appears."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/Handling-Media-and-Link-Taps":{"identifier":"doc:\/\/com.pagesuite.PSReader\/docum