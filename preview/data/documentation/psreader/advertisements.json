{"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywall-Integration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Sharing","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Media-Playback","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Search","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Analytics"],"generated":true,"title":"Features"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The SDK supports two kinds of advertising:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Banner ads","type":"text"}],"type":"strong"},{"type":"text","text":" — fixed banners above or below the reader content. Banners"},{"type":"text","text":" "},{"type":"text","text":"are opt-in: implement the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AdvertDelegate"},{"type":"text","text":" protocol to provide the banner"},{"type":"text","text":" "},{"type":"text","text":"view controllers, otherwise no banners are displayed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Advert pages","type":"text"}]},{"text":" — dedicated full-page adverts in the page flow of feed","type":"text"},{"text":" ","type":"text"},{"text":"editions. These are part of the edition content and render out of the box.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.P