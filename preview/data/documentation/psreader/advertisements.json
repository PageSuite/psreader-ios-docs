e":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" from any method to omit the ad placement for that context."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed editions support bottom banners only. Replica editions support"},{"type":"text","text":" "},{"type":"text","text":"both top and bottom banners."}]}],"style":"note","name":"Note","type":"aside"},{"level":2,"text":"Creating an AdvertViewController","type":"heading","anchor":"Creating-an-AdvertViewController"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your ad view controller must conform to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AdvertViewController"},{"type":"text","text":". The SDK"},{"type":"text","text":" "},{"type":"text","text":"embeds it as a "},{"type":"strong","inlineContent":[{"type":"text","text":"child view controller"}]},{"type":"text","text":" within the reader interface — it is"},{"type":"text","text":" "},{"type":"text","text":"added via "},{"type":"codeVoice","code":"addChild"},{"type":"text","text":" and its view is placed inside the reader’s view hierarchy."},{"type":"text","text":" "},{"type":"text","text":"This means your ad banner participates in the standard UIKit containment"},{"type":"text","text":" "},{"type":"text","text":"lifecycle ("},{"type":"codeVoice","code":"willMove(toParent:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"didMove(toParent:)"},{"type":"text","text":", etc.)."}]},{"syntax":"swift","type":"codeListing","code":["import PSReader","import PSReader","","class MyAdBanner: UIViewController, PSReader.AdvertViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        \/\/ Load and display your ad content","    }","","    func didChangeTo(spread: PSEPageSpread?,","                     inEdition edition: PSEEdition,","                     inPublished published: PSEPublished) {","        refreshAd()","    }","","    func didChangeTo(spread: PSReplicaPageSpread?,","                     inReplicaEdition replicaEdition: PSReplicaEdition) {","        refreshAd()","    }","","    private func refreshAd(forPage pageNumber: Int) {","        \/\/ Refresh your ad or update section targeting","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The banner’s height is determined by your view’s Auto Layout constraints. Set"},{"type":"text","text":" "},{"type":"text","text":"an intrinsic content size or explicit height constraint on your ad view to"},{"type":"text","text":" "},{"type":"text","text":"control how tall the banner appears in the reader."}]},{"level":2,"text":"Assigning the Delegate","type":"heading","anchor":"Assigning-the-Delegate"},{"type":"paragraph","inlineContent":[{"text":"Set the delegate on your ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","code":["struct MyAdvertDelegate: PSReader.AdvertDelegate {","    func advertViewControllerForBottomBanner(","        inPublished published: PSEPublished,","        edition: PSEEdition","    ) -> AdvertViewController? {","        return MyAdBanner()","    }","","    func advertViewControllerForBottomBanner(","        inReplicaEdition edition: PSEdition","    ) -> AdvertViewController? {","        return MyAdBanner()","    }","","    func advertViewControllerForTopBanner(","        inReplicaEdition edition: PSEdition","    ) -> AdvertViewController? {","        return nil \/\/ No top banner","    }","}","","globalConfig.advertDelegate = MyAdvertDelegate()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The delegate is inherited by all reader configurations created from the","type":"text"},{"text":" ","type":"text"},{"text":"global configuration.","type":"text"}]},{"text":"Responding to Page Changes","anchor":"Responding-to-Page-Changes","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The SDK notifies your ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AdvertViewController","isActive":true,"type":"reference"},{"text":" when the reader’s visible page","type":"text"},{"text":" ","type":"text"},{"text":"changes. This is useful for refreshing ad content or updating section-level","type":"text"},{"text":" ","type":"text"},{"text":"ad targeting as the user navigates through an edition.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AdvertViewController"},{"text":" defines two page change callbacks — one for each","type":"text"},{"text":" ","type":"text"},{"text":"edition type:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AdvertViewController\/didChangeTo(spread:inEdition:inPublished:)","type":"reference"},{"text":" ","type":"text"},{"text":"— called in ","type":"text"},{"type":"strong","inlineContent":[{"text":"feed edition","type":"text"}]},{"text":" readers.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AdvertViewController\/didChangeTo(spread:inReplicaEdition:)","isActive":true},{"text":" ","type":"text"},{"text":"— called in ","type":"text"},{"inlineContent":[{"text":"replica edition","type":"text"}],"type":"strong"},{"text":" readers.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Both methods receive the current page spread and edition context. The ","type":"text"},{"type":"codeVoice","code":"spread"},{"text":" ","type":"text"},{"text":"parameter is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when there is no active page (for example, during a","type":"text"},{"text":" ","type":"text"},{"text":"transition). Use ","type":"text"},{"type":"codeVoice","code":"referencePage()"},{"text":" on the spread to get the primary page:","type":"text"}]},{"syntax":"swift","code":["func didChangeTo(spread: PSEPageSpread?,","                 inEdition edition: PSEEdition,","                 inPublished published: PSEPublished) {","    guard let page = spread?.referencePage() else { return }","    \/\/ Use page.pageNumber for ad targeting or to trigger an ad refresh","    adView.setTargeting(page: page.pageNumber)","    adView.loadNewAd()","}","","func didChangeTo(spread: PSReplicaPageSpread?,","                 inReplicaEdition replicaEdition: PSReplicaEdition) {","    guard let page = spread?.referencePage() else { return }","    \/\/ Use page.num for the page number in replica editions","    adView.setTargeting(page: page.num)","    adView.loadNewAd()","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Both methods have default implementations that do nothing, so you only need to","type":"text"},{"text":" ","type":"text"},{"text":"implement the ones relevant to your ad setup. If you only serve ads in feed","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"editions, you can omit the replica variant and vice versa."}]},{"anchor":"Full-Page-Advert-Pages","level":2,"type":"heading","text":"Full Page Advert Pages"},{"type":"paragraph","inlineContent":[{"text":"Feed editions can contain dedicated advert pages, including one at the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"page-zero position — displayed beside the cover in double-page mode. Advert"},{"type":"text","text":" "},{"type":"text","text":"pages render out of the box; no setup is required."}]},{"inlineContent":[{"type":"text","text":"For third-party adverts the built-in rendering shows an “Advertisement” label"},{"type":"text","text":" "},{"type":"text","text":"above the ad. The label text is localizable through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey\/advertisementLabel","isActive":true},{"type":"text","text":". Other advert flows — HTML"},{"type":"text","text":" "},{"type":"text","text":"templates, external URLs, and images — display full bleed without a label."}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"inlineContent":[{"text":"Google Ad Manager advert pages have no built-in rendering — they","type":"text"},{"text":" ","type":"text"},{"text":"are left blank unless your ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AdvertDelegate"},{"text":" supplies a view controller.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"text":"Custom Advert Page Rendering","type":"heading","level":3,"anchor":"Custom-Advert-Page-Rendering"},{"inlineContent":[{"type":"text","text":"Implement"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AdvertDelegate\/advertViewController(forAdvertPage:inPublished:edition:)","isActive":true},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"replace the built-in rendering with your own view controller, or return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"type":"text","text":"to keep the default. The returned view controller must conform to"},{"type":"text","text":" "},{"type":"codeVoice","code":"PSEAdvertContentViewController"},{"type":"text","text":" from the core PSReader SDK:"}],"type":"paragraph"},{"type":"codeListing","code":["func advertViewController(","    forAdvertPage page: PSEPage,","    inPublished published: PSEPublished,","    edition: PSEEdition",") -> PSEAdvertContentViewController? {","    switch page.advertProvider {","    case