{"abstract":[{"type":"text","text":"Guidance to help you smoothly transition your app to newer versions of the SDK."},{"type":"text","text":" "},{"type":"text","text":"This page highlights breaking changes, necessary updates, and recommended"},{"type":"text","text":" "},{"type":"text","text":"practices when migrating between versions."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/migration-guides"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/migration-guides"]}],"metadata":{"role":"article","title":"Migration Guides","modules":[{"name":"PSReader"}],"roleHeading":"Article"},"seeAlsoSections":[{"title":"Release Notes","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Change-Log"],"generated":true,"anchor":"Release-Notes"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Next Release","type":"heading","anchor":"Next-Release","level":2},{"name":"Note","content":[{"inlineContent":[{"text":"This entry covers the SDK unification and is finalized — including","type":"text"},{"text":" ","type":"text"},{"text":"its version number — with the release itself.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"One module: PSReader"}]}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The PSReaderUI and PSReader modules have merged into a single "},{"type":"codeVoice","code":"PSReader"},{"type":"text","text":" "},{"type":"text","text":"module, and the SDK’s full surface — including the core reader engine — is"},{"type":"text","text":" "},{"type":"text","text":"now public and documented."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Replace ","type":"text"},{"type":"codeVoice","code":"import PSReaderUI"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"import PSReader"},{"text":". Type names are","type":"text"},{"text":" ","type":"text"},{"text":"unchanged; module-qualified spellings such as ","type":"text"},{"type":"codeVoice","code":"PSReaderUI.GlobalConfiguration"},{"text":" ","type":"text"},{"text":"become ","type":"text"},{"code":"PSReader.GlobalConfiguration","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Manual installations embed a single ","type":"text"},{"code":"PSReader.xcframework","type":"codeVoice"},{"text":" (plus the","type":"text"},{"text":" ","type":"text"},{"text":"Apryse libraries). There is no separate ","type":"text"},{"code":"PSReaderUI.xcframework","type":"codeVoice"},{"text":" anymore.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Swift Package Manager and CocoaPods coordinates are unchanged.","type":"text"}]}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Core APIs renamed ahead of the contract lock"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The core layer was tidied before being locked as public API. If you reached","type":"text"},{"text":" ","type":"text"},{"text":"past the prebuilt UI into these types, the notable renames:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"PSELocalBookmarkManager","type":"codeVoice"},{"text":" is now ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmarkManager","isActive":true,"type":"reference"},{"text":"; creators are","type":"text"},{"text":" ","type":"text"},{"code":"addBookmark","type":"codeVoice"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"removeBookmark"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"removeAllBookmarks"},{"text":", and toggles return a","type":"text"},{"text":" ","type":"text"},{"text":"typed ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmarkChange","isActive":true,"type":"reference"},{"text":" instead of a tuple.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"On "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager"},{"type":"text","text":": "},{"type":"codeVoice","code":"getDownloaded(publishedGUID:)"},{"type":"text","text":" is now"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager\/downloadedEdition(for:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"deleteDownloadedEditonsIfModified(for:)"},{"type":"text","text":" is now"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager\/removeOutdatedDownload(for:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ToggleDownloadStatus.canceled"},{"type":"text","text":" is spelled "},{"type":"codeVoice","code":".cancelled"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController","isActive":true},{"type":"text","text":": "},{"type":"codeVoice","code":"reload()"},{"type":"text","text":" is now"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController\/reloadData()","type":"reference","isActive":true},{"text":" and ","type":"text"},{"code":"reloadPages()","type":"codeVoice"},{"text":" is now","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController\/reloadPageContent()","type":"reference"},{"text":"; the advert delegate","type":"text"},{"text":" ","type":"text"},{"text":"protocol is nested as ","type":"text"},{"code":"PSEditionReaderViewController.AdvertDelegate","type":"codeVoice"},{"text":"; and","type":"text"},{"text":" ","type":"text"},{"code":"ScrollCollapseController","type":"codeVoice"},{"text":" is now ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEScrollCollapseController","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The reader’s ","type":"text"},{"code":"MediaDelegate","type":"codeVoice"},{"text":" and nested commenting delegate no longer","type":"text"},{"text":" ","type":"text"},{"text":"carry localization-shim methods (","type":"text"},{"code":"replacementHTML","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"templateCommentButtonText","type":"codeVoice"},{"text":", ","type":"text"},{"code":"updateCommentButtonText","type":"codeVoice"},{"text":") — the SDK","type":"text"},{"text":" ","type":"text"},{"text":"localizes those strings itself via ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizationManager","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Legacy Core SDK clients"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The old "},{"type":"codeVoice","code":"PS"},{"type":"text","text":"-prefixed reader stack is retired from the documentation and"},{"type":"text","text":" "},{"type":"text","text":"will be removed with the legacy backend. Migrating a legacy Core SDK"},{"type":"text","text":" "},{"type":"text","text":"integration is a rewrite against the new core layer — see"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Core-SDK-Migration-Guide","type":"reference","isActive":true},{"type":"text","text":" for the API mapping and the hooks that"},{"type":"text","text":" "},{"type":"text","text":"preserve users’ downloads and bookmarks."}],"type":"paragraph"},{"anchor":"v2670","level":2,"text":"v26.7.0","type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Carousel headers replace "},{"type":"codeVoice","code":"dismissButton"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Breaking change: "},{"type":"codeVoice","code":"CarouselConfiguration.dismissButton"},{"type":"text","text":" has been removed. The"},{"type":"text","text":" "},{"type":"text","text":"carousel now accepts a full header view controller, pinned above the carousel"},{"type":"text","text":" "},{"type":"text","text":"content, via the new "},{"type":"codeVoice","code":"header"},{"type":"text","text":" parameter on the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController"},{"type":"text","text":" "},{"type":"text","text":"initializer."}],"type":"paragraph"},{"inlineContent":[{"text":"To retain the previous dismiss button behavior, pass a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DismissHeaderViewController","type":"reference"},{"text":" as the header. It accepts the same","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ButtonConfiguration\/dismissButton(size:insets:position:tintColor:image:)","type":"reference"},{"text":" ","type":"text"},{"text":"configuration as before, and by default dismisses the carousel on tap. Supply","type":"text"},{"text":" ","type":"text"},{"code":"onClose","type":"codeVoice"},{"text":" to run custom behaviour instead (for example when the carousel is","type":"text"},{"text":" ","type":"text"},{"text":"embedded rather than presented).","type":"text"}],"type":"paragraph"},{"code":["\/\/ Before","var carouselConfig = PSReader.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    sections: sections",")","","\/\/ After","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: DismissHeaderViewController(config: .dismissButton(position: .leading())),","    sections: sections",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Headers can also hide as the content scrolls via"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselConfiguration\/hidesHeaderOnScroll","isActive":true,"type":"reference"},{"type":"text","text":". Leave it "},{"code":"false","type":"codeVoice"},{"type":"text","text":" (the default)"},{"type":"text","text":" "},{"type":"text","text":"when using a "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DismissHeaderViewController","isActive":true,"type":"reference"},{"type":"text","text":" so the close button stays"},{"type":"text","text":" "},{"type":"text","text":"reachable."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Search API changes"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support replica search, "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchService","isActive":true},{"type":"text","text":" is now a protocol with two"},{"type":"text","text":" "},{"type":"text","text":"implementations:"}]},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedSearchService","type":"reference"},{"text":" — the previous ","type":"text"},{"code":"SearchService","type":"codeVoice"},{"type":"text","text":" struct, renamed. It"},{"type":"text","text":" "},{"type":"text","text":"searches feed edition publications."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReplicaSearchService"},{"text":" — new. It searches replica publications.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"If you use the service directly, replace "},{"code":"SearchService()","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"code":"FeedSearchService()","type":"codeVoice"},{"type":"text","text":"; the "},{"code":"search","type":"codeVoice"},{"type":"text","text":" method signature is unchanged. The nested"},{"type":"text","text":" "},{"type":"text","text":"types have moved to the top level: "},{"code":"SearchService.SearchType","type":"codeVoice"},{"type":"text","text":" is now"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchType","type":"reference"},{"type":"text","text":" and "},{"code":"SearchService.Response","type":"codeVoice"},{"type":"text","text":" is now "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResponse","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Advert pages and analytics"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"Advert pages join the feed edition page flow as a new page type","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements#Full-Page-Advert-Pages","isActive":true},{"type":"text","text":"). If your editions contain"},{"type":"text","text":" "},{"type":"text","text":"them, be aware of the analytics implications:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An advert page settling on screen fires ","type":"text"},{"code":"feedEditionOtherPageView","type":"codeVoice"},{"text":", the same","type":"text"},{"text":" ","type":"text"},{"text":"event as other non-article, non-section pages. If you report page views","type":"text"},{"type":"text","text":" "},{"type":"text","text":"downstream, decide whether advert views should count — the event context’s"},{"type":"text","text":" "},{"type":"text","text":"page spread identifies advert pages ("},{"type":"codeVoice","code":"referencePage()?.isAdvertPage"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"text":"In double-page mode, a spread’s reference page prefers editorial content: a","type":"text"},{"text":" ","type":"text"},{"text":"spread pairing an advert with an editorial page reports the editorial page,","type":"text"},{"text":" ","type":"text"},{"text":"so only advert-only spreads report an advert. The page-zero advert always","type":"text"},{"text":" ","type":"text"},{"text":"shares its spread with the cover, so it never produces its own page-view","type":"text"},{"text":" ","type":"text"},{"text":"event; single-page mode does not include the page-zero advert at all.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"v2610","level":2,"text":"v26.1.0"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Archive limit defaults","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"code":"archiveLimit","type":"codeVoice"},{"text":" now defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", with type-specific behavior:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Replica archives: 30 editions (unchanged from previous releases).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Feed archives: unbounded — shows the full backend archive (usually ~1 year).","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This is a behavior change for feed edition clients who previously saw a default","type":"text"},{"text":" ","type":"text"},{"text":"of 30 editions. To restore the old behavior, explicitly set ","type":"text"},{"type":"codeVoice","code":"archiveLimit"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["var archiveConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.archiveLimit = 30"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Modern replica reader"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A modern replacement for the legacy replica reader is now available. It shares"},{"type":"text","text":" "},{"type":"text","text":"delegates and navigation with the feed edition reader, giving end users the same"},{"type":"text","text":" "},{"type":"text","text":"experience regardless of backend. Replica-specific analytics events still fire."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Opt in by setting "},{"type":"codeVoice","code":"useLegacyReplicaReader"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"now). The modern reader will become the default in a future release, and the"},{"text":" ","type":"text"},{"text":"legacy reader will be removed further out.","type":"text"}],"type":"paragraph"},{"code":["var archiveConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.useLegacyReplicaReader = false"],"type":"codeListing","syntax":"swift"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"The legacy reader’s content browser next\/previous button events are"},{"type":"text","text":" "},{"type":"text","text":"not reported in the modern reader:"},{"type":"text","text":" "},{"type":"codeVoice","code":"replicaPageBrowserNextTapped"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"replicaPageBrowserPreviousTapped"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"replicaArticleBrowserNextTapped","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"replicaArticleBrowserPreviousTapped","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"important","type":"aside"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"LegacyReaderConfiguration"},{"type":"text","text":" properties (e.g. "},{"type":"codeVoice","code":"shareTemplater"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"prefersStatusBarHidden"},{"type":"text","text":", "},{"type":"codeVoice","code":"navigationBarItems"},{"type":"text","text":") do not apply to the modern"},{"type":"text","text":" "},{"type":"text","text":"reader — it uses the standard "},{"type":"codeVoice","code":"ReaderConfiguration"},{"type":"text","text":" delegates instead."}]}],"style":"note"},{"level":2,"type":"heading","text":"v5.5.0","anchor":"v550"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Liquid Glass UI defaults"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS 26 and later, the SDK defaults to a new Liquid Glass design. The SDK"},{"type":"text","text":" "},{"type":"text","text":"respects the host app’s "},{"code":"UIDesignRequiresCompatibility","type":"codeVoice"},{"type":"text","text":" flag and will fall back"},{"text":" ","type":"text"},{"text":"automatically on older OS versions. The new design can also be controlled via","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"LiquidGlassPolicy","type":"codeVoice"},{"type":"text","text":" option. You can apply this globally or more granularly"},{"type":"text","text":" "},{"type":"text","text":"on specific configuration objects (for example, subsection ribbon, navigation"},{"type":"text","text":" "},{"type":"text","text":"bar, page browser, etc.). To disable it globally:"}]},{"syntax":"swift","type":"codeListing","code":["var globalConfig = PSReader.GlobalConfiguration(apiKey: apiKey, accountGUID: accountGUID)","globalConfig.liquidGlassPolicy = .disabled \/\/ disable Liquid Glass across the SDK"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Archive thumbnail layout"}]}]},{"type":"paragraph","inlineContent":[{"text":"Archive thumbnails now offer a dynamic layout mode:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ImageContentMode.flexibleHeight"},{"type":"text","text":". It lets edition artwork (including the"},{"type":"text","text":" "},{"type":"text","text":"latest\/hero card) grow or shrink to its true aspect ratio, keeping the full"},{"type":"text","text":" "},{"type":"text","text":"image visible instead of cropping. Start with an estimated ratio for a steady"},{"type":"text","text":" "},{"type":"text","text":"initial layout; the SDK tunes the size automatically once the real image"},{"type":"text","text":" "},{"type":"text","text":"arrives. Example:"}]},{"code":["var archiveConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.9)"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"v520","text":"v5.2.0","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reader UI\/UX Changes"}]}],"type":"paragraph"},{"inlineContent":[{"text":"In PDF-driven editions, PDF pages and articles are now segmented. Users can no","type":"text"},{"text":" ","type":"text"},{"text":"longer swipe between them. Articles are accessed either via article hotspot","type":"text"},{"text":" ","type":"text"},{"text":"links or through the content browser. The content browser is also segmented in","type":"text"},{"text":" ","type":"text"},{"text":"the same way, with a toggle that allows switching between pages and articles.","type":"text"},{"text":" ","type":"text"},{"text":"This behavior now matches the web reader.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The navigation bar layout has also been updated:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The right-side back arrow has been removed.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The left-side icon now adapts to the current context:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Dismiss Article – If the user opened an article from a hotspot link, this","type":"text"},{"text":" ","type":"text"},{"text":"action returns them to the PDF page containing that article.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dismiss Reader – In all other cases, this action dismisses the reader"},{"type":"text","text":" "},{"type":"text","text":"view controller."}]}]}],"type":"unorderedList"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"You can customize the icons for these actions via your ","type":"text"},{"type":"codeVoice","code":"AssetDelegate"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["ImageResourceName.dismiss        \/\/ Default: back arrow","ImageResourceName.dismissArticle \/\/ Default: xmark"]},{"level":2,"type":"heading","anchor":"v500","text":"v5.0.0"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edition Download Behavior"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"code":"5.0.0","type":"codeVoice"},{"text":" introduces the ability to read editions without downloading them.","type":"text"},{"text":" ","type":"text"},{"text":"This is the new default behavior. It can be customized by users via the reader","type":"text"},{"text":" ","type":"text"},{"text":"settings menu. To retain the original default:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.settings.downloadWhileReadingDefault = false","","\/\/ To hide the user facing setting","archiveConfig.readerConfig.settings.isDownloadWhileReadingToggleEnabled = false","archiveConfig.readerConfig.settings.isDownloadWhileReadingPreferenceAlertEnabled = false"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Edition Date Formatting","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Breaking Change: "},{"type":"codeVoice","code":"DateFormatter"},{"type":"text","text":" objects in configuration structs have been"},{"type":"text","text":" "},{"type":"text","text":"replaced with the "},{"type":"codeVoice","code":"EditionDateFormatter"},{"text":" protocol. This enables more fine","type":"text"},{"text":" ","type":"text"},{"text":"grained customization and allows for alternative naming strategies such as","type":"text"},{"text":" ","type":"text"},{"text":"edition names, identifiers, or any other custom labeling approach.","type":"text"}]},{"inlineContent":[{"text":"The SDK provides a ","type":"text"},{"type":"codeVoice","code":"DefaultEditionDateFormatter"},{"text":" that wraps a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DateFormatter"},{"text":". This allows","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let dateFormatter = DateFormatter()","dateFormatter.dateFormat = \"d MMMM yyyy\"","dateFor