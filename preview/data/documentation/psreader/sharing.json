{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The PSReader SDK provides built-in sharing through the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate"},{"text":" ","type":"text"},{"text":"protocol. The SDK ships three ready-to-use providers — ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareProvider"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/WebReaderShareProvider"},{"text":", and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArticleLinkShareProvider"},{"text":" — that cover the","type":"text"},{"text":" ","type":"text"},{"text":"most common scenarios. For full control, implement ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate"},{"text":" directly.","type":"text"}]},{"type":"heading","level":2,"text":"Key Concepts","anchor":"Key-Concepts"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Web reader link","type":"text"}]},{"text":" — a URL that opens the edition page in the PageSuite web","type":"text"},{"text":" ","type":"text"},{"text":"reader (e.g., ","type":"text"},{"code":"reader.pagesuite.com\/shortcode\/CODE\/edition\/GUID","type":"codeVoice"},{"text":"). This lets","type":"text"},{"text":" ","type":"text"},{"text":"anyone view the page in a browser without installing the app.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Article link"}]},{"type":"text","text":" — a URL pointing to the article on the publisher’s own website"},{"type":"text","text":" "},{"type":"text","text":"(e.g., "},{"type":"codeVoice","code":"example.com\/news\/article-slug"},{"type":"text","text":"). This link is set by the publisher in"},{"type":"text","text":" "},{"type":"text","text":"the CMS and is only available for article-type pages that have a "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":" "},{"type":"text","text":"configured."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both link types are surfaced through the iOS share sheet"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"UIActivityViewController"},{"type":"text","text":"). The built-in providers automatically include a"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Copy Link","type":"text"}]},{"text":" activity alongside the standard system activities.","type":"text"}]},{"type":"heading","level":2,"anchor":"Choosing-a-Share-Policy","text":"Choosing a Share Policy"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareProvider","isActive":true},{"type":"text","text":" wraps one or both of the built-in providers and applies a"},{"type":"text","text":" "},{"type":"text","text":"fallback strategy through its "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareProvider\/SharePolicy","isActive":true},{"type":"text","text":" enum:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Policy"}]}],[{"inlineContent":[{"type":"text","text":"When to use"}],"type":"paragraph"}],[{"inlineContent":[{"text":"What’s shareable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".disabled"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"You don’t want any sharing"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Nothing","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".onlyWebReader"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All pages should share a web reader link"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Any page with a page GUID","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".onlyArticleLink"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only article pages with a CMS link should be shareable"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Article pages with a non-empty ","type":"text"},{"code":"shareLink","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".preferWebReader"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Web reader link preferred, article link as fallback"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Most pages via web reader; article pages also eligible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".preferArticleLink","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Article link preferred, web reader as fallback"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Article pages via CMS link; all other pages via web reader"}],"type":"paragraph"}]]]},{"name":"Tip","content":[{"inlineContent":[{"text":"","type":"text"},{"code":".onlyArticleLink()","type":"codeVoice"},{"text":" is the default policy when no share delegate is","type":"text"},{"text":" ","type":"text"},{"text":"assigned. Assign a delegate explicitly only if you need a different policy.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"tip"},{"level":2,"type":"heading","text":"Quick Setup","anchor":"Quick-Setup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To enable web reader sharing, create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/WebReaderShareProvider"},{"text":" with your","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"shortcode and assign it through a "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareProvider","type":"reference","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let webProvider = PSReader.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReader.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReader.ArticleLinkShareProvider()","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To disable sharing entirely:"}]},{"syntax":"swift","type":"codeListing","code":["globalConfig.shareDelegate = PSReader.ShareProvider(sharePolicy: .disabled)"]},{"level":2,"anchor":"Policy-Examples","type":"heading","text":"Policy Examples"},{"level":3,"anchor":"Web-Reader-Only","type":"heading","text":"Web Reader Only"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Share every page as a web reader link. Useful when the publisher does not have"},{"type":"text","text":" "},{"type":"text","text":"article pages on their website:"}]},{"syntax":"swift","type":"codeListing","code":["let webProvider = PSReader.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReader.ShareProvider(","    sharePolicy: .onlyWebReader(webProvider: webProvider)",")"]},{"level":3,"anchor":"Custom-Web-Reader-Domain","type":"heading","text":"Custom Web Reader Domain"},{"type":"paragraph","inlineContent":[{"text":"If your web reader is hosted on a custom domain, pass it as the ","type":"text"},{"code":"urlMask","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let webProvider = PSReader.WebReaderShareProvider(","    urlMask: \"reader.mypublication.com\",","    shortCode: \"SHORTCODE\"",")"]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"urlMask","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the provider defaults to ","type":"text"},{"code":"reader.pagesuite.com","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"feed editions and ","type":"text"},{"code":"edition.pagesuite.com","type":"codeVoice"},{"text":" for replica editions.","type":"text"}]},{"level":3,"anchor":"Article-Link-Only-Default","type":"heading","text":"Article Link Only (Default)"},{"type":"paragraph","inlineContent":[{"text":"Only pages that have a publisher-configured article link are shareable:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["globalConfig.shareDelegate = PSReader.ShareProvider(","    sharePolicy: .onlyArticleLink()",")"]},{"level":3,"type":"heading","text":"Prefer Article Link with Web Reader Fallback","anchor":"Prefer-Article-Link-with-Web-Reader-Fallback"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Share the article link when available, otherwise fall back to the web reader:"}]},{"syntax":"swift","type":"codeListing","code":["let webProvider = PSReader.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReader.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReader.ArticleLinkShareProvider()","    )",")"]},{"level":2,"type":"heading","text":"ShareContext","anchor":"ShareContext"},{"type":"paragraph","inlineContent":[{"text":"When a share action is triggered, the delegate returns a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareContext","type":"reference","isActive":true},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"the SDK passes to ","type":"text"},{"type":"codeVoice","code":"UIActivityViewController"},{"text":". The struct has three fields:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"activityItems"}],"type":"strong"},{"text":" — the primary items to share (URLs, strings, images).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"applicationActivities","type":"codeVoice"}]},{"text":" — optional custom ","type":"text"},{"type":"codeVoice","code":"UIActivity"},{"text":" instances to","type":"text"},{"text":" ","type":"text"},{"text":"include in the share sheet.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"subject","type":"codeVoice"}],"type":"strong"},{"text":" — an optional subject line used by activities like Mail.","type":"text"}]}]}]},{"inlineContent":[{"text":"The built-in providers automatically add a ","type":"text"},{"inlineContent":[{"text":"Copy Link","type":"text"}],"type":"strong"},{"text":" activity to","type":"text"},{"text":" ","type":"text"},{"code":"applicationActivities","type":"codeVoice"},{"text":". If you implement a custom delegate, add your own","type":"text"},{"text":" ","type":"text"},{"text":"activities as needed.","type":"text"}],"type":"paragraph"},{"anchor":"Replica-vs-Feed-Sharing","text":"Replica vs Feed Sharing","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate","isActive":true},{"type":"text","text":" protocol defines "},{"type":"strong","inlineContent":[{"type":"text","text":"separate methods"}]},{"type":"text","text":" for feed and"},{"type":"text","text":" "},{"type":"text","text":"replica editions."}],"type":"paragraph"},{"anchor":"Feed-Edition-Methods","text":"Feed Edition Methods","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed editions use page-level sharing:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isShareable(page:inEdition:inPublished:)","type":"codeVoice"},{"text":" — controls whether the share","type":"text"},{"text":" ","type":"text"},{"text":"button is visible for a given page.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"shareContext(forPage:inEdition:inPublished:)","type":"codeVoice"},{"text":" — provides the share content.","type":"text"}]}]}]},{"type":"heading","level":3,"text":"Replica Edition Methods","anchor":"Replica-Edition-Methods"},{"type":"paragraph","inlineContent":[{"text":"Replica editions use spread-level sharing. A ","type":"text"},{"type":"codeVoice","code":"PSReplicaPageSpread"},{"text":" represents","type":"text"},{"text":" ","type":"text"},{"text":"what the user currently sees and has three cases:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".single(PSPage)"}]},{"type":"text","text":" — a single PDF page."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".double(left: PSPage?, right: PSPage?)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — a double-page spread in"},{"type":"text","text":" "},{"type":"text","text":"landscape mode."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".article(PSArticle)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — an article view within the replica reader."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The delegate methods receive a "},{"type":"codeVoice","code":"PSReplicaPageSpread"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"PSReplicaEdition"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isShareable(spread:inReplicaEdition:)"},{"type":"text","text":" — controls share button visibility."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"shareContext(forSpread:inReplicaEdition:)","type":"codeVoice"},{"text":" — provides the share content.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArticleLinkShareProvider","type":"reference","isActive":true},{"text":" only shares replica article spreads","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":".article","type":"codeVoice"},{"text":" case) where the article has a non-empty ","type":"text"},{"code":"shareLink","type":"codeVoice"},{"text":". PDF page","type":"text"},{"text":" ","type":"text"},{"text":"spreads are not shareable through this provider.","type":"text"}]}],"type":"aside"},{"anchor":"Custom-ShareDelegate","level":2,"text":"Custom ShareDelegate","type":"heading"},{"inlineContent":[{"type":"text","text":"For full control, implement "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate","isActive":true},{"type":"text","text":" directly. The protocol has"},{"type":"text","text":" "},{"type":"text","text":"methods for both feed edition pages and replica spreads:"}],"type":"paragraph"},{"code":["struct MyShareDelegate: PSReader.ShareDelegate {","","    \/\/ MARK: Feed Edition Methods","","    func isShareable(","        page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> Bool {","        \/\/ Only share article pages","        return page.type == \"templateArticle\"","    }","","    func shareContext(","        forPage page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> ShareContext? {","        guard let article = page.articles?.first,","              let shareLink = article.sharelink,","              let url = URL(string: shareLink) else {","            return nil","        }","        return ShareContext(","            activityItems: [url],","            subject: article.headline","        )","    }","","    \/\/ MARK: Replica Edition Methods","","    func isShareable(","        spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> Bool {","        \/\/ Share all page spreads; only share articles that have a link","        switch spread {","        case .single, .double:","            return true","        case .article(let article):","            return !article.shareLink.isEmpty","        }","    }","","    func shareContext(","        forSpread spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> ShareContext? {","        let edition = replicaEdition.edition","","        switch spread {","        case .article(let article):","            \/\/ Share the article link","            guard let url = URL(string: article.shareLink) else { return nil }","            return ShareContext(","                activityItems: [url],","                subject: article.headline","            )","","        case .single(let page):","            \/\/ Share a text description of the page","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","","        case .double(let left, let right):","            let page = left ?? right","            guard let page else { return nil }","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"isShareable"},{"type":"text","text":" methods have default implementations that return"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when "},{"type":"codeVoice","code":"shareContext"},{"type":"text","text":" returns a non-nil value. You only need to implement"},{"type":"text","text":" "},{"type":"text","text":"them explicitly as a performance optimization to avoid building a share"},{"type":"text","text":" "},{"type":"text","text":"context just to check visibility."}]}],"type":"aside"},{"text":"Print Integration","level":2,"anchor":"Print-Integration","type":"heading"},{"inlineContent":[{"type":"text","text":"Since v5.3, printing is consolidated into the share actions. The dedicated"},{"type":"text","text":" "},{"type":"text","text":"print icon has been removed from the reader navigation bar. Users access"},{"type":"text","text":" "},{"type":"text","text":"printing through the system share sheet, where it appears as a standard"},{"type":"text","text":" "},{"code":"UIActivity","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Printing requires no configuration. It is available automatically whenever","type":"text"},{"text":" ","type":"text"},{"text":"sharing is enabled (i.e., the share delegate is not set to ","type":"text"},{"type":"codeVoice","code":".disabled"},{"text":").","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"title":"Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywall-Integration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Media-Playback","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Search","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Analytics"],"generated":true,"a