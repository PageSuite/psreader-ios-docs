{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Advert-Pages"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt reader asks the app for a banner to show below the pages,"},{"type":"text","text":" "},{"type":"text","text":"and for a view controller for each advert page. In your own reader"},{"type":"text","text":" "},{"type":"text","text":"screen, banners are yours to build, but advert pages need little work:"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController","type":"reference","isActive":true},{"type":"text","text":" renders them itself, with the same"},{"type":"text","text":" "},{"type":"text","text":"built-in rendering, and its advert delegate can replace any of them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the prebuilt UI? See "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When your editions carry adverts, your reader screen usually needs two"},{"type":"text","text":" "},{"type":"text","text":"things. First, the app configuration, passed when the reader opens an"},{"type":"text","text":" "},{"type":"text","text":"edition, so third-party adverts can serve and in-article adverts appear:"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Passing-the-App-Configuration","type":"reference","isActive":true},{"type":"text","text":" adds an "},{"type":"codeVoice","code":"appConfig"},{"type":"text","text":" "},{"type":"text","text":"property to "},{"type":"codeVoice","code":"ReaderScreenViewController"},{"type":"text","text":", the reader screen from"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader","type":"reference","isActive":true},{"type":"text","text":", and passes it to the reader. Second, a view"},{"type":"text","text":" "},{"type":"text","text":"controller for Google Ad Manager pages, which have no built-in rendering."},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":"hostReader()"},{"type":"text","text":", with the other delegates, make the screen the reader’s"},{"type":"text","text":" "},{"type":"text","text":"advert delegate:"}]},{"syntax":"swift","showLineNumbers":false,"code":["reader.advertDelegate = self"],"copyToClipboard":true,"type":"codeListing","lineAnnotations":[],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"text","text":"And conform in an extension, in the same file as the class:"}]},{"syntax":"swift","showLineNumbers":false,"code":["extension ReaderScreenViewController: PSEditionReaderViewController.AdvertDelegate {","","    func advertViewController(forPage page: PSEPage) -> PSEAdvertContentViewController? {","        guard page.advertProvider == .googleAdManager else {","            return nil   \/\/ The built-in rendering.","        }","        return GoogleAdPageViewController(page: page)","    }","}"],"copyToClipboard":true,"type":"codeListing","lineAnnotations":[],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GoogleAdPageViewController"},{"type":"text","text":" is your advert page view controller, written"},{"type":"text","text":" "},{"type":"text","text":"as in "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements#Rendering-Advert-Pages-Yourself","type":"reference","isActive":true},{"type":"text","text":". In Swift 6"},{"type":"text","text":" "},{"type":"text","text":"language mode, mark the conformance "},{"type":"codeVoice","code":"@preconcurrency"},{"type":"text","text":"; see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Swift-6-Language-Mode","isActive":true},{"type":"text","text":"."}]},{"type":"heading","anchor":"Giving-Third-Party-Adverts-an-Origin","level":2,"text":"Giving Third-Party Adverts an Origin"},{"inlineContent":[{"text":"The built-in rendering serves third-party adverts in a web view, which","type":"text"},{"text":" ","type":"text"},{"text":"needs a web origin to load against, usually your publication’s website.","type":"text"},{"text":" ","type":"text"},{"text":"The reader takes it from your media delegate’s","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController\/MediaDelegate-swift.protocol\/baseURL(for:)"},{"type":"text","text":" when that"},{"text":" ","type":"text"},{"text":"returns one, and otherwise from your app configuration’s advertising","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"domain, then its edition base URL. Third-party adverts also prefer the app"},{"text":" ","type":"text"},{"type":"text","text":"configuration’s ad-stack scripts to the page’s own copy. With neither a"},{"text":" ","type":"text"},{"type":"text","text":"base URL from your media delegate nor an app configuration, third-party"},{"type":"text","text":" "},{"type":"text","text":"adverts have no origin and can’t serve."}],"type":"paragraph"},{"inlineContent":[{"text":"The app configuration also switches on the in-article adverts it","type":"text"},{"text":" ","type":"text"},{"text":"configures, which templated pages render within their content (see","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements#Adverts-Inside-Pages","isActive":true,"type":"reference"},{"text":"). To load it and pass it to the","type":"text"},{"text":" ","type":"text"},{"text":"reader, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Passing-the-App-Configuration"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"Serving-Advert-Pages-From-Your-Ad-Stack","level":2,"text":"Serving Advert Pages From Your Ad Stack"},{"inlineContent":[{"type":"text","text":"The reader asks"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController\/AdvertDelegate-swift.protocol\/advertViewController(forPage:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"for every "},{"code":"advert_html","type":"codeVoice"},{"type":"text","text":" and "},{"code":"advert_third_party","type":"codeVoice"},{"type":"text","text":" page. Return a view"},{"type":"text","text":" "},{"type":"text","text":"controller that adopts "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEAdvertContentViewController","isActive":true,"type":"reference"},{"type":"text","text":", and the reader"},{"type":"text","text":" "},{"type":"text","text":"pins its view to the page’s edges; return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to keep the built-in"},{"type":"text","text":" "},{"type":"text","text":"rendering for a page. To render nothing, return an empty view controller"},{"type":"text","text":" "},{"type":"text","text":"instead. "},{"code":"advert","type":"codeVoice"},{"type":"text","text":" and "},{"code":"advert_pdf","type":"codeVoice"},{"type":"text","text":" pages render as PDF or web content and"},{"type":"text","text":" "},{"type":"text","text":"never reach the delegate."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Set the delegate before the edition opens, as "},{"code":"hostReader()","type":"codeVoice"},{"type":"text","text":" does, so"},{"type":"text","text":" "},{"type":"text","text":"the first pages use it. Everything else works as it does in the prebuilt"},{"type":"text","text":" "},{"type":"text","text":"reader:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The reader builds pages before they’re on screen and rebuilds them","type":"text"},{"text":" ","type":"text"},{"text":"later, and asks your delegate each time, so return a new view controller","type":"text"},{"text":" ","type":"text"},{"text":"from every call.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Request ads and count impressions from the reader’s visibility hooks,","type":"text"},{"text":" ","type":"text"},{"text":"never ","type":"text"},{"code":"viewDidAppear","type":"codeVoice"},{"text":". ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements#Rendering-Advert-Pages-Yourself"},{"text":" ","type":"text"},{"text":"explains each hook, with a Google Ad Manager view controller to start","type":"text"},{"text":" ","type":"text"},{"text":"from.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements#Full-Page-Advert-Pages"},{"text":" lists what the built-in","type":"text"},{"text":" ","type":"text"},{"text":"rendering shows for each provider.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A classic PDF edition’s page-zero advert reaches your delegate too, for a","type":"text"},{"text":" ","type":"text"},{"text":"slot beside the cover; see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements#Adverts-Beside-the-Cover"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Localizing-the-Advertisement-Label","level":2,"text":"Localizing the Advertisement Label"},{"inlineContent":[{"type":"text","text":"The built-in rendering shows a label above fixed-size third-party slots."},{"type":"text","text":" "},{"type":"text","text":"The reader always labels them “Advertisement”, in English. To show your"},{"type":"text","text":" "},{"type":"text","text":"own text, create the default renderer yourself, as a"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDefaultAdvertViewController","isActive":true,"type":"reference"},{"type":"text","text":". Replace the delegate method with:"}],"type":"paragraph"},{"syntax":"swift","showLineNumbers":false,"code":["func advertViewController(forPage page: PSEPage) -> PSEAdvertContentViewController? {","    if page.advertProvider == .googleAdManager {","        return GoogleAdPageViewController(page: page)","    }","    return PSEDefaultAdvertViewController(","        page: page,","        application: appConfig,","        baseURL: \"https:\/\/www.example.com\",","        advertisementLabelText: String(localized: \"Advertisement\")","    )","}"],"copyToClipboard":true,"type":"codeListing","lineAnnotations":[],"wrap":0},{"inlineContent":[{"type":"text","text":"Pass the app configuration you open the edition with, and the base URL"},{"type":"text","text":" "},{"type":"text","text":"the advert content loads against, usually your publication’s website. The"},{"type":"text","text":" "},{"type":"text","text":"initializer returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for pages it can’t render, such as Google Ad"},{"type":"text","text":" "},{"type":"text","text":"Manager pages, and those pages stay blank."}],"type":"paragraph"},{"type":"heading","anchor":"Placing-a-Banner","level":2,"text":"Placing a Banner"},{"inlineContent":[{"type":"text","text":"The reader has no banner slot. A banner is part of your chrome: lay it"},{"type":"text","text":" "},{"type":"text","text":"out below the reader, as the prebuilt reader screen does, by pinning the"},{"type":"text","text":" "},{"type":"text","text":"reader’s bottom edge to the banner’s top in "},{"code":"hostReader()","type":"codeVoice"},{"type":"text","text":" instead of to"},{"type":"text","text":" "},{"type":"text","text":"the safe area. Add a property that remembers the page the banner last"},{"type":"text","text":" "},{"type":"text","text":"targeted:"}],"type":"paragraph"},{"syntax":"swift","showLineNumbers":false,"code":["private var bannerPageGUID: String?"],"copyToClipboard":true,"type":"codeListing","lineAnnotations":[],"wrap":0},{"inlineContent":[{"type":"text","text":"And in "},{"code":"updateChrome()","type":"codeVoice"},{"type":"text","text":", refresh the banner when the reader settles on a"},{"type":"text","text":" "},{"type":"text","text":"new page:"}],"type":"paragraph"},{"syntax":"swift","showLineNumbers":false,"code":["if page.pageguid != bannerPageGUID {","    bannerPageGUID = page.pageguid","    bannerAd.refresh(section: page.section)","}"],"copyToClipboard":true,"type":"codeListing","lineAnnotations":[],"wrap":0},{"inlineContent":[{"code":"bannerAd","type":"codeVoice"},{"type":"text","text":" is your banner view. The check skips a settle on the same"},{"type":"text","text":" "},{"type":"text","text":"page, which the reader reports when the user drags and lets go without"},{"type":"text","text":" "},{"type":"text","text":"turning the page."}],"type":"paragraph"},{"type":"heading","anchor":"Handling-Clickthroughs-and-Analytics","level":2,"text":"Handling Clickthroughs and Analytics"},{"inlineContent":[{"type":"text","text":"The built-in rendering doesn’t navigate an advert’s web view when the user"},{"type":"text","text":" "},{"type":"text","text":"taps it. Clickthroughs, including "},{"code":"window.open","type":"codeVoice"},{"type":"text","text":" calls, post"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController\/linkTappedNotification","isActive":true,"type":"reference"},{"type":"text","text":", and open only"},{"type":"text","text":" "},{"type":"text","text":"once your reader screen observes it, as it does for every other link; see"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps#Opening-Links","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The prebuilt reader reports an advert page that settles on screen as a"},{"type":"text","text":" "},{"type":"text","text":"page view. Its analytics events don’t fire in your reader screen;"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics#Reporting-Page-Views"},{"type":"text","text":" reports page views and"},{"type":"text","text":" "},{"type":"text","text":"says how to decide whether advert pages count. Count impressions in your"},{"type":"text","text":" "},{"type":"text","text":"own advert view controllers."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"seeAlsoSections":[{"anchor":"Adding-Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics"],"title":"Adding Features","generated":true}],"kind":"article","variants":[{"paths":["\/documentation\/psreader\/handling-advert-pages"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreader\/handling-advert-pages"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"text":"Let the reader in your own reader screen render advert pages, or serve them from your own ad stack, and place any banners in your chrome.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDefaultAdvertViewController"],"title":"Localizing the Advertisement Label","anchor":"Localizing-the-Advertisement-Label"}],"metadata":{"roleHeading":"Guide","modules":[{"name":"PSReader"}],"role":"collectionGroup","title":"Handling Advert Pages"},"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/Handling-Media-and-Link-Taps#Opening-Links":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps#Opening-Links","kind":"section","type":"topic","url":"\/documentation\/psreader\/handling-media-and-link-taps#Opening-Links","title":"Opening Links","abstract":[]},"doc://com.pagesuite.PSReader/documentation/PSReader/Handling-Media-and-Link-Taps":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps","type":"topic","title":"Handling Media and Link Taps","abstract":[{"text":"Respond to taps on the images, videos, embeds, hotspots, and links in the pages your own reader screen hosts.","type":"text"}],"role":"collectionGroup","url":"\/documentation\/psreader\/handling-media-and-link-taps","kind":"article"},"doc://com.pagesuite.PSReader/documentation/PSReader/PSEditionReaderViewController/linkTappedNotification":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController\/linkTappedNotification","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"linkTappedNotification"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Notification","preciseIdentifier":"s:10Foundation12NotificationV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Name","preciseIdentifier":"s:10Foundation12NotificationV4Namea"}],"url":"\/documentation\/psreader\/pseditionreaderviewcontroller\/linktappednotification","kind":"symbol","title":"linkTappedNotification","abstract":[{"text":"Posted when the user taps a link inside edition content — an article","type":"text"},{"text":" ","type":"text"},{"text":"hyperlink, a link hotspot, or a link out of an advert page.","type":"text"}],"type":"topic","role":"symbol"},"doc://com.pagesuite.PSReader/documentation/PSReader/Adding-Comment-Buttons":{"title":"Adding Comment Buttons","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","abstract":[{"text":"Show comment buttons and counts on the articles in your own reader screen, with the SDK’s commenting provider.","type":"text"}],"url":"\/documentation\/psreader\/adding-comment-buttons"},"doc://com.pagesuite.PSReader/documentation/PSReader/PSEDefaultAdvertViewController":{"title":"PSEDefaultAdvertViewController","abstract":[{"type":"text","text":"The framework’s default, webview-only renderer for advert pages"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"advert_html"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"advert_third_party"},{"type":"text","text":"). No third-party native SDKs are"},{"type":"text","text":" "},{"type":"text","text":"involved — third-party ad tech (htlbid\/aditude) runs inside the webview"},{"type":"text","text":" "},{"type":"text","text":"via the PageSuite hosted loader. Google Ad Manager pages have no"},{"type":"text","text":" "},{"type":"text","text":"framework default: clients supply a native Google ad through"},{"type":"text","text":" "},{"type":"codeVoice","code":"PSEditionReaderViewController.AdvertDelegate.advertViewController(forPage:)"},{"type":"text","text":". This class is"},{"type":"text","text":" "},{"type":"text","text":"public so overriding delegates can still fall back to it selectively."}],"url":"\/documentation\/psreader\/psedefaultadvertviewcontroller","kind":"symbol","role":"symbol","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDefaultAdvertViewController","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PSEDefaultAdvertViewController","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"PSEDefaultAdvertViewController","kind":"identifier"}]},"doc://com.pagesuite.PSReader/documentation/PSReader/Advertisements#Rendering-Advert-Pages-Yourself":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements#Rendering-Advert-Pages-Yourself","kind":"section","type":"topic","url":"\/documentation\/psreader\/advertisements#Rendering-Advert-Pages-Yourself","title":"Rendering Advert Pages Yourself","abstract":[]},"doc://com.pagesuite.PSReader/documentation/PSReader/Adding-a-Bookmark-Button":{"role":"collectionGroup","kind":"article","title":"Adding a Bookmark Button","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","url":"\/documentation\/psreader\/adding-a-bookmark-button","abstract":[{"type":"text","text":"Add a bookmark button to your own reader screen that saves the page or article in view, then list and reopen what the user saved."}],"type":"topic"},"doc://com.pagesuite.PSReader/documentation/PSReader/Advertisements":{"url":"\/documentation\/psreader\/advertisements","title":"Advertisements","abstract":[{"type":"text","text":"Show banner adverts in the prebuilt reader, and serve its advert pages"},{"type":"text","text":" "},{"type":"text","text":"from your own ad stack."}],"type":"topic","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements","role":"collectionGroup","kind":"article"},"doc://com.pagesuite.PSReader/documentation/PSReader/PSEditionReaderViewController":{"navigatorTitle":[{"kind":"identifier","text":"PSEditionReaderViewController"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PSEditionReaderViewController"}],"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController","abstract":[{"type":"text","text":"A view controller that presents an edition from PageSuite’s current"},{"type":"text","text":" "},{"type":"text","text":"system, classic PDF or responsive, as a horizontally paged reader."}],"title":"PSEditionReaderViewController","kind":"symbol","url":"\/documentation\/psreader\/pseditionreaderviewcontroller"},"doc://com.pagesuite.PSReader/documentation/PSReader/Advertisements#Adverts-Inside-Pages":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements#Adverts-Inside-Pages","kind":"section","type":"topic","url":"\/documentation\/psreader\/advertisements#Adverts-Inside-Pages","title":"Adverts Inside Pages","abstract":[]},"doc://com.pagesuite.PSReader/documentation/PSReader/PSEditionReaderViewController/AdvertDelegate-swift.protocol/advertViewController(forPage:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"advertViewController","kind":"identifier"},{"text":"(","kind":"text"},{"text":"forPage","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PSEPage","kind":"typeIdentifier","preciseIdentifier":"c:@M@PSReader@objc(cs)PSEPage"},{"text":") -> ","kind":"text"},{"text":"PSEAdvertContentViewController","kind":"typeIdentifier","preciseIdentifier":"s:8PSReader30PSEAdvertContentViewControllerP"},{"text":"?","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/psreader\/pseditionreaderviewcontroller\/advertdelegate-swift.protocol\/advertviewcontroller(forpage:)","abstract":[{"text":"The view controller to render an advert page, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to accept","type":"text"},{"text":" ","type":"text"},{"text":"the built-in rendering. To render nothing for a page, return an","type":"text"},{"text":" ","type":"text"},{"text":"empty view controller.","type":"text"}],"title":"advertViewController(forPage:)","role":"symbol","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController\/AdvertDelegate-swift.protocol\/advertViewController(forPage:)","required":true},"doc://com.pagesuite.PSReader/documentation/PSReader":{"title":"PSReader","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Embed digital newspaper and magazine editions in your iOS app. Use PageSuite’s prebuilt reader, or build your own interface on the same engine."}],"url":"\/documentation\/psreader","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","type":"topic"},"doc://com.pagesuite.PSReader/documentation/PSReader/Adding-a-Share-Button":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","title":"Adding a Share Button","url":"\/documentation\/psreader\/adding-a-share-button","abstract":[{"type":"text","text":"Add a share button to your own reader screen that shares the page in view, using the share providers the prebuilt reader uses."}],"type":"topic","role":"article","kind":"article"},"doc://com.pagesuite.PSReader/documentation/PSReader/Adding-a-Download-Button":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","url":"\/documentation\/psreader\/adding-a-download-button","title":"Adding a Download Button","kind":"article","abstract":[{"typ