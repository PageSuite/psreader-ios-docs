{"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywall-Integration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Sharing","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Media-Playback","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Search","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Analytics"],"anchor":"Features","title":"Features","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"The PSReader SDK provides a modular text-to-speech (TTS) architecture built","type":"text"},{"text":" ","type":"text"},{"text":"around the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate"},{"type":"text","text":" protocol. The system is designed so that each"},{"type":"text","text":" "},{"type":"text","text":"layer can be swapped independently — you can replace just the voice synthesis,"},{"type":"text","text":" "},{"type":"text","text":"just the article formatting, or just the UI without touching the rest:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Article Formatter","type":"text"}]},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/TextToSpeechArticleFormatter","isActive":true},{"type":"text","text":") — extracts and"},{"type":"text","text":" "},{"type":"text","text":"formats article text for synthesis."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Speech Synthesizer","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/TextToSpeechSynthesizer"},{"text":") — converts formatted","type":"text"},{"text":" ","type":"text"},{"text":"text into an audio file.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Audio Session Provider"}],"type":"strong"},{"text":" (","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioSessionProvider","isActive":true,"type":"reference"},{"text":") — manages the","type":"text"},{"text":" ","type":"text"},{"code":"AVAudioSession","type":"codeVoice"},{"text":" lifecycle.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Audio Interface"}],"type":"strong"},{"type":"text","text":" — presents playback controls to the user as either a"},{"type":"text","text":" "},{"type":"text","text":"transient overlay or a persistent banner."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK ships default implementations of each component. For most apps, the"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider","isActive":true,"type":"reference"},{"type":"text","text":" class wires everything together in a single"},{"type":"text","text":" "},{"type":"text","text":"line."}]},{"level":2,"type":"heading","text":"Quick Start","anchor":"Quick-Start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Assign a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider","isActive":true},{"type":"text","text":" as the audio delegate on your"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["globalConfig.audioDelegate = PSReader.DefaultTextToSpeechProvider(","    configuration: .init(globalConfig: globalConfig)",")"]},{"type":"paragraph","inlineContent":[{"text":"That’s it. This enables a listen button in the reader navigation bar. When","type":"text"},{"text":" ","type":"text"},{"text":"tapped, the SDK formats the current article, synthesizes speech using the","type":"text"},{"text":" ","type":"text"},{"text":"device’s text-to-speech engine, and presents an audio overlay with playback","type":"text"},{"text":" ","type":"text"},{"text":"controls.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"All of the defaults — article formatting, speech synthesis, audio session","type":"text"},{"text":" ","type":"text"},{"text":"management, and overlay appearance — are handled automatically. The sections","type":"text"},{"type":"text","text":" "},{"type":"text","text":"below cover how to customize individual layers if you need more control."}]},{"content":[{"inlineContent":[{"type":"text","text":"TTS is available for "},{"inlineContent":[{"text":"article pages only","type":"text"}],"type":"strong"},{"text":". Pure PDF pages (non-article","type":"text"},{"text":" ","type":"text"},{"text":"page spreads) do not contain structured text and cannot be synthesized. The","type":"text"},{"text":" ","type":"text"},{"text":"listen button will not appear for these pages.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"anchor":"Custom-Synthesizer","level":2,"type":"heading","text":"Custom Synthesizer"},{"type":"paragraph","inlineContent":[{"text":"The default synthesizer (","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechSynthesizer","type":"reference","isActive":true},{"text":") uses","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AVSpeechSynthesizer"},{"text":" with the device’s default voice. If the user has","type":"text"},{"text":" ","type":"text"},{"text":"downloaded a premium or enhanced voice through ","type":"text"},{"inlineContent":[{"type":"text","text":"Settings > Accessibility >"},{"type":"text","text":" "},{"type":"text","text":"Spoken Content > Voices"}],"type":"strong"},{"text":", iOS will prefer it automatically. However, most","type":"text"},{"text":" ","type":"text"},{"text":"users will not have done this, and the default system voice can sound","type":"text"},{"text":" ","type":"text"},{"text":"noticeably robotic.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To provide a higher quality experience, implement "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/TextToSpeechSynthesizer","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and plug in your own synthesis layer — whether that’s a third-party TTS"},{"type":"text","text":" "},{"type":"text","text":"package bundled with the app or a cloud-based service. Everything else the SDK"},{"type":"text","text":" "},{"type":"text","text":"provides (article formatting, the overlay UI, audio session management,"},{"type":"text","text":" "},{"text":"playback controls) continues to work unchanged:","type":"text"}]},{"code":["struct PremiumSynthesizer: PSReader.TextToSpeechSynthesizer {","    func synthesize(string: String, completion: @escaping (Result<URL, Error>) -> Void) {","        \/\/ Call your TTS API, write the audio to a temporary file,","        \/\/ and return the file URL.","        MyTTSService.synthesize(string) { result in","            completion(result)","        }","    }","}","","\/\/ Swap in your synthesizer — the rest of the stack stays the same","globalConfig.audioDelegate = PSReader.DefaultTextToSpeechProvider(","    configuration: .init(globalConfig: globalConfig),","    speechSynthesizer: PremiumSynthesizer()",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"language","type":"codeVoice"},{"text":" parameter on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechSynthesizer"},{"text":" controls the","type":"text"},{"text":" ","type":"text"},{"text":"voice locale when using the built-in engine (defaults to ","type":"text"},{"code":"\"en\"","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"level":2,"text":"Custom Article Formatter","type":"heading","anchor":"Custom-Article-Formatter"},{"inlineContent":[{"type":"text","text":"Implement "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/TextToSpeechArticleFormatter"},{"type":"text","text":" to control how article content is"},{"type":"text","text":" "},{"type":"text","text":"prepared before it reaches the synthesizer. This is useful for stripping"},{"type":"text","text":" "},{"type":"text","text":"boilerplate, reordering sections, adding pronunciation hints, or inserting"},{"type":"text","text":" "},{"type":"text","text":"pauses between paragraphs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Like the synthesizer, the formatter plugs directly into"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider"},{"type":"text","text":" — you get to customize what text is spoken"},{"type":"text","text":" "},{"type":"text","text":"without rebuilding the rest of the stack:"}],"type":"paragraph"},{"code":["struct MyArticleFormatter: PSReader.TextToSpeechArticleFormatter {","    func format(article: PSEArticle) throws -> String {","        let title = article.title ?? \"\"","        let body = article.body ?? \"\"","        return \"\\(title). \\(body)\"","    }","","    func format(article: PSArticle) throws -> String {","        return article.title ?? \"\"","    }","}","","globalConfig.audioDelegate = PSReader.DefaultTextToSpeechProvider(","    configuration: .init(globalConfig: globalConfig),","    articleFormatter: MyArticleFormatter()",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The built-in ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechArticleFormatter","isActive":true,"type":"reference"},{"type":"text","text":" extracts the headline,"},{"type":"text","text":" "},{"type":"text","text":"byline, and body text, strips HTML markup, and joins them into a clean string"},{"type":"text","text":" "},{"type":"text","text":"ready for synthesis."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You can combine a custom formatter and a custom synthesizer together:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["globalConfig.audioDelegate = PSReader.DefaultTextToSpeechProvider(","    configuration: .init(globalConfig: globalConfig),","    articleFormatter: MyArticleFormatter(),","    speechSynthesizer: PremiumSynthesizer()",")"]},{"anchor":"Audio-Interface-Patterns","level":2,"text":"Audio Interface Patterns","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK supports two UI patterns for audio playback. You can use either one or"},{"type":"text","text":" "},{"type":"text","text":"both, depending on your "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate","type":"reference"},{"type":"text","text":" implementation."}]},{"anchor":"Transient-Overlay","level":3,"text":"Transient Overlay","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The default pattern used by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider"},{"text":". When the user taps","type":"text"},{"text":" ","type":"text"},{"text":"the listen button, a popover-style overlay appears over the reader content. The","type":"text"},{"text":" ","type":"text"},{"text":"overlay includes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Play \/ Pause","type":"text"}],"type":"strong"},{"text":" button with a loading indicator during synthesis","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Skip backward \/ forward","type":"text"}],"type":"strong"},{"type":"text","text":" buttons (15-second increments)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Progress bar","type":"text"}],"type":"strong"},{"text":" with scrub support for seeking through the audio","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Elapsed","type":"text"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"remaining"}]},{"type":"text","text":" time labels"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Title","type":"text"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"subtitle"}],"type":"strong"},{"text":" labels showing the article name","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The SDK manages the overlay’s presentation and dismissal. The overlay is","type":"text"},{"text":" ","type":"text"},{"text":"dismissed when the user taps outside it. On iOS 26+, the overlay adopts the","type":"text"},{"text":" ","type":"text"},{"text":"Liquid Glass design language by default.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To provide a fully custom overlay UI while keeping the SDK’s lifecycle"},{"type":"text","text":" "},{"type":"text","text":"management, subclass "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioOverlay","isActive":true,"type":"reference"},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioOverlay","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Design your audio interface in the subclass.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Return an instance from your ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"code":"playAudio","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Both feed and replica editions support overlays via separate delegate methods:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"playAudio(for:inEdition:)"},{"text":" for feed editions and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"playAudio(forSpread:inReplicaEdition:)"},{"text":" for replica editions.","type":"text"}]},{"level":3,"text":"Persistent Banner","type":"heading","anchor":"Persistent-Banner"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An alternative pattern where a compact audio control banner remains visible at"},{"type":"text","text":" "},{"type":"text","text":"the bottom of the reader as the user navigates between pages. This is useful"},{"type":"text","text":" "},{"type":"text","text":"when you want playback controls to persist across page navigation rather than"},{"type":"text","text":" "},{"type":"text","text":"appearing as a modal."}]},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioBannerViewController","type":"reference"},{"text":" and return it from","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate\/audioBannerViewController()","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["class MyAudioBanner: UIViewController, PSReader.AudioBannerViewController {","","    var isFloating: Bool { true }","","    override func viewDidLoad() {","        super.viewDidLoad()","        \/\/ Build your compact audio control UI (play\/pause, progress, etc.)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"isFloating","type":"codeVoice"},{"text":" property controls how the banner is positioned:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"true"}]},{"type":"text","text":" — the banner floats above the reader content, pinned to the"},{"type":"text","text":" "},{"type":"text","text":"bottom of the screen. The SDK automatically applies a bottom safe-area inset"},{"type":"text","text":" "},{"type":"text","text":"equal to the banner’s height so content is not obscured."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"false"}]},{"text":" — the banner is stacked below the reader. The reader’s available","type":"text"},{"text":" ","type":"text"},{"text":"height is reduced accordingly.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Banner visibility is driven by the view’s own layout. Set an intrinsic content"},{"type":"text","text":" "},{"type":"text","text":"height (via Auto Layout constraints) to show the banner. Collapse the height to"},{"type":"text","text":" "},{"type":"text","text":"zero to hide it. The SDK does not call show\/hide methods — it reads the"},{"type":"text","text":" "},{"type":"text","text":"banner’s layout directly."}],"type":"paragraph"},{"anchor":"Choosing-a-Pattern","level":3,"type":"heading","text":"Choosing a Pattern"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pattern"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Best for"}]}],[{"type":"paragraph","inlineContent":[{"text":"Default provider","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transient overlay"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Most integrations — simple, no custom UI needed"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider","type":"reference","isActive":true},{"text":" provides this out of the box","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Persistent banner"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Apps with their own audio system or “now playing” UI"}]}],[{"type":"paragraph","inlineContent":[{"text":"Requires a custom ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate","type":"reference"},{"text":" implementation","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"Both"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Overlay for on-demand playback, banner for persistent controls","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Requires a custom "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate"},{"type":"text","text":" returning both"}],"type":"paragraph"}]]]},{"level":2,"text":"Customizing the Overlay","anchor":"Customizing-the-Overlay","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioOverlayConfiguration"},{"type":"text","text":" struct controls the appearance of the"},{"type":"text","text":" "},{"text":"default audio overlay. It inherits defaults from ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"can be customized before passing to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider"},{"text":":","type":"text"}]},{"code":["var ttsConfig = PSReader.AudioOverlayConfiguration(globalConfig: globalConfig)","","\/\/ Accent color for the play button and progress bar","ttsConfig.brandColor = .systemBlue","","\/\/ Overlay background","ttsConfig.backgroundColor = .secondarySystemBackground","","\/\/ Article title (defaults: primaryFont bold, 18pt)","ttsConfig.titleLabel = LabelConfiguration(","    font: .systemFont(ofSize: 18, weight: .bold),","    pointSize: 18,","    color: .label",")","","\/\/ Secondary info line (defaults: primaryFont, 14pt)","ttsConfig.subtitleLabel = LabelConfiguration(","    font: .systemFont(ofSize: 14),","    pointSize: 14,","    color: .secondaryLabel",")","","\/\/ Elapsed time display (defaults: primaryFont, 12pt)","ttsConfig.elapsedLabel = LabelConfiguration(","    font: .monospacedDigitSystemFont(ofSize: 12, weight: .regular),","    pointSize: 12,","    color: .tertiaryLabel",")","","\/\/ Remaining time display (defaults: primaryFont, 12pt)","ttsConfig.remainingLabel = LabelConfiguration(","    font: .monospacedDigitSystemFont(ofSize: 12, weight: .regular),","    pointSize: 12,","    color: .tertiaryLabel",")","","\/\/ Custom playback icons","ttsConfig.assetDelegate = MyAssetDelegate()","","\/\/ iOS 26+ Liquid Glass effect (defaults to global value)","ttsConfig.liquidGlassPolicy = .automatic","","let ttsProvider = PSReader.DefaultTextToSpeechProvider(configuration: ttsConfig)","globalConfig.audioDelegate = ttsProvider"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Handling Page Navigation","level":2,"anchor":"Handling-Page-Navigation"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate"},{"text":" protocol includes methods that the SDK calls when the","type":"text"},{"type":"text","text":" "},{"text":"user navigates to a different page or spread:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"didChangeTo(page:inEdition:inPublished:)","type":"codeVoice"},{"text":" — called for feed edition","type":"text"},{"text":" ","type":"text"},{"text":"navigation.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"didChangeTo(spread:inReplicaEdition:)","type":"codeVoice"},{"type":"text","text":" — called for replica edition"},{"type":"text","text":" "},{"text":"navigation.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider"},{"text":" uses these methods to automatically stop","type":"text"},{"text":" ","type":"text"},{"text":"playback when the user navigates away from the article that is currently","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"playing. If the user navigates back to the same article, playback resumes from"},{"type":"text","text":" "},{"type":"text","text":"where it left off."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you implement a custom "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate","isActive":true,"type":"reference"},{"text":", use these methods to pause or stop","type":"text"},{"text":" ","type":"text"},{"text":"your audio player, update banner state, or perform any cleanup needed when the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"user moves between pages."}]},{"level":2,"anchor":"Audio-Session-Management","type":"heading","text":"Audio Session Management"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioSessionProvider","type":"reference","isActive":true},{"type":"text","text":" protocol manages "},{"type":"codeVoice","code":"AVAudioSession"},{"type":"text","text":" activation and"},{"type":"text","text":" "},{"text":"deactivation around playback. The default implementation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultAudioSessionProvider"},{"text":") configures the session for ","type":"text"},{"type":"codeVoice","code":".playback"},{"text":" ","type":"text"},{"text":"category, enabling background audio.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Override it if your app has specific audio session requirements — for example,"},{"type":"text","text":" "},{"type":"text","text":"mixing with other audio sources or handling interruptions differently:"}]},{"type":"codeListing","code":["struct MyAudioSessionProvider: PSReader.AudioSessionProvider {","    func setupAudioSession(for article: PSEArticle, inEdition source: PSEEditionSource) throws {","        let session = AVAudioSession.sharedInstance()","        try session.setCategory(.playback, options: .mixWithOthers)","        try session.setActive(true)","    }","","    func deactivateAudioSession(for article: PSEArticle, inEdition source: PSEEditionSource) throws {","        try AVAudioSession.sharedInstance().setActive(false, options: .notifyOthersOnDeactivation)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The protocol also defines matching methods for replica editions","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"setupAudioSession(for:inReplicaEdition:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"deactivateAudioSession(for:inReplicaEdition:)"},{"text":") with default implementations","type":"text"},{"text":" ","type":"text"},{"text":"that delegate to the feed edition methods.","type":"text"}]},{"level":2,"type":"heading","text":"Custom AudioDelegate","anchor":"Custom-AudioDelegate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For full control over the audio experience, implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate"},{"type":"text","text":" "},{"type":"text","text":"directly. This is an advanced pattern for apps that manage their own audio"},{"type":"text","text":" "},{"type":"text","text":"system entirely — for example, using a persistent “now playing” banner with an"},{"type":"text","text":" "},{"type":"text","text":"external audio manager instead of the SDK’s built-in overlay."}]},{"code":["class MyAudioDelegate: PSReader.AudioDelegate {","","    let audioManager: MyAudioManager","","    \/\/ MARK: Feed Edition Methods","","    func isListenable(page: PSEPage, inEdition source: PSEEditionSource) -> Bool {","        return page.articles?.count == 1","    }","","    func audioBannerViewController() -> AudioBannerViewController? {","        \/\/ Return a persistent banner, or nil for overlay-only","        return MyAudioBanner(audioManager: audioManager)","    }","","    func playAudio(for page: PSEPage, inEdition source: PSEEditionSource) -> AudioOverlay? {","        guard let article = page.articles?.first else { return nil }","","        \/\/ Start playback through your own audio manager","        audioManager.play(article: article)","","        \/\/ Return nil — the banner handles the UI","        return nil","    }","","    func didChangeTo(page: PSEPage?,","                     inEdition edition: PSEEdition,","                     inPublished published: PSEPublished) {","        audioManager.pause()","    }","","    \/\/ MARK: Replica Edition Methods","","    func isListenable(spread: PSReplicaPageSpread,","                      inReplicaEdition replicaEdition: PSReplicaEdition) -> Bool {","        return spread.isArticle","    }","","    func playAudio(forSpread spread: PSReplicaPageSpread,","                   inReplicaEdition replicaEdition: PSReplicaEdition) -> AudioOverlay? {","        guard case .article(let article) = spread else { return nil }","        audioManager.play(replicaArticle: article)","        return nil","    }","","    func didChangeTo(spread: PSReplicaPageSpread?,","                     inReplicaEdition replicaEdition: PSReplicaEdition) {","        audioManager.pause()","    }","}","","globalConfig.audioDelegate = MyAudioDelegate(audioManager: myAudioManager)"],"type":"codeListing","syntax":"swift"},{"name":"Tip","type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"If you return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" from both ","type":"text"},{"code":"playAudio","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"audioBannerViewController()","type":"codeVoice"},{"type":"text","text":", the SDK will not present any audio UI. Use this"},{"text":" ","type":"text"},{"type":"text","text":"when your app manages the entire audio experience externally."}]}]}]}],"sections":[],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Prebuilt-UI"]]},"abstract":[{"type":"text","text":"Add audio playback of article content using the SDK’s text-to-speech system."}],"variants":[{"tra