{"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Localization is provided by the "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizationManager","type":"reference","isActive":true},{"type":"text","text":" singleton. Every"},{"type":"text","text":" "},{"type":"text","text":"user-facing string in the SDK is identified by a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The base "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizationManager"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"NSLocalizedString"},{"type":"text","text":" to resolve each key,"},{"type":"text","text":" "},{"type":"text","text":"with the key’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey"},{"type":"text","text":" "},{"code":"rawValue","type":"codeVoice"},{"type":"text","text":" as the lookup key and its"},{"text":" ","type":"text"},{"text":"built-in default as the fallback value. This means you can provide translations","type":"text"},{"text":" ","type":"text"},{"text":"using a standard ","type":"text"},{"code":".strings","type":"codeVoice"},{"text":" file or a String Catalog (","type":"text"},{"code":".xcstrings","type":"codeVoice"},{"text":") in your","type":"text"},{"text":" ","type":"text"},{"text":"app bundle without writing any code.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"New localized string keys may be added between SDK releases. After","type":"text"},{"text":" ","type":"text"},{"text":"updating the SDK, review the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey"},{"text":" reference to identify","type":"text"},{"text":" ","type":"text"},{"text":"any new keys that need translations.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside"},{"text":"Using String Catalogs","level":2,"anchor":"Using-String-Catalogs","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Because the SDK resolves strings through ","type":"text"},{"type":"codeVoice","code":"NSLocalizedString"},{"text":", any translation","type":"text"},{"text":" ","type":"text"},{"text":"workflow that produces ","type":"text"},{"type":"codeVoice","code":".strings"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".xcstrings"},{"text":" files works automatically.","type":"text"},{"text":" ","type":"text"},{"text":"In Xcode, add a String Catalog to your app target and include entries whose","type":"text"},{"text":" ","type":"text"},{"text":"keys match the ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey","isActive":true},{"text":" raw values. The SDK will pick them up","type":"text"},{"text":" ","type":"text"},{"text":"at runtime.","type":"text"}]},{"text":"Subclassing LocalizationManager","level":2,"anchor":"Subclassing-LocalizationManager","type":"heading"},{"inlineContent":[{"type":"text","text":"For more control, subclass "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizationManager"},{"type":"text","text":" and replace the shared"},{"type":"text","text":" "},{"type":"text","text":"singleton. This lets you load strings from a remote server, apply A\/B test"},{"type":"text","text":" "},{"type":"text","text":"variants, or fall through to the default behavior selectively:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import PSReader","","class CustomLocalizationManager: PSReader.Localizatio