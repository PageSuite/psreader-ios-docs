{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Analytics"},"seeAlsoSections":[{"anchor":"Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywall-Integration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Sharing","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Media-Playback","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Search"],"generated":true,"title":"Features"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"All analytics events are reported through the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel","isActive":true,"type":"reference"},{"text":" singleton. To","type":"text"},{"text":" ","type":"text"},{"text":"begin receiving events, create a class that conforms to ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventSubscriber","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"and subscribe it to the shared channel:","type":"text"}]},{"syntax":"swift","code":["import PSReader","","class AnalyticsHandler: PSReader.EventSubscriber {","    func analytics(event: PSReader.EventChannel.AnalyticsEvent) {","        switch event {","        \/\/ handle events","        }","    }","}","","let subscriber = AnalyticsHandler()","PSReader.EventChannel.shared.subscribe(subscriber)"],"type":"codeListing"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel","isActive":true},{"type":"text","text":" holds a "},{"inlineContent":[{"text":"weak","type":"text"}],"type":"strong"},{"type":"text","text":" reference to each"},{"type":"text","text":" "},{"type":"text","text":"subscriber. Maintain a strong reference to your subscriber (for example, as a"},{"type":"text","text":" "},{"type":"text","text":"property on your app delegate or coordinator) to prevent it from being"},{"type":"text","text":" "},{"type":"text","text":"deallocated. You do not need to explicitly unsubscribe."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Events are always delivered on the ","type":"text"},{"inlineContent":[{"text":"main thread","type":"text"}],"type":"strong"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Replica-vs-Feed-Events","text":"Replica vs Feed Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Which events the SDK fires depends on the backend system your publication uses."},{"type":"text","text":" "},{"type":"text","text":"Replica editions produce "},{"type":"codeVoice","code":"replica*"},{"type":"text","text":" events while feed editions produce"},{"type":"text","text":" "},{"type":"codeVoice","code":"feedEdition*"},{"type":"text","text":" events. Some events (such as carousel views and bookmark"},{"type":"text","text":" "},{"type":"text","text":"operations) apply to both systems."}]},{"type":"paragraph","inlineContent":[{"text":"Consult the PageSuite portal or your account manager to determine which system","type":"text"},{"text":" ","type":"text"},{"text":"applies to your publications. See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Replica-and-Feed-Editions","type":"reference","isActive":true},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"background.","type":"text"}]},{"type":"heading","level":2,"anchor":"Event-Categories","text":"Event Categories"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/AnalyticsEvent","isActive":true},{"text":" enumeration defines every event the SDK","type":"text"},{"text":" ","type":"text"},{"text":"reports. Below is a summary of the main categories. See the","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/AnalyticsEvent","isActive":true},{"text":" symbol page for the complete list.","type":"text"}]},{"text":"Carousel Events","level":3,"type":"heading","anchor":"Carousel-Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fired when a carousel section becomes visible, providing the section index,"},{"type":"text","text":" "},{"type":"text","text":"name, and content type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/CarouselEventContext"},{"type":"text","text":"."}]},{"text":"Edition Lifecycle","level":3,"type":"heading","anchor":"Edition-Lifecycle"},{"type":"paragraph","inlineContent":[{"text":"Events for edition launches, downloads, and deletions. For example,","type":"text"},{"text":" ","type":"text"},{"code":"replicaLaunch","type":"codeVoice"},{"text":" fires when a user opens a replica edition, and","type":"text"},{"text":" ","type":"text"},{"code":"feedEditionDownloaded","type":"codeVoice"},{"text":" fires when a feed edition finishes downloading.","type":"text"}]},{"text":"Page View and Navigation","level":3,"type":"heading","anchor":"Page-View-and-Navigation"},{"type":"paragraph","inlineContent":[{"text":"Page view events fire as the user navigates through an edition. Replica","type":"text"},{"text":" ","type":"text"},{"text":"editions report ","type":"text"},{"code":"replicaPageView","type":"codeVoice"},{"text":" with page numbers; feed editions report","type":"text"},{"text":" ","type":"text"},{"code":"feedEditionArticleView","type":"codeVoice"},{"text":", ","type":"text"},{"code":"feedEditionSectionView","type":"codeVoice"},{"type":"text","text":", or"},{"type":"text","text":" "},{"code":"feedEditionOtherPageView","type":"codeVoice"},{"type":"text","text":" depending on the page type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The content browser also emits events when the user opens it or taps"},{"type":"text","text":" "},{"type":"text","text":"navigation controls within it."}]},{"type":"heading","level":3,"anchor":"Bookmark-Events","text":"Bookmark Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bookmark and unbookmark events fire for both pages and articles. Each event"},{"type":"text","text":" "},{"type":"text","text":"includes the bookmark object with edition and page metadata."}]},{"type":"heading","level":3,"anchor":"Share-and-Print-Events","text":"Share and Print Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Share and print actions are tracked separately for replica pages, replica"},{"type":"text","text":" "},{"type":"text","text":"articles, and feed edition pages. These fire when the user initiates the"},{"type":"text","text":" "},{"type":"text","text":"action from the navigation bar."}]},{"type":"heading","level":3,"anchor":"Search-Events","text":"Search Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Search events track user queries and result interactions. "},{"type":"codeVoice","code":"searchCompleted"},{"type":"text","text":" "},{"type":"text","text":"fires when a search query returns results (not on pagination), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"searchResultTapped"},{"type":"text","text":" fires when a user taps a result. Both carry a"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/SearchEventContext","type":"reference","isActive":true},{"type":"text","text":" with the query, search type filter, result"},{"type":"text","text":" "},{"type":"text","text":"count, and the publications that were searched."}]},{"type":"heading","level":3,"anchor":"Article-Specific-Events","text":"Article-Specific Events"},{"type":"paragraph","inlineContent":[{"text":"In replica editions, additional events track article taps, article link taps,","type":"text"},{"text":" ","type":"text"},{"text":"and text size changes. Each carries a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/ReplicaArticleEventContext","isActive":true},{"text":" ","type":"text"},{"text":"with the edition and article details.","type":"text"}]},{"type":"heading","anchor":"Context-Objects","text":"Context Objects","level":2},{"type":"paragraph","inlineContent":[{"text":"Each event carries an associated context object that provides the relevant","type":"text"},{"text":" ","type":"text"},{"text":"metadata. The five context types are:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/CarouselEventContext","isActive":true,"type":"reference"},{"text":" — section index, name, and content","type":"text"},{"text":" ","type":"text"},{"text":"type. Use ","type":"text"},{"code":"sectionName","type":"codeVoice"},{"text":" to identify which tab the user is viewing and","type":"text"},{"text":" ","type":"text"},{"code":"contentType","type":"codeVoice"},{"text":" to distinguish between archive, bookmarks, and downloads.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/ReplicaEventContext","isActive":true,"type":"reference"},{"text":" — edition, page number, and spread page","type":"text"},{"text":" ","type":"text"},{"text":"numbers for double-page mode. The ","type":"text"},{"code":"edition","type":"codeVoice"},{"text":" property gives you access to","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"PSEdition","type":"codeVoice"},{"text":" model, and ","type":"text"},{"code":"pageNumber","type":"codeVoice"},{"type":"text","text":" identifies the current page."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/ReplicaArticleEventContext"},{"text":" — edition and article. The","type":"text"},{"text":" ","type":"text"},{"code":"article","type":"codeVoice"},{"text":" property contains the article headline, ID, and share link.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/FeedEditionEventContext","isActive":true},{"type":"text","text":" — published object, edition, and"},{"type":"text","text":" "},{"type":"text","text":"current page spread. The "},{"code":"published","type":"codeVoice"},{"type":"text","text":" property provides the "},{"code":"PSEPublished","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"model with edition metadata, and "},{"code":"edition","type":"codeVoice"},{"type":"text","text":" contains page-level details."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/SearchEventContext","type":"reference","isActive":true},{"text":" — query string, search type filter,","type":"text"},{"text":" ","type":"text"},{"text":"total result count, and the publications that were searched. The","type":"text"},{"text":" ","type":"text"},{"code":"searchResultTapped","type":"codeVoice"},{"text":" event also includes the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResult","type":"reference","isActive":true},{"text":" that was","type":"text"},{"text":" ","type":"text"},{"text":"tapped.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"See the symbol pages for each context type for the full list of properties."}],"type":"paragraph"},{"style":"tip","content":[{"inlineContent":[{"type":"text","text":"Map SDK event names to your analytics provider’s conventions in one"},{"type":"text","text":" "},{"type":"text","text":"central place. A "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" over "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/EventChannel\/AnalyticsEvent","type":"reference","isActive":true},{"type":"text","text":" with a"},{"type":"text","text":" "},{"code":"default","type":"codeVoice"},{"type":"text","text":" case ensures you gracefully handle new events added in future SDK"},{"type":"text","text":" "},{"type":"text","text":"versions without a compile error."}],"type":"paragraph"}],"type":"aside","name":"Tip"},{"text":"Example","type":"heading","anchor":"Example","level":2},{"type":"paragraph","inlineContent":[{"text":"A practical example mapping common events to an analytics provider:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class MyAnalyticsSubscriber: PSReader.EventSubscriber {","    func analytics(event: PSReader.EventChannel.AnalyticsEvent) {","        switch event {","        case .carouselView(let context):","            trackScreen(\"carousel_\\(context.sectionName)\")","","        case .replicaLaunch(let context):","            trackEvent(\"edition_open\", properties: [","                \"page\": context.pageNumber ?? 0","            ])","","        case .feedEditionLaunch(let published):","            trackEvent(\"edition_open\", properties: [","                \"edition\": published.guid","            ])","","        case .replicaPageView(let context):","            trackEvent(\"page_view\", properties: [","                \"page\": context.pageNumber ?? 0","            ])","","        case .feedEditionArticleView(let context):","            trackEvent(\"article_view\", properties: [","                \"edition\": context.edition?.guid ?? \"\"","            ])","","        case .replicaPageBookmark, .feedEditionPageBookmark,","             .feedEditionArticleBookmark, .replicaArticleBookmark:","            trackEvent(\"bookmark_added\")","","        case .replicaPageShare, .feedEditionShare:","            trackEvent(\"share\")","","        case .searchCompleted(let context):","            trackEvent(\"search\", properties: [","                \"query\": context.query,","                \"results\": context.totalCount","            ])","","        case .searchResultTapped(let result, _):","            trackEvent(\"search_result_tapped\", properties: [","                \"type\": result.type ?? \"\",","                \"headline\": result.headline ?? \"\"","            ])","","        default:","            break","        }","    }","","    private func trackEvent(_ name: String, properties: [String: Any] = [:]) {","        \/\/ Forward to your analytics provider","    }","","    private func trackScreen(_ name: String) {","        \/\/ Forward to your analytics provider","    }","}"]}],"kind":"content"}],"sections":[],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Prebuilt-UI"]]},"abstract":[{"text":"Track user interactions and content engagement across the PSReader SDK.","type":"text"}],"variants":[{"paths":["\/documentation\/psreader\/analytics"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/analytics"]}],"metadata":{"role":"collectionGroup","modules":[{"name":"PSReader"}],"roleHeading":"API Collection","title":"Analytics"},"topicSections":[{"anchor":"Analytics-API","identifiers":["doc:\/\/com.pagesuite.PSReader\/documenta