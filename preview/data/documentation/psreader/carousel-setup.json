{"metadata":{"roleHeading":"API Collection","modules":[{"name":"PSReader"}],"role":"collectionGroup","title":"Carousel Setup"},"kind":"article","seeAlsoSections":[{"anchor":"Setup-and-Customization","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Theming-and-Customization","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/The-Reader-Experience","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Deep-Linking","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Localization"],"generated":true,"title":"Setup and Customization"}],"variants":[{"paths":["\/documentation\/psreader\/carousel-setup"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreader\/carousel-setup"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController"},{"type":"text","text":" is the primary entry point for the PSReader SDK."},{"text":" ","type":"text"},{"text":"It presents a tabbed interface with horizontal section ribbons at the top and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"content grids below. Each section can display edition archives, bookmarks,"},{"type":"text","text":" "},{"type":"text","text":"downloads, or kiosk grids."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Sections are defined as an array of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController\/SectionItem"},{"type":"text","text":" "},{"type":"text","text":"values passed to the initializer. The SDK supports three kinds of section"},{"type":"text","text":" "},{"text":"items: dynamic archives, single sections, and subsection groups.","type":"text"}],"type":"paragraph"},{"anchor":"Dynamic-Archives-Recommended","type":"heading","text":"Dynamic Archives (Recommended)","level":2},{"type":"paragraph","inlineContent":[{"text":"The simplest way to populate the carousel is with a ","type":"text"},{"inlineContent":[{"text":"shortcode","type":"text"}],"type":"strong"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":".dynamicArchive","type":"codeVoice"},{"text":". The SDK fetches publication configuration from the","type":"text"},{"text":" ","type":"text"},{"text":"PageSuite backend and automatically creates the appropriate content sections:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let carouselVC = PSReader.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController\/refreshDynamicArchives(completion:)","isActive":true},{"type":"text","text":" at any"},{"type":"text","text":" "},{"type":"text","text":"time to re-fetch the remote configuration and update the carousel content."}]},{"type":"heading","text":"Manual Sections","anchor":"Manual-Sections","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For full control, define sections explicitly using "},{"code":".section","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"code":".subsections","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let sections: [PSReader.CarouselViewController.SectionItem] = [","    .section(.init(name: \"Latest\", type: .feedArchive(guid: \"PUBLICATION_GUID\"))),","    .subsections(\"More\", [","        .init(name: \"Archive\", type: .replicaArchive(guid: \"REPLICA_PUBLICATION_GUID\")),","        .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","        .init(name: \"Downloads\", type: .downloads(type: .all))","    ])","]"]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":".section"},{"text":" creates a top-level tab with a single content view. A","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".subsections"},{"text":" creates a top-level tab with a secondary ribbon that lets","type":"text"},{"text":" ","type":"text"},{"text":"users switch between multiple content views.","type":"text"}]},{"type":"heading","text":"Content Types","anchor":"Content-Types","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController\/ContentType"},{"type":"text","text":" enum defines all available content"},{"type":"text","text":" "},{"type":"text","text":"sources:"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Content Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".feedArchive(guid:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed edition archive identified by the publication’s GUID."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".replicaArchive(guid:, supplements:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replica edition archive identified by a publication GUID. Pass an optional "},{"type":"codeVoice","code":"supplements"},{"type":"text","text":" array of publication GUIDs to include supplemental editions alongside the main archive."}]}]],[[{"inlineContent":[{"code":".feedPublicationKiosk(publications:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grid of multiple feed publications (kiosk layout). Each cell represents a different publication and tapping one opens its archive."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".replicaPublicationKiosk(publications:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grid of multiple replica publications (kiosk layout). Same multi-publication grid for replica editions."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".bookmarks(type:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"User’s bookmarked pages and articles. Filter by type."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".downloads(type:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"User’s downloaded editions. Filter by type."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".search(config:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full-text search across feed edition articles and pages. Requires a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchConfiguration","isActive":true,"type":"reference"},{"text":". See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Search","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Replica-and-Feed-Editions","type":"reference","isActive":true},{"type":"text","text":" to determine whether your publications use"},{"type":"text","text":" "},{"type":"text","text":"feed or replica content types."}],"type":"paragraph"},{"level":2,"text":"Per-Section Configuration Overrides","anchor":"Per-Section-Configuration-Overrides","type":"heading"},{"inlineContent":[{"text":"Each content type accepts an optional configuration parameter. Use this to","type":"text"},{"text":" ","type":"text"},{"text":"override the global defaults for a specific section — for example, to use a","type":"text"},{"text":" ","type":"text"},{"text":"different date formatter or thumbnail aspect ratio:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var specialArchiveConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","specialArchiveConfig.aspectRatio = 0.75","specialArchiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)","",".section(.init(","    name: \"Special Edition\",","    type: .feedArchive(guid: \"GUID\", config: specialArchiveConfig)","))"],"type":"codeListing"},{"level":2,"text":"Headers","anchor":"Headers","type":"heading"},{"inlineContent":[{"type":"text","text":"Supply your own header view controller, pinned above the carousel content. Set"},{"type":"text","text":" "},{"type":"codeVoice","code":"hidesHeaderOnScroll"},{"type":"text","text":" to have the SDK hide it as the content scrolls and reveal"},{"type":"text","text":" "},{"type":"text","text":"it again when scrolling back up or changing page:"}],"type":"paragraph"},{"syntax":"swift","code":["var carouselConfig = PSReader.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.hidesHeaderOnScroll = true","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: myHeaderViewController,","    sections: sections",")"],"type":"codeListing"},{"level":3,"text":"Dismissing a Modal Carousel","anchor":"Dismissing-a-Modal-Carousel","type":"heading"},{"inlineContent":[{"type":"text","text":"When the carousel is presented modally, give users a way to close it — usually a"},{"type":"text","text":" "},{"type":"text","text":"close button in your header, which you can build yourself."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"As a convenience for this common case, the SDK provides a prebuilt option:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DismissHeaderViewController","isActive":true},{"type":"text","text":" renders a close button that dismisses the carousel"},{"type":"text","text":" "},{"type":"text","text":"on tap (or calls your "},{"type":"codeVoice","code":"onClose"},{"type":"text","text":"). Style it with a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ButtonConfiguration","isActive":true},{"type":"text","text":" and keep"},{"type":"text","text":" "},{"type":"codeVoice","code":"hidesHeaderOnScroll"},{"type":"text","text":" at its default of "},{"type":"codeVoice","code":"false"},{"type":"text","text":" so the button stays reachable:"}],"type":"paragraph"},{"type":"codeListing","code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: DismissHeaderViewController(config: .dismissButton(position: .leading())),","    sections: sections",")","present(carousel, animated: true)"],"syntax":"swift"},{"text":"Safe Area","type":"heading","level":2,"anchor":"Safe-Area"},{"type":"paragraph","inlineContent":[{"text":"Control which safe area edges the carousel ignores. This is useful when","type":"text"},{"text":" ","type":"text"},{"text":"embedding the carousel in a container that already provides its own safe","type":"text"},{"text":" ","type":"text"},{"text":"area handling:","type":"text"}]},{"type":"codeListing","code":["carouselConfig.ignoreSafeArea = .bottom"],"syntax":"swift"},{"text":"Complete Example","type":"heading","level":2,"anchor":"Complete-Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A carousel combining a dynamic archive, a manual section with a per-section"},{"type":"text","text":" "},{"type":"text","text":"configuration override, and a subsection group:"}]},{"type":"codeListing","code":["let globalConfig = PSReader.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","","\/\/ Per-section override for the premium archive","var premiumConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","premiumConfig.aspectRatio = 0.75","","let carouselVC = PSReader.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        \/\/ Dynamic archive populated from a shortcode","        .dynamicArchive(\"Latest\", shortcode: \"SHORTCODE\"),","","        \/\/ Manual section with a per-section configuration","        .section(.init(","            name: \"Premium\",","            type: .replicaArchive(","                guid: \"REPLICA_PUBLICATION_GUID\",","                supplements: [\"SUPPLEMENT_PUBLICATION_GUID\"],","                config: premiumConfig","            )","        )),","","        \/\/ Subsection group for user content","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"syntax":"swift"},{"text":"SwiftUI Integration","type":"heading","level":2,"anchor":"SwiftUI-Integration"},{"type":"paragraph","inlineContent":[{"text":"Wrap ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController","type":"reference","isActive":true},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"UIViewControllerRepresentable"},{"text":" for use","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in SwiftUI:"}]},{"code":["import SwiftUI","import PSReader","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReader.CarouselViewController {","        let globalConfig = PSReader.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReader.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReader.CarouselViewController, context: Context) {}","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Prebuilt-UI"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Configure the carousel’s sections, content sources, and layout."}],"sections":[],"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Carousel-Setup","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Carousel-API","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselConfiguration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SectionRibbonConfiguration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SubsectionRibbonConfiguration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ButtonConfiguration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DismissHeaderViewController"],"title":"Carousel API"}],"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/SearchConfiguration":{"url":"\/documentation\/psreader\/searchconfiguration","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SearchConfiguration","kind":"identifier"}],"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchConfiguration","title":"SearchConfiguration","abstract":[{"type":"text","text":"Configuration for the SDK’s built-in search interface."}],"navigatorTitle":[{"text":"SearchConfiguration","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://com.pagesuite.PSReader/documentation/PSRea