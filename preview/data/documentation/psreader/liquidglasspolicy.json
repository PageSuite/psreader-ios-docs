{"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LiquidGlassPolicy","interfaceLanguage":"swift"},"relationshipsSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/SQ","doc:\/\/com.pagesuite.PSReader\/SH"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LiquidGlassPolicy"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this type to control whether the SDK applies the Liquid Glass appearance"},{"type":"text","text":" "},{"type":"text","text":"on devices running iOS 26 or later. This policy acts as a global preference,"},{"type":"text","text":" "},{"type":"text","text":"and may be overridden by more granular configuration objects."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Liquid Glass effect is only available at runtime on iOS 26+ devices,"},{"type":"text","text":" "},{"type":"text","text":"and will not be applied if the host application opts into design compatibility"},{"type":"text","text":" "},{"type":"text","text":"using the "},{"type":"codeVoice","code":"\"UIDesignRequiresCompatibility\""},{"type":"text","text":" Info.plist key."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default policy is "},{"type":"codeVoice","code":".automatic"},{"type":"text","text":", which enables Liquid Glass when supported."},{"type":"text","text":" "},{"type":"text","text":"Set this to "},{"type":"codeVoice","code":".disabled"},{"type":"text","text":" to prevent use of the effect even on capable systems."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For the prebuilt UI’s other appearance settings, see "},{"isActive":true,"type":"reference","identifier":"doc:\