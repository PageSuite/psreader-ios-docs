{"kind":"article","abstract":[{"type":"text","text":"Install the SDK, gather your credentials, and initialize it."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide covers the setup shared by every integration: installation,"},{"type":"text","text":" "},{"type":"text","text":"credentials, and SDK initialization. It ends where your integration level"},{"text":" ","type":"text"},{"text":"begins — the prebuilt UI or a custom UI built on the core layer.","type":"text"}]},{"text":"Installation","anchor":"Installation","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"We support three installation methods for integrating the SDK into your iOS app:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Manual installation","type":"text"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Swift Package Manager (SPM)","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"CocoaPods","type":"text"}],"type":"strong"}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"text":"1. Manual Installation","anchor":"1-Manual-Installation","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Manually install the provided ","type":"text"},{"code":"PSReader.xcframework","type":"codeVoice"},{"text":" and its dependencies by dragging and dropping them into your Xcode project.","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"PSReader.xcframework","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"PDFNet.xcframework","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Tools.xcframework","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the frameworks are set to "},{"inlineContent":[{"text":"Embed and Sign","type":"text"}],"type":"strong"},{"type":"text","text":" in your Xcode project settings."}]},{"type":"thematicBreak"},{"type":"heading","level":3,"anchor":"2-Swift-Package-Manager","text":"2. Swift Package Manager"},{"inlineContent":[{"inlineContent":[{"text":"Package URL:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"code":["https:\/\/github.com\/PageSuite\/psreader-swift-package.git"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To integrate:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > Add Packages…"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Enter the repository URL above.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the desired version\/range and add the package to your target."}]}]}]},{"type":"thematicBreak"},{"level":3,"text":"3. CocoaPods","type":"heading","anchor":"3-CocoaPods"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Specs repository:","type":"text"}]}],"type":"paragraph"},{"code":["https:\/\/github.com\/PageSuite\/psreader-specs.git"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"Example "},{"type":"codeVoice","code":"Podfile"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"ruby","code":["source 'https:\/\/github.com\/PageSuite\/psreader-specs.git'","","target 'YourAppTarget' do","  use_frameworks!","","  pod 'PDFTron', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron\/11.5.0.85515.podspec'","  pod 'PDFTronTools', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron-tools\/11.5.0.85515.podspec'","  pod 'PSReaderUI2'","end"],"type":"codeListing"},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Note","type":"text"}],"type":"strong"},{"text":": The Apryse SDK integration is slightly non-standard. We recommend pinning it to version ","type":"text"},{"type":"codeVoice","code":"11.5.0.85515"},{"text":", as this is the version we have tested internally.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"text":"Versioning","anchor":"Versioning","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Starting in 2026, the SDK uses a calendar-based versioning scheme to align"},{"type":"text","text":" "},{"type":"text","text":"with the rest of the PageSuite product line. Versions follow the format"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"year.month.patch"}],"type":"strong"},{"text":" — for example, ","type":"text"},{"code":"26.1.0","type":"codeVoice"},{"type":"text","text":" is the first January 2026"},{"text":" ","type":"text"},{"text":"release.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This scheme does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" follow semantic versioning. While we strive to","type":"text"},{"text":" ","type":"text"},{"text":"maintain API stability, breaking changes may occur in any release without a","type":"text"},{"text":" ","type":"text"},{"text":"major version bump. We recommend pinning to a specific version and reviewing","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Change-Log","isActive":true,"type":"reference"},{"text":" before upgrading.","type":"text"}]},{"type":"heading","level":2,"anchor":"Credentials","text":"Credentials"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use the PSReader SDK you need the following credentials. Contact your"},{"type":"text","text":" "},{"type":"text","text":"PageSuite account manager or