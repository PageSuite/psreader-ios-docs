{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/The-Reader-Experience"},"seeAlsoSections":[{"anchor":"Setup-and-Customization","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Carousel-Setup","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Theming-and-Customization","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Deep-Linking","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Localization"],"generated":true,"title":"Setup and Customization"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When a user opens an edition from the carousel, an archive, or a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedReaderViewController","type":"reference"},{"text":", the prebuilt reader screen takes over: paged","type":"text"},{"text":" ","type":"text"},{"text":"content with a navigation bar on top, a content browser for jumping between","type":"text"},{"text":" ","type":"text"},{"text":"sections, pages, and articles, a splash screen while the edition loads, and","type":"text"},{"type":"text","text":" "},{"text":"a settings menu for reading preferences.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"All of it is configured through ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReaderConfiguration","isActive":true},{"text":". You rarely create","type":"text"},{"text":" ","type":"text"},{"text":"one directly — it lives at ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveConfiguration\/readerConfig","isActive":true},{"text":", inheriting","type":"text"},{"text":" ","type":"text"},{"text":"fonts, colors, and delegates from your ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true},{"text":", so reader","type":"text"},{"text":" ","type":"text"},{"text":"customizations flow through the archive configuration:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var archiveConfig = ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.backgroundColor = .black","archiveConfig.readerConfig.navigationBar.itemSelectedBackgroundColor = .systemBlue"]},{"text":"The pieces","level":2,"anchor":"The-pieces","type":"heading"},{"inlineContent":[{"text":"Each part of the reader screen has its own sub-configuration, inheriting","type":"text"},{"text":" ","type":"text"},{"text":"from the global config and overridable individually:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReaderNavigationBarConfiguration","type":"reference"},{"type":"text","text":" ("},{"code":"navigationBar","type":"codeVoice"},{"type":"text","text":") — colors, fonts,"},{"type":"text","text":" "},{"type":"text","text":"and styling of the reader’s navigation items."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReaderBrowserConfiguration","type":"reference","isActive":true},{"text":" (","type":"text"},{"type":"codeVoice","code":"contentBrowser"},{"text":") — the section, page,","type":"text"},{"text":" ","type":"text"},{"text":"and article browser’s colors, typography, and highlights.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReaderSplashConfiguration","isActive":true},{"text":" (","type":"text"},{"type":"codeVoice","code":"splashScreen"},{"text":") — the loading screen shown","type":"text"},{"text":" ","type":"text"},{"text":"while an edition opens: thumbnail layout, name and date labels, progress,","type":"text"},{"text":" ","type":"text"},{"text":"and error messaging.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SettingsConfiguration","isActive":true,"type":"reference"},{"text":" (","type":"text"},{"code":"settings","type":"codeVoice"},{"text":") — the reading-preferences menu:","type":"text"},{"text":" ","type":"text"},{"text":"PDF viewing modes, double-page spreads, and download-while-reading","type":"text"},{"text":" ","type":"text"},{"text":"behavior, including which options users can see and their defaults.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Download-while-reading","type":"heading","level":2,"text":"Download-while-reading"},{"inlineContent":[{"type":"text","text":"By default the reader streams editions without downloading them, and users"},{"type":"text","text":" "},{"type":"text","text":"can opt into downloading while reading through the settings menu. The"},{"type":"text","text":" "},{"type":"text","text":"defaults and the visibility of that choice are yours:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["archiveConfig.readerConfig.settings.downloadWhileReadingDefault = false","archiveConfig.readerConfig.settings.isDownloadWhileReadingToggleEnabled = false"]},{"type":"heading","text":"Reacting to reader navigation","anchor":"Reacting-to-reader-navigation","level":2},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/NavigationDelegate","isActive":true,"type":"reference"},{"text":" (set on ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true,"type":"reference"},{"text":") to be","type":"text"},{"type":"text","text":" "},{"text":"notified as reader screens come and go — for example to pause your app’s","type":"text"},{"text":" ","type":"text"},{"text":"media playback or adjust analytics session state while a replica edition is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"on screen."}]},{"type":"heading","text":"The legacy replica reader","level":2,"anchor":"The-legacy-replica-reader"},{"inlineContent":[{"type":"text","text":"Replica editions can render in two readers. The modern replica reader"},{"type":"text","text":" "},{"type":"text","text":"shares its look, delegates, and configuration with the feed edition reader."},{"type":"text","text":" "},{"type":"text","text":"The original legacy reader remains the default for now"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReaderConfiguration\/useLegacyReplicaReader"},{"text":") and carries its own","type":"text"},{"text":" ","type":"text"},{"text":"distinct chrome, configured separately through ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LegacyReaderConfiguration","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"legacyReader","type":"codeVoice"},{"text":") — navigation bar items, template-string sharing, and","type":"text"},{"type":"text","text":" "},{"text":"legacy icon overrides.","type":"text"}],"type":"paragraph"},{"code":["archiveConfig.readerConfig.useLegacyReplicaReader = false   \/\/ opt in to the modern reader"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Replica-and-Feed-Editions"},{"type":"text","text":" for the trade-offs and timeline."}],"type":"paragraph"}]}],"schemaVersion