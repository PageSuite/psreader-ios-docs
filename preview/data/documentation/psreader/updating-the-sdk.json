{"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Updating-the-SDK","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"v2680","type":"heading","level":2,"text":"v26.8.0"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"One module: PSReader","type":"text"}]}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"PSReaderUI has merged into the "},{"code":"PSReader","type":"codeVoice"},{"type":"text","text":" module, which now holds the"},{"type":"text","text":" "},{"type":"text","text":"prebuilt UI and the core SDK it’s built on."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Migrating-From-PSReaderUI"},{"type":"text","text":" walks through each breaking change."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An app on the legacy Core SDK has a rewrite to do; see"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Migrating-From-the-Legacy-Core-SDK"},{"text":".","type":"text"}]},{"type":"heading","anchor":"v2670","text":"v26.7.0","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Carousel headers replace "},{"code":"dismissButton","type":"codeVoice"}],"type":"strong"}]},{"inlineContent":[{"type":"text","text":"Breaking change: "},{"code":"CarouselConfiguration.dismissButton","type":"codeVoice"},{"type":"text","text":" has been removed. The"},{"type":"text","text":" "},{"type":"text","text":"carousel now accepts a full header view controller, pinned above the carousel"},{"type":"text","text":" "},{"type":"text","text":"content, via the new "},{"code":"header","type":"codeVoice"},{"type":"text","text":" parameter on the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController"},{"type":"text","text":" "},{"type":"text","text":"initializer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To retain the previous dismiss button behavior, pass a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DismissHeaderViewController"},{"type":"text","text":" as the header. It accepts the same"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ButtonConfiguration\/dismissButton(size:insets:position:tintColor:image:)"},{"type":"text","text":" "},{"type":"text","text":"configuration as before, and by default dismisses the carousel on tap. Supply"},{"type":"text","text":" "},{"code":"onClose","type":"codeVoice"},{"type":"text","text":" to run custom behaviour instead (for example when the carousel is"},{"type":"text","text":" "},{"type":"text","text":"embedded rather than presented)."}],"type":"paragraph"},{"code":["\/\/ Before","var carouselConfig = PSReader.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    sections: sections",")","","\/\/ After","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: DismissHeaderViewController(config: .dismissButton(position: .leading())),","    sections: sections",")"],"syntax":"swift","type":"codeListing","copyToClipboard":true,"showLineNumbers":false,"wrap":0,"lineAnnotations":[]},{"inlineContent":[{"type":"text","text":"Headers can also hide as the content scrolls via"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselConfiguration\/hidesHeaderOnScroll"},{"type":"text","text":". Leave it "},{"code":"false","type":"codeVoice"},{"type":"text","text":" (the default)"},{"type":"text","text":" "},{"type":"text","text":"when using a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DismissHeaderViewController"},{"type":"text","text":" so the close button stays"},{"type":"text","text":" "},{"type":"text","text":"reachable."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Search API changes"}]}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To support replica search, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchService"},{"type":"text","text":" is now a protocol with two"},{"type":"text","text":" "},{"type":"text","text":"implementations:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedSearchService","isActive":true},{"type":"text","text":" — the previous "},{"code":"SearchService","type":"codeVoice"},{"type":"text","text":" struct, renamed. It"},{"type":"text","text":" "},{"type":"text","text":"searches feed edition publications."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReplicaSearchService"},{"text":" — new. It searches replica publications.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you use the service directly, replace "},{"type":"codeVoice","code":"SearchService()"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FeedSearchService()"},{"type":"text","text":"; the "},{"type":"codeVoice","code":"search"},{"type":"text","text":" method signature is unchanged. The nested"},{"type":"text","text":" "},{"type":"text","text":"types have moved to the top level: "},{"code":"SearchService.SearchType","type":"codeVoice"},{"type":"text","text":" is now"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchType"},{"type":"text","text":" and "},{"code":"SearchService.Response","type":"codeVoice"},{"type":"text","text":" is now "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResponse","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Advert pages and analytics","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Advert pages join the feed edition page flow as a new page type"},{"type":"text","text":" "},{"type":"text","text":"(see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Advertisements#Full-Page-Advert-Pages"},{"type":"text","text":"). If your editions contain"},{"type":"text","text":" "},{"type":"text","text":"them, be aware of the analytics implications:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"An advert page settling on screen fires ","type":"text"},{"code":"feedEditionOtherPageView","type":"codeVoice"},{"text":", the same","type":"text"},{"text":" ","type":"text"},{"text":"event as other non-article, non-section pages. If you report page views","type":"text"},{"text":" ","type":"text"},{"text":"downstream, decide whether advert views should count — the event context’s","type":"text"},{"text":" ","type":"text"},{"text":"page spread identifies advert pages (","type":"text"},{"code":"referencePage()?.isAdvertPage","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In double-page mode, a spread’s reference page prefers editorial content: a","type":"text"},{"text":" ","type":"text"},{"text":"spread pairing an advert with an editorial page reports the editorial page,","type":"text"},{"text":" ","type":"text"},{"text":"so only advert-only spreads report an advert. The page-zero advert always","type":"text"},{"text":" ","type":"text"},{"text":"shares its spread with the cover, so it never produces its own page-view","type":"text"},{"text":" ","type":"text"},{"text":"event; single-page mode does not include the page-zero advert at all.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"v2610","text":"v26.1.0","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Archive limit defaults"}]}]},{"type":"paragraph","inlineContent":[{"code":"archiveLimit","type":"codeVoice"},{"type":"text","text":" now defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", with type-specific behavior:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Replica archives: 30 editions (unchanged from previous releases)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Feed archives: unbounded — shows the full backend archive (usually ~1 year)."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a behavior change for feed edition clients who previously saw a default"},{"type":"text","text":" "},{"type":"text","text":"of 30 editions. To restore the old behavior, explicitly set "},{"code":"archiveLimit","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["var archiveConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.archiveLimit = 30"],"syntax":"swift","type":"codeListing","copyToClipboard":true,"showLineNumbers":false,"wrap":0,"lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Modern replica reader","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A modern replacement for the legacy replica reader is now available. It shares"},{"type":"text","text":" "},{"type":"text","text":"delegates and navigation with the feed edition reader, giving end users the same"},{"type":"text","text":" "},{"type":"text","text":"experience regardless of backend. Replica-specific analytics events still fire."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opt in by setting "},{"code":"useLegacyReplicaReader","type":"codeVoice"},{"type":"text","text":" to "},{"code":"false","type":"codeVoice"},{"type":"text","text":" (defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"now). The modern reader will become the default in a future release, and the"},{"type":"text","text":" "},{"type":"text","text":"legacy reader will be removed further out."}]},{"code":["var archiveConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.useLegacyReplicaReader = false"],"syntax":"swift","type":"codeListing","copyToClipboard":true,"showLineNumbers":false,"wrap":0,"lineAnnotations":[]},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"The legacy reader’s content browser next\/previous button events are","type":"text"},{"text":" ","type":"text"},{"text":"not reported in the modern reader:","type":"text"},{"text":" ","type":"text"},{"code":"replicaPageBrowserNextTapped","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"replicaPageBrowserPreviousTapped","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"replicaArticleBrowserNextTapped","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"replicaArticleBrowserPreviousTapped","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"Important"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"LegacyReaderConfiguration","type":"codeVoice"},{"type":"text","text":" properties (e.g. "},{"code":"shareTemplater","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"prefersStatusBarHidden","type":"codeVoice"},{"type":"text","text":", "},{"code":"navigationBarItems","type":"codeVoice"},{"type":"text","text":") do not apply to the modern"},{"type":"text","text":" "},{"type":"text","text":"reader — it uses the standard "},{"code":"ReaderConfiguration","type":"codeVoice"},{"type":"text","text":" delegates instead."}]}],"name":"Note"},{"type":"heading","anchor":"v550","text":"v5.5.0","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Liquid Glass UI defaults"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS 26 and later, the SDK defaults to a new Liquid Glass design. The SDK"},{"type":"text","text":" "},{"type":"text","text":"respects the host app’s "},{"code":"UIDesignRequiresCompatibility","type":"codeVoice"},{"type":"text","text":" flag and will fall back"},{"type":"text","text":" "},{"type":"text","text":"automatically on older OS versions. The new design can also be controlled via"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"LiquidGlassPolicy","type":"codeVoice"},{"type":"text","text":" option. You can apply this globally or more granularly"},{"type":"text","text":" "},{"type":"text","text":"on specific configuration objects (for example, subsection ribbon, navigation"},{"type":"text","text":" "},{"type":"text","text":"bar, page browser, etc.). To disable it globally:"}]},{"code":["var globalConfig = PSReader.GlobalConfiguration(apiKey: apiKey, accountGUID: accountGUID)","globalConfig.liquidGlassPolicy = .disabled \/\/ disable Liquid Glass across the SDK"],"syntax":"swift","type":"codeListing","copyToClipboard":true,"showLineNumbers":false,"wrap":0,"lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Archive thumbnail layout"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Archive thumbnails now offer a dynamic layout mode:"},{"type":"text","text":" "},{"code":"ImageContentMode.flexibleHeight","type":"codeVoice"},{"type":"text","text":". It lets edition artwork (including the"},{"type":"text","text":" "},{"type":"text","text":"latest\/hero card) grow or shrink to its true aspect ratio, keeping the full"},{"type":"text","text":" "},{"type":"text","text":"image visible instead of cropping. Start with an estimated ratio for a steady"},{"type":"text","text":" "},{"type":"text","text":"initial layout; the SDK tunes the size automatically once the real image"},{"type":"text","text":" "},{"type":"text","text":"arrives. Example:"}]},{"code":["var archiveConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.9)"],"syntax":"swift","type":"codeListing","copyToClipboard":true,"showLineNumbers":false,"wrap":0,"lineAnnotations":[]},{"type":"heading","anchor":"v520","text":"v5.2.0","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reader UI\/UX Changes"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In PDF-driven editions, PDF pages and articles are now segmented. Users can no"},{"type":"text","text":" "},{"type":"text","text":"longer swipe between them. Articles are accessed either via article hotspot"},{"type":"text","text":" "},{"type":"text","text":"links or through the content browser. The content browser is also segmented in"},{"type":"text","text":" "},{"type":"text","text":"the same way, with a toggle that allows switching between pages and articles."},{"type":"text","text":" "},{"type":"text","text":"This behavior now matches the web reader."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The navigation bar layout has also been updated:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The right-side back arrow has been removed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The left-side icon now adapts to the current context:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Dismiss Article – If the user opened an article from a hotspot link, this"},{"type":"text","text":" "},{"type":"text","text":"action returns them to the PDF page containing that article."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Dismiss Reader – In all other cases, this action dismisses the reader"},{"type":"text","text":" "},{"type":"text","text":"view controller."}],"type":"paragraph"}]}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can customize the icons for these actions via your "},{"code":"AssetDelegate","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["ImageResourceName.dismiss        \/\/ Default: back arrow","ImageResourceName.dismissArticle \/\/ Default: xmark"],"syntax":"swift","type":"codeListing","copyToClipboard":true,"showLineNumbers":false,"wrap":0,"lineAnnotations":[]},{"type":"heading","anchor":"v500","text":"v5.0.0","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edition Download Behavior"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"code":"5.0.0","type":"codeVoice"},{"type":"text","text":" introduces the ability to read editions without downloading them."},{"type":"text","text":" "},{"type":"text","text":"This is the new default behavior. It can be customized by users via the reader"},{"type":"text","text":" "},{"type":"text","text":"settings menu. To retain the original default:"}]},{"code":["var archiveConfig = PSReader.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.settings.downloadWhileReadingDefault = false","","\/\/ To hide the user facing setting","archiveConfig.readerConfig.settings.isDownloadWhileReadingToggleEnabled = false","archiveConfig.readerConfig.settings.isDownloadWhileReadingPreferenceAlertEnabled = false"],"syntax":"swift","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edition Date Formatting"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Breaking Change: "},{"code":"DateFormatter","type":"codeVoice"},{"type":"text","text":" objects in configuration structs have been"},{"type":"text","text":" "},{"type":"text","text":"replaced with the "},{"code":"EditionDateFormatter","type":"codeVoice"},{"type":"text","text":" protocol. This enables more fine"},{"type":"text","text":" "},{"type":"text","text":"grained customization and allows for alternative naming strategies such as"},{"type":"text","text":" "},{"type":"text","text":"edition names, identifiers, or any other custom labeling approach."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK provides a "},{"code":"DefaultEditionDateFormatter","type":"codeVoice"},{"type":"text","text":" that wraps a"},{"type":"text","text":" "},{"code":"DateFormatter","type":"codeVoice"},{"type":"text","text":". This allows"}]},{"code":["let dateFormatter = DateFormatter()","dateFormatter.dateFormat = \"d MMMM yyyy\"","dateFormatter.timeZone = .current","archiveConfig.dateFormatter = DefaultEditionDateFormatter(dateFormatter: dateFormatter)","","\/\/ Alternative initializer","archiveConfig.dateFormatter = DefaultEditionDateFormatter(dateFormat: \"d MMMM yyyy\", timeZone: .current)"],"syntax":"swift","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Asset Customization"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Breaking Change: The "},{"code":"imageResourceForName","type":"codeVoice"},{"type":"text","text":" callbacks have been removed. They"},{"type":"text","text":" "},{"type":"text","text":"have been replaced by "},{"code":"AssetDelegate","type":"codeVoice"},{"type":"text","text":". To migrate to the new system implement"},{"type":"text","text":" "},{"type":"text","text":"the delegate and set it as needed."}]},{"code":["\/\/ Customize assets as desired","struct MyAssetDelegate: PSReader.AssetDelegate {","    func imageResource(for name: ImageResourceName) -> UIImage? {","        return name.defaultImage()","    }","}","","var globalConfig = PSReader.GlobalConfiguration(apiKey: apiKey, accountGUID: accountGUID)","globalConfig.assetDelegate = MyAssetDelegate()"],"syntax":null,"lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Change-Log"],"generated":true,"anchor":"Release-Notes","title":"Release Notes"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader"]]},"sections":[],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Updating the SDK","roleHeading":"Article","role":"article","modules":[{"name":"PSReader"}]},"abstract":[{"type":"text","text":"Move your app from one SDK release to the next: the breaking changes in each release, and what to change in your code."}],"variants":[{"paths":["\/documentation\/psreader\/updating-the-sdk"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreader\/updating-the-sdk"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/CarouselViewController/init(globalConfig:carouselConfig:header:sections:)":{"title":"init(globalConfig:carouselConfig:header:sections:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"globalConfig","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GlobalConfiguration","preciseIdentifier":"s:8PSReader19GlobalConfigurationV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"carouselConfig","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CarouselConfiguration","preciseIdentifier":"s:8PSReader21CarouselConfigurationV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"header","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UIViewController","preciseIdentifier":"c:objc(cs)UIViewController","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"sections","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"SectionItem","preciseIdentifier":"s:8PSReader22CarouselViewControllerC11SectionItemO","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController\/init(globalConfig:carouselConfig:header:sections:)","url":"\/documentation\/psreader\/carouselviewcontroller\/init(globalconfig:carouselconfig:header:sections:)","abstract":[{"type":"text","text":"Creates a "},{"type":"codeVoice","code":"CarouselViewController"},{"type":"text","text":" with the given config and content."}]},"doc://com.pagesuite.PSReader/documentation/PSReader":{"title":"PSReader","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Embed digital newspaper and magazine editions in your iOS app. Use PageSuite’s prebuilt reader, or build your own interface on the same engine."}],"url":"\/documentation\/psreader","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","type":"topic"},"doc://com.pagesuite.PSReader/documentation/PSReader/ReplicaSearchService":{"title":"ReplicaSearchService","abstract":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchService"},{"text":" for searching legacy replica edition content.","type":"text"}],"url":"\/documentation\/psreader\/replicasearchservice","kind":"symbol","role":"symbol","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReplicaSearchService","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReplicaSearchService","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"ReplicaSearchService","kind":"identifier"}]},"doc://com.pagesuite.PSReader/documentation/PSReader/FeedSearchService":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedSearchService","navigatorTitle":[{"kind":"identifier","text":"FeedSearchService"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeedSearchService","kind":"identifier"}],"title":"FeedSearchService","abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchService","isActive":true,"type":"reference"},{"type":"text","text":" for searching editions on PageSuite’s current system."}],"role":"symbol","url":"\/documentation\/psreader\/feedsearchservice","kind":"symbol"},"doc://com.pagesuite.PSReader/documentation/PSReader/ButtonConfiguration/dismissButton(size:insets:position:tintColor:image:)":{"title":"dismissButton(size:insets:position:tintColor:image:)","role":"symbol","url":"\/documentation\/psreader\/buttonconfiguration\/dismissbutton(size:insets:position:tintcolor:image:)","abstract":[{"type":"text","text":"Creates a preconfigured dismiss button suitable for use with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DismissHeaderViewController"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"dismissButton"},{"kind":"text","text":"("},{"kind"