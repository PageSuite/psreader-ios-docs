fallback","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Most pages via web reader; article pages also eligible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".preferArticleLink"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Article link preferred, web reader as fallback"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Article pages via CMS link; all other pages via web reader"}]}]]],"header":"row","type":"table"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".onlyArticleLink()"},{"type":"text","text":" is the default policy when no share delegate is"},{"type":"text","text":" "},{"type":"text","text":"assigned. Assign a delegate explicitly only if you need a different policy."}]}],"type":"aside","style":"tip","name":"Tip"},{"anchor":"Quick-Setup","text":"Quick Setup","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"To enable web reader sharing, create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider"},{"type":"text","text":" with your"},{"type":"text","text":" "},{"type":"text","text":"shortcode and assign it through a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To disable sharing entirely:"}],"type":"paragraph"},{"code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(sharePolicy: .disabled)"],"type":"codeListing","syntax":"swift"},{"anchor":"Policy-Examples","text":"Policy Examples","level":2,"type":"heading"},{"anchor":"Web-Reader-Only","text":"Web Reader Only","level":3,"type":"heading"},{"inlineContent":[{"text":"Share every page as a web reader link. Useful when the publisher does not have","type":"text"},{"text":" ","type":"text"},{"text":"article pages on their website:","type":"text"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyWebReader(webProvider: webProvider)",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Custom-Web-Reader-Domain","text":"Custom Web Reader Domain","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"If your web reader is hosted on a custom domain, pass it as the "},{"type":"codeVoice","code":"urlMask"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: \"reader.mypublication.com\",","    shortCode: \"SHORTCODE\"",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"urlMask","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the provider defaults to ","type":"text"},{"code":"reader.pagesuite.com","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"feed editions and ","type":"text"},{"code":"edition.pagesuite.com","type":"codeVoice"},{"text":" for replica editions.","type":"text"}],"type":"paragraph"},{"anchor":"Article-Link-Only-Default","text":"Article Link Only (Default)","level":3,"type":"heading"},{"inlineContent":[{"text":"Only pages that have a publisher-configured article link are shareable:","type":"text"}],"type":"paragraph"},{"code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyArticleLink()",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Prefer-Article-Link-with-Web-Reader-Fallback","text":"Prefer Article Link with Web Reader Fallback","level":3,"type":"heading"},{"inlineContent":[{"text":"Share the article link when available, otherwise fall back to the web reader:","type":"text"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"],"type":"codeListing","syntax":"swift"},{"anchor":"ShareContext","text":"ShareContext","level":2,"type":"heading"},{"inlineContent":[{"text":"When a share action is triggered, the delegate returns a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareContext","isActive":true,"type":"reference"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"the SDK passes to ","type":"text"},{"code":"UIActivityViewController","type":"codeVoice"},{"text":". The struct has three fields:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"activityItems"}]},{"type":"text","text":" — the primary items to share (URLs, strings, images)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"applicationActivities","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — optional custom "},{"type":"codeVoice","code":"UIActivity"},{"type":"text","text":" instances to"},{"type":"text","text":" "},{"type":"text","text":"include in the share sheet."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"subject","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — an optional subject line used by activities like Mail."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The built-in providers automatically add a "},{"inlineContent":[{"type":"text","text":"Copy Link"}],"type":"strong"},{"type":"text","text":" activity to"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationActivities"},{"type":"text","text":". If you implement a custom delegate, add your own"},{"type":"text","text":" "},{"type":"text","text":"activities as needed."}],"type":"paragraph"},{"anchor":"Replica-vs-Feed-Sharing","text":"Replica vs Feed Sharing","level":2,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","type":"reference"},{"text":" protocol defines ","type":"text"},{"inlineContent":[{"type":"text","text":"separate methods"}],"type":"strong"},{"text":" for feed and","type":"text"},{"text":" ","type":"text"},{"text":"replica editions.","type":"text"}],"type":"paragraph"},{"anchor":"Feed-Edition-Methods","text":"Feed Edition Methods","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Feed editions use page-level sharing:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"isShareable(page:inEdition:inPublished:)","type":"codeVoice"},{"text":" — controls whether the share","type":"text"},{"text":" ","type":"text"},{"text":"button is visible for a given page.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"shareContext(forPage:inEdition:inPublished:)"},{"type":"text","text":" — provides the share content."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Replica-Edition-Methods","text":"Replica Edition Methods","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Replica editions use spread-level sharing. A "},{"type":"codeVoice","code":"PSReplicaPageSpread"},{"type":"text","text":" represents"},{"type":"text","text":" "},{"type":"text","text":"what the user currently sees and has three cases:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".single(PSPage)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — a single PDF page."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".double(left: PSPage?, right: PSPage?)","type":"codeVoice"}],"type":"strong"},{"text":" — a double-page spread in","type":"text"},{"text":" ","type":"text"},{"text":"landscape mode.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".article(PSArticle)","type":"codeVoice"}],"type":"strong"},{"text":" — an article view within the replica reader.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The delegate methods receive a ","type":"text"},{"type":"codeVoice","code":"PSReplicaPageSpread"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PSReplicaEdition"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isShareable(spread:inReplicaEdition:)","type":"codeVoice"},{"text":" — controls share button visibility.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"shareContext(forSpread:inReplicaEdition:)","type":"codeVoice"},{"type":"text","text":" — provides the share content."}]}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider"},{"type":"text","text":" only shares replica article spreads"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".article"},{"type":"text","text":" case) where the article has a non-empty "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":". PDF page"},{"type":"text","text":" "},{"type":"text","text":"spreads are not shareable through this provider."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"anchor":"Custom-ShareDelegate","text":"Custom ShareDelegate","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"For full control, implement "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true},{"type":"text","text":" directly. The protocol has"},{"type":"text","text":" "},{"type":"text","text":"methods for both feed edition pages and replica spreads:"}],"type":"paragraph"},{"code":["struct MyShareDelegate: PSReaderUI.ShareDelegate {","","    \/\/ MARK: Feed Edition Methods","","    func isShareable(","        page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> Bool {","        \/\/ Only share article pages","        return page.type == \"templateArticle\"","    }","","    func shareContext(","        forPage page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> ShareContext? {","        guard let article = page.articles?.first,","              let shareLink = article.sharelink,","              let url = URL(string: shareLink) else {","            return nil","        }","        return ShareContext(","            activityItems: [url],","            subject: article.headline","        )","    }","","    \/\/ MARK: Replica Edition Methods","","    func isShareable(","        spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> Bool {","        \/\/ Share all page spreads; only share articles that have a link","        switch spread {","        case .single, .double:","            return true","        case .article(let article):","            return !article.shareLink.isEmpty","        }","    }","","    func shareContext(","        forSpread spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> ShareContext? {","        let edition = replicaEdition.edition","","        switch spread {","        case .article(let article):","            \/\/ Share the article link","            guard let url = URL(string: article.shareLink) else { return nil }","            return ShareContext(","                activityItems: [url],","                subject: article.headline","            )","","        case .single(let page):","            \/\/ Share a text description of the page","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","","        case .double(let left, let right):","            let page = left ?? right","            guard let page else { return nil }","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"isShareable"},{"type":"text","text":" methods have default implementations that return"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when "},{"type":"codeVoice","code":"shareContext"},{"type":"text","text":" returns a non-nil value. You only need to implement"},{"type":"text","text":" "},{"type":"text","text":"them explicitly as a performance optimization to avoid building a share"},{"type":"text","text":" "},{"type":"text","text":"context just to check visibility."}]}],"type":"aside","style":"tip","name":"Tip"},{"anchor":"Print-Integration","text":"Print Integration","level":2,"type":"heading"},{"inlineContent":[{"text":"Since v5.3, printing is consolidated into the share actions. The dedicated","type":"text"},{"text":" ","type":"text"},{"text":"print icon has been removed from the reader navigation bar. Users access","type":"text"},{"text":" ","type":"text"},{"text":"printing through the system share sheet, where it appears as a standard","type":"text"},{"text":" ","type":"text"},{"code":"UIActivity","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Printing requires no configuration. It is available automatically whenever"},{"type":"text","text":" "},{"type":"text","text":"sharing is enabled (i.e., the share delegate is not set to "},{"type":"codeVoice","code":".disabled"},{"type":"text","text":")."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/sharing"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/sharing"]}],"sections":[],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ShareProvider":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShareProvider","kind":"identifier"}],"abstract":[{"text":"A composite share provider allowing multiple share strategies to be chained.","type":"text"},{"text":" ","type":"text"},{"text":"Configure this provider to choose preferred or fallback sharing behaviors.","type":"text"}],"role":"symbol","title":"ShareProvider","navigatorTitle":[{"text":"ShareProvider","kind":"identifier"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","url":"\/documentation\/psreaderui\/shareprovider","type":"topic","kind":"symbol"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ShareDelegate":{"kind":"symbol","type":"topic","url":"\/documentation\/psreaderui\/sharedelegate","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShareDelegate"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ShareDelegate"}],"identifier":"doc:\/\/com.pag