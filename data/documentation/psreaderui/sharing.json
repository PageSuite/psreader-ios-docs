{"metadata":{"title":"Sharing","modules":[{"name":"PSReaderUI"}],"roleHeading":"Article","role":"article"},"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Features","title":"Features","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Deep-Linking","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Commenting","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Media-Playback","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/sharing"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/sharing"]}],"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","interfaceLanguage":"swift"},"abstract":[{"text":"Configure how users share edition content from the reader.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The PSReaderUI SDK provides built-in sharing through the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate"},{"type":"text","text":" "},{"type":"text","text":"protocol. The SDK ships three ready-to-use providers — "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider"},{"type":"text","text":" — that cover the"},{"type":"text","text":" "},{"type":"text","text":"most common scenarios. For full control, implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate"},{"type":"text","text":" directly."}],"type":"paragraph"},{"level":2,"anchor":"Key-Concepts","type":"heading","text":"Key Concepts"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Web reader link"}],"type":"strong"},{"type":"text","text":" — a URL that opens the edition page in the PageSuite web"},{"type":"text","text":" "},{"type":"text","text":"reader (e.g., "},{"type":"codeVoice","code":"reader.pagesuite.com\/shortcode\/CODE\/edition\/GUID"},{"type":"text","text":"). This lets"},{"type":"text","text":" "},{"type":"text","text":"anyone view the page in a browser without installing the app."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Article link"}]},{"type":"text","text":" — a URL pointing to the article on the publisher’s own website"},{"type":"text","text":" "},{"type":"text","text":"(e.g., "},{"type":"codeVoice","code":"example.com\/news\/article-slug"},{"type":"text","text":"). This link is set by the publisher in"},{"type":"text","text":" "},{"type":"text","text":"the CMS and is only available for article-type pages that have a "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":" "},{"type":"text","text":"configured."}],"type":"paragraph"},{"inlineContent":[{"text":"Both link types are surfaced through the iOS share sheet","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"UIActivityViewController","type":"codeVoice"},{"text":"). The built-in providers automatically include a","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Copy Link"}],"type":"strong"},{"text":" activity alongside the standard system activities.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Choosing-a-Share-Policy","type":"heading","text":"Choosing a Share Policy"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider"},{"type":"text","text":" wraps one or both of the built-in providers and applies a"},{"type":"text","text":" "},{"type":"text","text":"fallback strategy through its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider\/SharePolicy"},{"type":"text","text":" enum:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Policy","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When to use"}]}],[{"type":"paragraph","inlineContent":[{"text":"What’s shareable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".disabled"}]}],[{"type":"paragraph","inlineContent":[{"text":"You don’t want any sharing","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Nothing","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".onlyWebReader","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All pages should share a web reader link"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any page with a page GUID"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".onlyArticleLink","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only article pages with a CMS link should be shareable"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Article pages with a non-empty "},{"type":"codeVoice","code":"shareLink"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".preferWebReader","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Web reader link preferred, article link as fallback","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Most pages via web reader; article pages also eligible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".preferArticleLink"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Article link preferred, web reader as fallback"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Article pages via CMS link; all other pages via web reader"}]}]]],"header":"row","type":"table"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".onlyArticleLink()"},{"type":"text","text":" is the default policy when no share delegate is"},{"type":"text","text":" "},{"type":"text","text":"assigned. Assign a delegate explicitly only if you need a different policy."}]}],"style":"tip","type":"aside","name":"Tip"},{"level":2,"anchor":"Quick-Setup","type":"heading","text":"Quick Setup"},{"inlineContent":[{"type":"text","text":"To enable web reader sharing, create a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider","isActive":true},{"type":"text","text":" with your"},{"type":"text","text":" "},{"type":"text","text":"shortcode and assign it through a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To disable sharing entirely:"}],"type":"paragraph"},{"code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(sharePolicy: .disabled)"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Policy-Examples","type":"heading","text":"Policy Examples"},{"level":3,"anchor":"Web-Reader-Only","type":"heading","text":"Web Reader Only"},{"inlineContent":[{"type":"text","text":"Share every page as a web reader link. Useful when the publisher does not have"},{"type":"text","text":" "},{"type":"text","text":"article pages on their website:"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyWebReader(webProvider: webProvider)",")"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Custom-Web-Reader-Domain","type":"heading","text":"Custom Web Reader Domain"},{"inlineContent":[{"type":"text","text":"If your web reader is hosted on a custom domain, pass it as the "},{"type":"codeVoice","code":"urlMask"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: \"reader.mypublication.com\",","    shortCode: \"SHORTCODE\"",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"urlMask"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the provider defaults to "},{"type":"codeVoice","code":"reader.pagesuite.com"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"feed editions and "},{"type":"codeVoice","code":"edition.pagesuite.com"},{"type":"text","text":" for replica editions."}],"type":"paragraph"},{"level":3,"anchor":"Article-Link-Only-Default","type":"heading","text":"Article Link Only (Default)"},{"inlineContent":[{"type":"text","text":"Only pages that have a publisher-configured article link are shareable:"}],"type":"paragraph"},{"code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyArticleLink()",")"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Prefer-Article-Link-with-Web-Reader-Fallback","type":"heading","text":"Prefer Article Link with Web Reader Fallback"},{"inlineContent":[{"type":"text","text":"Share the article link when available, otherwise fall back to the web reader:"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"ShareContext","type":"heading","text":"ShareContext"},{"inlineContent":[{"text":"When a share action is triggered, the delegate returns a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareContext","isActive":true},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"the SDK passes to ","type":"text"},{"type":"codeVoice","code":"UIActivityViewController"},{"text":". The struct has three fields:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"activityItems"}],"type":"strong"},{"text":" — the primary items to share (URLs, strings, images).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"applicationActivities"}],"type":"strong"},{"type":"text","text":" — optional custom "},{"code":"UIActivity","type":"codeVoice"},{"type":"text","text":" instances to"},{"type":"text","text":" "},{"type":"text","text":"include in the share sheet."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"subject","type":"codeVoice"}]},{"type":"text","text":" — an optional subject line used by activities like Mail."}]}]}]},{"inlineContent":[{"type":"text","text":"The built-in providers automatically add a "},{"inlineContent":[{"type":"text","text":"Copy Link"}],"type":"strong"},{"type":"text","text":" activity to"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationActivities"},{"type":"text","text":". If you implement a custom delegate, add your own"},{"type":"text","text":" "},{"type":"text","text":"activities as needed."}],"type":"paragraph"},{"level":2,"anchor":"Replica-vs-Feed-Sharing","type":"heading","text":"Replica vs Feed Sharing"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","type":"reference","isActive":true},{"text":" protocol defines ","type":"text"},{"type":"strong","inlineContent":[{"text":"separate methods","type":"text"}]},{"text":" for feed and","type":"text"},{"text":" ","type":"text"},{"text":"replica editions.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Feed-Edition-Methods","type":"heading","text":"Feed Edition Methods"},{"inlineContent":[{"type":"text","text":"Feed editions use page-level sharing:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"isShareable(page:inEdition:inPublished:)","type":"codeVoice"},{"text":" — controls whether the share","type":"text"},{"text":" ","type":"text"},{"text":"button is visible for a given page.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"shareContext(forPage:inEdition:inPublished:)","type":"codeVoice"},{"text":" — provides the share content.","type":"text"}]}]}]},{"level":3,"anchor":"Replica-Edition-Methods","type":"heading","text":"Replica Edition Methods"},{"inlineContent":[{"type":"text","text":"Replica editions use spread-level sharing. A "},{"type":"codeVoice","code":"PSReplicaPageSpread"},{"type":"text","text":" represents"},{"type":"text","text":" "},{"type":"text","text":"what the user currently sees and has three cases:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".single(PSPage)","type":"codeVoice"}]},{"type":"text","text":" — a single PDF page."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".double(left: PSPage?, right: PSPage?)"}],"type":"strong"},{"text":" — a double-page spread in","type":"text"},{"text":" ","type":"text"},{"text":"landscape mode.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".article(PSArticle)"}],"type":"strong"},{"type":"text","text":" — an article view within the replica reader."}]}]}]},{"inlineContent":[{"type":"text","text":"The delegate methods receive a "},{"code":"PSReplicaPageSpread","type":"codeVoice"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"code":"PSReplicaEdition","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isShareable(spread:inReplicaEdition:)","type":"codeVoice"},{"type":"text","text":" — controls share button visibility."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shareContext(forSpread:inReplicaEdition:)"},{"type":"text","text":" — provides the share content."}]}]}]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","isActive":true},{"text":" only shares replica article spreads","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":".article","type":"codeVoice"},{"text":" case) where the article has a non-empty ","type":"text"},{"code":"shareLink","type":"codeVoice"},{"text":". PDF page","type":"text"},{"text":" ","type":"text"},{"text":"spreads are not shareable through this provider.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"level":2,"anchor":"Custom-ShareDelegate","type":"heading","text":"Custom ShareDelegate"},{"inlineContent":[{"text":"For full control, implement ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true,"type":"reference"},{"text":" directly. The protocol has","type":"text"},{"text":" ","type":"text"},{"text":"methods for both feed edition pages and replica spreads:","type":"text"}],"type":"paragraph"},{"code":["struct MyShareDelegate: PSReaderUI.ShareDelegate {","","    \/\/ MARK: Feed Edition Methods","","    func isShareable(","        page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> Bool {","        \/\/ Only share article pages","        return page.type == \"templateArticle\"","    }","","    func shareContext(","        forPage page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> ShareContext? {","        guard let article = page.articles?.first,","              let shareLink = article.sharelink,","              let url = URL(string: shareLink) else {","            return nil","        }","        return ShareContext(","            activityItems: [url],","            subject: article.headline","        )","    }","","    \/\/ MARK: Replica Edition Methods","","    func isShareable(","        spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> Bool {","        \/\/ Share all page spreads; only share articles that have a link","        switch spread {","        case .single, .double:","            return true","        case .article(let article):","            return !article.shareLink.isEmpty","        }","    }","","    func shareContext(","        forSpread spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> ShareContext? {","        let edition = replicaEdition.edition","","        switch spread {","        case .article(let article):","            \/\/ Share the article link","            guard let url = URL(string: article.shareLink) else { return nil }","            return ShareContext(","                activityItems: [url],","                subject: article.headline","            )","","        case .single(let page):","            \/\/ Share a text description of the page","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","","        case .double(let left, let right):","            let page = left ?? right","            guard let page else { return nil }","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"isShareable","type":"codeVoice"},{"text":" methods have default implementations that return","type":"text"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when ","type":"text"},{"code":"shareContext","type":"codeVoice"},{"text":" returns a non-nil value. You only need to implement","type":"text"},{"text":" ","type":"text"},{"text":"them explicitly as a performance optimization to avoid building a share","type":"text"},{"text":" ","type":"text"},{"text":"context just to check visibility.","type":"text"}]}],"style":"tip","type":"aside","name":"Tip"},{"level":2,"anchor":"Print-Integration","type":"heading","text":"Print Integration"},{"inli