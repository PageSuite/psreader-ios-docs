":"To disable sharing entirely:","type":"text"}]},{"code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(sharePolicy: .disabled)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Policy Examples","type":"heading","anchor":"Policy-Examples"},{"level":3,"text":"Web Reader Only","type":"heading","anchor":"Web-Reader-Only"},{"type":"paragraph","inlineContent":[{"text":"Share every page as a web reader link. Useful when the publisher does not have","type":"text"},{"text":" ","type":"text"},{"text":"article pages on their website:","type":"text"}]},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyWebReader(webProvider: webProvider)",")"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Custom Web Reader Domain","type":"heading","anchor":"Custom-Web-Reader-Domain"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your web reader is hosted on a custom domain, pass it as the "},{"type":"codeVoice","code":"urlMask"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: \"reader.mypublication.com\",","    shortCode: \"SHORTCODE\"",")"],"type":"codeListing"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"urlMask","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the provider defaults to ","type":"text"},{"code":"reader.pagesuite.com","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"feed editions and ","type":"text"},{"code":"edition.pagesuite.com","type":"codeVoice"},{"text":" for replica editions.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Article Link Only (Default)","anchor":"Article-Link-Only-Default","type":"heading"},{"inlineContent":[{"text":"Only pages that have a publisher-configured article link are shareable:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyArticleLink()",")"],"type":"codeListing"},{"level":3,"text":"Prefer Article Link with Web Reader Fallback","anchor":"Prefer-Article-Link-with-Web-Reader-Fallback","type":"heading"},{"inlineContent":[{"text":"Share the article link when available, otherwise fall back to the web reader:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"],"type":"codeListing"},{"level":2,"text":"ShareContext","anchor":"ShareContext","type":"heading"},{"inlineContent":[{"type":"text","text":"When a share action is triggered, the delegate returns a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareContext","isActive":true},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"the SDK passes to "},{"type":"codeVoice","code":"UIActivityViewController"},{"type":"text","text":". The struct has three fields:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"activityItems","type":"codeVoice"}],"type":"strong"},{"text":" — the primary items to share (URLs, strings, images).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"applicationActivities","type":"codeVoice"}],"type":"strong"},{"text":" — optional custom ","type":"text"},{"code":"UIActivity","type":"codeVoice"},{"text":" instances to","type":"text"},{"text":" ","type":"text"},{"text":"include in the share sheet.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"subject"}]},{"text":" — an optional subject line used by activities like Mail.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The built-in providers automatically add a "},{"type":"strong","inlineContent":[{"type":"text","text":"Copy Link"}]},{"type":"text","text":" activity to"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationActivities"},{"type":"text","text":". If you implement a custom delegate, add your own"},{"type":"text","text":" "},{"type":"text","text":"activities as needed."}],"type":"paragraph"},{"level":2,"text":"Replica vs Feed Sharing","anchor":"Replica-vs-Feed-Sharing","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","type":"reference"},{"text":" protocol defines ","type":"text"},{"inlineContent":[{"type":"text","text":"separate methods"}],"type":"strong"},{"text":" for feed and","type":"text"},{"text":" ","type":"text"},{"text":"replica editions.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Feed Edition Methods","anchor":"Feed-Edition-Methods","type":"heading"},{"inlineContent":[{"type":"text","text":"Feed editions use page-level sharing:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"isShareable(page:inEdition:inPublished:)","type":"codeVoice"},{"type":"text","text":" — controls whether the share"},{"type":"text","text":" "},{"type":"text","text":"button is visible for a given page."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"shareContext(forPage:inEdition:inPublished:)","type":"codeVoice"},{"text":" — provides the share content.","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"text":"Replica Edition Methods","anchor":"Replica-Edition-Methods","type":"heading"},{"inlineContent":[{"type":"text","text":"Replica editions use spread-level sharing. A "},{"type":"codeVoice","code":"PSReplicaPageSpread"},{"type":"text","text":" represents"},{"type":"text","text":" "},{"type":"text","text":"what the user currently sees and has three cases:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".single(PSPage)","type":"codeVoice"}]},{"type":"text","text":" — a single PDF page."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".double(left: PSPage?, right: PSPage?)"}],"type":"strong"},{"type":"text","text":" — a double-page spread in"},{"type":"text","text":" "},{"type":"text","text":"landscape mode."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".article(PSArticle)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — an article view within the replica reader."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The delegate methods receive a "},{"type":"codeVoice","code":"PSReplicaPageSpread"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"PSReplicaEdition"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isShareable(spread:inReplicaEdition:)"},{"type":"text","text":" — controls share button visibility."}]}]},{"content":[{"inlineContent":[{"code":"shareContext(forSpread:inReplicaEdition:)","type":"codeVoice"},{"text":" — provides the share content.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","type":"reference","isActive":true},{"type":"text","text":" only shares replica article spreads"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".article"},{"type":"text","text":" case) where the article has a non-empty "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":". PDF page"},{"type":"text","text":" "},{"type":"text","text":"spreads are not shareable through this provider."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"level":2,"text":"Custom ShareDelegate","anchor":"Custom-ShareDelegate","type":"heading"},{"inlineContent":[{"text":"For full control, implement ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","type":"reference"},{"text":" directly. The protocol has","type":"text"},{"text":" ","type":"text"},{"text":"methods for both feed edition pages and replica spreads:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyShareDelegate: PSReaderUI.ShareDelegate {","","    \/\/ MARK: Feed Edition Methods","","    func isShareable(","        page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> Bool {","        \/\/ Only share article pages","        return page.type == \"templateArticle\"","    }","","    func shareContext(","        forPage page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> ShareContext? {","        guard let article = page.articles?.first,","              let shareLink = article.sharelink,","              let url = URL(string: shareLink) else {","            return nil","        }","        return ShareContext(","            activityItems: [url],","            subject: article.headline","        )","    }","","    \/\/ MARK: Replica Edition Methods","","    func isShareable(","        spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> Bool {","        \/\/ Share all page spreads; only share articles that have a link","        switch spread {","        case .single, .double:","            return true","        case .article(let article):","            return !article.shareLink.isEmpty","        }","    }","","    func shareContext(","        forSpread spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> ShareContext? {","        let edition = replicaEdition.edition","","        switch spread {","        case .article(let article):","            \/\/ Share the article link","            guard let url = URL(string: article.shareLink) else { return nil }","            return ShareContext(","                activityItems: [url],","                subject: article.headline","            )","","        case .single(let page):","            \/\/ Share a text description of the page","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","","        case .double(let left, let right):","            let page = left ?? right","            guard let page else { return nil }","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","        }","    }","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"isShareable"},{"text":" methods have default implementations that return","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" when ","type":"text"},{"type":"codeVoice","code":"shareContext"},{"text":" returns a non-nil value. You only need to implement","type":"text"},{"text":" ","type":"text"},{"text":"them explicitly as a performance optimization to avoid building a share","type":"text"},{"text":" ","type":"text"},{"text":"context just to check visibility.","type":"text"}]}],"style":"tip","name":"Tip","type":"aside"},{"level":2,"text":"Print Integration","anchor":"Print-Integration","type":"heading"},{"inlineContent":[{"type":"text","text":"Since v5.3, printing is consolidated into the share actions. The dedicated"},{"type":"text","text":" "},{"type":"text","text":"print icon has been removed from the reader navigation bar. Users access"},{"type":"text","text":" "},{"type":"text","text":"printing through the system share sheet, where it appears as a standard"},{"type":"text","text":" "},{"code":"UIActivity","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Printing requires no configuration. It is available automatically whenever"},{"type":"text","text":" "},{"type":"text","text":"sharing is enabled (i.e., the share delegate is not set to "},{"type":"codeVoice","code":".disabled"},{"type":"text","text":")."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","interfaceLanguage":"swift"},"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ShareDelegate":{"kind":"symbol","url":"\/documentation\/psreaderui\/sharedelegate","title":"ShareDelegate","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShareDelegate"}],"type":"topic","abstract":[{"type":"text","text":"Delegate protocol used to provide sharing functionality within the SDK."}],"role":"symbol","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","navigatorTitle":[{"kind":"identifier","text":"ShareDelegate"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Deep-Linking":{"title":"Deep Linking","role":"article","type":"topic","abstract":[{"text":"Open a specific feed edition directly, bypassing the archive screen.","type":"text"}],"url":"\/documentation\/psreaderui\/deep-linking","kind":"article","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Deep-Linking"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Analytics":{"title":"Analytics","role":"article","type":"topic","abs