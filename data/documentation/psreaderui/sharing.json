:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true,"type":"reference"},{"type":"text","text":" directly."}],"type":"paragraph"},{"level":2,"text":"Key Concepts","anchor":"Key-Concepts","type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Web reader link"}],"type":"strong"},{"text":" — a URL that opens the edition page in the PageSuite web","type":"text"},{"text":" ","type":"text"},{"text":"reader (e.g., ","type":"text"},{"code":"reader.pagesuite.com\/shortcode\/CODE\/edition\/GUID","type":"codeVoice"},{"text":"). This lets","type":"text"},{"text":" ","type":"text"},{"text":"anyone view the page in a browser without installing the app.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Article link","type":"text"}],"type":"strong"},{"text":" — a URL pointing to the article on the publisher’s own website","type":"text"},{"text":" ","type":"text"},{"text":"(e.g., ","type":"text"},{"code":"example.com\/news\/article-slug","type":"codeVoice"},{"text":"). This link is set by the publisher in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the CMS and is only available for article-type pages that have a "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":" "},{"type":"text","text":"configured."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Both link types are surfaced through the iOS share sheet","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"UIActivityViewController"},{"text":"). The built-in providers automatically include a","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Copy Link"}]},{"text":" activity alongside the standard system activities.","type":"text"}]},{"text":"Choosing a Share Policy","anchor":"Choosing-a-Share-Policy","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","isActive":true},{"type":"text","text":" wraps one or both of the built-in providers and applies a"},{"type":"text","text":" "},{"type":"text","text":"fallback strategy through its "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider\/SharePolicy","isActive":true},{"type":"text","text":" enum:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Policy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When to use","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"What’s shareable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".disabled"}],"type":"paragraph"}],[{"inlineContent":[{"text":"You don’t want any sharing","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Nothing"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".onlyWebReader"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All pages should share a web reader link","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Any page with a page GUID"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".onlyArticleLink"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only article pages with a CMS link should be shareable","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Article pages with a non-empty ","type":"text"},{"code":"shareLink","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".preferWebReader","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Web reader link preferred, article link as fallback"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Most pages via web reader; article pages also eligible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".preferArticleLink","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Article link preferred, web reader as fallback","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Article pages via CMS link; all other pages via web reader","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"style":"tip","name":"Tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":".onlyArticleLink()","type":"codeVoice"},{"text":" is the default policy when no share delegate is","type":"text"},{"text":" ","type":"text"},{"text":"assigned. Assign a delegate explicitly only if you need a different policy.","type":"text"}]}]},{"text":"Quick Setup","anchor":"Quick-Setup","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To enable web reader sharing, create a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider","type":"reference","isActive":true},{"type":"text","text":" with your"},{"type":"text","text":" "},{"type":"text","text":"shortcode and assign it through a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"]},{"type":"paragraph","inlineContent":[{"text":"To disable sharing entirely:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(sharePolicy: .disabled)"]},{"text":"Policy Examples","anchor":"Policy-Examples","type":"heading","level":2},{"text":"Web Reader Only","anchor":"Web-Reader-Only","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Share every page as a web reader link. Useful when the publisher does not have"},{"type":"text","text":" "},{"type":"text","text":"article pages on their website:"}]},{"type":"codeListing","syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyWebReader(webProvider: webProvider)",")"]},{"text":"Custom Web Reader Domain","anchor":"Custom-Web-Reader-Domain","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"If your web reader is hosted on a custom domain, pass it as the ","type":"text"},{"code":"urlMask","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: \"reader.mypublication.com\",","    shortCode: \"SHORTCODE\"",")"]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"urlMask","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the provider defaults to ","type":"text"},{"code":"reader.pagesuite.com","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"feed editions and ","type":"text"},{"code":"edition.pagesuite.com","type":"codeVoice"},{"text":" for replica editions.","type":"text"}]},{"text":"Article Link Only (Default)","anchor":"Article-Link-Only-Default","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only pages that have a publisher-configured article link are shareable:"}]},{"type":"codeListing","syntax":"swift","code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyArticleLink()",")"]},{"text":"Prefer Article Link with Web Reader Fallback","anchor":"Prefer-Article-Link-with-Web-Reader-Fallback","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Share the article link when available, otherwise fall back to the web reader:"}]},{"type":"codeListing","syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"]},{"text":"ShareContext","anchor":"ShareContext","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"When a share action is triggered, the delegate returns a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareContext","type":"reference"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"the SDK passes to ","type":"text"},{"code":"UIActivityViewController","type":"codeVoice"},{"text":". The struct has three fields:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"activityItems"}],"type":"strong"},{"type":"text","text":" — the primary items to share (URLs, strings, images)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"applicationActivities","type":"codeVoice"}]},{"type":"text","text":" — optional custom "},{"code":"UIActivity","type":"codeVoice"},{"type":"text","text":" instances to"},{"type":"text","text":" "},{"type":"text","text":"include in the share sheet."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"subject"}],"type":"strong"},{"type":"text","text":" — an optional subject line used by activities like Mail."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The built-in providers automatically add a "},{"type":"strong","inlineContent":[{"text":"Copy Link","type":"text"}]},{"type":"text","text":" activity to"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationActivities"},{"type":"text","text":". If you implement a custom delegate, add your own"},{"type":"text","text":" "},{"type":"text","text":"activities as needed."}]},{"text":"Replica vs Feed Sharing","anchor":"Replica-vs-Feed-Sharing","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true},{"text":" protocol defines ","type":"text"},{"inlineContent":[{"text":"separate methods","type":"text"}],"type":"strong"},{"text":" for feed and","type":"text"},{"text":" ","type":"text"},{"text":"replica editions.","type":"text"}]},{"text":"Feed Edition Methods","anchor":"Feed-Edition-Methods","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed editions use page-level sharing:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isShareable(page:inEdition:inPublished:)"},{"text":" — controls whether the share","type":"text"},{"text":" ","type":"text"},{"text":"button is visible for a given page.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"shareContext(forPage:inEdition:inPublished:)","type":"codeVoice"},{"text":" — provides the share content.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Replica Edition Methods","anchor":"Replica-Edition-Methods","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Replica editions use spread-level sharing. A ","type":"text"},{"code":"PSReplicaPageSpread","type":"codeVoice"},{"text":" represents","type":"text"},{"text":" ","type":"text"},{"text":"what the user currently sees and has three cases:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".single(PSPage)","type":"codeVoice"}]},{"type":"text","text":" — a single PDF page."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".double(left: PSPage?, right: PSPage?)","type":"codeVoice"}]},{"type":"text","text":" — a double-page spread in"},{"type":"text","text":" "},{"type":"text","text":"landscape mode."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".article(PSArticle)"}]},{"type":"text","text":" — an article view within the replica reader."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The delegate methods receive a ","type":"text"},{"code":"PSReplicaPageSpread","type":"codeVoice"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"code":"PSReplicaEdition","type":"codeVoice"},{"text":":","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isShareable(spread:inReplicaEdition:)","type":"codeVoice"},{"text":" — controls share button visibility.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shareContext(forSpread:inReplicaEdition:)"},{"type":"text","text":" — provides the share content."}]}]}],"type":"unorderedList"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","isActive":true},{"text":" only shares replica article spreads","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":".article","type":"codeVoice"},{"text":" case) where the article has a non-empty ","type":"text"},{"code":"shareLink","type":"codeVoice"},{"text":". PDF page","type":"text"},{"text":" ","type":"text"},{"text":"spreads are not shareable through this provider.","type":"text"}]}]},{"text":"Custom ShareDelegate","anchor":"Custom-ShareDelegate","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For full control, implement "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true},{"type":"text","text":" directly. The protocol has"},{"type":"text","text":" "},{"type":"text","text":"methods for both feed edition pages and replica spreads:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyShareDelegate: PSReaderUI.ShareDelegate {","","    \/\/ MARK: Feed Edition Methods","","    func isShareable(","        page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> Bool {","        \/\/ Only share article pages","        return page.type == \"templateArticle\"","    }","","    func shareContext(","        forPage page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> ShareContext? {","        guard let article = page.articles?.first,","              let shareLink = article.sharelink,","              let url = URL(string: shareLink) else {","            return nil","        }","        return ShareContext(","            activityItems: [url],","            subject: article.headline","        )","    }","","    \/\/ MARK: Replica Edition Methods","","    func isShareable(","        spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> Bool {","        \/\/ Share all page spreads; only share articles that have a link","        switch spread {","        case .single, .double:","            return true","        case .article(let article):","            return !article.shareLink.isEmpty","        }","    }","","    func shareContext(","        forSpread spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> ShareContext? {","        let edition = replicaEdition.edition","","        switch spread {","        case .article(let article):","            \/\/ Share the article link","            guard let url = URL(string: article.shareLink) else { return nil }","            return ShareContext(","                activityItems: [url],","                subject: article.headline","            )","","        case .single(let page):","            \/\/ Share a text description of the page","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","","        case .double(let left, let right):","            let page = left ?? right","            guard let page else { return nil }","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","        }","    }","}"]},{"style":"tip","name":"Tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"isShareable"},{"type":"text","text":" methods have default implementations that return"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when "},{"type":"codeVoice","code":"shareContext"},{"type":"text","text":" returns a non-nil value. You only need to implement"},{"type":"text","text":" "},{"type":"text","text":"them explicitly as a performance optimization to avoid building a share"},{"type":"text","text":" "},{"type":"text","text":"context just to check visibility."}]}]},{"text":"Print Integration","anchor":"Print-Integration","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Since v5.3, printing is consolidated into the share actions. The dedicated","type":"text"},{"text":" ","type":"text"},{"text":"print icon has been removed from the reader navigation bar. Users access","type":"text"},{"text":" ","type":"text"},{"text":"printing through the system share sheet, where it appears as a standard","type":"text"},{"text":" ","type":"text"},{"cod