{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"metadata":{"role":"article","roleHeading":"Article","title":"Sharing","modules":[{"name":"PSReaderUI"}]},"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The PSReaderUI SDK provides built-in sharing through the "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"protocol. The SDK ships three ready-to-use providers — "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider","type":"reference","isActive":true},{"type":"text","text":", and "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","type":"reference","isActive":true},{"type":"text","text":" — that cover the"},{"text":" ","type":"text"},{"text":"most common scenarios. For full control, implement ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","type":"reference","isActive":true},{"text":" directly.","type":"text"}],"type":"paragraph"},{"anchor":"Key-Concepts","text":"Key Concepts","level":2,"type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Web reader link"}],"type":"strong"},{"type":"text","text":" — a URL that opens the edition page in the PageSuite web"},{"type":"text","text":" "},{"type":"text","text":"reader (e.g., "},{"code":"reader.pagesuite.com\/shortcode\/CODE\/edition\/GUID","type":"codeVoice"},{"type":"text","text":"). This lets"},{"type":"text","text":" "},{"type":"text","text":"anyone view the page in a browser without installing the app."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Article link"}],"type":"strong"},{"type":"text","text":" — a URL pointing to the article on the publisher’s own website"},{"type":"text","text":" "},{"type":"text","text":"(e.g., "},{"code":"example.com\/news\/article-slug","type":"codeVoice"},{"type":"text","text":"). This link is set by the publisher in"},{"type":"text","text":" "},{"type":"text","text":"the CMS and is only available for article-type pages that have a "},{"code":"shareLink","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"configured."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both link types are surfaced through the iOS share sheet"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"UIActivityViewController","type":"codeVoice"},{"type":"text","text":"). The built-in providers automatically include a"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Copy Link"}]},{"type":"text","text":" activity alongside the standard system activities."}],"type":"paragraph"},{"anchor":"Choosing-a-Share-Policy","text":"Choosing a Share Policy","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","isActive":true},{"type":"text","text":" wraps one or both of the built-in providers and applies a"},{"type":"text","text":" "},{"type":"text","text":"fallback strategy through its "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider\/SharePolicy","isActive":true},{"type":"text","text":" enum:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Policy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When to use","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What’s shareable"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".disabled"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"You don’t want any sharing"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Nothing"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".onlyWebReader"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All pages should share a web reader link"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Any page with a page GUID"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".onlyArticleLink","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only article pages with a CMS link should be shareable","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Article pages with a non-empty "},{"type":"codeVoice","code":"shareLink"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".preferWebReader","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Web reader link preferred, article link as fallback","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Most pages via web reader; article pages also eligible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".preferArticleLink"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Article link preferred, web reader as fallback"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Article pages via CMS link; all other pages via web reader"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".onlyArticleLink()"},{"type":"text","text":" is the default policy when no share delegate is"},{"type":"text","text":" "},{"type":"text","text":"assigned. Assign a delegate explicitly only if you need a different policy."}]}],"type":"aside","name":"Tip"},{"anchor":"Quick-Setup","text":"Quick Setup","level":2,"type":"heading"},{"inlineContent":[{"text":"To enable web reader sharing, create a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider","type":"reference"},{"text":" with your","type":"text"},{"text":" ","type":"text"},{"text":"shortcode and assign it through a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"To disable sharing entirely:"}],"type":"paragraph"},{"code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(sharePolicy: .disabled)"],"syntax":"swift","type":"codeListing"},{"anchor":"Policy-Examples","text":"Policy Examples","level":2,"type":"heading"},{"anchor":"Web-Reader-Only","text":"Web Reader Only","level":3,"type":"heading"},{"inlineContent":[{"text":"Share every page as a web reader link. Useful when the publisher does not have","type":"text"},{"text":" ","type":"text"},{"text":"article pages on their website:","type":"text"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyWebReader(webProvider: webProvider)",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Custom-Web-Reader-Domain","text":"Custom Web Reader Domain","level":3,"type":"heading"},{"inlineContent":[{"text":"If your web reader is hosted on a custom domain, pass it as the ","type":"text"},{"code":"urlMask","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: \"reader.mypublication.com\",","    shortCode: \"SHORTCODE\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"urlMask","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the provider defaults to ","type":"text"},{"code":"reader.pagesuite.com","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"feed editions and ","type":"text"},{"code":"edition.pagesuite.com","type":"codeVoice"},{"text":" for replica editions.","type":"text"}],"type":"paragraph"},{"anchor":"Article-Link-Only-Default","text":"Article Link Only (Default)","level":3,"type":"heading"},{"inlineContent":[{"text":"Only pages that have a publisher-configured article link are shareable:","type":"text"}],"type":"paragraph"},{"code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyArticleLink()",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Prefer-Article-Link-with-Web-Reader-Fallback","text":"Prefer Article Link with Web Reader Fallback","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Share the article link when available, otherwise fall back to the web reader:"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"],"syntax":"swift","type":"codeListing"},{"anchor":"ShareContext","text":"ShareContext","level":2,"type":"heading"},{"inlineContent":[{"text":"When a share action is triggered, the delegate returns a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareContext","isActive":true},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"the SDK passes to ","type":"text"},{"type":"codeVoice","code":"UIActivityViewController"},{"text":". The struct has three fields:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"activityItems","type":"codeVoice"}]},{"type":"text","text":" — the primary items to share (URLs, strings, images)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"applicationActivities","type":"codeVoice"}]},{"type":"text","text":" — optional custom "},{"type":"codeVoice","code":"UIActivity"},{"type":"text","text":" instances to"},{"type":"text","text":" "},{"type":"text","text":"include in the share sheet."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"subject"}]},{"type":"text","text":" — an optional subject line used by activities like Mail."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The built-in providers automatically add a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Copy Link"}]},{"text":" activity to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"applicationActivities"},{"text":". If you implement a custom delegate, add your own","type":"text"},{"text":" ","type":"text"},{"text":"activities as needed.","type":"text"}],"type":"paragraph"},{"anchor":"Replica-vs-Feed-Sharing","text":"Replica vs Feed Sharing","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true},{"type":"text","text":" protocol defines "},{"type":"strong","inlineContent":[{"text":"separate methods","type":"text"}]},{"type":"text","text":" for feed and"},{"type":"text","text":" "},{"type":"text","text":"replica editions."}],"type":"paragraph"},{"anchor":"Feed-Edition-Methods","text":"Feed Edition Methods","level":3,"type":"heading"},{"inlineContent":[{"text":"Feed editions use page-level sharing:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isShareable(page:inEdition:inPublished:)"},{"type":"text","text":" — controls whether the share"},{"type":"text","text":" "},{"type":"text","text":"button is visible for a given page."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"shareContext(forPage:inEdition:inPublished:)","type":"codeVoice"},{"text":" — provides the share content.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Replica-Edition-Methods","text":"Replica Edition Methods","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Replica editions use spread-level sharing. A "},{"type":"codeVoice","code":"PSReplicaPageSpread"},{"type":"text","text":" represents"},{"type":"text","text":" "},{"type":"text","text":"what the user currently sees and has three cases:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".single(PSPage)","type":"codeVoice"}],"type":"strong"},{"text":" — a single PDF page.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".double(left: PSPage?, right: PSPage?)"}]},{"text":" — a double-page spread in","type":"text"},{"text":" ","type":"text"},{"text":"landscape mode.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".article(PSArticle)","type":"codeVoice"}]},{"text":" — an article view within the replica reader.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The delegate methods receive a "},{"code":"PSReplicaPageSpread","type":"codeVoice"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"code":"PSReplicaEdition","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isShareable(spread:inReplicaEdition:)","type":"codeVoice"},{"text":" — controls share button visibility.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"shareContext(forSpread:inReplicaEdition:)"},{"type":"text","text":" — provides the share content."}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","isActive":true},{"type":"text","text":" only shares replica article spreads"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".article"},{"type":"text","text":" case) where the article has a non-empty "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":". PDF page"},{"type":"text","text":" "},{"type":"text","text":"spreads are not shareable through this provider."}]}],"type":"aside","name":"Note"},{"anchor":"Custom-ShareDelegate","text":"Custom ShareDelegate","level":2,"type":"heading"},{"inlineContent":[{"text":"For full control, implement ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate"},{"type":"text","text":" directly. The protocol has"},{"type":"text","text":" "},{"type":"text","text":"methods for both feed edition pages and replica spreads:"}],"type":"paragraph"},{"code":["struct MyShareDelegate: PSReaderUI.ShareDelegate {","","    \/\/ MARK: Feed Edition Methods","","    func isShareable(","        page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> Bool {","        \/\/ Only share article pages","        return page.type == \"templateArticle\"","    }","","    func shareContext(","        forPage page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> ShareContext? {","        guard let article = page.articles?.first,","              let shareLink = article.sharelink,","              let url = URL(string: shareLink) else {","            return nil","        }","        return ShareContext(","            activityItems: [url],","            subject: article.headline","        )","    }","","    \/\/ MARK: Replica Edition Methods","","    func isShareable(","        spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> Bool {","        \/\/ Share all page spreads; only share articles that have a link","        switch spread {","        case .single, .double:","            return true","        case .article(let article):","            return !article.shareLink.isEmpty","        }","    }","","    func shareContext(","        forSpread spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> ShareContext? {","        let edition = replicaEdition.edition","","        switch spread {","        case .article(let article):","            \/\/ Share the article link","            guard let url = URL(string: article.shareLink) else { return nil }","            return ShareContext(","                activityItems: [url],","                subject: article.headline","            )","","        case .single(let page):","            \/\/ Share a text description of the page","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","","        case .double(let left, let right):","            let page = left ?? right","            guard let page else { return nil }","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"isShareable","type":"codeVoice"},{"text":" methods have default implementations that return","type":"text"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when ","type":"text"},{"code":"shareContext","type":"codeVoice"},{"text":" returns a non-nil value. You only need to implement","type":"text"},{"text":" ","type":"text"},{"text":"them explicitly as a performance optimization to avoid building a share","type":"text"},{"text":" ","type":"text"},{"text":"context just to check visibility.","type":"text"}]}],"type":"aside","name":"Tip"},{"anchor":"Print-Integration","text":"Print Integration","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Since v5.3, printing is consolidated into the share actions. The dedicated"},{"type":"text","text":" "},{"type":"text","text":"print icon has been removed from the reader navigation bar. Users access"},{"type":"text","text":" "},{"type":"text","text":"printing through the system share sheet, where it appears as a standard"},{"type":"text","text":" "},{"type":"codeVoice","code":"UIActivity"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Printing requires no configuration. It is available automatically whenever","type":"text"},{"text":" ","type":"text"},{"text":"sharing is enabled (i.e., the share delegate is not set to ","type":"text"},{"code":".disabled","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/psreaderui\/sharing"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/sharing"],"traits":[{"interfaceLanguage":"oc