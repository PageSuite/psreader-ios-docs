 a","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Copy Link"}]},{"text":" activity alongside the standard system activities.","type":"text"}]},{"type":"heading","level":2,"anchor":"Choosing-a-Share-Policy","text":"Choosing a Share Policy"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","type":"reference"},{"text":" wraps one or both of the built-in providers and applies a","type":"text"},{"text":" ","type":"text"},{"text":"fallback strategy through its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider\/SharePolicy","type":"reference"},{"text":" enum:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Policy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When to use","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"What’s shareable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".disabled","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"You don’t want any sharing","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Nothing","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".onlyWebReader","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All pages should share a web reader link"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Any page with a page GUID","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".onlyArticleLink"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only article pages with a CMS link should be shareable","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Article pages with a non-empty ","type":"text"},{"code":"shareLink","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".preferW