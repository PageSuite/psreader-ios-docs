gesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","isActive":true,"type":"reference"},{"text":" — that cover the","type":"text"},{"text":" ","type":"text"},{"text":"most common scenarios. For full control, implement ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true,"type":"reference"},{"text":" directly.","type":"text"}],"type":"paragraph"},{"text":"Key Concepts","type":"heading","level":2,"anchor":"Key-Concepts"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Web reader link","type":"text"}]},{"type":"text","text":" — a URL that opens the edition page in the PageSuite web"},{"type":"text","text":" "},{"type":"text","text":"reader (e.g., "},{"type":"codeVoice","code":"reader.pagesuite.com\/shortcode\/CODE\/edition\/GUID"},{"type":"text","text":"). This lets"},{"type":"text","text":" "},{"type":"text","text":"anyone view the page in a browser without installing the app."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Article link"}]},{"type":"text","text":" — a URL pointing to the article on the publisher’s own website"},{"type":"text","text":" "},{"type":"text","text":"(e.g., "},{"type":"codeVoice","code":"example.com\/news\/article-slug"},{"type":"text","text":"). This link is set by the publisher in"},{"type":"text","text":" "},{"type":"text","text":"the CMS and is only available for article-type pages that have a "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":" "},{"type":"text","text":"configured."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both link types are surfaced through the iOS share sheet"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"UIActivityViewController","type":"codeVoice"},{"type":"text","text":"). The built-in providers automatically include a"},{"type":"text","text":" "},{"inlineContent":[{"text":"Copy Link","type":"text"}],"type":"