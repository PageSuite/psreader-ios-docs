xt","text":" "},{"type":"text","text":"assigned. Assign a delegate explicitly only if you need a different policy."}],"type":"paragraph"}],"name":"Tip","type":"aside","style":"tip"},{"anchor":"Quick-Setup","text":"Quick Setup","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"To enable web reader sharing, create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider"},{"type":"text","text":" with your"},{"type":"text","text":" "},{"type":"text","text":"shortcode and assign it through a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"]},{"inlineContent":[{"text":"To disable sharing entirely:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(sharePolicy: .disabled)"]},{"anchor":"Policy-Examples","text":"Policy Examples","type":"heading","level":2},{"anchor":"Web-Reader-Only","text":"Web Reader Only","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Share every page as a web reader link. Useful when the publisher does not have"},{"type":"text","text":" "},{"type":"text","text":"article pages on their website:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyWebReader(webProvider: webProvider)",")"]},{"anchor":"Custom-Web-Reader-Domain","text":"Custom Web Reader Domain","type":"heading","level":3},{"inlineContent":[{"text":"If your web reader is hosted on a custom domain, pass it as the ","type":"text"},{"type":"codeVoice","code":"urlMask"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: \"reader.mypublication.com\",","    shortCode: \"SHORTCODE\"",")"]},{"inlineContent":[{"text":"When ","type":"text"},{"code":"urlMask","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the provider defaults to ","type":"text"},{"code":"reader.pagesuite.com","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"feed editions and ","type":"text"},{"code":"edition.pagesuite.com","type":"codeVoice"},{"text":" for replica editions.","type":"text"}],"type":"paragraph"},{"anchor":"Article-Link-Only-Default","text":"Article Link Only (Default)","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Only pages that have a publisher-configured article link are shareable:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyArticleLink()",")"]},{"anchor":"Prefer-Article-Link-with-Web-Reader-Fallback","text":"Prefer Article Link with Web Reader Fallback","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Share the article link when available, otherwise fall back to the web reader:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"]},{"anchor":"ShareContext","text":"ShareContext","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When a share action is triggered, the delegate returns a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareContext"},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"the SDK passes to "},{"type":"codeVoice","code":"UIActivityViewController"},{"type":"text","text":". The struct has three fields:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"activityItems","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — the primary items to share (URLs, strings, images)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"applicationActivities"}]},{"type":"text","text":" — optional custom "},{"type":"codeVoice","code":"UIActivity"},{"type":"text","text":" instances to"},{"type":"text","text":" "},{"type":"text","text":"include in the share sheet."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"subject","type":"codeVoice"}]},{"type":"text","text":" — an optional subject line used by activities like Mail."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The built-in providers automatically add a ","type":"text"},{"inlineContent":[{"text":"Copy Link","type":"text"}],"type":"strong"},{"text":" activity to","type":"text"},{"text":" ","type":"text"},{"code":"applicationActivities","type":"codeVoice"},{"text":". If you implement a custom delegate, add your own","type":"text"},{"text":" ","type":"text"},{"text":"activities as needed.","type":"text"}],"type":"paragraph"},{"anchor":"Replica-vs-Feed-Sharing","text":"Replica vs Feed Sharing","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate"},{"type":"text","text":" protocol defines "},{"type":"strong","inlineContent":[{"text":"separate methods","type":"text"}]},{"type":"text","text":" for feed and"},{"type":"text","text":" "},{"type":"text","text":"replica editions."}],"type":"paragraph"},{"anchor":"Feed-Edition-Methods","text":"Feed Edition Methods","type":"heading","level":3},{"inlineContent":[{"text":"Feed editions use page-level sharing:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"isShareable(page:inEdition:inPublished:)","type":"codeVoice"},{"type":"text","text":" — controls whether the share"},{"type":"text","text":" "},{"type":"text","text":"button is visible for a given page."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"shareContext(forPage:inEdition:inPublished:)"},{"type":"text","text":" — provides the share content."}],"type":"paragraph"}]}]},{"anchor":"Replica-Edition-Methods","text":"Replica Edition Methods","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Replica editions use spread-level sharing. A "},{"code":"PSReplicaPageSpread","type":"codeVoice"},{"type":"text","text":" represents"},{"type":"text","text":" "},{"type":"text","text":"what the user currently sees and has three cases:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".single(PSPage)"}]},{"type":"text","text":" — a single PDF page."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".double(left: PSPage?, right: PSPage?)"}],"type":"strong"},{"text":" — a double-page spread in","type":"text"},{"text":" ","type":"text"},{"text":"landscape mode.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".article(PSArticle)"}]},{"type":"text","text":" — an article view within the replica reader."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The delegate methods receive a ","type":"text"},{"code":"PSReplicaPageSpread","type":"codeVoice"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"code":"PSReplicaEdition","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isShareable(spread:inReplicaEdition:)"},{"text":" — controls share button visibility.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"shareContext(forSpread:inReplicaEdition:)"},{"text":" — provides the share content.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","isActive":true},{"type":"text","text":" only shares replica article spreads"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".article"},{"type":"text","text":" case) where the article has a non-empty "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":". PDF page"},{"type":"text","text":" "},{"type":"text","text":"spreads are not shareable through this provider."}]}],"name":"Note","type":"aside","style":"note"},{"anchor":"Custom-ShareDelegate","text":"Custom ShareDelegate","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"For full control, implement "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate"},{"type":"text","text":" directly. The protocol has"},{"type":"text","text":" "},{"type":"text","text":"methods for both feed edition pages and replica spreads:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyShareDelegate: PSReaderUI.ShareDelegate {","","    \/\/ MARK: Feed Edition Methods","","    func isShareable(","        page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> Bool {","        \/\/ Only share article pages","        return page.type == \"templateArticle\"","    }","","    func shareContext(","        forPage page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> ShareContext? {","        guard let article = page.articles?.first,","              let shareLink = article.sharelink,","              let url = URL(string: shareLink) else {","            return nil","        }","        return ShareContext(","            activityItems: [url],","            subject: article.headline","        )","    }","","    \/\/ MARK: Replica Edition Methods","","    func isShareable(","        spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> Bool {","        \/\/ Share all page spreads; only share articles that have a link","        switch spread {","        case .single, .double:","            return true","        case .article(let article):","            return !article.shareLink.isEmpty","        }","    }","","    func shareContext(","        forSpread spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> ShareContext? {","        let edition = replicaEdition.edition","","        switch spread {","        case .article(let article):","            \/\/ Share the article link","            guard let url = URL(string: article.shareLink) else { return nil }","            return ShareContext(","                activityItems: [url],","                subject: article.headline","            )","","        case .single(let page):","            \/\/ Share a text description of the page","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","","        case .double(let left, let right):","            let page = left ?? right","            guard let page else { return nil }","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","        }","    }","}"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"isShareable","type":"codeVoice"},{"text":" methods have default implementations that return","type":"text"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when ","type":"text"},{"code":"shareContext","type":"codeVoice"},{"text":" returns a non-nil value. You only need to implement","type":"text"},{"text":" ","type":"text"},{"text":"them explicitly as a performance optimization to avoid building a share","type":"text"},{"text":" ","type":"text"},{"text":"context just to check visibility.","type":"text"}]}],"name":"Tip","type":"aside","style":"tip"},{"anchor":"Print-Integration","text":"Print Integration","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Since v5.3, printing is consolidated into the share actions. The dedicated"},{"type":"text","text":" "},{"type":"text","text":"print icon has been removed from the reader navigation bar. Users access"},{"type":"text","text":" "},{"type":"text","text":"printing through the system share sheet, where it appears as a standard"},{"type":"text","text":" "},{"type":"codeVoice","code":"UIActivity"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Printing requires no configuration. It is available automatically whenever","type":"text"},{"text":" ","type":"text"},{"text":"sharing is enabled (i.e., the share delegate is not set to ","type":"text"},{"code":".disabled","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths