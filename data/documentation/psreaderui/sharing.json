{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"generated":true,"title":"Features","anchor":"Features","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Deep-Linking","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Commenting","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Media-Playback","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The PSReaderUI SDK provides built-in sharing through the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"protocol. The SDK ships three ready-to-use providers — ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","isActive":true,"type":"reference"},{"text":" — that cover the","type":"text"},{"text":" ","type":"text"},{"text":"most common scenarios. For full control, implement ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true,"type":"reference"},{"text":" directly.","type":"text"}]},{"type":"heading","anchor":"Key-Concepts","level":2,"text":"Key Concepts"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Web reader link"}],"type":"strong"},{"text":" — a URL that opens the edition page in the PageSuite web","type":"text"},{"text":" ","type":"text"},{"text":"reader (e.g., ","type":"text"},{"code":"reader.pagesuite.com\/shortcode\/CODE\/edition\/GUID","type":"codeVoice"},{"text":"). This lets","type":"text"},{"text":" ","type":"text"},{"text":"anyone view the page in a browser without installing the app.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Article link","type":"text"}]},{"type":"text","text":" — a URL pointing to the article on the publisher’s own website"},{"type":"text","text":" "},{"type":"text","text":"(e.g., "},{"type":"codeVoice","code":"example.com\/news\/article-slug"},{"type":"text","text":"). This link is set by the publisher in"},{"type":"text","text":" "},{"type":"text","text":"the CMS and is only available for article-type pages that have a "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":" "},{"type":"text","text":"configured."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both link types are surfaced through the iOS share sheet"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"UIActivityViewController"},{"type":"text","text":"). The built-in providers automatically include a"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Copy Link"}]},{"type":"text","text":" activity alongside the standard system activities."}]},{"type":"heading","anchor":"Choosing-a-Share-Policy","level":2,"text":"Choosing a Share Policy"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","isActive":true},{"type":"text","text":" wraps one or both of the built-in providers and applies a"},{"type":"text","text":" "},{"type":"text","text":"fallback strategy through its "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider\/SharePolicy","isActive":true},{"type":"text","text":" enum:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Policy"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"When to use","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What’s shareable"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".disabled"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"You don’t want any sharing"}]}],[{"type":"paragraph","inlineContent":[{"text":"Nothing","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".onlyWebReader","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"All pages should share a web reader link","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Any page with a page GUID","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".onlyArticleLink"}]}],[{"type":"paragraph","inlineContent":[{"text":"Only article pages with a CMS link should be shareable","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Article pages with a non-empty "},{"type":"codeVoice","code":"shareLink"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".preferWebReader","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Web reader link preferred, article link as fallback"}]}],[{"type":"paragraph","inlineContent":[{"text":"Most pages via web reader; article pages also eligible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".preferArticleLink"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Article link preferred, web reader as fallback"}]}],[{"type":"paragraph","inlineContent":[{"text":"Article pages via CMS link; all other pages via web reader","type":"text"}]}]]]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"code":".onlyArticleLink()","type":"codeVoice"},{"type":"text","text":" is the default policy when no share delegate is"},{"type":"text","text":" "},{"type":"text","text":"assigned. Assign a delegate explicitly only if you need a different policy."}],"type":"paragraph"}],"style":"tip","name":"Tip"},{"type":"heading","anchor":"Quick-Setup","level":2,"text":"Quick Setup"},{"inlineContent":[{"text":"To enable web reader sharing, create a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider","type":"reference"},{"text":" with your","type":"text"},{"text":" ","type":"text"},{"text":"shortcode and assign it through a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To disable sharing entirely:","type":"text"}],"type":"paragraph"},{"code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(sharePolicy: .disabled)"],"syntax":"swift","type":"codeListing"},{"anchor":"Policy-Examples","text":"Policy Examples","level":2,"type":"heading"},{"anchor":"Web-Reader-Only","text":"Web Reader Only","level":3,"type":"heading"},{"inlineContent":[{"text":"Share every page as a web reader link. Useful when the publisher does not have","type":"text"},{"text":" ","type":"text"},{"text":"article pages on their website:","type":"text"}],"type":"paragraph"},{"code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyWebReader(webProvider: webProvider)",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Custom-Web-Reader-Domain","text":"Custom Web Reader Domain","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"If your web reader is hosted on a custom domain, pass it as the "},{"type":"codeVoice","code":"urlMask"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: \"reader.mypublication.com\",","    shortCode: \"SHORTCODE\"",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"urlMask"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the provider defaults to "},{"type":"codeVoice","code":"reader.pagesuite.com"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"feed editions and "},{"type":"codeVoice","code":"edition.pagesuite.com"},{"type":"text","text":" for replica editions."}],"type":"paragraph"},{"level":3,"text":"Article Link Only (Default)","anchor":"Article-Link-Only-Default","type":"heading"},{"inlineContent":[{"type":"text","text":"Only pages that have a publisher-configured article link are shareable:"}],"type":"paragraph"},{"syntax":"swift","code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyArticleLink()",")"],"type":"codeListing"},{"level":3,"text":"Prefer Article Link with Web Reader Fallback","anchor":"Prefer-Article-Link-with-Web-Reader-Fallback","type":"heading"},{"inlineContent":[{"type":"text","text":"Share the article link when available, otherwise fall back to the web reader:"}],"type":"paragraph"},{"syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"],"type":"codeListing"},{"level":2,"text":"ShareContext","anchor":"ShareContext","type":"heading"},{"inlineContent":[{"type":"text","text":"When a share action is triggered, the delegate returns a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareContext","isActive":true},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"the SDK passes to "},{"type":"codeVoice","code":"UIActivityViewController"},{"type":"text","text":". The struct has three fields:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"activityItems","type":"codeVoice"}]},{"type":"text","text":" — the primary items to share (URLs, strings, images)."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"applicationActivities","type":"codeVoice"}],"type":"strong"},{"text":" — optional custom ","type":"text"},{"code":"UIActivity","type":"codeVoice"},{"text":" instances to","type":"text"},{"text":" ","type":"text"},{"text":"include in the share sheet.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"subject"}],"type":"strong"},{"type":"text","text":" — an optional subject line used by activities like Mail."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The built-in providers automatically add a "},{"type":"strong","inlineContent":[{"text":"Copy Link","type":"text"}]},{"type":"text","text":" activity to"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationActivities"},{"type":"text","text":". If you implement a custom delegate, add your own"},{"type":"text","text":" "},{"type":"text","text":"activities as needed."}],"type":"paragraph"},{"level":2,"text":"Replica vs Feed Sharing","anchor":"Replica-vs-Feed-Sharing","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true},{"type":"text","text":" protocol defines "},{"type":"strong","inlineContent":[{"text":"separate methods","type":"text"}]},{"type":"text","text":" for feed and"},{"type":"text","text":" "},{"type":"text","text":"replica editions."}],"type":"paragraph"},{"level":3,"text":"Feed Edition Methods","anchor":"Feed-Edition-Methods","type":"heading"},{"inlineContent":[{"text":"Feed editions use page-level sharing:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isShareable(page:inEdition:inPublished:)","type":"codeVoice"},{"text":" — controls whether the share","type":"text"},{"text":" ","type":"text"},{"text":"button is visible for a given page.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"shareContext(forPage:inEdition:inPublished:)","type":"codeVoice"},{"text":" — provides the share content.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Replica Edition Methods","anchor":"Replica-Edition-Methods","type":"heading"},{"inlineContent":[{"type":"text","text":"Replica editions use spread-level sharing. A "},{"type":"codeVoice","code":"PSReplicaPageSpread"},{"type":"text","text":" represents"},{"type":"text","text":" "},{"type":"text","text":"what the user currently sees and has three cases:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".single(PSPage)"}]},{"type":"text","text":" — a single PDF page."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".double(left: PSPage?, right: PSPage?)","type":"codeVoice"}]},{"text":" — a double-page spread in","type":"text"},{"text":" ","type":"text"},{"text":"landscape mode.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".article(PSArticle)"}]},{"type":"text","text":" — an article view within the replica reader."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The delegate methods receive a ","type":"text"},{"code":"PSReplicaPageSpread","type":"codeVoice"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"code":"PSReplicaEdition","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isShareable(spread:inReplicaEdition:)"},{"type":"text","text":" — controls share button visibility."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"shareContext(forSpread:inReplicaEdition:)","type":"codeVoice"},{"type":"text","text":" — provides the share content."}]}]}],"type":"unorderedList"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider"},{"type":"text","text":" only shares replica article spreads"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".article"},{"type":"text","text":" case) where the article has a non-empty "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":". PDF page"},{"type":"text","text":" "},{"type":"text","text":"spreads are not shareable through this provider."}],"type":"paragraph"}],"name":"Note","type":"aside"},{"level":2,"text":"Custom ShareDelegate","anchor":"Custom-ShareDelegate","type":"heading"},{"inlineContent":[{"type":"text","text":"For full control, implement "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate"},{"type":"text","text":" directly. The protocol has"},{"type":"text","text":" "},{"type":"text","text":"methods for both feed edition pages and replica spreads:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyShareDelegate: PSReaderUI.ShareDelegate {","","    \/\/ MARK: Feed Edition Methods","","    func isShareable(","        page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> Bool {","        \/\/ Only share article pages","        return page.type == \"templateArticle\"","    }","","    func shareContext(","        forPage page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> ShareContext? {","        guard let article = page.articles?.first,","              let shareLink = article.sharelink,","              let url = URL(string: shareLink) else {","            return nil","        }","        return ShareContext(","            activityItems: [url],","            subject: article.headline","        )","    }","","    \/\/ MARK: Replica Edition Methods","","    func isShareable(","        spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> Bool {","        \/\/ Share all page spreads; only share articles that have a link","        switch spread {","        case .single, .double:","            return true","        case .article(let article):","            return !article.shareLink.isEmpty","        }","    }","","    func shareContext(","        forSpread spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> ShareContext? {","        let edition = replicaEdition.edition","","        switch spread {","        case .article(let article):","            \/\/ Share the article link","            guard let url = URL(string: article.shareLink) else { return nil }","            return ShareContext(","                activityItems: [url],","                subject: article.headline","            )","","        case .single(let page):","            \/\/ Share a text description of the page","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","","        case .double(let left, let right):","            let page = left ?? right","            guard let page else { return nil }","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","        }","    }","}"],"type":"codeListing"},{"style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"isShareable"},{"text":" methods have default implementations that return","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" when ","type":"text"},{"type":"codeVoice","code":"shareContext"},{"text":" returns a non-nil value. You only need to implement","type":"text"},{"text":" ","type":"text"},{"text":"them explicitly as a performance optimization to avoid building a share","type":"text"},{"text":" ","type":"text"},{"text":"context just to check visibility.","type":"text"}]}],"name":"Tip","type":"aside"},{"level":2,"text":"Print Integration","anchor":"Print-Integration","type":"heading"},{"inlineContent":[{"text":"Since v5.3, printing is consolidated into the share actions. The dedicated","type":"text"},{"text":" ","type":"text"},{"text":"print icon has been removed from the reader navigation bar. Users access","type":"text"},{"text":" ","type":"text"},{"text":"printing through the system share sheet, where it appears as a standard","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UIActivity"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Printing requires no configuration. It is available automatically whenever"},{"type":"text","text":" "},{"type":"text","text":"sharing is enabled (i.e., the share delegate is not set to "},{"code":".disabled","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]}],"abstract":[{"text":"Configure how users share edition content from the reader.","type":"text"}],"variants":[{"paths":["\/documentation\/psreaderui\/sharing"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/sharing"],"traits":[{"interfaceLanguage":"occ"}]}],"kind":"article","metadata":{"modules":[{"name":"PSReaderUI"}],"role":"article","roleHeading":"Article","title":"Sharing"},"sections":[],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ShareContext":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShareContext"}],"url":"\/documentation\/psreaderui\/sharecontext","role":"symbol","abstract":[{"type":"text","text":"A structure encapsulating information used to present shareable content."}],"navigatorTitle":[{"kind":"identifier","text":"ShareContext"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareContext","kind":"symbol","type":"topic","title":"ShareContext"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/WebReaderShareProvider":{"abstract":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate"},{"type":"text","text":" that provides shareable links to the web reader pages."},{"type":"text","text":" "},{"type":"text","text":"Use this provider to generate URLs pointing to web reader content."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WebReaderShareProvider","kind":"identifier"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider","role":"symbol","title":"WebReaderShareProvider","navigatorTitle":[{"text":"WebReaderShareProvider","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/psreaderui\/webreadershareprovider"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI":{"title":"PSReaderUI","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI","kind":"symbol","abstract":[{"text":"A UI framework for building digital newspaper and magazine reader experiences on iOS.","type":"text"}],"type":"topic","role":"collection","url":"\/documentation\/psreaderui"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Search":{"type":"topic","abstract":[{"text":"Search across feed edition content for articles and pages.","type":"text"}],"role":"article","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search","url":"\/documentation\/psreaderui\/search","title":"Search","kind":"article"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ShareProvider":{"abstract":[{"text":"A composite share provider allowing multiple share strategies to be chained.","type":"text"},{"text":" ","type":"text"},{"text":"Configure this provider to choose preferred or fallback sharing behaviors.","type":"text"}],"title":"ShareProvider","url":"\/documentation\/psreaderui\/shareprovider","kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShareProvider","kind":"identifier"}],"navigatorTitle":[{"text":"ShareProvider","kind":"identifier"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","type":"topic"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Deep-Linking":{"type":"topic","role":"article","abstract":[{"type":"text","text":"Open a specific feed edition directly, bypassing the arc