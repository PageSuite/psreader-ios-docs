{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The PSReaderUI SDK provides built-in sharing through the ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true},{"text":" ","type":"text"},{"text":"protocol. The SDK ships three ready-to-use providers — ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider","isActive":true},{"text":", and ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","isActive":true},{"text":" — that cover the","type":"text"},{"text":" ","type":"text"},{"text":"most common scenarios. For full control, implement ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true,"type":"reference"},{"text":" directly.","type":"text"}]},{"type":"heading","anchor":"Key-Concepts","text":"Key Concepts","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Web reader link","type":"text"}],"type":"strong"},{"text":" — a URL that opens the edition page in the PageSuite web","type":"text"},{"text":" ","type":"text"},{"text":"reader (e.g., ","type":"text"},{"code":"reader.pagesuite.com\/shortcode\/CODE\/edition\/GUID","type":"codeVoice"},{"text":"). This lets","type":"text"},{"text":" ","type":"text"},{"text":"anyone view the page in a browser without installing the app.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Article link","type":"text"}],"type":"strong"},{"type":"text","text":" — a URL pointing to the article on the publisher’s own website"},{"type":"text","text":" "},{"type":"text","text":"(e.g., "},{"type":"codeVoice","code":"example.com\/news\/article-slug"},{"type":"text","text":"). This link is set by the publisher in"},{"type":"text","text":" "},{"type":"text","text":"the CMS and is only available for article-type pages that have a "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":" "},{"type":"text","text":"configured."}]},{"type":"paragraph","inlineContent":[{"text":"Both link types are surfaced through the iOS share sheet","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"UIActivityViewController","type":"codeVoice"},{"text":"). The built-in providers automatically include a","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Copy Link","type":"text"}],"type":"strong"},{"text":" activity alongside the standard system activities.","type":"text"}]},{"type":"heading","anchor":"Choosing-a-Share-Policy","text":"Choosing a Share Policy","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider"},{"type":"text","text":" wraps one or both of the built-in providers and applies a"},{"type":"text","text":" "},{"type":"text","text":"fallback strategy through its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider\/SharePolicy"},{"type":"text","text":" enum:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Policy"}]}],[{"inlineContent":[{"type":"text","text":"When to use"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What’s shareable"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".disabled"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"You don’t want any sharing"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Nothing","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".onlyWebReader"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All pages should share a web reader link"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Any page with a page GUID"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".onlyArticleLink"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only article pages with a CMS link should be shareable","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Article pages with a non-empty "},{"code":"shareLink","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".preferWebReader","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Web reader link preferred, article link as fallback","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Most pages via web reader; article pages also eligible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".preferArticleLink"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Article link preferred, web reader as fallback"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Article pages via CMS link; all other pages via web reader","type":"text"}],"type":"paragraph"}]]]},{"type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".onlyArticleLink()"},{"type":"text","text":" is the default policy when no share delegate is"},{"type":"text","text":" "},{"type":"text","text":"assigned. Assign a delegate explicitly only if you need a different policy."}]}],"style":"tip"},{"type":"heading","anchor":"Quick-Setup","text":"Quick Setup","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To enable web reader sharing, create a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/WebReaderShareProvider","type":"reference","isActive":true},{"type":"text","text":" with your"},{"type":"text","text":" "},{"type":"text","text":"shortcode and assign it through a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"]},{"inlineContent":[{"type":"text","text":"To disable sharing entirely:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(sharePolicy: .disabled)"]},{"anchor":"Policy-Examples","type":"heading","level":2,"text":"Policy Examples"},{"anchor":"Web-Reader-Only","type":"heading","level":3,"text":"Web Reader Only"},{"inlineContent":[{"text":"Share every page as a web reader link. Useful when the publisher does not have","type":"text"},{"text":" ","type":"text"},{"text":"article pages on their website:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyWebReader(webProvider: webProvider)",")"]},{"anchor":"Custom-Web-Reader-Domain","type":"heading","level":3,"text":"Custom Web Reader Domain"},{"inlineContent":[{"type":"text","text":"If your web reader is hosted on a custom domain, pass it as the "},{"type":"codeVoice","code":"urlMask"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: \"reader.mypublication.com\",","    shortCode: \"SHORTCODE\"",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"urlMask"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the provider defaults to "},{"type":"codeVoice","code":"reader.pagesuite.com"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"feed editions and "},{"type":"codeVoice","code":"edition.pagesuite.com"},{"type":"text","text":" for replica editions."}]},{"anchor":"Article-Link-Only-Default","type":"heading","level":3,"text":"Article Link Only (Default)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only pages that have a publisher-configured article link are shareable:"}]},{"type":"codeListing","syntax":"swift","code":["globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .onlyArticleLink()",")"]},{"anchor":"Prefer-Article-Link-with-Web-Reader-Fallback","type":"heading","level":3,"text":"Prefer Article Link with Web Reader Fallback"},{"type":"paragraph","inlineContent":[{"text":"Share the article link when available, otherwise fall back to the web reader:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let webProvider = PSReaderUI.WebReaderShareProvider(","    urlMask: nil,","    shortCode: \"SHORTCODE\"",")","","globalConfig.shareDelegate = PSReaderUI.ShareProvider(","    sharePolicy: .preferArticleLink(","        webProvider: webProvider,","        articleLinkProvider: PSReaderUI.ArticleLinkShareProvider()","    )",")"]},{"anchor":"ShareContext","type":"heading","level":2,"text":"ShareContext"},{"type":"paragraph","inlineContent":[{"text":"When a share action is triggered, the delegate returns a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareContext","isActive":true},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"the SDK passes to ","type":"text"},{"code":"UIActivityViewController","type":"codeVoice"},{"text":". The struct has three fields:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"activityItems"}],"type":"strong"},{"text":" — the primary items to share (URLs, strings, images).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"applicationActivities"}]},{"type":"text","text":" — optional custom "},{"type":"codeVoice","code":"UIActivity"},{"type":"text","text":" instances to"},{"type":"text","text":" "},{"type":"text","text":"include in the share sheet."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"subject","type":"codeVoice"}],"type":"strong"},{"text":" — an optional subject line used by activities like Mail.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The built-in providers automatically add a ","type":"text"},{"inlineContent":[{"text":"Copy Link","type":"text"}],"type":"strong"},{"text":" activity to","type":"text"},{"text":" ","type":"text"},{"code":"applicationActivities","type":"codeVoice"},{"text":". If you implement a custom delegate, add your own","type":"text"},{"text":" ","type":"text"},{"text":"activities as needed.","type":"text"}]},{"anchor":"Replica-vs-Feed-Sharing","type":"heading","level":2,"text":"Replica vs Feed Sharing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true,"type":"reference"},{"text":" protocol defines ","type":"text"},{"inlineContent":[{"type":"text","text":"separate methods"}],"type":"strong"},{"text":" for feed and","type":"text"},{"text":" ","type":"text"},{"text":"replica editions.","type":"text"}]},{"anchor":"Feed-Edition-Methods","type":"heading","level":3,"text":"Feed Edition Methods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed editions use page-level sharing:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isShareable(page:inEdition:inPublished:)"},{"type":"text","text":" — controls whether the share"},{"type":"text","text":" "},{"type":"text","text":"button is visible for a given page."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shareContext(forPage:inEdition:inPublished:)"},{"type":"text","text":" — provides the share content."}]}]}]},{"anchor":"Replica-Edition-Methods","type":"heading","level":3,"text":"Replica Edition Methods"},{"type":"paragraph","inlineContent":[{"text":"Replica editions use spread-level sharing. A ","type":"text"},{"code":"PSReplicaPageSpread","type":"codeVoice"},{"text":" represents","type":"text"},{"text":" ","type":"text"},{"text":"what the user currently sees and has three cases:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".single(PSPage)","type":"codeVoice"}],"type":"strong"},{"text":" — a single PDF page.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".double(left: PSPage?, right: PSPage?)","type":"codeVoice"}]},{"type":"text","text":" — a double-page spread in"},{"type":"text","text":" "},{"type":"text","text":"landscape mode."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".article(PSArticle)"}]},{"text":" — an article view within the replica reader.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The delegate methods receive a ","type":"text"},{"code":"PSReplicaPageSpread","type":"codeVoice"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"code":"PSReplicaEdition","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isShareable(spread:inReplicaEdition:)"},{"type":"text","text":" — controls share button visibility."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shareContext(forSpread:inReplicaEdition:)"},{"type":"text","text":" — provides the share content."}]}]}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArticleLinkShareProvider","isActive":true},{"type":"text","text":" only shares replica article spreads"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".article"},{"type":"text","text":" case) where the article has a non-empty "},{"type":"codeVoice","code":"shareLink"},{"type":"text","text":". PDF page"},{"type":"text","text":" "},{"type":"text","text":"spreads are not shareable through this provider."}]}],"type":"aside","style":"note"},{"anchor":"Custom-ShareDelegate","type":"heading","level":2,"text":"Custom ShareDelegate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For full control, implement "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","type":"reference","isActive":true},{"type":"text","text":" directly. The protocol has"},{"type":"text","text":" "},{"type":"text","text":"methods for both feed edition pages and replica spreads:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyShareDelegate: PSReaderUI.ShareDelegate {","","    \/\/ MARK: Feed Edition Methods","","    func isShareable(","        page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> Bool {","        \/\/ Only share article pages","        return page.type == \"templateArticle\"","    }","","    func shareContext(","        forPage page: PSEPage,","        inEdition edition: PSEEdition,","        inPublished published: PSEPublished","    ) -> ShareContext? {","        guard let article = page.articles?.first,","              let shareLink = article.sharelink,","              let url = URL(string: shareLink) else {","            return nil","        }","        return ShareContext(","            activityItems: [url],","            subject: article.headline","        )","    }","","    \/\/ MARK: Replica Edition Methods","","    func isShareable(","        spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> Bool {","        \/\/ Share all page spreads; only share articles that have a link","        switch spread {","        case .single, .double:","            return true","        case .article(let article):","            return !article.shareLink.isEmpty","        }","    }","","    func shareContext(","        forSpread spread: PSReplicaPageSpread,","        inReplicaEdition replicaEdition: PSReplicaEdition","    ) -> ShareContext? {","        let edition = replicaEdition.edition","","        switch spread {","        case .article(let article):","            \/\/ Share the article link","            guard let url = URL(string: article.shareLink) else { return nil }","            return ShareContext(","                activityItems: [url],","                subject: article.headline","            )","","        case .single(let page):","            \/\/ Share a text description of the page","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","","        case .double(let left, let right):","            let page = left ?? right","            guard let page else { return nil }","            let text = \"\\(edition.publicationName) - \\(edition.name), page \\(page.num)\"","            return ShareContext(activityItems: [text])","        }","    }","}"]},{"name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"isShareable"},{"type":"text","text":" methods have default implementations that return"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when "},{"type":"codeVoice","code":"shareContext"},{"type":"text","text":" returns a non-nil value. You only need to implement"},{"type":"text","text":" "},{"type":"text","text":"them explicitly as a performance optimization to avoid building a share"},{"type":"text","text":" "},{"type":"text","text":"context just to check visibility."}]}],"type":"aside","style":"tip"},{"anchor":"Print-Integration","type":"heading","level":2,"text":"Print Integration"},{"type":"paragraph","inlineContent":[{"text":"Since v5.3, printing is consolidated into the share actions. The dedicated","type":"text"},{"text":" ","type":"text"},{"text":"print icon has been removed from the reader navigation bar. Users access","type":"text"},{"text":" ","type":"text"},{"text":"printing through the system share sheet, where it appears as a standard","type":"text"},{"text":" ","type":"text"},{"code":"UIActivity","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Printing requires no configuration. It is available automatically whenever","type":"text"},{"text":" ","type":"text"},{"text":"sharing is enabled (i.e., the share delegate is not set to ","type":"text"},{"code":".disabled","type":"codeVoice"},{"text":").","type":"text"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Deep-Linking","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Commenting","doc:\/\/com.pagesuite.PSReaderUI\/documentation\