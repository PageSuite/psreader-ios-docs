t","text":"When using the legacy replica reader"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"), additional"},{"type":"text","text":" "},{"type":"text","text":"customization options are available through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This includes navigation bar items, share templating, and legacy-specific"},{"type":"text","text":" "},{"type":"text","text":"icon overrides via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyImageResourceName"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"PSReaderUI"}],"title":"Theming and Customization","roleHeading":"Article","role":"article"},"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/GlobalConfiguration/brandColor":{"abstract":[{"type":"text","text":"The primary brand \/ accent color used throughout the SDK’s interface."}],"role":"symbol","type":"topic","url":"\/documentation\/psreaderui\/globalconfiguration\/brandcolor","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"brandColor","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UIColor","text":"UIColor","kind":"typeIdentifier"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/brandColor","kind":"symbol","title":"brandColor"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/EditionDateFormatter":{"type":"topic","title":"EditionD