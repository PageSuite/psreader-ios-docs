{"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/psreaderui\/theming-and-customization"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/theming-and-customization"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"PSReaderUI is designed to be customized. The configuration system follows a"},{"type":"text","text":" "},{"type":"text","text":"cascading hierarchy: "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference","isActive":true},{"type":"text","text":" supplies default values that flow"},{"type":"text","text":" "},{"type":"text","text":"into "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration","isActive":true},{"type":"text","text":", and their sub-configurations. Override any value at"},{"type":"text","text":" "},{"type":"text","text":"any level to apply targeted changes."}],"type":"paragraph"},{"type":"heading","text":"Configuration Hierarchy","anchor":"Configuration-Hierarchy","level":2},{"inlineContent":[{"text":"When you create a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration","type":"reference"},{"text":", pass","type":"text"},{"text":" ","type":"text"},{"text":"your ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference"},{"text":" to its initializer. The child configuration","type":"text"},{"text":" ","type":"text"},{"text":"inherits the global fonts, brand color, delegates, and other settings. You","type":"text"},{"text":" ","type":"text"},{"text":"can then override individual properties without affecting the rest:","type":"text"}],"type":"paragraph"},{"code":["let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID,","    primaryFont: UIFont(name: \"Georgia\", size: 12)!,","    secondaryFont: .systemFont(ofSize: 12),","    brandColor: .systemBlue",")","","var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.sectionRibbon.layout = .fillEqually","\/\/ brandColor, fonts, etc. are inherited from globalConfig"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Fonts","anchor":"Fonts","level":2},{"inlineContent":[{"type":"text","text":"Two font families control the SDK’s typography:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"primaryFont","type":"codeVoice"}]},{"type":"text","text":" — used for titles, headlines, publication names, and other"},{"type":"text","text":" "},{"type":"text","text":"prominent text. Set on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/primaryFont"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"secondaryFont","type":"codeVoice"}],"type":"strong"},{"text":" — used for labels, dates, captions, and secondary UI","type":"text"},{"text":" ","type":"text"},{"text":"elements. Set on ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/secondaryFont","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}]},{"inlineContent":[{"text":"Individual components expose ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LabelConfiguration","isActive":true,"type":"reference"},{"text":" properties that let you","type":"text"},{"text":" ","type":"text"},{"text":"override the font, point size, and color for specific labels without changing","type":"text"},{"text":" ","type":"text"},{"text":"the global fonts:","type":"text"}],"type":"paragraph"},{"code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.editionNameLabel = LabelConfiguration(","    font: UIFont(name: \"Georgia-Bold\", size: 14)!,","    pointSize: 14,","    color: .label",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Brand Color","anchor":"Brand-Color","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/brandColor","isActive":true},{"type":"text","text":" is used as an accent color throughout"},{"type":"text","text":" "},{"type":"text","text":"the SDK — in selection states, progress indicators, and interactive elements."}],"type":"paragraph"},{"inlineContent":[{"text":"To support both light and dark appearances, provide a dynamic color:","type":"text"}],"type":"paragraph"},{"code":["let brandColor = UIColor(dynamicProvider: {","    $0.userInterfaceStyle == .dark ? .white : .black","})"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Or define the color in your asset catalog for automatic trait resolution.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Thumbnail Content Mode","anchor":"Thumbnail-Content-Mode","level":2},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode","type":"reference","isActive":true},{"type":"text","text":" enum controls how edition thumbnails are sized and"},{"type":"text","text":" "},{"type":"text","text":"positioned within their containers across archive, bookmarks, downloads, and"},{"type":"text","text":" "},{"type":"text","text":"splash screens. This is one of the most impactful visual customization points"},{"type":"text","text":" "},{"type":"text","text":"— it determines the layout feel of your archive grid."}],"type":"paragraph"},{"inlineContent":[{"text":"There are three modes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/fitToWidth","isActive":true,"type":"reference"}],"type":"strong"},{"type":"text","text":" — the image fills the container’s width"},{"type":"text","text":" "},{"type":"text","text":"and is cropped vertically if the aspect ratio differs. This is the default"},{"type":"text","text":" "},{"type":"text","text":"for archives, bookmarks, and downloads."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/fitToHeight","isActive":true,"type":"reference"}]},{"type":"text","text":" — the image fills the container’s"},{"type":"text","text":" "},{"type":"text","text":"height and is cropped horizontally if needed. This is the default for the"},{"type":"text","text":" "},{"type":"text","text":"reader splash screen."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/flexibleHeight(estimatedAspectRatio:)","type":"reference"}],"type":"strong"},{"text":" — the image","type":"text"},{"text":" ","type":"text"},{"text":"fills the container’s width while the cell height adjusts dynamically to","type":"text"},{"text":" ","type":"text"},{"text":"preserve the image’s natural aspect ratio. Provide an ","type":"text"},{"code":"estimatedAspectRatio","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to stabilize layout during loading; the SDK refines it automatically once","type":"text"},{"text":" ","type":"text"},{"text":"images arrive.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Set the content mode on any configuration that displays thumbnails:"}],"type":"paragraph"},{"code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","","\/\/ Fixed-height cells that crop vertically (default)","archiveConfig.thumbnailContentMode = .fitToWidth","","\/\/ Dynamic-height cells that show the full image","archiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Pair the content mode with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration\/cellAspectRatio"},{"type":"text","text":" (or the"},{"type":"text","text":" "},{"type":"text","text":"equivalent "},{"type":"codeVoice","code":"aspectRatio"},{"type":"text","text":" on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksConfiguration"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DownloadsConfiguration"},{"type":"text","text":") to fine-tune the grid dimensions."}],"type":"paragraph"},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/flexibleHeight(estimatedAspectRatio:)","isActive":true},{"type":"text","text":" is not"},{"type":"text","text":" "},{"type":"text","text":"supported in the bookmarks or downloads views."}]}]},{"type":"heading","text":"Dark Mode","anchor":"Dark-Mode","level":2},{"inlineContent":[{"text":"The SDK respects the system appearance by default. To force a specific style","type":"text"},{"text":" ","type":"text"},{"text":"across the entire SDK, set ","type":"text"},{"code":"overrideUserInterfaceStyle","type":"codeVoice"},{"text":" on the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["carouselVC.overrideUserInterfaceStyle = .dark"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This propagates to all child view controllers, including the reader, archive,"},{"type":"text","text":" "},{"type":"text","text":"bookmarks, and downloads views."}],"type":"paragraph"},{"type":"heading","text":"Liquid Glass (iOS 26+)","anchor":"Liquid-Glass-iOS-26+","level":2},{"inlineContent":[{"text":"On iOS 26 and later, the SDK adopts the Liquid Glass design language by","type":"text"},{"text":" ","type":"text"},{"text":"default. The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LiquidGlassPolicy"},{"text":" enum controls this behavior:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".automatic","type":"codeVoice"}],"type":"strong"},{"text":" (default) — uses Liquid Glass on iOS 26+ when supported.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".disabled"}]},{"text":" — uses the standard appearance on all OS versions.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Set the policy globally or on specific configuration objects for granular","type":"text"},{"text":" ","type":"text"},{"text":"control:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Disable globally","globalConfig.liquidGlassPolicy = .disabled","","\/\/ Or disable only on the subsection ribbon","carouselConfig.subsectionRibbon.liquidGlassPolicy = .disabled"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The SDK also respects the host app’s "},{"code":"UIDesignRequiresCompatibility","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"Info.plist key and will fall back automatically when set."}],"type":"paragraph"},{"type":"heading","text":"Custom Icons","anchor":"Custom-Icons","level":2},{"inlineContent":[{"type":"text","text":"Implement "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AssetDelegate","type":"reference","isActive":true},{"type":"text","text":" to replace any of the SDK’s built-in icons with"},{"type":"text","text":" "},{"type":"text","text":"your own images. See the "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageResourceName","type":"reference","isActive":true},{"type":"text","text":" symbol page for the full list"},{"type":"text","text":" "},{"type":"text","text":"of icon identifiers and their usage context."}],"type":"paragraph"},{"code":["struct MyAssetDelegate: PSReaderUI.AssetDelegate {","    func imageResource(for name: ImageResourceName) -> UIImage? {","        switch name {","        case .share:","            return UIImage(named: \"my-share-icon\")","        default:","            return name.defaultImage()","        }","    }","}","","globalConfig.assetDelegate = MyAssetDelegate()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"For the legacy replica reader, override","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AssetDelegate\/legacyImageResource(for:)","isActive":true,"type":"reference"},{"text":" using ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyImageResourceName","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"identifiers.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Placeholder Images","anchor":"Placeholder-Images","level":2},{"inlineContent":[{"text":"The SDK can use placeholder images when a thumbnail is unavailable — for","type":"text"},{"text":" ","type":"text"},{"text":"example, when an article has no associated image or a thumbnail fails to load.","type":"text"},{"text":" ","type":"text"},{"text":"By default the SDK shows a solid skeleton view (a grey box that adapts to","type":"text"},{"text":" ","type":"text"},{"text":"light and dark mode). Implement","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AssetDelegate\/placeholderImage(size:with:completion:)","isActive":true,"type":"reference"},{"text":" to provide a custom","type":"text"},{"text":" ","type":"text"},{"text":"placeholder instead:","type":"text"}],"type":"paragraph"},{"code":["struct MyAssetDelegate: PSReaderUI.AssetDelegate {","    func placeholderImage(","        size: CGSize,","        with traits: UITraitCollection,","        completion: @escaping (UIImage?) -> Void","    ) {","        let name = traits.userInterfaceStyle == .dark","            ? \"placeholder-dark\"","            : \"placeholder-light\"","","        let image = UIImage(named: name)","        completion(image)","    }","}","","globalConfig.assetDelegate = MyAssetDelegate()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter reflects the thumbnail container’s dimensions, which you"},{"type":"text","text":" "},{"type":"text","text":"can use to select or generate an appropriately sized image. The "},{"type":"codeVoice","code":"traits"},{"type":"text","text":" "},{"type":"text","text":"parameter carries the current "},{"type":"codeVoice","code":"UITraitCollection"},{"type":"text","text":" — use it to adapt to"},{"type":"text","text":" "},{"type":"text","text":"light or dark mode via "},{"type":"codeVoice","code":"userInterfaceStyle"},{"type":"text","text":", or to account for display scale,"},{"type":"text","text":" "},{"type":"text","text":"size classes, and other environment traits."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" from the completion handler to keep the current placeholder"},{"type":"text","text":" "},{"type":"text","text":"presentation unchanged."}],"type":"paragraph"},{"inlineContent":[{"text":"The asset delegate is inherited from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"text":" by default. To","type":"text"},{"text":" ","type":"text"},{"text":"use a different delegate specifically for bookmarks, set it directly on the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksConfiguration\/assetDelegate"},{"text":" property.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Date Formatting","anchor":"Date-Formatting","level":2},{"inlineContent":[{"type":"text","text":"Edition dates are formatted through the "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EditionDateFormatter","type":"reference"},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"The SDK provides "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DefaultEditionDateFormatter","type":"reference"},{"type":"text","text":", which wraps a standard"},{"type":"text","text":" "},{"type":"codeVoice","code":"DateFormatter"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let dateFormatter = DefaultEditionDateFormatter(","    dateFormat: \"d MMMM yyyy\",","    timeZone: .current",")","globalConfig.dateFormatter = dateFormatter"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"If your publications use custom names instead of dates, implement","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EditionDateFormatter"},{"text":" to return the appropriate label for each edition.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Ribbon and Navigation Customization","anchor":"Ribbon-and-Navigation-Customization","level":2},{"inlineContent":[{"type":"text","text":"The carousel’s section and subsection ribbons are configurable via"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SectionRibbonConfiguration","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SubsectionRibbonConfiguration","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["carouselConfig.sectionRibbon.layout = .fillEqually  \/\/ or .fitLeft, .fitCenter","carouselConfig.subsectionRibbon.alignment = .center  \/\/ or .left"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The reader navigation bar appearance is controlled through"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderNavigationBarConfiguration","type":"reference"},{"type":"text","text":" on the "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.navigationBar.titleLabel.color = .label"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Content Browser","anchor":"Content-Browser","level":2},{"inlineContent":[{"type":"text","text":"The reader’s content browser is the panel that lets users navigate between"},{"type":"text","text":" "},{"type":"text","text":"sections, pages, and articles within an open edition. It is configured via"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderBrowserConfiguration"},{"type":"text","text":", which provides independent control over fonts,"},{"type":"text","text":" "},{"type":"text","text":"colors, and the Liquid Glass policy. Customize the browser without affecting"},{"type":"text","text":" "},{"type":"text","text":"the rest of the reader by setting properties on"},{"type":"text","text":" "},{"type":"codeVoice","code":"archiveConfig.readerConfig.browserConfig"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Legacy Replica Reader","anchor":"Legacy-Replica-Reader","level":2},{"inlineContent":[{"type":"text","text":"When using the legacy replica reader"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"), additional"},{"type":"text","text":" "},{"type":"text","text":"customization options are available through "},{"isActive":true,"type":