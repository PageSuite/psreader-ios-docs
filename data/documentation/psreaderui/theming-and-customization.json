{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"PSReaderUI is designed to be customized. The configuration system follows a","type":"text"},{"text":" ","type":"text"},{"text":"cascading hierarchy: ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true,"type":"reference"},{"text":" supplies default values that flow","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration"},{"text":", and their sub-configurations. Override any value at","type":"text"},{"text":" ","type":"text"},{"text":"any level to apply targeted changes.","type":"text"}]},{"level":2,"text":"Configuration Hierarchy","type":"heading","anchor":"Configuration-Hierarchy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you create a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration"},{"type":"text","text":", pass"},{"type":"text","text":" "},{"type":"text","text":"your "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"type":"text","text":" to its initializer. The child configuration"},{"type":"text","text":" "},{"type":"text","text":"inherits the global fonts, brand color, delegates, and other settings. You"},{"type":"text","text":" "},{"type":"text","text":"can then override individual properties without affecting the rest:"}]},{"syntax":"swift","type":"codeListing","code":["let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID,","    primaryFont: UIFont(name: \"Georgia\", size: 12)!,","    secondaryFont: .systemFont(ofSize: 12),","    brandColor: .systemBlue",")","","var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.sectionRibbon.layout = .fillEqually","\/\/ brandColor, fonts, etc. are inherited from globalConfig"]},{"level":2,"text":"Fonts","type":"heading","anchor":"Fonts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two font families control the SDK’s typography:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"primaryFont"}],"type":"strong"},{"text":" — used for titles, headlines, publication names, and other","type":"text"},{"text":" ","type":"text"},{"text":"prominent text. Set on ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/primaryFont","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"secondaryFont"}]},{"type":"text","text":" — used for labels, dates, captions, and secondary UI"},{"type":"text","text":" "},{"type":"text","text":"elements. Set on "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/secondaryFont","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Individual components expose "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LabelConfiguration"},{"type":"text","text":" properties that let you"},{"type":"text","text":" "},{"type":"text","text":"override the font, point size, and color for specific labels without changing"},{"type":"text","text":" "},{"type":"text","text":"the global fonts:"}]},{"syntax":"swift","type":"codeListing","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.editionNameLabel = LabelConfiguration(","    font: UIFont(name: \"Georgia-Bold\", size: 14)!,","    pointSize: 14,","    color: .label",")"]},{"level":2,"text":"Brand Color","type":"heading","anchor":"Brand-Color"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/brandColor"},{"type":"text","text":" is used as an accent color throughout"},{"type":"text","text":" "},{"type":"text","text":"the SDK — in selection states, progress indicators, and interactive elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support both light and dark appearances, provide a dynamic color:"}]},{"syntax":"swift","type":"codeListing","code":["let brandColor = UIColor(dynamicProvider: {","    $0.userInterfaceStyle == .dark ? .white : .black","})"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or define the color in your asset catalog for automatic trait resolution."}]},{"level":2,"text":"Thumbnail Content Mode","type":"heading","anchor":"Thumbnail-Content-Mode"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode"},{"text":" enum controls how edition thumbnails are sized and","type":"text"},{"text":" ","type":"text"},{"text":"positioned within their containers across archive, bookmarks, downloads, and","type":"text"},{"text":" ","type":"text"},{"text":"splash screens. This is one of the most impactful visual customization points","type":"text"},{"text":" ","type":"text"},{"text":"— it determines the layout feel of your archive grid.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There are three modes:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/fitToWidth"}]},{"type":"text","text":" — the image fills the container’s width"},{"type":"text","text":" "},{"type":"text","text":"and is cropped vertically if the aspect ratio differs. This is the default"},{"type":"text","text":" "},{"type":"text","text":"for archives, bookmarks, and downloads."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/fitToHeight"}]},{"type":"text","text":" — the image fills the container’s"},{"type":"text","text":" "},{"type":"text","text":"height and is cropped horizontally if needed. This is the default for the"},{"type":"text","text":" "},{"type":"text","text":"reader splash screen."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/flexibleHeight(estimatedAspectRatio:)","isActive":true}]},{"text":" — the image","type":"text"},{"text":" ","type":"text"},{"text":"fills the container’s width while the cell height adjusts dynamically to","type":"text"},{"text":" ","type":"text"},{"text":"preserve the image’s natural aspect ratio. Provide an ","type":"text"},{"code":"estimatedAspectRatio","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to stabilize layout during loading; the SDK refines it automatically once","type":"text"},{"text":" ","type":"text"},{"text":"images arrive.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the content mode on any configuration that displays thumbnails:"}]},{"syntax":"swift","type":"codeListing","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","","\/\/ Fixed-height cells that crop vertically (default)","archiveConfig.thumbnailContentMode = .fitToWidth","","\/\/ Dynamic-height cells that show the full image","archiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)"]},{"type":"paragraph","inlineContent":[{"text":"Pair the content mode with ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration\/cellAspectRatio","isActive":true,"type":"reference"},{"text":" (or the","type":"text"},{"text":" ","type":"text"},{"text":"equivalent ","type":"text"},{"code":"aspectRatio","type":"codeVoice"},{"text":" on ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksConfiguration","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DownloadsConfiguration","isActive":true,"type":"reference"},{"text":") to fine-tune the grid dimensions.","type":"text"}]},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/flexibleHeight(estimatedAspectRatio:)"},{"type":"text","text":" is not"},{"type":"text","text":" "},{"type":"text","text":"supported in the bookmarks or downloads views."}],"type":"paragraph"}]},{"level":2,"text":"Dark Mode","type":"heading","anchor":"Dark-Mode"},{"type":"paragraph","inlineContent":[{"text":"The SDK respects the system appearance by default. To force a specific style","type":"text"},{"text":" ","type":"text"},{"text":"across the entire SDK, set ","type":"text"},{"code":"overrideUserInterfaceStyle","type":"codeVoice"},{"text":" on the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["carouselVC.overrideUserInterfaceStyle = .dark"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This propagates to all child view controllers, including the reader, archive,"},{"type":"text","text":" "},{"type":"text","text":"bookmarks, and downloads views."}]},{"level":2,"text":"Liquid Glass (iOS 26+)","type":"heading","anchor":"Liquid-Glass-iOS-26+"},{"type":"paragraph","inlineContent":[{"text":"On iOS 26 and later, the SDK adopts the Liquid Glass design language by","type":"text"},{"text":" ","type":"text"},{"text":"default. The ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LiquidGlassPolicy","type":"reference","isActive":true},{"text":" enum controls this behavior:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".automatic","type":"codeVoice"}]},{"type":"text","text":" (default) — uses Liquid Glass on iOS 26+ when supported."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".disabled"}]},{"type":"text","text":" — uses the standard appearance on all OS versions."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Set the policy globally or on specific configuration objects for granular","type":"text"},{"text":" ","type":"text"},{"text":"control:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Disable globally","globalConfig.liquidGlassPolicy = .disabled","","\/\/ Or disable only on the subsection ribbon","carouselConfig.subsectionRibbon.liquidGlassPolicy = .disabled"]},{"type":"paragraph","inlineContent":[{"text":"The SDK also respects the host app’s ","type":"text"},{"code":"UIDesignRequiresCompatibility","type":"codeVoice"},{"text":" ","type":"text"},{"text":"Info.plist key and will fall back automatically when set.","type":"text"}]},{"level":2,"text":"Custom Icons","type":"heading","anchor":"Custom-Icons"},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AssetDelegate","type":"reference","isActive":true},{"text":" to replace any of the SDK’s built-in icons with","type":"text"},{"text":" ","type":"text"},{"text":"your own images. See the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageResourceName","type":"reference","isActive":true},{"text":" symbol page for the full list","type":"text"},{"text":" ","type":"text"},{"text":"of icon identifiers and their usage context.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct MyAssetDelegate: PSReaderUI.AssetDelegate {","    func imageResource(for name: ImageResourceName) -> UIImage? {","        switch name {","        case .share:","            return UIImage(named: \"my-share-icon\")","        default:","            return name.defaultImage()","        }","    }","}","","globalConfig.assetDelegate = MyAssetDelegate()"]},{"type":"paragraph","inlineContent":[{"text":"For the legacy replica reader, override","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AssetDelegate\/legacyImageResource(for:)","type":"reference","isActive":true},{"text":" using ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyImageResourceName","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"identifiers.","type":"text"}]},{"level":2,"text":"Placeholder Images","type":"heading","anchor":"Placeholder-Images"},{"type":"paragraph","inlineContent":[{"text":"The SDK can use placeholder images when a thumbnail is unavailable — for","type":"text"},{"text":" ","type":"text"},{"text":"example, when an article has no associated image or a thumbnail fails to load.","type":"text"},{"text":" ","type":"text"},{"text":"By default the SDK shows a solid skeleton view (a grey box that adapts to","type":"text"},{"text":" ","type":"text"},{"text":"light and dark mode). Implement","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AssetDelegate\/placeholderImage(size:with:completion:)","type":"reference","isActive":true},{"text":" to provide a custom","type":"text"},{"text":" ","type":"text"},{"text":"placeholder instead:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct MyAssetDelegate: PSReaderUI.AssetDelegate {","    func placeholderImage(","        size: CGSize,","        with traits: UITraitCollection,","        completion: @escaping (UIImage?) -> Void","    ) {","        let name = traits.userInterfaceStyle == .dark","            ? \"placeholder-dark\"","            : \"placeholder-light\"","","        let image = UIImage(named: name)","        completion(image)","    }","}","","globalConfig.assetDelegate = MyAssetDelegate()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter reflects the thumbnail container’s dimensions, which you"},{"type":"text","text":" "},{"type":"text","text":"can use to select or generate an appropriately sized image. The "},{"type":"codeVoice","code":"traits"},{"type":"text","text":" "},{"type":"text","text":"parameter carries the current "},{"type":"codeVoice","code":"UITraitCollection"},{"type":"text","text":" — use it to adapt to"},{"type":"text","text":" "},{"type":"text","text":"light or dark mode via "},{"type":"codeVoice","code":"userInterfaceStyle"},{"type":"text","text":", or to account for display scale,"},{"type":"text","text":" "},{"type":"text","text":"size classes, and other environment traits."}]},{"type":"paragraph","inlineContent":[{"text":"Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" from the completion handler to keep the current placeholder","type":"text"},{"text":" ","type":"text"},{"text":"presentation unchanged.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The asset delegate is inherited from "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true,"type":"reference"},{"type":"text","text":" by default. To"},{"type":"text","text":" "},{"type":"text","text":"use a different delegate specifically for bookmarks, set it directly on the"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksConfiguration\/assetDelegate","isActive":true,"type":"reference"},{"type":"text","text":" property."}]},{"level":2,"text":"Date Formatting","type":"heading","anchor":"Date-Formatting"},{"type":"paragraph","inlineContent":[{"text":"Edition dates are formatted through the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EditionDateFormatter","type":"reference","isActive":true},{"text":" protocol.","type":"text"},{"text":" ","type":"text"},{"text":"The SDK provides ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DefaultEditionDateFormatter","type":"reference","isActive":true},{"text":", which wraps a standard","type":"text"},{"text":" ","type":"text"},{"code":"DateFormatter","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let dateFormatter = DefaultEditionDateFormatter(","    dateFormat: \"d MMMM yyyy\",","    timeZone: .current",")","globalConfig.dateFormatter = dateFormatter"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your publications use custom names instead of dates, implement"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EditionDateFormatter","isActive":true},{"type":"text","text":" to return the appropriate label for each edition."}]},{"level":2,"text":"Ribbon and Navigation Customization","type":"heading","anchor":"Ribbon-and-Navigation-Customization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The carousel’s section and subsection ribbons are configurable via"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SectionRibbonConfiguration"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SubsectionRibbonConfiguration"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["carouselConfig.sectionRibbon.layout = .fillEqually  \/\/ or .fitLeft, .fitCenter","carouselConfig.subsectionRibbon.alignment = .center  \/\/ or .left"]},{"type":"paragraph","inlineContent":[{"text":"The reader navigation bar appearance is controlled through","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderNavigationBarConfiguration"},{"text":" on the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.navigationBar.titleLabel.color = .label"]},{"level":2,"text":"Content Browser","type":"heading","anchor":"Content-Browser"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reader’s content browser is the panel that lets users navigate between"},{"type":"text","text":" "},{"type":"text","text":"sections, pages, and articles within an open edition. It is configured via"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderBrowserConfiguration","type":"reference"},{"type":"text","text":", which provides independent control over fonts,"},{"type":"text","text":" "},{"type":"text","text":"colors, and the Liquid Glass policy. Customize the browser without affecting"},{"type":"text","text":" "},{"type":"text","text":"the rest of the reader by setting properties on"},{"type":"text","text":" "},{"code":"archiveConfig.readerConfig.browserConfig","type":"codeVoice"},{"type":"text","text":"."}]},{"level":2,"text":"Legacy Replica Reader","type":"heading","anchor":"Legacy-Replica-Reader"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using the legacy replica reader"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader","type":"reference","isActive":true},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":"), additional"},{"type":"text","text":" "},{"type":"text","text":"customization options are available through "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This includes navigation bar items, share templating, and legacy-specific"},{"type":"text","text":" "},{"type":"text","text":"icon overrides via "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyImageResourceName","type":"reference","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"PSReaderUI"}],"title":"Theming and Customization"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization"},"kind":"article","sections":[],"seeAlsoSections":[{"title":"Customization","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Localization"],"generated":true,"anchor":"Customization"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/theming-and-customization"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/theming-and-customization"]}],"abstract":[{"text":"Adjust fonts, colors, icons, and layouts to match your app’s brand.","type":"text"}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ReaderBrowserConfiguration":{"title":"ReaderBrowserConfiguration","type":"topic","url":"\/documentation\/psreaderui\/readerbrowserconfiguration","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReaderBrowserConfiguration","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"ReaderBrowserConfiguration","kind":"identifier"}],"abstract":[{"text":"Configuration object used to customize the appearance of the reader content browser.","type":"text"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderBrowserConfiguration","kind":"symbol"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ReaderNavigationBarConfiguration":{"url":"\/documentation\/psreaderui\/readernavigationbarconfiguration","type":"topic","title":"ReaderNavigationBarConfiguration","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ReaderNavigationBarConfiguration"}],"abstract":[{"text":"Configuration object for customizing reader navigation bars.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReaderNavigationBarConfiguration"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderNavigationBarConfiguration"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ArchiveConfiguration/cellAspectRatio":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration\/cellAspectRatio","url":"\/documentation\/psreaderui\/archiveconfiguration\/cellaspectratio","abstract":[{"text":"Aspect ratio for thumbnails representing editions in the archive view.","type":"text"}],"kind":"symbol","title":"cellAspectRatio","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cellAspectRatio","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV","kind":"typeIdentifier"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ImageContentMode/fitToHeight":{"abstract":[{"type":"text","text":"The image is scaled proportionally to fit the height of its container,"},{"type":"text","text":" "},{"type":"text","text":"potentially cropping horizontally."}],"kind":"symbol","url":"\/documentation\/psreaderui\/imagecontentmode\/fittoheight","type":"topic","role":"symbol","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/fitToHeight","title":"ImageContentMode.fitToHeight","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fitToHeight","kind":"identifier"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/