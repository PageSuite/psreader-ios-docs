{"seeAlsoSections":[{"generated":true,"anchor":"Customization","title":"Customization","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Localization"]}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/theming-and-customization"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/theming-and-customization"]}],"sections":[],"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Theming and Customization","role":"article","modules":[{"name":"PSReaderUI"}],"roleHeading":"Article"},"abstract":[{"type":"text","text":"Adjust fonts, colors, icons, and layouts to match your app’s brand."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"PSReaderUI is designed to be customized. The configuration system follows a"},{"type":"text","text":" "},{"type":"text","text":"cascading hierarchy: "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference","isActive":true},{"type":"text","text":" supplies default values that flow"},{"type":"text","text":" "},{"type":"text","text":"into "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration","type":"reference","isActive":true},{"type":"text","text":", and their sub-configurations. Override any value at"},{"type":"text","text":" "},{"type":"text","text":"any level to apply targeted changes."}],"type":"paragraph"},{"text":"Configuration Hierarchy","type":"heading","level":2,"anchor":"Configuration-Hierarchy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you create a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration","isActive":true},{"type":"text","text":", pass"},{"type":"text","text":" "},{"type":"text","text":"your "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true},{"type":"text","text":" to its initializer. The child configuration"},{"type":"text","text":" "},{"type":"text","text":"inherits the global fonts, brand color, delegates, and other settings. You"},{"type":"text","text":" "},{"type":"text","text":"can then override individual properties without affecting the rest:"}]},{"code":["let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID,","    primaryFont: UIFont(name: \"Georgia\", size: 12)!,","    secondaryFont: .systemFont(ofSize: 12),","    brandColor: .systemBlue",")","","var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.sectionRibbon.layout = .fillEqually","\/\/ brandColor, fonts, etc. are inherited from globalConfig"],"type":"codeListing","syntax":"swift"},{"text":"Fonts","type":"heading","level":2,"anchor":"Fonts"},{"type":"paragraph","inlineContent":[{"text":"Two font families control the SDK’s typography:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"primaryFont","type":"codeVoice"}]},{"type":"text","text":" — used for titles, headlines, publication names, and other"},{"type":"text","text":" "},{"type":"text","text":"prominent text. Set on "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/primaryFont","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"secondaryFont"}],"type":"strong"},{"type":"text","text":" — used for labels, dates, captions, and secondary UI"},{"type":"text","text":" "},{"type":"text","text":"elements. Set on "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/secondaryFont","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Individual components expose "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LabelConfiguration","isActive":true},{"type":"text","text":" properties that let you"},{"type":"text","text":" "},{"type":"text","text":"override the font, point size, and color for specific labels without changing"},{"type":"text","text":" "},{"type":"text","text":"the global fonts:"}]},{"code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.editionNameLabel = LabelConfiguration(","    font: UIFont(name: \"Georgia-Bold\", size: 14)!,","    pointSize: 14,","    color: .label",")"],"type":"codeListing","syntax":"swift"},{"text":"Brand Color","type":"heading","level":2,"anchor":"Brand-Color"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/brandColor","isActive":true,"type":"reference"},{"type":"text","text":" is used as an accent color throughout"},{"type":"text","text":" "},{"type":"text","text":"the SDK — in selection states, progress indicators, and interactive elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support both light and dark appearances, provide a dynamic color:"}]},{"syntax":"swift","type":"codeListing","code":["let brandColor = UIColor(dynamicProvider: {","    $0.userInterfaceStyle == .dark ? .white : .black","})"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or define the color in your asset catalog for automatic trait resolution."}]},{"text":"Thumbnail Content Mode","level":2,"type":"heading","anchor":"Thumbnail-Content-Mode"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode"},{"type":"text","text":" enum controls how edition thumbnails are sized and"},{"type":"text","text":" "},{"type":"text","text":"positioned within their containers across archive, bookmarks, downloads, and"},{"type":"text","text":" "},{"type":"text","text":"splash screens. This is one of the most impactful visual customization points"},{"type":"text","text":" "},{"type":"text","text":"— it determines the layout feel of your archive grid."}]},{"type":"paragraph","inlineContent":[{"text":"There are three modes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/fitToWidth"}],"type":"strong"},{"text":" — the image fills the container’s width","type":"text"},{"text":" ","type":"text"},{"text":"and is cropped vertically if the aspect ratio differs. This is the default","type":"text"},{"text":" ","type":"text"},{"text":"for archives, bookmarks, and downloads.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/fitToHeight","type":"reference","isActive":true}]},{"type":"text","text":" — the image fills the container’s"},{"type":"text","text":" "},{"type":"text","text":"height and is cropped horizontally if needed. This is the default for the"},{"type":"text","text":" "},{"type":"text","text":"reader splash screen."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/flexibleHeight(estimatedAspectRatio:)"}]},{"type":"text","text":" — the image"},{"type":"text","text":" "},{"type":"text","text":"fills the container’s width while the cell height adjusts dynamically to"},{"type":"text","text":" "},{"type":"text","text":"preserve the image’s natural aspect ratio. Provide an "},{"type":"codeVoice","code":"estimatedAspectRatio"},{"type":"text","text":" "},{"type":"text","text":"to stabilize layout during loading; the SDK refines it automatically once"},{"type":"text","text":" "},{"type":"text","text":"images arrive."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Set the content mode on any configuration that displays thumbnails:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","","\/\/ Fixed-height cells that crop vertically (default)","archiveConfig.thumbnailContentMode = .fitToWidth","","\/\/ Dynamic-height cells that show the full image","archiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)"]},{"type":"paragraph","inlineContent":[{"text":"Pair the content mode with ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration\/cellAspectRatio","isActive":true},{"text":" (or the","type":"text"},{"text":" ","type":"text"},{"text":"equivalent ","type":"text"},{"type":"codeVoice","code":"aspectRatio"},{"text":" on ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksConfiguration","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DownloadsConfiguration","isActive":true},{"type":"text","text":") to fine-tune the grid dimensions."}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageContentMode\/flexibleHeight(estimatedAspectRatio:)","isActive":true},{"type":"text","text":" is not"},{"type":"text","text":" "},{"type":"text","text":"supported in the bookmarks or downloads views."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"text":"Dark Mode","level":2,"type":"heading","anchor":"Dark-Mode"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK respects the system appearance by default. To force a specific style"},{"type":"text","text":" "},{"type":"text","text":"across the entire SDK, set "},{"code":"overrideUserInterfaceStyle","type":"codeVoice"},{"type":"text","text":" on the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["carouselVC.overrideUserInterfaceStyle = .dark"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This propagates to all child view controllers, including the reader, archive,"},{"type":"text","text":" "},{"type":"text","text":"bookmarks, and downloads views."}]},{"text":"Liquid Glass (iOS 26+)","level":2,"type":"heading","anchor":"Liquid-Glass-iOS-26+"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS 26 and later, the SDK adopts the Liquid Glass design language by"},{"type":"text","text":" "},{"type":"text","text":"default. The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LiquidGlassPolicy"},{"type":"text","text":" enum controls this behavior:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".automatic","type":"codeVoice"}],"type":"strong"},{"text":" (default) — uses Liquid Glass on iOS 26+ when supported.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".disabled"}]},{"type":"text","text":" — uses the standard appearance on all OS versions."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the policy globally or on specific configuration objects for granular"},{"type":"text","text":" "},{"type":"text","text":"control:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Disable globally","globalConfig.liquidGlassPolicy = .disabled","","\/\/ Or disable only on the subsection ribbon","carouselConfig.subsectionRibbon.liquidGlassPolicy = .disabled"]},{"type":"paragraph","inlineContent":[{"text":"The SDK also respects the host app’s ","type":"text"},{"code":"UIDesignRequiresCompatibility","type":"codeVoice"},{"text":" ","type":"text"},{"text":"Info.plist key and will fall back automatically when set.","type":"text"}]},{"text":"Custom Icons","level":2,"type":"heading","anchor":"Custom-Icons"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AssetDelegate"},{"type":"text","text":" to replace any of the SDK’s built-in icons with"},{"type":"text","text":" "},{"type":"text","text":"your own images. See the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ImageResourceName"},{"type":"text","text":" symbol page for the full list"},{"type":"text","text":" "},{"type":"text","text":"of icon identifiers and their usage context."}]},{"syntax":"swift","type":"codeListing","code":["struct MyAssetDelegate: PSReaderUI.AssetDelegate {","    func imageResource(for name: ImageResourceName) -> UIImage? {","        switch name {","        case .share:","            return UIImage(named: \"my-share-icon\")","        default:","            return name.defaultImage()","        }","    }","}","","globalConfig.assetDelegate = MyAssetDelegate()"]},{"type":"paragraph","inlineContent":[{"text":"For the legacy replica reader, override","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AssetDelegate\/legacyImageResource(for:)","isActive":true,"type":"reference"},{"text":" using ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyImageResourceName","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"identifiers.","type":"text"}]},{"text":"Placeholder Images","level":2,"type":"heading","anchor":"Placeholder-Images"},{"type":"paragraph","inlineContent":[{"text":"The SDK can use placeholder images when a thumbnail is unavailable — for","type":"text"},{"text":" ","type":"text"},{"text":"example, when an article has no associated image or a thumbnail fails to load.","type":"text"},{"text":" ","type":"text"},{"text":"By default the SDK shows a solid skeleton view (a grey box that adapts to","type":"text"},{"text":" ","type":"text"},{"text":"light and dark mode). Implement","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AssetDelegate\/placeholderImage(size:with:completion:)","type":"reference","isActive":true},{"text":" to provide a custom","type":"text"},{"text":" ","type":"text"},{"text":"placeholder instead:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct MyAssetDelegate: PSReaderUI.AssetDelegate {","    func placeholderImage(","        size: CGSize,","        with traits: UITraitCollection,","        completion: @escaping (UIImage?) -> Void","    ) {","        let name = traits.userInterfaceStyle == .dark","            ? \"placeholder-dark\"","            : \"placeholder-light\"","","        let image = UIImage(named: name)","        completion(image)","    }","}","","globalConfig.assetDelegate = MyAssetDelegate()"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" parameter reflects the thumbnail container’s dimensions, which you","type":"text"},{"text":" ","type":"text"},{"text":"can use to select or generate an appropriately sized image. The ","type":"text"},{"code":"traits","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter carries the current ","type":"text"},{"code":"UITraitCollection","type":"codeVoice"},{"text":" — use it to adapt to","type":"text"},{"text":" ","type":"text"},{"text":"light or dark mode via ","type":"text"},{"code":"userInterfaceStyle","type":"codeVoice"},{"text":", or to account for display scale,","type":"text"},{"text":" ","type":"text"},{"text":"size classes, and other environment traits.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" from the completion handler to keep the current placeholder"},{"type":"text","text":" "},{"type":"text","text":"presentation unchanged."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The asset delegate is inherited from "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true,"type":"reference"},{"type":"text","text":" by default. To"},{"type":"text","text":" "},{"type":"text","text":"use a different delegate specifically for bookmarks, set it directly on the"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksConfiguration\/assetDelegate","isActive":true,"type":"reference"},{"type":"text","text":" property."}]},{"text":"Date Formatting","level":2,"type":"heading","anchor":"Date-Formatting"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edition dates are formatted through the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EditionDateFormatter"},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"The SDK provides "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DefaultEditionDateFormatter"},{"type":"text","text":", which wraps a standard"},{"type":"text","text":" "},{"code":"DateFormatter","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let dateFormatter = DefaultEditionDateFormatter(","    dateFormat: \"d MMMM yyyy\",","    timeZone: .current",")","globalConfig.dateFormatter = dateFormatter"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your publications use custom names instead of dates, implement"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EditionDateFormatter","type":"reference","isActive":true},{"type":"text","text":" to return the appropriate label for each edition."}]},{"text":"Ribbon and Navigation Customization","level":2,"type":"heading","anchor":"Ribbon-and-Navigation-Customization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The carousel’s section and subsection ribbons are configurable via"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SectionRibbonConfiguration","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SubsectionRibbonConfiguration","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["carouselConfig.sectionRibbon.layout = .fillEqually  \/\/ or .fitLeft, .fitCenter","carouselConfig.subsectionRibbon.alignment = .center  \/\/ or .left"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reader navigation bar appearance is controlled through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderNavigationBarConfiguration","isActive":true},{"type":"text","text":" on the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.navigationBar.titleLabel.color = .label"]},{"text":"Content Browser","level":2,"type":"heading","anchor":"Content-Browser"},{"type":"paragraph","inlineContent":[{"text":"The reader’s content browser is the panel that lets users navigate between","type":"text"},{"text":" ","type":"text"},{"text":"sections, pages, and articles within an open edition. It is configured via","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderBrowserConfiguration","type":"reference"},{"text":", which provides independent control over fonts,","type":"text"},{"text":" ","type":"text"},{"text":"colors, and the Liquid Glass policy. Customize the browser without affecting","type":"text"},{"text":" ","type":"text"},{"text":"the rest of the reader by setting properties on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"archiv