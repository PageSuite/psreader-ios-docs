{"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By default the PSReaderUI SDK does ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" restrict access to any content.","type":"text"},{"text":" ","type":"text"},{"text":"Paywalls are entirely opt-in: you implement the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate"},{"text":" protocol,","type":"text"},{"text":" ","type":"text"},{"text":"provide view controllers that conform to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController"},{"text":", and assign","type":"text"},{"text":" ","type":"text"},{"text":"the delegate to your ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"text":".","type":"text"}]},{"type":"heading","text":"How It Works","level":2,"anchor":"How-It-Works"},{"type":"paragraph","inlineContent":[{"text":"When a user attempts to open an edition, download an edition, or tap a search","type":"text"},{"text":" ","type":"text"},{"text":"result, the SDK consults a paywall delegate. When the SDK finds a delegate, the flow is:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"User taps an edition to open or download it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK calls the relevant "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","type":"reference","isActive":true},{"type":"text","text":" method."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Your delegate returns a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController"},{"type":"text","text":" (or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to skip the paywall)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The SDK sets the ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" closure on your view controller and presents","type":"text"},{"text":" ","type":"text"},{"text":"it modally. Presentation style is controlled by your view controller —","type":"text"},{"text":" ","type":"text"},{"text":"the SDK does not set one.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK suspends the originating action and waits on "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"When the user finishes, your view controller dismisses itself and ","type":"text"},{"inlineContent":[{"type":"text","text":"then"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"invokes ","type":"text"},{"code":"onDismiss(true)","type":"codeVoice"},{"text":" to grant access or ","type":"text"},{"code":"onDismiss(false)","type":"codeVoice"},{"text":" to deny","type":"text"},{"text":" ","type":"text"},{"text":"it. The SDK resumes the suspended action with that decision.","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" a dismissal command — it is the"},{"type":"text","text":" "},{"type":"text","text":"continuation callback that tells the SDK whether to grant access. Your"},{"type":"text","text":" "},{"type":"text","text":"view controller owns its own dismissal: call "},{"type":"codeVoice","code":"dismiss(animated:)"},{"type":"text","text":" "},{"type":"text","text":"yourself, and make sure "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" is invoked exactly once when the"},{"type":"text","text":" "},{"type":"text","text":"paywall flow ends (including when the user dismisses the paywall"},{"type":"text","text":" "},{"type":"text","text":"interactively, e.g. by swiping a sheet down). See"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration#Dismissing-the-Paywall","type":"reference","isActive":true},{"type":"text","text":" below."}]}],"style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"text":"The delegate methods receive different model objects depending on the edition","type":"text"},{"text":" ","type":"text"},{"text":"type. Knowing their properties helps you make informed paywall decisions.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"PSEdition","type":"codeVoice"},{"text":" represents a replica (PDF) edition.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PSEPublished"},{"type":"text","text":" represents a feed edition."}]}]}]},{"type":"heading","text":"Creating a PaywallViewController","level":2,"anchor":"Creating-a-PaywallViewController"},{"type":"paragraph","inlineContent":[{"text":"Your paywall screen must conform to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController","type":"reference"},{"text":". The protocol","type":"text"},{"text":" ","type":"text"},{"text":"requires a single property — ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" — which the SDK sets before the view","type":"text"},{"text":" ","type":"text"},{"text":"controller is presented. Invoke it when the user completes or cancels the","type":"text"},{"text":" ","type":"text"},{"text":"paywall flow, passing ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" to grant access or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" to deny it.","type":"text"}]},{"type":"codeListing","code":["import PSReaderUI","","class MyPaywallScreen: UIViewController, PSReaderUI.PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    \/\/ Build your paywall UI...","","    @objc func userDidSubscribe() {","        dismiss(animated: true) {","            self.onDismiss?(true) \/\/ Grant access","        }","    }","","    @objc func userDidCancel() {","        dismiss(animated: true) {","            self.onDismiss?(false) \/\/ Deny access","        }","    }","}"],"syntax":"swift"},{"type":"aside","content":[{"inlineContent":[{"text":"Invoke ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"text":"exactly once","type":"text"}],"type":"strong"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"text":" dismissal completes.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important"},{"type":"heading","text":"Dismissing the Paywall","level":3,"anchor":"Dismissing-the-Paywall"},{"type":"paragraph","inlineContent":[{"text":"Your view controller is responsible for its own dismissal — the SDK presents","type":"text"},{"text":" ","type":"text"},{"text":"the paywall modally and leaves presentation style and dismissal entirely up","type":"text"},{"text":" ","type":"text"},{"text":"to you. If you use a presentation style that allows interactive dismissal","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. a sheet that can be swiped down), ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" needs to fire on that","type":"text"},{"text":" ","type":"text"},{"text":"path too, not only for dismissals triggered by your own UI. The cleanest","type":"text"},{"text":" ","type":"text"},{"text":"way to cover both is to centralize the callback in ","type":"text"},{"code":"viewDidDisappear(_:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["class MyPaywallScreen: UIViewController, PSReaderUI.PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    private var didGrantAccess = false","","    @objc func userDidSubscribe() {","        didGrantAccess = true","        dismiss(animated: true)","    }","","    @objc func userDidCancel() {","        dismiss(animated: true)","    }","","    \/\/ Catches dismissals triggered by your own UI and any interactive","    \/\/ dismissals (e.g. a sheet swiped down) in one place. Alternatively,","    \/\/ use UIAdaptivePresentationControllerDelegate.presentationControllerDidDismiss","    \/\/ to hook interactive dismissal explicitly and invoke onDismiss from","    \/\/ your own UI handlers instead.","    override func viewDidDisappear(_ animated: Bool) {","        super.viewDidDisappear(animated)","        guard isBeingDismissed else { return }","        onDismiss?(didGrantAccess)","        onDismiss = nil \/\/ Guard against double invocation","    }","}"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Calling ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"without"}]},{"text":" dismissing the view controller will","type":"text"},{"text":" ","type":"text"},{"text":"leave the paywall on screen even though the SDK has moved on. Conversely,","type":"text"},{"text":" ","type":"text"},{"text":"dismissing the view controller without invoking ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" will leave the","type":"text"},{"text":" ","type":"text"},{"text":"SDK waiting indefinitely.","type":"text"}]}],"style":"warning","name":"Warning"},{"type":"heading","text":"Implementing PaywallDelegate","level":2,"anchor":"Implementing-PaywallDelegate"},{"type":"paragraph","inlineContent":[{"text":"The delegate has five methods — two for opening editions, two for downloading","type":"text"},{"text":" ","type":"text"},{"text":"them, and one for search results:","type":"text"}]},{"type":"codeListing","code":["struct MyPaywallDelegate: PSReaderUI.PaywallDelegate {","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        downloadReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        \/\/ Default implementation delegates to openReplicaEdition.","        return paywallViewControllerForAction(openReplicaEdition: edition)","    }","","    func paywallViewControllerForAction(","        downloadFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        \/\/ Default implementation delegates to openFeedEdition.","        return paywallViewControllerForAction(openFeedEdition: published)","    }","","    func paywallViewControllerForAction(","        openSearchResult result: SearchResult","    ) -> PaywallViewController? {","        \/\/ Default implementation returns nil (no paywall).","        return nil","    }","}"],"syntax":"swift"},{"type":"aside","content":[{"inlineContent":[{"text":"The download methods have default implementations that delegate to the","type":"text"},{"text":" ","type":"text"},{"text":"corresponding open methods, and the search result method defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"You only need to override them if your paywall logic differs.","type":"text"}],"type":"paragraph"}],"style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that separate methods exist for replica and feed editions. See"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","type":"reference","isActive":true},{"type":"text","text":" for background on the two systems."}]},{"type":"heading","text":"Conditional Paywalls","level":3,"anchor":"Conditional-Paywalls"},{"type":"paragraph","inlineContent":[{"text":"Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" from any delegate method to skip the paywall for that edition.","type":"text"},{"text":" ","type":"text"},{"text":"This lets you implement conditional access logic:","type":"text"}]},{"type":"codeListing","code":["struct MyPaywallDelegate: PSReaderUI.PaywallDelegate {","","    let userIsSubscribed: Bool","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        \/\/ No paywall for subscribers","        if userIsSubscribed { return nil }","","        \/\/ No paywall for supplements","        if published.isSupplement { return nil }","","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        if userIsSubscribed { return nil }","        return MyPaywallScreen()","    }","}"],"syntax":"swift"},{"type":"heading","text":"Assigning the Delegate","level":2,"anchor":"Assigning-the-Delegate"},{"type":"heading","text":"Global Level","level":3,"anchor":"Global-Level"},{"type":"paragraph","inlineContent":[{"text":"Set the delegate on your ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"text":" to apply it across the entire","type":"text"},{"text":" ","type":"text"},{"text":"SDK. For most use cases, this is all you need.","type":"text"}]},{"type":"codeListing","code":["var globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","globalConfig.paywallDelegate = MyPaywallDelegate()"],"syntax":"swift"},{"type":"heading","text":"Carousel Level","level":3,"anchor":"Carousel-Level"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the delegate on a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","isActive":true},{"type":"text","text":" to override the global delegate"},{"type":"text","text":" "},{"type":"text","text":"for all sections within a specific carousel:"}]},{"type":"codeListing","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.paywallDelegate = MyCarouselPaywallDelegate()"],"syntax":"swift"},{"type":"heading","text":"Per-Section Level","level":3,"anchor":"Per-Section-Level"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the delegate on an "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration","isActive":true},{"type":"text","text":" to override the paywall for a"},{"type":"text","text":" "},{"type":"text","text":"single section. This is useful when different publications within the same"},{"type":"text","text":" "},{"type":"text","text":"carousel have different access rules:"}]},{"type":"codeListing","code":["var premiumArchiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","premiumArchiveConfig.paywallDelegate = PremiumPaywallDelegate()","","let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    \/\/ This section uses the per-section paywall","    .section(.init(","        name: \"Premium\",","        type: .feedArchive(guid: \"PREMIUM_GUID\", config: premiumArchiveConfig)","    )),","    \/\/ This section falls back to the global or carousel paywall","    .section(.init(","        name: \"Free\",","        type: .feedArchive(guid: \"FREE_GUID\")","    ))","]"],"syntax":"swift"},{"type":"heading","text":"Search Result Paywalls","level":2,"anchor":"Search-Result-Paywalls"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"openSearchResult"},{"type":"text","text":" method is called when a user taps a search result. By"},{"type":"text","text":" "},{"type":"text","text":"default it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", meaning search results open without a paywall."},{"type":"text","text":" "},{"type":"text","text":"Override it to restrict access:"}]},{"type":"codeListing","code":["func paywallViewControllerForAction(","    openSearchResult result: SearchResult",") -> PaywallViewController? {","    guard !subscriptionManager.isSubscribed else { return nil }","    return SubscriptionPaywall()","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"editionId"},{"type":"text","text":", "},{"type":"codeVoice","code":"publicationId"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationId"},{"type":"text","text":" properties that you can use to make per-publication or"},{"type":"text","text":" "},{"type":"text","text":"per-edition access decisions."}]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search","isActive":true,"type":"reference"},{"text":" for the full search integration guide.","type":"text"}]},{"type":"heading","text":"Open vs Download Paywalls","level":2,"anchor":"Open-vs-Download-Paywalls"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In most cases the same paywall applies to both actions. However, some"},{"type":"text","text":" "},{"type":"text","text":"publishers may want to allow free streaming while requiring a subscription to"},{"type":"text","text":" "},{"type":"text","text":"download."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The download delegate methods have default implementations that call through to"},{"type":"text","text":" "},{"type":"text","text":"the corresponding open methods. Override them to differentiate:"}]},{"type":"codeListing","code":["struct StreamingPaywallDelegate: PSReaderUI.PaywallDelegate {","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        \/\/ Free to open and read (streaming)","        return nil","    }","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        return nil","    }","","    func paywallViewControllerForAction(","        downloadReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        \/\/ Require subscription for offline downloads","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        downloadFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        return MyPaywallScreen()","    }","}"],"syntax":"swift"},{"type":"heading","text":"Troubleshooting","level":2,"anchor":"Troubleshooting"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Paywall stays on screen and the edition never opens"}],"type":"strong"},{"text":" ","type":"text"},{"text":"You dismissed the paywall but never invoked ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" (or never invoked","type":"text"},{"text":" ","type":"text"},{"text":"either). The SDK is suspended waiting on the callback — without it, the","type":"text"},{"text":" ","type":"text"},{"text":"originating action stays parked indefinitely. Make sure ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" fires","type":"text"},{"text":" ","type":"text"},{"text":"on every dismissal path, including interactive ones. The ","type":"text"},{"code":"viewDidDisappear","type":"codeVoice"},{"text":" ","type":"text"},{"text":"pattern shown in ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration#Dismissing-the-Paywall","isActive":true,"type":"reference"},{"text":" handles","type":"text"},{"text":" ","type":"text"},{"text":"all paths in one place.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Paywall reappears after the user closes the edition"}],"type":"strong"},{"text":" ","type":"text"},{"text":"You invoked ","type":"text"},{"code":"onDismiss(true)","type":"codeVoice"},{"text":" but didn’t call ","type":"text"},{"code":"dismiss(animated:)","type":"codeVoice"},{"text":". The SDK","type":"text"},{"text":" ","type":"text"},{"text":"uses ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" purely as the access-decision signal — it does not control","type":"text"},{"text":" ","type":"text"},{"text":"presentation. The paywall stays in the view hierarchy underneath the edition","type":"text"},{"text":" ","type":"text"},{"text":"reader and becomes visible again when the edition is closed. Dismiss your","type":"text"},{"text":" ","type":"text"},{"text":"view controller in addition to invoking ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Paywall and edition appear together, or the transition looks broken"}],"type":"strong"},{"text":" ","type":"text"},{"text":"You’re invoking ","type":"text"},{"code":"onDismiss(true)","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" the dismissal animation finishes.","type":"text"},{"text":" ","type":"text"},{"text":"The SDK resumes the originating action the moment the closure fires, so the","type":"text"},{"text":" ","type":"text"},{"text":"next view controller (e.g. the edition reader) tries to present while your","type":"text"},{"type":"text","text":" "},{"type":"text","text":"paywall is still on screen. Invoke "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" from the"},{"type":"text","text":" "},{"code":"dismiss(animated:completion:)","type":"codeVoice"},{"type":"text","text":" completion handler or from"},{"type":"text","text":" "},{"code":"viewDidDisappear(_:)","type":"codeVoice"},{"type":"text","text":" instead."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Wrong paywall appears for a section"}],"type":"strong"},{"text":" ","type":"text"},{"text":"Check the delegate cascade. A per-section delegate on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration","type":"reference"},{"text":" ","type":"text"},{"text":"takes priority over the carousel and global delegates. Verify which level your","type":"text"},{"text":" ","type":"text"},{"text":"delegate is assigned to and whether a more specific override exists.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Download always shows a paywall even though open is free","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"The default download methods delegate to the open methods. If your open method","type":"text"},{"text":" ","type":"text"},{"text":"returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" but downloads still show a paywall, you may have a separate","type":"text"},{"text":" ","type":"text"},{"text":"delegate assigned at a different cascade level that overrides the download","type":"text"},{"text":" ","type":"text"},{"text":"methods. Check all three levels.","type":"text"}]},{"type":"heading","text":"Complete Example","level":2,"anchor":"Complete-Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An end-to-end integration tying everything together:"}]},{"type":"codeListing","code":["import PSReaderUI","","\/\/ 1. Create a paywall view controller","class SubscriptionPaywall: UIViewController, PSReaderUI.PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    private var didGrantAccess = false","","    override func viewDidLoad() {","        super.viewDidLoad()","        \/\/ Set up your subscription UI...","    }","","    @objc func subscribe() {","        \/\/ Handle subscription logic, then grant access.","        didGrantAccess = true","        dismiss(animated: true)","    }","","    @objc func cancel() {","        dismiss(animated: true)","    }","","    \/\/ Catches dismissals triggered by your own UI and any interactive","    \/\/ dismissals (e.g. a sheet swiped down) in one place. Alternatively, use","    \/\/ UIAdaptivePresentationControllerDelegate.presentationControllerDidDismiss.","    override func viewDidDisappear(_ animated: Bool) {","        super.viewDidDisappear(animated)","        guard isBeingDismissed else { return }","        onDismiss?(didGrantAccess)","        onDismiss = nil","    }","}","","\/\/ 2. Implement the delegate","struct AppPaywallDelegate: PSReaderUI.PaywallDelegate {","","    let subscriptionManager: SubscriptionManager","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        guard !subscriptionManager.isSubscribed else { return nil }","        return SubscriptionPaywall()","    }","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        guard !subscriptionManager.isSubscribed else { return nil }","        if published.isSupplement {