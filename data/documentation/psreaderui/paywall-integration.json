{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By default the PSReaderUI SDK does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" restrict access to any content.","type":"text"},{"text":" ","type":"text"},{"text":"Paywalls are entirely opt-in: you implement the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","type":"reference"},{"text":" protocol,","type":"text"},{"text":" ","type":"text"},{"text":"provide view controllers that conform to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController","type":"reference"},{"text":", and assign","type":"text"},{"text":" ","type":"text"},{"text":"the delegate to your ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference","isActive":true},{"text":".","type":"text"}]},{"anchor":"How-It-Works","type":"heading","level":2,"text":"How It Works"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a user attempts to open an edition, download an edition, or tap a search"},{"type":"text","text":" "},{"type":"text","text":"result, the SDK consults a paywall delegate. When the SDK finds a delegate, the flow is:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"User taps an edition to open or download it.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The SDK calls the relevant "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate"},{"type":"text","text":" method."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your delegate returns a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController","type":"reference","isActive":true},{"type":"text","text":" (or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to skip the paywall)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK sets the "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" closure on your view controller and presents"},{"type":"text","text":" "},{"type":"text","text":"it modally. Presentation style is controlled by your view controller —"},{"type":"text","text":" "},{"type":"text","text":"the SDK does not set one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The SDK suspends the originating action and waits on ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user finishes, your view controller dismisses itself and "},{"type":"emphasis","inlineContent":[{"text":"then","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"invokes "},{"type":"codeVoice","code":"onDismiss(true)"},{"type":"text","text":" to grant access or "},{"type":"codeVoice","code":"onDismiss(false)"},{"type":"text","text":" to deny"},{"type":"text","text":" "},{"type":"text","text":"it. The SDK resumes the suspended action with that decision."}]}]}],"type":"orderedList"},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":""},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" a dismissal command — it is the"},{"type":"text","text":" "},{"type":"text","text":"continuation callback that tells the SDK whether to grant access. Your"},{"type":"text","text":" "},{"type":"text","text":"view controller owns its own dismissal: call "},{"code":"dismiss(animated:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"yourself, and make sure "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" is invoked exactly once when the"},{"type":"text","text":" "},{"type":"text","text":"paywall flow ends (including when the user dismisses the paywall"},{"type":"text","text":" "},{"type":"text","text":"interactively, e.g. by swiping a sheet down). See"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration#Dismissing-the-Paywall","isActive":true,"type":"reference"},{"type":"text","text":" below."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delegate methods receive different model objects depending on the edition"},{"type":"text","text":" "},{"type":"text","text":"type. Knowing their properties helps you make informed paywall decisions."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"PSEdition","type":"codeVoice"},{"text":" represents a replica (PDF) edition.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PSEPublished"},{"type":"text","text":" represents a feed edition."}]}]}],"type":"unorderedList"},{"anchor":"Creating-a-PaywallViewController","type":"heading","level":2,"text":"Creating a PaywallViewController"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your paywall screen must conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController"},{"type":"text","text":". The protocol"},{"type":"text","text":" "},{"type":"text","text":"requires a single property — "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" — which the SDK sets before the view"},{"type":"text","text":" "},{"type":"text","text":"controller is presented. Invoke it when the user completes or cancels the"},{"type":"text","text":" "},{"type":"text","text":"paywall flow, passing "},{"type":"codeVoice","code":"true"},{"type":"text","text":" to grant access or "},{"type":"codeVoice","code":"false"},{"type":"text","text":" to deny it."}]},{"type":"codeListing","code":["import PSReaderUI","","class MyPaywallScreen: UIViewController, PSReaderUI.PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    \/\/ Build your paywall UI...","","    @objc func userDidSubscribe() {","        dismiss(animated: true) {","            self.onDismiss?(true) \/\/ Grant access","        }","    }","","    @objc func userDidCancel() {","        dismiss(animated: true) {","            self.onDismiss?(false) \/\/ Deny access","        }","    }","}"],"syntax":"swift"},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Invoke "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"exactly once","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"type":"text","text":" dismissal completes."}],"type":"paragraph"}]},{"anchor":"Dismissing-the-Paywall","type":"heading","level":3,"text":"Dismissing the Paywall"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your view controller is responsible for its own dismissal — the SDK presents"},{"type":"text","text":" "},{"type":"text","text":"the paywall modally and leaves presentation style and dismissal entirely up"},{"type":"text","text":" "},{"type":"text","text":"to you. If you use a presentation style that allows interactive dismissal"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a sheet that can be swiped down), "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" needs to fire on that"},{"type":"text","text":" "},{"type":"text","text":"path too, not only for dismissals triggered by your own UI. The cleanest"},{"type":"text","text":" "},{"type":"text","text":"way to cover both is to centralize the callback in "},{"code":"viewDidDisappear(_:)","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["class MyPaywallScreen: UIViewController, PSReaderUI.PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    private var didGrantAccess = false","","    @objc func userDidSubscribe() {","        didGrantAccess = true","        dismiss(animated: true)","    }","","    @objc func userDidCancel() {","        dismiss(animated: true)","    }","","    \/\/ Catches dismissals triggered by your own UI and any interactive","    \/\/ dismissals (e.g. a sheet swiped down) in one place. Alternatively,","    \/\/ use UIAdaptivePresentationControllerDelegate.presentationControllerDidDismiss","    \/\/ to hook interactive dismissal explicitly and invoke onDismiss from","    \/\/ your own UI handlers instead.","    override func viewDidDisappear(_ animated: Bool) {","        super.viewDidDisappear(animated)","        guard isBeingDismissed else { return }","        onDismiss?(didGrantAccess)","        onDismiss = nil \/\/ Guard against double invocation","    }","}"],"syntax":"swift"},{"type":"aside","style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"without"}]},{"type":"text","text":" dismissing the view controller will"},{"type":"text","text":" "},{"type":"text","text":"leave the paywall on screen even though the SDK has moved on. Conversely,"},{"type":"text","text":" "},{"type":"text","text":"dismissing the view controller without invoking "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" will leave the"},{"type":"text","text":" "},{"type":"text","text":"SDK waiting indefinitely."}]}]},{"anchor":"Implementing-PaywallDelegate","type":"heading","level":2,"text":"Implementing PaywallDelegate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delegate has five methods — two for opening editions, two for downloading"},{"type":"text","text":" "},{"type":"text","text":"them, and one for search results:"}]},{"type":"codeListing","code":["struct MyPaywallDelegate: PSReaderUI.PaywallDelegate {","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        downloadReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        \/\/ Default implementation delegates to openReplicaEdition.","        return paywallViewControllerForAction(openReplicaEdition: edition)","    }","","    func paywallViewControllerForAction(","        downloadFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        \/\/ Default implementation delegates to openFeedEdition.","        return paywallViewControllerForAction(openFeedEdition: published)","    }","","    func paywallViewControllerForAction(","        openSearchResult result: SearchResult","    ) -> PaywallViewController? {","        \/\/ Default implementation returns nil (no paywall).","        return nil","    }","}"],"syntax":"swift"},{"type":"aside","style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"The download methods have default implementations that delegate to the"},{"type":"text","text":" "},{"type":"text","text":"corresponding open methods, and the search result method defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You only need to override them if your paywall logic differs."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Note that separate methods exist for replica and feed editions. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},{"text":" for background on the two systems.","type":"text"}]},{"anchor":"Conditional-Paywalls","type":"heading","level":3,"text":"Conditional Paywalls"},{"type":"paragraph","inlineContent":[{"text":"Return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" from any delegate method to skip the paywall for that edition.","type":"text"},{"text":" ","type":"text"},{"text":"This lets you implement conditional access logic:","type":"text"}]},{"type":"codeListing","code":["struct MyPaywallDelegate: PSReaderUI.PaywallDelegate {","","    let userIsSubscribed: Bool","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        \/\/ No paywall for subscribers","        if userIsSubscribed { return nil }","","        \/\/ No paywall for supplements","        if published.isSupplement { return nil }","","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        if userIsSubscribed { return nil }","        return MyPaywallScreen()","    }","}"],"syntax":"swift"},{"anchor":"Assigning-the-Delegate","type":"heading","level":2,"text":"Assigning the Delegate"},{"anchor":"Global-Level","type":"heading","level":3,"text":"Global Level"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the delegate on your "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"type":"text","text":" to apply it across the entire"},{"type":"text","text":" "},{"type":"text","text":"SDK. For most use cases, this is all you need."}]},{"type":"codeListing","code":["var globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","globalConfig.paywallDelegate = MyPaywallDelegate()"],"syntax":"swift"},{"anchor":"Carousel-Level","type":"heading","level":3,"text":"Carousel Level"},{"type":"paragraph","inlineContent":[{"text":"Set the delegate on a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","type":"reference","isActive":true},{"text":" to override the global delegate","type":"text"},{"text":" ","type":"text"},{"text":"for all sections within a specific carousel:","type":"text"}]},{"type":"codeListing","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.paywallDelegate = MyCarouselPaywallDelegate()"],"syntax":"swift"},{"anchor":"Per-Section-Level","type":"heading","level":3,"text":"Per-Section Level"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the delegate on an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration"},{"type":"text","text":" to override the paywall for a"},{"type":"text","text":" "},{"type":"text","text":"single section. This is useful when different publications within the same"},{"type":"text","text":" "},{"type":"text","text":"carousel have different access rules:"}]},{"type":"codeListing","code":["var premiumArchiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","premiumArchiveConfig.paywallDelegate = PremiumPaywallDelegate()","","let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    \/\/ This section uses the per-section paywall","    .section(.init(","        name: \"Premium\",","        type: .feedArchive(guid: \"PREMIUM_GUID\", config: premiumArchiveConfig)","    )),","    \/\/ This section falls back to the global or carousel paywall","    .section(.init(","        name: \"Free\",","        type: .feedArchive(guid: \"FREE_GUID\")","    ))","]"],"syntax":"swift"},{"anchor":"Search-Result-Paywalls","type":"heading","level":2,"text":"Search Result Paywalls"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"openSearchResult","type":"codeVoice"},{"text":" method is called when a user taps a search result. By","type":"text"},{"text":" ","type":"text"},{"text":"default it returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", meaning search results open without a paywall.","type":"text"},{"text":" ","type":"text"},{"text":"Override it to restrict access:","type":"text"}]},{"type":"codeListing","code":["func paywallViewControllerForAction(","    openSearchResult result: SearchResult",") -> PaywallViewController? {","    guard !subscriptionManager.isSubscribed else { return nil }","    return SubscriptionPaywall()","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult","isActive":true,"type":"reference"},{"type":"text","text":" provides "},{"code":"editionId","type":"codeVoice"},{"type":"text","text":", "},{"code":"publicationId","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"applicationId","type":"codeVoice"},{"type":"text","text":" properties that you can use to make per-publication or"},{"type":"text","text":" "},{"type":"text","text":"per-edition access decisions."}]},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search","type":"reference","isActive":true},{"type":"text","text":" for the full search integration guide."}],"type":"paragraph"},{"anchor":"Open-vs-Download-Paywalls","text":"Open vs Download Paywalls","level":2,"type":"heading"},{"inlineContent":[{"text":"In most cases the same paywall applies to both actions. However, some","type":"text"},{"text":" ","type":"text"},{"text":"publishers may want to allow free streaming while requiring a subscription to","type":"text"},{"text":" ","type":"text"},{"text":"download.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The download delegate methods have default implementations that call through to","type":"text"},{"text":" ","type":"text"},{"text":"the corresponding open methods. Override them to differentiate:","type":"text"}],"type":"paragraph"},{"code":["struct StreamingPaywallDelegate: PSReaderUI.PaywallDelegate {","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        \/\/ Free to open and read (streaming)","        return nil","    }","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        return nil","    }","","    func paywallViewControllerForAction(","        downloadReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        \/\/ Require subscription for offline downloads","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        downloadFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        return MyPaywallScreen()","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Troubleshooting","text":"Troubleshooting","level":2,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Paywall stays on screen and the edition never opens"}]},{"text":" ","type":"text"},{"text":"You dismissed the paywall but never invoked ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" (or never invoked","type":"text"},{"text":" ","type":"text"},{"text":"either). The SDK is suspended waiting on the callback — without it, the","type":"text"},{"text":" ","type":"text"},{"text":"originating action stays parked indefinitely. Make sure ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" fires","type":"text"},{"text":" ","type":"text"},{"text":"on every dismissal path, including interactive ones. The ","type":"text"},{"code":"viewDidDisappear","type":"codeVoice"},{"text":" ","type":"text"},{"text":"pattern shown in ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration#Dismissing-the-Paywall","type":"reference","isActive":true},{"text":" handles","type":"text"},{"text":" ","type":"text"},{"text":"all paths in one place.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Paywall reappears after the user closes the edition"}],"type":"strong"},{"text":" ","type":"text"},{"text":"You invoked ","type":"text"},{"code":"onDismiss(true)","type":"codeVoice"},{"text":" but didn’t call ","type":"text"},{"code":"dismiss(animated:)","type":"codeVoice"},{"text":". The SDK","type":"text"},{"text":" ","type":"text"},{"text":"uses ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" purely as the access-decision signal — it does not control","type":"text"},{"type":"text","text":" "},{"type":"text","text":"presentation. The paywall stays in the view hierarchy underneath the edition"},{"type":"text","text":" "},{"type":"text","text":"reader and becomes visible again when the edition is closed. Dismiss your"},{"type":"text","text":" "},{"type":"text","text":"view controller in addition to invoking "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Paywall and edition appear together, or the transition looks broken","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"You’re invoking ","type":"text"},{"code":"onDismiss(true)","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" the dismissal animation finishes.","type":"text"},{"text":" ","type":"text"},{"text":"The SDK resumes the originating action the moment the closure fires, so the","type":"text"},{"text":" ","type":"text"},{"text":"next view controller (e.g. the edition reader) tries to present while your","type":"text"},{"type":"text","text":" "},{"type":"text","text":"paywall is still on screen. Invoke "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" from the"},{"type":"text","text":" "},{"type":"codeVoice","code":"dismiss(animated:completion:)"},{"type":"text","text":" completion handler or from"},{"type":"text","text":" "},{"type":"codeVoice","code":"viewDidDisappear(_:)"},{"type":"text","text":" instead."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wrong paywall appears for a section"}]},{"type":"text","text":" "},{"type":"text","text":"Check the delegate cascade. A per-section delegate on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration"},{"type":"text","text":" "},{"type":"text","text":"takes priority over the carousel and global delegates. Verify which level your"},{"type":"text","text":" "},{"type":"text","text":"delegate is assigned to and whether a more specific override exists."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Download always shows a paywall even though open is free"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"The default download methods delegate to the open methods. If your open method"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" but downloads still show a paywall, you may have a separate"},{"type":"text","text":" "},{"type":"text","text":"delegate assigned at a different cascade level that overrides the download"},{"type":"text","text":" "},{"type":"text","text":"methods. Check all three levels."}]},{"type":"heading","anchor":"Complete-Example","text":"Complete Example","level":2},{"type":"paragraph","inlineContent":[{"text":"An end-to-end integration tying everything together:","type":"text"}]},{"code":["import PSReaderUI","","\/\/ 1. Create a paywall view controller","class SubscriptionPaywall: UIViewController, PSReaderUI.PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    private var didGrantAccess = false","","    override func viewDidLoad() {","        super.viewDidLoad()","        \/\/ Set up your subscription UI...","    }","","    @objc func subscribe() {","        \/\/ Handle subscription logic, then grant access.","        didGrantAccess = true","        dismiss(animated: true)","    }","","    @objc func cancel() {","        dismiss(animated: true)","    }","","    \/\/ Catches dismissals triggered by your own UI and any interactive","    \/\/ dismissals (e.g. a sheet swiped down) in one place. Alternatively, use","    \/\/ UIAdaptivePresentationControllerDelegate.presentationControllerDidDismiss.","    override func viewDidDisappear(_ animated: Bool) {","        super.viewDidDisappear(animated)","        guard isBeingDismissed else { return }","        onDismiss?(didGrantAccess)","        onDismiss = nil","    }","}","","\/\/ 2. Implement the delegate","struct AppPaywallDelegate: PSReaderUI.PaywallDelegate {","","    let subscriptionManager: SubscriptionManager","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        guard !subscriptionManager.isSubscribed else { return nil }","        return SubscriptionPaywall()","    }","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        guard !subscriptionManager.isSubscribed else { return nil }","        if published.isSupplement { return nil }","        return SubscriptionPaywall()","    }","}","","\/\/ 3. Assign to the global configuration","var globalConfig = PSReaderUI.GlobalCo