{"sections":[],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Paywall Integration","modules":[{"name":"PSReaderUI"}]},"abstract":[{"text":"Restrict access to premium content with custom paywall screens.","type":"text"}],"seeAlsoSections":[{"title":"Features","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Deep-Linking","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Commenting","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Media-Playback","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"],"generated":true,"anchor":"Features"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"variants":[{"paths":["\/documentation\/psreaderui\/paywall-integration"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/paywall-integration"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"By default the PSReaderUI SDK does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" restrict access to any content.","type":"text"},{"text":" ","type":"text"},{"text":"Paywalls are entirely opt-in: you implement the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","type":"reference","isActive":true},{"text":" protocol,","type":"text"},{"text":" ","type":"text"},{"text":"provide view controllers that conform to ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController","type":"reference","isActive":true},{"text":", and assign","type":"text"},{"text":" ","type":"text"},{"text":"the delegate to your ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"How-It-Works","type":"heading","text":"How It Works","level":2},{"inlineContent":[{"text":"When a user attempts to open an edition, download an edition, or tap a search","type":"text"},{"text":" ","type":"text"},{"text":"result, the SDK consults a paywall delegate. When the SDK finds a delegate, the flow is:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"User taps an edition to open or download it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The SDK calls the relevant "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","isActive":true},{"type":"text","text":" method."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your delegate returns a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController","isActive":true},{"type":"text","text":" (or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to skip the paywall)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The SDK sets the "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" closure on your view controller and presents"},{"type":"text","text":" "},{"type":"text","text":"it modally. Presentation style is controlled by your view controller —"},{"type":"text","text":" "},{"type":"text","text":"the SDK does not set one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The SDK suspends the originating action and waits on ","type":"text"},{"type":"codeVoice","code":"onDismiss"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When the user finishes, your view controller dismisses itself and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"then"}]},{"type":"text","text":" "},{"type":"text","text":"invokes "},{"type":"codeVoice","code":"onDismiss(true)"},{"type":"text","text":" to grant access or "},{"type":"codeVoice","code":"onDismiss(false)"},{"type":"text","text":" to deny"},{"type":"text","text":" "},{"type":"text","text":"it. The SDK resumes the suspended action with that decision."}],"type":"paragraph"}]}],"type":"orderedList"},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a dismissal command — it is the"},{"type":"text","text":" "},{"type":"text","text":"continuation callback that tells the SDK whether to grant access. Your"},{"type":"text","text":" "},{"type":"text","text":"view controller owns its own dismissal: call "},{"code":"dismiss(animated:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"yourself, and make sure "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":" is invoked exactly once when the"},{"type":"text","text":" "},{"type":"text","text":"paywall flow ends (including when the user dismisses the paywall"},{"type":"text","text":" "},{"type":"text","text":"interactively, e.g. by swiping a sheet down). See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration#Dismissing-the-Paywall","isActive":true},{"type":"text","text":" below."}]}]},{"inlineContent":[{"text":"The delegate methods receive different model objects depending on the edition","type":"text"},{"text":" ","type":"text"},{"text":"type. Knowing their properties helps you make informed paywall decisions.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"PSEdition","type":"codeVoice"},{"type":"text","text":" represents a replica (PDF) edition."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"PSEPublished","type":"codeVoice"},{"text":" represents a feed edition.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Creating-a-PaywallViewController","type":"heading","text":"Creating a PaywallViewController","level":2},{"inlineContent":[{"type":"text","text":"Your paywall screen must conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController"},{"type":"text","text":". The protocol"},{"type":"text","text":" "},{"type":"text","text":"requires a single property — "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" — which the SDK sets before the view"},{"type":"text","text":" "},{"type":"text","text":"controller is presented. Invoke it when the user completes or cancels the"},{"type":"text","text":" "},{"type":"text","text":"paywall flow, passing "},{"type":"codeVoice","code":"true"},{"type":"text","text":" to grant access or "},{"type":"codeVoice","code":"false"},{"type":"text","text":" to deny it."}],"type":"paragraph"},{"code":["import PSReaderUI","","class MyPaywallScreen: UIViewController, PSReaderUI.PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    \/\/ Build your paywall UI...","","    @objc func userDidSubscribe() {","        dismiss(animated: true) {","            self.onDismiss?(true) \/\/ Grant access","        }","    }","","    @objc func userDidCancel() {","        dismiss(animated: true) {","            self.onDismiss?(false) \/\/ Deny access","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Invoke ","type":"text"},{"code":"onDismiss","type":"codeVoice"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"exactly once"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"text":" dismissal completes.","type":"text"}]}]},{"anchor":"Dismissing-the-Paywall","type":"heading","text":"Dismissing the Paywall","level":3},{"inlineContent":[{"type":"text","text":"Your view controller is responsible for its own dismissal — the SDK presents"},{"type":"text","text":" "},{"type":"text","text":"the paywall modally and leaves presentation style and dismissal entirely up"},{"type":"text","text":" "},{"type":"text","text":"to you. If you use a presentation style that allows interactive dismissal"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a sheet that can be swiped down), "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" needs to fire on that"},{"type":"text","text":" "},{"type":"text","text":"path too, not only for dismissals triggered by your own UI. The cleanest"},{"type":"text","text":" "},{"type":"text","text":"way to cover both is to centralize the callback in "},{"type":"codeVoice","code":"viewDidDisappear(_:)"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["class MyPaywallScreen: UIViewController, PSReaderUI.PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    private var didGrantAccess = false","","    @objc func userDidSubscribe() {","        didGrantAccess = true","        dismiss(animated: true)","    }","","    @objc func userDidCancel() {","        dismiss(animated: true)","    }","","    \/\/ Catches dismissals triggered by your own UI and any interactive","    \/\/ dismissals (e.g. a sheet swiped down) in one place. Alternatively,","    \/\/ use UIAdaptivePresentationControllerDelegate.presentationControllerDidDismiss","    \/\/ to hook interactive dismissal explicitly and invoke onDismiss from","    \/\/ your own UI handlers instead.","    override func viewDidDisappear(_ animated: Bool) {","        super.viewDidDisappear(animated)","        guard isBeingDismissed else { return }","        onDismiss?(didGrantAccess)","        onDismiss = nil \/\/ Guard against double invocation","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"warning","name":"Warning","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"without"}],"type":"emphasis"},{"type":"text","text":" dismissing the view controller will"},{"type":"text","text":" "},{"type":"text","text":"leave the paywall on screen even though the SDK has moved on. Conversely,"},{"type":"text","text":" "},{"type":"text","text":"dismissing the view controller without invoking "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" will leave the"},{"type":"text","text":" "},{"type":"text","text":"SDK waiting indefinitely."}]}]},{"anchor":"Implementing-PaywallDelegate","type":"heading","text":"Implementing PaywallDelegate","level":2},{"inlineContent":[{"type":"text","text":"The delegate has five methods — two for opening editions, two for downloading"},{"type":"text","text":" "},{"type":"text","text":"them, and one for search results:"}],"type":"paragraph"},{"code":["struct MyPaywallDelegate: PSReaderUI.PaywallDelegate {","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        downloadReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        \/\/ Default implementation delegates to openReplicaEdition.","        return paywallViewControllerForAction(openReplicaEdition: edition)","    }","","    func paywallViewControllerForAction(","        downloadFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        \/\/ Default implementation delegates to openFeedEdition.","        return paywallViewControllerForAction(openFeedEdition: published)","    }","","    func paywallViewControllerForAction(","        openSearchResult result: SearchResult","    ) -> PaywallViewController? {","        \/\/ Default implementation returns nil (no paywall).","        return nil","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The download methods have default implementations that delegate to the"},{"type":"text","text":" "},{"type":"text","text":"corresponding open methods, and the search result method defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You only need to override them if your paywall logic differs."}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"Note that separate methods exist for replica and feed editions. See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","isActive":true},{"type":"text","text":" for background on the two systems."}],"type":"paragraph"},{"anchor":"Conditional-Paywalls","type":"heading","text":"Conditional Paywalls","level":3},{"inlineContent":[{"text":"Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" from any delegate method to skip the paywall for that edition.","type":"text"},{"text":" ","type":"text"},{"text":"This lets you implement conditional access logic:","type":"text"}],"type":"paragraph"},{"code":["struct MyPaywallDelegate: PSReaderUI.PaywallDelegate {","","    let userIsSubscribed: Bool","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        \/\/ No paywall for subscribers","        if userIsSubscribed { return nil }","","        \/\/ No paywall for supplements","        if published.isSupplement { return nil }","","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        if userIsSubscribed { return nil }","        return MyPaywallScreen()","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Assigning-the-Delegate","type":"heading","text":"Assigning the Delegate","level":2},{"anchor":"Global-Level","type":"heading","text":"Global Level","level":3},{"inlineContent":[{"type":"text","text":"Set the delegate on your "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"type":"text","text":" to apply it across the entire"},{"type":"text","text":" "},{"type":"text","text":"SDK. For most use cases, this is all you need."}],"type":"paragraph"},{"code":["var globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","globalConfig.paywallDelegate = MyPaywallDelegate()"],"syntax":"swift","type":"codeListing"},{"anchor":"Carousel-Level","type":"heading","text":"Carousel Level","level":3},{"inlineContent":[{"text":"Set the delegate on a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","isActive":true},{"text":" to override the global delegate","type":"text"},{"text":" ","type":"text"},{"text":"for all sections within a specific carousel:","type":"text"}],"type":"paragraph"},{"code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.paywallDelegate = MyCarouselPaywallDelegate()"],"syntax":"swift","type":"codeListing"},{"anchor":"Per-Section-Level","type":"heading","text":"Per-Section Level","level":3},{"inlineContent":[{"type":"text","text":"Set the delegate on an "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration","isActive":true},{"type":"text","text":" to override the paywall for a"},{"type":"text","text":" "},{"type":"text","text":"single section. This is useful when different publications within the same"},{"type":"text","text":" "},{"type":"text","text":"carousel have different access rules:"}],"type":"paragraph"},{"code":["var premiumArchiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","premiumArchiveConfig.paywallDelegate = PremiumPaywallDelegate()","","let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    \/\/ This section uses the per-section paywall","    .section(.init(","        name: \"Premium\",","        type: .feedArchive(guid: \"PREMIUM_GUID\", config: premiumArchiveConfig)","    )),","    \/\/ This section falls back to the global or carousel paywall","    .section(.init(","        name: \"Free\",","        type: .feedArchive(guid: \"FREE_GUID\")","    ))","]"],"syntax":"swift","type":"codeListing"},{"anchor":"Search-Result-Paywalls","type":"heading","text":"Search Result Paywalls","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"openSearchResult"},{"type":"text","text":" method is called when a user taps a search result. By"},{"type":"text","text":" "},{"type":"text","text":"default it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", meaning search results open without a paywall."},{"type":"text","text":" "},{"type":"text","text":"Override it to restrict access:"}],"type":"paragraph"},{"code":["func paywallViewControllerForAction(","    openSearchResult result: SearchResult",") -> PaywallViewController? {","    guard !subscriptionManager.isSubscribed else { return nil }","    return SubscriptionPaywall()","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult","type":"reference","isActive":true},{"text":" provides ","type":"text"},{"code":"editionId","type":"codeVoice"},{"text":", ","type":"text"},{"code":"publicationId","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"applicationId","type":"codeVoice"},{"text":" properties that you can use to make per-publication or","type":"text"},{"text":" ","type":"text"},{"text":"per-edition access decisions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"},{"type":"text","text":" for the full search integration guide."}],"type":"paragraph"},{"anchor":"Open-vs-Download-Paywalls","type":"heading","text":"Open vs Download Paywalls","level":2},{"inlineContent":[{"type":"text","text":"In most cases the same paywall applies to both actions. However, some"},{"type":"text","text":" "},{"type":"text","text":"publishers may want to allow free streaming while requiring a subscription to"},{"type":"text","text":" "},{"type":"text","text":"download."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The download delegate methods have default implementations that call through to"},{"type":"text","text":" "},{"type":"text","text":"the corresponding open methods. Override them to differentiate:"}],"type":"paragraph"},{"code":["struct StreamingPaywallDelegate: PSReaderUI.PaywallDelegate {","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        \/\/ Free to open and read (streaming)","        return nil","    }","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        return nil","    }","","    func paywallViewControllerForAction(","        downloadReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        \/\/ Require subscription for offline downloads","        return MyPaywallScreen()","    }","","    func paywallViewControllerForAction(","        downloadFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        return MyPaywallScreen()","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Troubleshooting","type":"heading","text":"Troubleshooting","level":2},{"inlineContent":[{"inlineContent":[{"text":"Paywall stays on screen and the edition never opens","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"You dismissed the paywall but never invoked ","type":"text"},{"type":"codeVoice","code":"onDismiss"},{"text":" (or never invoked","type":"text"},{"text":" ","type":"text"},{"text":"either). The SDK is suspended waiting on the callback — without it, the","type":"text"},{"text":" ","type":"text"},{"text":"originating action stays parked indefinitely. Make sure ","type":"text"},{"type":"codeVoice","code":"onDismiss"},{"text":" fires","type":"text"},{"text":" ","type":"text"},{"text":"on every dismissal path, including interactive ones. The ","type":"text"},{"type":"codeVoice","code":"viewDidDisappear"},{"text":" ","type":"text"},{"text":"pattern shown in ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration#Dismissing-the-Paywall","isActive":true},{"text":" handles","type":"text"},{"text":" ","type":"text"},{"text":"all paths in one place.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Paywall reappears after the user closes the edition"}]},{"type":"text","text":" "},{"type":"text","text":"You invoked "},{"type":"codeVoice","code":"onDismiss(true)"},{"type":"text","text":" but didn’t call "},{"type":"codeVoice","code":"dismiss(animated:)"},{"type":"text","text":". The SDK"},{"type":"text","text":" "},{"type":"text","text":"uses "},{"type":"codeVoice","code":"onDismiss"},{"type":"text","text":" purely as the access-decision signal — it does not control"},{"type":"text","text":" "},{"type":"text","text":"presentation. The paywall stays in the view hierarchy underneath the edition"},{"type":"text","text":" "},{"type":"text","text":"reader and becomes visible again when the edition is closed. Dismiss your"},{"type":"text","text":" "},{"type":"text","text":"view controller in addition to invoking "},{"code":"onDismiss","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Paywall and edition appear together, or the transition looks broken"}]},{"type":"text","text":" "},{"type":"text","text":"You’re invoking "},{"type":"codeVoice","code":"onDismiss(true)"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the dismissal animation finishes."},{"type":"text","text":" "},{"type":"text","text":"The SDK resumes the originating action the moment the closure fires, so the"},{"type":"text","text":" "},{"type":"text","text":"next view controller (e.g. the edition reader) tries to present while your"},{"text":" ","type":"text"},{"text":"paywall is still on screen. Invoke ","type":"text"},{"type":"codeVoice","code":"onDismiss"},{"text":" from the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dismiss(animated:completion:)"},{"text":" completion handler or from","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"viewDidDisappear(_:)"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wrong paywall appears for a section"}]},{"type":"text","text":" "},{"type":"text","text":"Check the delegate cascade. A per-section delegate on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration"},{"type":"text","text":" "},{"type":"text","text":"takes priority over the carousel and global delegates. Verify which level your"},{"type":"text","text":" "},{"type":"text","text":"delegate is assigned to and whether a more specific override exists."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Download always shows a paywall even though open is free","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"The default download methods delegate to the open methods. If your open method"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" but downloads still show a paywall, you may have a separate"},{"type":"text","text":" "},{"type":"text","text":"delegate assigned at a different cascade level that overrides the download"},{"type":"text","text":" "},{"type":"text","text":"methods. Check all three levels."}],"type":"paragraph"},{"anchor":"Complete-Example","type":"heading","text":"Complete Example","level":2},{"inlineContent":[{"type":"text","text":"An end-to-end integration tying everything together:"}],"type":"paragraph"},{"code":["import PSReaderUI","","\/\/ 1. Create a paywall view controller","class SubscriptionPaywall: UIViewController, PSReaderUI.PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    private var didGrantAccess = false","","    override func viewDidLoad() {","        super.viewDidLoad()","        \/\/ Set up your subscription UI...","    }","","    @objc func subscribe() {","        \/\/ Handle subscription logic, then grant access.","        didGrantAccess = true","        dismiss(animated: true)","    }","","    @objc func cancel() {","        dismiss(animated: true)","    }","","    \/\/ Catches dismissals triggered by your own UI and any interactive","    \/\/ dismissals (e.g. a sheet swiped down) in one place. Alternatively, use","    \/\/ UIAdaptivePresentationControllerDelegate.presentationControllerDidDismiss.","    override func viewDidDisappear(_ animated: Bool) {","        super.viewDidDisappear(animated)","        guard isBeingDismissed else { return }","        onDismiss?(didGrantAccess)","        onDismiss = nil","    }","}","","\/\/ 2. Implement the delegate","struct AppPaywallDelegate: PSReaderUI.PaywallDelegate {","","    let subscriptionManager: SubscriptionManager","","    func paywallViewControllerForAction(","        openReplicaEdition edition: PSEdition","    ) -> PaywallViewController? {","        guard !subscriptionManager.isSubscribed else { return nil }","        return SubscriptionPaywall()","    }","","    func paywallViewControllerForAction(","        openFeedEdition published: PSEPublished","    ) -> PaywallViewController? {","        guard !subscriptionManager.isSubscribed else { return nil }","        if published.isSupplement { return nil }","        return SubscriptionPaywall()","    }","}","","\/\/ 3. Assign to the global configuration","var globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: \"YOUR_API_KEY\",","    accountGUID: \"YOUR_ACCOUNT_GUID\"",")","globalConfig.paywallDelegate = AppPaywallDelegate(","    subscriptionManager: mySubscriptionManager",")","","\/\/ 4. Create and present the carousel","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","    ]",")"],"syntax":"swift","type":"codeListing"}]}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Commenting":{"title":"Commenting","type":"topic","url":"\/documentation\/psreaderui\/commenting","kind":"article","abstract":[{"text":"Add comment counts, comment buttons, and commenting integration to the reader.","type":"text"}],"role":"article","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Commenting"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/CarouselConfiguration":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","kind":"symbol","role":"symbol","abstract":[{"text":"Configuration object for customizing the PSReaderUI carousel interface.","type":"text"}],"url":"\/documentation\/psreaderui\/carouselconfiguration","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CarouselConfiguration","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"CarouselConfiguration","kind":"identifier"}],"title":"CarouselConfiguration"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Text-to-Speech":{"role":"article","title":"Text-to-Speech","abstract":[{"text":"Add audio playback of article content using the SDK’s text-to-speech system.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","url":"\/documentation\/psreaderui\/text-to-speech"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/GlobalConfiguration":{"title":"GlobalConfiguration","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GlobalConfiguration"}],"url":"\/documentation\/psreaderui\/globalconfiguration","kind":"symbol","abstract":[{"text":"A configuration object that provides global settings and delegates for","type":"text"},{"text":" ","type":"text"},{"text":"customizing the SDK’s behavior and appearance.","type":"text"}],"navigatorTitle":[{"text":"GlobalConfiguration","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documen