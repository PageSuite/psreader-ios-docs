{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The PSReaderUI SDK does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" bundle a video player. To enable video"},{"type":"text","text":" "},{"type":"text","text":"playback for media embedded in editions, implement the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/MediaDelegate","isActive":true},{"type":"text","text":" "},{"type":"text","text":"protocol and provide your own player view controller."}],"type":"paragraph"},{"text":"Protocol Methods","anchor":"Protocol-Methods","level":2,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/MediaDelegate"},{"text":" protocol defines two methods:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/MediaDelegate\/videoViewController(for:presentingFrom:)","type":"reference","isActive":true},{"type":"text","text":" — returns a view"},{"type":"text","text":" "},{"type":"text","text":"controller for video playback, which the SDK embeds in its media gallery UI."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/MediaDelegate\/pdfMediaOverlay(for:in:superview:)","type":"reference"},{"text":" — returns a media","type":"text"},{"text":" ","type":"text"},{"text":"overlay for embedded media objects within replica edition PDF pages.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Both methods return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" by default, meaning media is not played unless you"},{"type":"text","text":" "},{"type":"text","text":"provide an implementation."}],"type":"paragraph"},{"text":"Example","anchor":"Example","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A minimal implementation using "},{"type":"codeVoice","code":"AVPlayerViewController"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import AVKit","import PSReaderUI","","struct MyMediaDelegate: PSReaderUI.MediaDelegate {","    func videoViewController(","        for video: PSEVideo,","        presentingFrom: UIViewController","    ) -> UIViewController? {","        guard let url = video.url else { return nil }","","        let player = AVPlayer(url: url)","        let playerVC = AVPlayerViewController()","        playerVC.player = player","        return playerVC","    }","}"]},{"text":"PDF Media Overlay","anchor":"PDF-Media-Overlay","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"To handle media objects embedded directly in replica edition PDF pages (such as"},{"type":"text","text":" "},{"type":"text","text":"inline videos or interactive elements), implement "},{"type":"codeVoice","code":"pdfMediaOverlay"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyMediaDelegate: PSReaderUI.MediaDelegate {","    func videoViewController(","        for video: PSEVideo,","        presentingFrom: UIViewController","    ) -> UIViewController? {","        guard let url = video.url else { return nil }","","        let player = AVPlayer(url: url)","        let playerVC = AVPlayerViewController()","        playerVC.player = player","        return playerVC","    }","","    func pdfMediaOverlay(","        for mediaObject: PSEMediaObject,","        in page: PSEPage,","        superview: UIView","    ) -> PSEMediaOverlay? {","        \/\/ Return a media overlay for the embedded object, or nil to skip","        return nil","    }","}"]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"The SDK supports video media objects embedded in PDF pages. Audio and"},{"type":"text","text":" "},{"type":"text","text":"interactive media types are passed through the same delegate methods —"},{"type":"text","text":" "},{"type":"text","text":"inspect the "},{"type":"codeVoice","code":"PSEMediaObject"},{"type":"text","text":" properties to determine the media type and"},{"type":"text","text":" "},{"type":"text","text":"handle accordingly."}],"type":"paragraph"}],"type":"aside","style":"note"},{"text":"Assigning the Delegate","anchor":"Assigning-the-Delegate","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Set the delegate on your "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["globalConfig.mediaDelegate = MyMediaDelegate()"]},{"inlineContent":[{"text":"The delegate is inherited by all reader configurations created from the","type":"text"},{"text":" ","type":"text"},{"text":"global configuration.","type":"text"}],"type":"paragraph"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Media-Playback"},"abstract":[{"type":"text","text":"Enable video and media playback within the reader."}],"metadata":{"roleHeading":"Article","role":"article","title":"Media Playback","modules":[{"name":"PSReaderUI"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"seeAlsoSections":[{"title":"Features","generated":true,"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Deep-Linking","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","