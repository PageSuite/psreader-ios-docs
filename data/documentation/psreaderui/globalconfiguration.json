":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default the SDK interprets timestamps in the system timezone. Provide an"},{"type":"text","text":" "},{"type":"text","text":"explicit timezone to keep this consistent across all locales."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide an instance of this configuration when initializing other SDK components."}]},{"type":"heading","level":2,"anchor":"Usage","text":"Usage"},{"type":"codeListing","code":["let globalConfig = GlobalConfiguration(","    apiKey: \"YOUR_API_KEY\",","    accountGUID: \"YOUR_ACCOUNT_GUID\",","    primaryFont: UIFont(name: \"Georgia\", size: 12)!,","    secondaryFont: UIFont(name: \"Helvetica\", size: 12)!,","    brandColor: .systemBlue",")"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Configuration-Inheritance","text":"Configuration Inheritance"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GlobalConfiguration"},{"type":"text","text":" sits at the top of the configuration hierarchy. When"},{"type":"text","text":" "},{"type":"text","text":"you create component-specific configurations such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveConfiguration"},{"type":"text","text":", or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration"},{"type":"text","text":" using their"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(globalConfig:)"},{"type":"text","text":" initializers, they automatically inherit fonts, colors,"},{"type":"text","text":" "},{"type":"text","text":"and delegates from the global config. You can then override individual"},{"type":"text","text":" "},{"t