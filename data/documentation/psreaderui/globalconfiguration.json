ir"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(globalConfig:)"},{"type":"text","text":" initializers, they automatically inherit fonts, colors,"},{"type":"text","text":" "},{"type":"text","text":"and delegates from the global config. You can then override individual"},{"type":"text","text":" "},{"type":"text","text":"properties at any level:"}]},{"type":"codeListing","code":["var archiveConfig = ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.backgroundColor = .black"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Delegates","text":"Delegates"},{"type":"paragraph","inlineContent":[{"text":"Optional delegates enable specific SDK features. All delegates are ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default except ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/shareDelegate","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/assetDelegate","type":"reference","isActive":true},{"text":" which have built-in","type":"text"},{"text":" ","type":"text"},{"text":"defaults:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Delegate","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Feature","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration\/shareDelegate","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Content sharing"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareProvider","type":"reference","isActive":true},{"type":"te