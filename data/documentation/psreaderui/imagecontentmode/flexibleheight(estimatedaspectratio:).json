,{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"An ","type":"text"},{"code":"estimatedAspectRatio","type":"codeVoice"},{"text":" is used as a placeholder while the image is","type":"text"},{"text":" ","type":"text"},{"text":"loading and its true aspect ratio is not yet known. This estimate helps","type":"text"},{"text":" ","type":"text"},{"text":"maintain stable layout during loading and is refined automatically at","type":"text"},{"text":" ","type":"text"},{"text":"runtime as the system learns the typical aspect ratios for a given","type":"text"},{"text":" ","type":"text"},{"text":"publication. Once the actual image is available, the layout is updated","type":"text"},{"text":" ","type":"text"},{"text":"if the true aspect ratio differs from the estimate.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI":{"title":"PSReaderUI","abstract":[{"text":"A UI framework for building digital newspaper and magazine reader experiences on iOS.","type":"text"}],"url":"\/documentation\/psreaderui","kind":"symbol","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI","role":"collection","type":"topic"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Theming-and-Customization":{"kind":"article","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization","role":"article","type":"topic","url":"\/documentation\/psreaderui\/theming-and-customization","abstract":[{"type":"text","text":"Adjust fonts, colors, icons, and layouts to match your app’s brand."}],"title":"Theming and Customization"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ImageContentMode/flexibleHeight(estimatedAspectRatio:)":{"kind":"symbol","title":"ImageContentMode.flexibleHeight(estimatedAspectRatio:)","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"