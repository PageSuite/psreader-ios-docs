"}],"type":"strong"},{"text":" — use ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","type":"reference","isActive":true},{"text":" directly to build a fully custom search UI.","type":"text"}]}]}]},{"level":2,"text":"Adding Search to the Carousel","anchor":"Adding-Search-to-the-Carousel","type":"heading"},{"inlineContent":[{"type":"text","text":"Add a search tab to the carousel using the "},{"type":"codeVoice","code":".search(config:)"},{"type":"text","text":" content type."},{"type":"text","text":" "},{"type":"text","text":"When using a dynamic archive, the carousel provides a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate"},{"type":"text","text":" "},{"type":"text","text":"automatically — no additional setup is needed:"}],"type":"paragraph"},{"code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"More\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Search\", type: .search(config: searchConfig))","        ])","    ]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When using manual sections, you must set a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","isActive":true},{"type":"text","text":" on the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["var searchConfig = PSReaderUI.SearchConfiguration(globalConfig: globalConfig)","searchConfig.searchDelegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: readerConfig",")","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .section(.init(name: \"Daily\", type: .feedArchive(guid: \"APP_GUID\"))),","        .section(.init(name: \"Search\", type: .search(config: searchConfig)))","    ]",")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Standalone Search View Controller","anchor":"Standalone-Search-View-Controller","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchViewController","isActive":true},{"type":"text","text":" presents search outside of the carousel. It requires"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","isActive":true},{"type":"text","text":" to provide the list of searchable publications and their"},{"type":"text","text":" "},{"type":"text","text":"reader configurations. Use "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ApplicationSearchDelegate","isActive":true},{"type":"text","text":" for a ready-made"},{"type":"text","text":" "},{"type":"text","text":"implementation:"}],"type":"paragraph"},{"code":["\/\/ From a shortcode (fetches application config lazily on first search)","let delegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: readerConfig",")","","let searchVC = PSReaderUI.SearchViewController(","    globalConfig: globalConfig,","    delegate: delegate",")","","navigationController?.pushViewController(searchVC, animated: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For modal presentation, set ","type":"text"},{"code":"dismissible","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" to show a close button:","type":"text"}],"type":"paragraph"},{"code":["let searchVC = PSReaderUI.SearchViewController(","    globalConfig: globalConfig,","    delegate: delegate,","    dismissible: true",")","","present(searchVC, animated: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If you already have a ","type":"text"},{"code":"PSEApplication","type":"codeVoice"},{"text":" object, you can create the delegate","type":"text"},{"text":" ","type":"text"},{"text":"from it directly:","type":"text"}],"type":"paragraph"},{"code":["let delegate = PSReaderUI.ApplicationSearchDelegate(","    application: myApplication,","    readerConfig: readerConfig",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers"},{"type":"text","text":" for common patterns like interface style"},{"type":"text","text":" "},{"type":"text","text":"overrides."}],"type":"paragraph"},{"level":2,"text":"In-Reader Search","anchor":"In-Reader-Search","type":"heading"},{"inlineContent":[{"text":"When ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/search","type":"reference"},{"text":" is set with a non-nil","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration\/searchDelegate","type":"reference"},{"text":", a search option appears in the reader’s","type":"text"},{"text":" ","type":"text"},{"text":"settings menu.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In carousel-based setups this is configured automatically — the carousel","type":"text"},{"text":" ","type":"text"},{"text":"provides a default ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","isActive":true,"type":"reference"},{"text":" if one is not set. For standalone view","type":"text"},{"text":" ","type":"text"},{"text":"controllers (","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksViewController","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DownloadsViewController","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedReaderViewController","isActive":true,"type":"reference"},{"text":"), set the delegate explicitly:","type":"text"}],"type":"paragraph"},{"code":["var readerConfig = PSReaderUI.ReaderConfiguration(globalConfig: globalConfig)","readerConfig.search?.searchDelegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: readerConfig",")","","var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig = readerConfig"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Set "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/search"},{"type":"text","text":" to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to disable search in the reader"},{"type":"text","text":" "},{"type":"text","text":"entirely."}],"type":"paragraph"},{"level":2,"text":"Search Service","anchor":"Search-Service","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService"},{"type":"text","text":" provides direct access to the PageSuite search API for"},{"type":"text","text":" "},{"type":"text","text":"building fully custom search experiences."}],"type":"paragraph"},{"inlineContent":[{"text":"Each publication must be paired with a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchPublicationType","type":"reference","isActive":true},{"text":" — either","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".app"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".publication"},{"text":". Despite the confusing names, there is no functional","type":"text"},{"text":" ","type":"text"},{"text":"difference between the two; they simply reflect how the publication is indexed","type":"text"},{"text":" ","type":"text"},{"text":"on the backend. Passing the wrong type will cause search to return no results.","type":"text"},{"text":" ","type":"text"},{"text":"You can find the correct type in your application configuration — the carousel","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ApplicationSearchDelegate","type":"reference","isActive":true},{"text":" resolve this automatically.","type":"text"}],"type":"paragraph"},{"code":["let service = PSReaderUI.SearchService()","","service.search(","    accountGuid: \"ACCOUNT_GUID\",","    query: \"election results\",","    type: .all,","    publications: [","        (.app, \"APP_GUID_1\"),","        (.publication, \"PUB_GUID_2\")","    ],","    offset: 0,","    limit: 20,","    timeZone: .current",") { result in","    switch result {","    case .success(let response):","        let totalCount = response.meta?.totalCount ?? 0","        let results = response.data ?? []","","        for item in results {","            print(item.headline ?? \"Untitled\")","            print(item.snippet ?? \"\")","        }","","    case .failure(let error):","        print(error)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult","isActive":true},{"type":"text","text":" includes:"}],"type":"paragraph"},{"r