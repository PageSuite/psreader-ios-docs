"}],[{"inlineContent":[{"text":"Array of associated images with URLs and captions.","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult\/formattedSnippet(font:)","type":"reference","isActive":true},{"text":" to convert the snippet into an","type":"text"},{"text":" ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":" with bold highlights:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let attributedSnippet = result.formattedSnippet(font: .systemFont(ofSize: 14))"]},{"type":"heading","anchor":"Opening-Search-Results","level":2,"text":"Opening Search Results"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedReaderViewController","type":"reference","isActive":true},{"type":"text","text":" to open an edition from a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Map the result’s identifiers to the reader’s initializer parameters:"}]},{"type":"codeListing","syntax":"swift","code":["guard let editionGUID = result.editionId,","      let publicationGUID = result.applicationId else {","    return","}","","let reader = PSReaderUI.FeedReaderViewController(","    globalConfig: globalConfig,","    publicationGUID: publicationGUID,","    editionGUID: editionGUID,","    openingPage: result.pageId.map { .page(guid: $0) }",")","","present(reader, animated: true)"]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Deep-Linking","type":"reference","isActive":true},{"text":" for more on presenting the reader directly.","type":"text"}]},{"type":"