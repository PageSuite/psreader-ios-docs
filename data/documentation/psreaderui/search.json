{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK includes a full-text search feature. Users can search across one or"},{"type":"text","text":" "},{"type":"text","text":"more publications and filter results by type — articles, pages, or both."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both feed and replica editions are searchable. Replica search is more limited:"},{"type":"text","text":" "},{"type":"text","text":"results are always pages, and each search runs against a single publication."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","isActive":true},{"type":"text","text":" to determine which system your"},{"type":"text","text":" "},{"type":"text","text":"publications use."}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"Feed and replica publications cannot be searched together. A","type":"text"},{"text":" ","type":"text"},{"text":"search setup supports one edition system at a time, so all publications","type":"text"},{"text":" ","type":"text"},{"text":"provided by a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","type":"reference","isActive":true},{"text":" must be of the same kind.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"There are three ways to integrate search:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Carousel tab"}]},{"type":"text","text":" — add a "},{"type":"codeVoice","code":".search"},{"type":"text","text":" content type to the carousel."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Standalone view controller","type":"text"}],"type":"strong"},{"text":" — use ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchViewController","isActive":true,"type":"reference"},{"text":" outside the carousel.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Search service"}]},{"type":"text","text":" — use "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","type":"reference"},{"type":"text","text":" directly to build a fully custom search UI."}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Adding-Search-to-the-Carousel","text":"Adding Search to the Carousel","type":"heading"},{"inlineContent":[{"text":"Add a search tab to the carousel using the ","type":"text"},{"code":".search(config:)","type":"codeVoice"},{"text":" content type.","type":"text"},{"text":" ","type":"text"},{"text":"When using a dynamic archive, the carousel provides a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","type":"reference"},{"text":" ","type":"text"},{"text":"automatically — no additional setup is needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"More\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Search\", type: .search(config: searchConfig))","        ])","    ]",")"],"type":"codeListing"},{"inlineContent":[{"text":"When using manual sections, you must set a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","isActive":true},{"text":" on the","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var searchConfig = PSReaderUI.SearchConfiguration(globalConfig: globalConfig)","searchConfig.searchDelegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: readerConfig",")","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .section(.init(name: \"Daily\", type: .feedArchive(guid: \"APP_GUID\"))),","        .section(.init(name: \"Search\", type: .search(config: searchConfig)))","    ]",")"],"type":"codeListing"},{"level":2,"anchor":"Standalone-Search-View-Controller","text":"Standalone Search View Controller","type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchViewController"},{"type":"text","text":" presents search outside of the carousel. It requires"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate"},{"type":"text","text":" to provide the list of searchable publications and their"},{"type":"text","text":" "},{"type":"text","text":"reader configurations. Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ApplicationSearchDelegate"},{"type":"text","text":" for a ready-made"},{"type":"text","text":" "},{"type":"text","text":"implementation:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ From a shortcode (fetches application config lazily on first search)","let delegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: readerConfig",")","","let searchVC = PSReaderUI.SearchViewController(","    globalConfig: globalConfig,","    delegate: delegate",")","","navigationController?.pushViewController(searchVC, animated: true)"],"type":"codeListing"},{"inlineContent":[{"text":"For modal presentation, set ","type":"text"},{"code":"dismissible","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" to show a close button:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let searchVC = PSReaderUI.SearchViewController(","    globalConfig: globalConfig,","    delegate: delegate,","    dismissible: true",")","","present(searchVC, animated: true)"],"type":"codeListing"},{"inlineContent":[{"text":"If you already have a ","type":"text"},{"type":"codeVoice","code":"PSEApplication"},{"text":" object, you can create the delegate","type":"text"},{"text":" ","type":"text"},{"text":"from it directly:","type":"text"}],"type":"paragraph"},{"code":["let delegate = PSReaderUI.ApplicationSearchDelegate(","    application: myApplication,","    readerConfig: readerConfig",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers"},{"type":"text","text":" for common patterns like interface style"},{"type":"text","text":" "},{"type":"text","text":"overrides."}],"type":"paragraph"},{"anchor":"In-Reader-Search","type":"heading","level":2,"text":"In-Reader Search"},{"inlineContent":[{"type":"text","text":"When "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/search"},{"type":"text","text":" is set with a non-nil"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration\/searchDelegate"},{"type":"text","text":", a search option appears in the reader’s"},{"type":"text","text":" "},{"type":"text","text":"settings menu."}],"type":"paragraph"},{"inlineContent":[{"text":"In carousel-based setups this is configured automatically — the carousel","type":"text"},{"text":" ","type":"text"},{"text":"provides a default ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","isActive":true,"type":"reference"},{"text":" if one is not set. For standalone view","type":"text"},{"text":" ","type":"text"},{"text":"controllers (","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksViewController","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DownloadsViewController","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedReaderViewController","isActive":true,"type":"reference"},{"text":"), set the delegate explicitly:","type":"text"}],"type":"paragraph"},{"code":["var readerConfig = PSReaderUI.ReaderConfiguration(globalConfig: globalConfig)","readerConfig.search?.searchDelegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: readerConfig",")","","var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig = readerConfig"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Set "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/search","type":"reference","isActive":true},{"type":"text","text":" to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to disable search in the reader"},{"type":"text","text":" "},{"type":"text","text":"entirely."}],"type":"paragraph"},{"anchor":"Search-Service","type":"heading","level":2,"text":"Search Service"},{"inlineContent":[{"text":"To build a fully custom search UI, use a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","type":"reference","isActive":true},{"text":" directly. The SDK","type":"text"},{"text":" ","type":"text"},{"text":"provides two implementations:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedSearchService","isActive":true},{"type":"text","text":" — searches feed edition publications."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReplicaSearchService"},{"type":"text","text":" — searches replica publications. Results are"},{"type":"text","text":" "},{"type":"text","text":"always pages, and only a single publication is searched per request."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Each publication is identified by a GUID paired with a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchPublicationType","isActive":true},{"type":"text","text":". Replica publications use "},{"type":"codeVoice","code":".replica"},{"type":"text","text":" with a"},{"type":"text","text":" "},{"type":"text","text":"publication GUID. Feed publications use "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or "},{"type":"codeVoice","code":".publication"},{"type":"text","text":" with an"},{"type":"text","text":" "},{"type":"text","text":"application GUID — despite the confusing names, there is no functional"},{"type":"text","text":" "},{"type":"text","text":"difference between those two; they simply reflect how the publication is"},{"type":"text","text":" "},{"type":"text","text":"indexed. Passing the wrong type will cause search to return no results. You"},{"type":"text","text":" "},{"type":"text","text":"can find the correct type in your application configuration — the carousel and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ApplicationSearchDelegate","isActive":true},{"type":"text","text":" resolve this automatically."}],"type":"paragraph"},{"code":["let service = PSReaderUI.FeedSearchService()","","service.search(","    accountGuid: \"ACCOUNT_GUID\",","    query: \"election results\",","    type: .all,","    publications: [","        (.app, \"APP_GUID_1\"),","        (.publication, \"PUB_GUID_2\")","    ],","    offset: 0,","    limit: 20,","    timeZone: .current",") { result in","    switch result {","    case .success(let response):","        let totalCount = response.meta?.totalCount ?? 0","        let results = response.data ?? []","","        for item in results {","            print(item.headline ?? \"Untitled\")","            print(item.snippet ?? \"\")","        }","","    case .failure(let error):","        print(error)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult","isActive":true},{"type":"text","text":" includes:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"EDITION_ARTICLE\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"EDITION_PAGE\""},{"type":"text","text":", or "},{"type":"codeVoice","code":"\"REPLICA_PAGE\""},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineCo