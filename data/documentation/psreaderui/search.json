   delegate: delegate,","    dismissible: true",")","","present(searchVC, animated: true)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you already have a "},{"type":"codeVoice","code":"PSEApplication"},{"type":"text","text":" object, you can create the delegate"},{"type":"text","text":" "},{"type":"text","text":"from it directly:"}]},{"type":"codeListing","syntax":"swift","code":["let delegate = PSReaderUI.ApplicationSearchDelegate(","    application: myApplication,","    readerConfig: readerConfig",")"]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers"},{"text":" for common patterns like interface style","type":"text"},{"text":" ","type":"text"},{"text":"overrides.","type":"text"}]},{"level":2,"type":"heading","text":"In-Reader Search","anchor":"In-Reader-Search"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/search"},{"type":"text","text":" is set with a non-nil"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration\/searchDelegate"},{"type":"text","text":", a search option appears in the reader’s"},{"type":"text","text":" "},{"type":"text","text":"settings menu."}]},{"type":"paragraph","inlineContent":[{"text":"In carousel-based setups this is configured automatically — the carousel","type":"text"},{"text":" ","type":"text"},{"text":"provides a default ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","type":"reference"},{"text":" if one is not set. For standalone view","type":"text"},{"text":" ","type":"text"},{"text":"controllers (","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksViewController","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DownloadsViewController","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedReaderViewController","type":"reference"},{"text":"), set the delegate explicitly:","type":"text"}]},{"code":["var readerConfig = PSReaderUI.ReaderConfiguration(globalConfig: globalConfig)","readerConfig.search?.searchDelegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: readerConfig",")","","var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig = readerConfig"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/search"},{"type":"text","text":" to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to disable search in the reader"},{"type":"text","text":" "},{"type":"text","text":"entirely."}]},{"type":"heading","anchor":"Search-Service","text":"Search Service","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","isActive":true},{"type":"text","text":" provides direct access to the PageSuite search API for"},{"type":"text","text":" "},{"type":"text","text":"building fully custom search experiences."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each publication must be paired with a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchPublicationType","isActive":true,"type":"reference"},{"type":"text","text":" — either"},{"type":"text","text":" "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or "},{"type":"codeVoice","code":".publication"},{"type":"text","text":". Despite the confusing names, there is no functional"},{"type":"text","text":" "},{"type":"text","text":"difference between the two; they simply reflect how the publication is indexed"},{"type":"text","text":" "},{"type":"text","text":"on the backend. Passing the wrong type will cause search to return no results."},{"type":"text","text":" "},{"type":"text","text":"You can find the correct type in your application configuration — the carousel"},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ApplicationSearchDelegate","isActive":true,"type":"reference"},{"type":"text","text":" resolve this automatically."}]},{"code":["let service = PSReaderUI.SearchService()","","service.search(","    accountGuid: \"ACCOUNT_GUID\",","    query: \"election results\",","    type: .all,","    publications: [","        (.app, \"APP_GUID_1\"),","        (.publication, \"PUB_GUID_2\")","    ],","    offset: 0,","    limit: 20,","    timeZone: .current",") { result in","    switch result {","    case .success(let response):","        let totalCount = response.meta?.totalCount ?? 0","        let results = response.data ?? []","","        for item in results {","            print(item.headline ?? \"Untitled\")","            print(item.snippet ?? \"\")","        }","","    case .failure(let error):","        print(error)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult","type":"reference","isActive":true},{"text":" includes:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Property","type":"text"}],"type":"paragraph"}],[{"inli