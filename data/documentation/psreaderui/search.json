","type":"text"}]},{"type":"text","text":" — use "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","isActive":true},{"type":"text","text":" directly to build a fully custom search UI."}],"type":"paragraph"}]}]},{"text":"Adding Search to the Carousel","type":"heading","anchor":"Adding-Search-to-the-Carousel","level":2},{"inlineContent":[{"type":"text","text":"Add a search tab to the carousel using the "},{"type":"codeVoice","code":".search(config:)"},{"type":"text","text":" content type."},{"type":"text","text":" "},{"type":"text","text":"When using a dynamic archive, the carousel provides a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"automatically — no additional setup is needed:"}],"type":"paragraph"},{"code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"More\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Search\", type: .search(config: searchConfig))","        ])","    ]",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When using manual sections, you must set a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate"},{"text":" on the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["var searchConfig = PSReaderUI.SearchConfiguration(globalConfig: globalConfig)","searchConfig.searchDelegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerC