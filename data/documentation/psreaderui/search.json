{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK includes a full-text search feature powered by the PageSuite search"},{"type":"text","text":" "},{"type":"text","text":"API. Users can search across one or more feed edition publications and filter"},{"type":"text","text":" "},{"type":"text","text":"results by type — articles, pages, or both."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Search is available for feed editions only. Replica (PDF-only) editions"},{"type":"text","text":" "},{"type":"text","text":"are not supported by the search API. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"determine which system your publications use."}]}],"type":"aside","style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are three ways to integrate search:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Carousel tab"}],"type":"strong"},{"text":" — add a ","type":"text"},{"code":".search","type":"codeVoice"},{"text":" content type to the carousel.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Standalone view controller"}],"type":"strong"},{"text":" — use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchViewController"},{"text":" outside the carousel.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Search service","type":"text"}]},{"type":"text","text":" — use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService"},{"type":"text","text":" directly to build a fully custom search UI."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Adding-Search-to-the-Carousel","level":2,"text":"Adding Search to the Carousel"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a search tab to the carousel using the "},{"type":"codeVoice","code":".search(config:)"},{"type":"text","text":" content type."},{"type":"text","text":" "},{"type":"text","text":"When using a dynamic archive, the carousel provides a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"automatically — no additional setup is needed:"}]},{"type":"codeListing","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"More\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Search\", type: .search(config: searchConfig))","        ])","    ]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When using manual sections, you must set a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","isActive":true,"type":"reference"},{"text":" on the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":["var searchConfig = PSReaderUI.SearchConfiguration(globalConfig: globalConfig)","searchConfig.searchDelegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: readerConfig",")","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,"