ext"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Search service"}]},{"type":"text","text":" — use "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","isActive":true},{"type":"text","text":" directly to build a fully custom search UI."}],"type":"paragraph"}]}]},{"text":"Adding Search to the Carousel","type":"heading","anchor":"Adding-Search-to-the-Carousel","level":2},{"inlineContent":[{"text":"Add a search tab to the carousel using the ","type":"text"},{"type":"codeVoice","code":".search(config:)"},{"text":" content type.","type":"text"},{"text":" ","type":"text"},{"text":"When using a dynamic archive, the carousel provides a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"automatically — no additional setup is needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"More\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Search\", type: .search(config: searchConfig))","        ])","    ]",")"],"type":"codeListing"},{"inlineContent":[{"text":"When using manual sections, you must set a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","isActive":true,"type":"reference"},{"text":" on the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var searchConfig = PSReaderUI.SearchConfiguration(globalConfig: globalConfig)",