ext":" to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" to show a close button:"}]},{"type":"codeListing","syntax":"swift","code":["let searchVC = PSReaderUI.SearchViewController(","    globalConfig: globalConfig,","    delegate: delegate,","    dismissible: true",")","","present(searchVC, animated: true)"]},{"type":"paragraph","inlineContent":[{"text":"If you already have a ","type":"text"},{"code":"PSEApplication","type":"codeVoice"},{"text":" object, you can create the delegate","type":"text"},{"text":" ","type":"text"},{"text":"from it directly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let delegate = PSReaderUI.ApplicationSearchDelegate(","    application: myApplication,","    readerConfig: readerConfig",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","isActive":true},{"type":"text","text":" for common patterns like interface style"},{"type":"text","text":" "},{"type":"text","text":"overrides."}]},{"type":"heading","anchor":"In-Reader-Search","level":2,"text":"In-Reader Search"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/search","isActive":true},{"type":"text","text":" is set with a non-nil"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration\/searchDelegate","isActive":true},{"type":"text","text":", a search option appears in the reader’s"},{"type":"text","text":" "},{"type":"text","text":"settings menu."}]},{"type":"paragraph","inlineContent":[{"text":"In carousel-based setups this is configured automatically — the carousel","type":"text"},{"text":" ","type":"text"},{"text":"provides a default ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate","isActive":true,"type":"reference"},{"text":" if one is not set. For standalone view","type":"text"},{"text":" ","type":"text"},{"text":"controllers (","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/BookmarksViewController","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DownloadsViewController","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedReaderViewController","isActive":true,"type":"reference"},{"text":"), set the delegate explicitly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var readerConfig = PSReaderUI.ReaderConfiguration(globalConfig: globalConfig)","readerConfig.search?.searchDelegate = PSReaderUI.ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: readerConfig",")","","var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig = readerConfig"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/search","type":"reference","isActive":true},{"type":"text","text":" to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to disable search in the reader"},{"type":"text","text":" "},{"type":"text","text":"entirely."}]},{"type":"heading","anchor":"Search-Service","level":2,"text":"Search Service"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","type":"reference","isActive":true},{"type":"text","text":" provides direct access to the PageSuite search API for"},{"type":"text","text":" "},{"type":"text","text":"building fully custom search experiences."}]},{"typ