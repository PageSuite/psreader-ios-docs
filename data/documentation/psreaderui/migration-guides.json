{"primaryContentSections":[{"kind":"content","content":[{"text":"v26.7.0","level":2,"type":"heading","anchor":"v2670"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Carousel headers replace ","type":"text"},{"code":"dismissButton","type":"codeVoice"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Breaking change: "},{"type":"codeVoice","code":"CarouselConfiguration.dismissButton"},{"type":"text","text":" has been removed. The"},{"type":"text","text":" "},{"type":"text","text":"carousel now accepts a full header view controller, pinned above the carousel"},{"type":"text","text":" "},{"type":"text","text":"content, via the new "},{"type":"codeVoice","code":"header"},{"type":"text","text":" parameter on the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":" "},{"type":"text","text":"initializer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To retain the previous dismiss button behavior, pass a"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController","isActive":true,"type":"reference"},{"type":"text","text":" as the header. It accepts the same"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ButtonConfiguration\/dismissButton(size:insets:position:tintColor:image:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"configuration as before, and by default dismisses the carousel on tap. Supply"},{"type":"text","text":" "},{"code":"onClose","type":"codeVoice"},{"type":"text","text":" to run custom behaviour instead (for example when the carousel is"},{"type":"text","text":" "},{"type":"text","text":"embedded rather than presented)."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Before","var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    sections: sections",")","","\/\/ After","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: DismissHeaderViewController(config: .dismissButton(position: .leading())),","    sections: sections",")"]},{"type":"paragraph","inlineContent":[{"text":"Headers can also hide as the content scrolls via","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration\/hidesHeaderOnScroll"},{"text":". Leave it ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" (the default)","type":"text"},{"text":" ","type":"text"},{"text":"when using a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController"},{"text":" so the close button stays","type":"text"},{"text":" ","type":"text"},{"text":"reachable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Search API changes","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support replica search, "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","isActive":true,"type":"reference"},{"type":"text","text":" is now a protocol with two"},{"type":"text","text":" "},{"type":"text","text":"implementations:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedSearchService","type":"reference","isActive":true},{"text":" — the previous ","type":"text"},{"code":"SearchService","type":"codeVoice"},{"text":" struct, renamed. It","type":"text"},{"text":" ","type":"text"},{"text":"searches feed edition publications.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReplicaSearchService","isActive":true,"type":"reference"},{"text":" — new. It searches replica publications.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you use the service directly, replace "},{"type":"codeVoice","code":"SearchService()"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FeedSearchService()"},{"type":"text","text":"; the "},{"type":"codeVoice","code":"search"},{"type":"text","text":" method signature is unchanged. The nested"},{"type":"text","text":" "},{"type":"text","text":"types have moved to the top level: "},{"type":"codeVoice","code":"SearchService.SearchType"},{"type":"text","text":" is now"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchType","isActive":true},{"type":"text","text":" and "},{"type":"codeVoice","code":"SearchService.Response"},{"type":"text","text":" is now "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResponse","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Advert pages and analytics","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Advert pages join the feed edition page flow as a new page type"},{"type":"text","text":" "},{"type":"text","text":"(see "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements#Full-Page-Advert-Pages","type":"reference","isActive":true},{"type":"text","text":"). If your editions contain"},{"type":"text","text":" "},{"type":"text","text":"them, be aware of the analytics implications:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An advert page settling on screen fires ","type":"text"},{"code":"feedEditionOtherPageView","type":"codeVoice"},{"text":", the same","type":"text"},{"text":" ","type":"text"},{"text":"event as other non-article, non-section pages. If you report page views","type":"text"},{"text":" ","type":"text"},{"text":"downstream, decide whether advert views should count — the event context’s","type":"text"},{"text":" ","type":"text"},{"text":"page spread identifies advert pages (","type":"text"},{"code":"referencePage()?.isAdvertPage","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"In double-page mode, a spread’s reference page prefers editorial content: a"},{"type":"text","text":" "},{"type":"text","text":"spread pairing an advert with an editorial page reports the editorial page,"},{"type":"text","text":" "},{"type":"text","text":"so only advert-only spreads report an advert. The page-zero advert always"},{"type":"text","text":" "},{"type":"text","text":"shares its spread with the cover, so it never produces its own page-view"},{"type":"text","text":" "},{"type":"text","text":"event; single-page mode does not include the page-zero advert at all."}],"type":"paragraph"}]}]},{"text":"v26.1.0","level":2,"type":"heading","anchor":"v2610"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Archive limit defaults"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"archiveLimit"},{"text":" now defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", with type-specific behavior:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Replica archives: 30 editions (unchanged from previous releases)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Feed archives: unbounded — shows the full backend archive (usually ~1 year)."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This is a behavior change for feed edition clients who previously saw a default","type":"text"},{"text":" ","type":"text"},{"text":"of 30 editions. To restore the old behavior, explicitly set ","type":"text"},{"code":"archiveLimit","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.archiveLimit = 30"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Modern replica reader"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"A modern replacement for the legacy replica reader is now available. It shares","type":"text"},{"text":" ","type":"text"},{"text":"delegates and navigation with the feed edition reader, giving end users the same","type":"text"},{"text":" ","type":"text"},{"text":"experience regardless of backend. Replica-specific analytics events still fire.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Opt in by setting ","type":"text"},{"code":"useLegacyReplicaReader","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" (defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"now). The modern reader will become the default in a future release, and the","type":"text"},{"text":" ","type":"text"},{"text":"legacy reader will be removed further out.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.useLegacyReplicaReader = false"]},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"The legacy reader’s content browser next\/previous button events are","type":"text"},{"text":" ","type":"text"},{"text":"not reported in the modern reader:","type":"text"},{"text":" ","type":"text"},{"code":"replicaPageBrowserNextTapped","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"replicaPageBrowserPreviousTapped","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"replicaArticleBrowserNextTapped","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"replicaArticleBrowserPreviousTapped","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"LegacyReaderConfiguration"},{"type":"text","text":" properties (e.g. "},{"type":"codeVoice","code":"shareTemplater"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"prefersStatusBarHidden"},{"type":"text","text":", "},{"type":"codeVoice","code":"navigationBarItems"},{"type":"text","text":") do not apply to the modern"},{"type":"text","text":" "},{"type":"text","text":"reader — it uses the standard "},{"type":"codeVoice","code":"ReaderConfiguration"},{"type":"text","text":" delegates instead."}]}]},{"text":"v5.5.0","level":2,"type":"heading","anchor":"v550"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Liquid Glass UI defaults"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"On iOS 26 and later, the SDK defaults to a new Liquid Glass design. The SDK","type":"text"},{"text":" ","type":"text"},{"text":"respects the host app’s ","type":"text"},{"code":"UIDesignRequiresCompatibility","type":"codeVoice"},{"text":" flag and will fall back","type":"text"},{"text":" ","type":"text"},{"text":"automatically on older OS versions. The new design can also be controlled via","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"LiquidGlassPolicy","type":"codeVoice"},{"text":" option. You can apply this globally or more granularly","type":"text"},{"text":" ","type":"text"},{"text":"on specific configuration objects (for example, subsection ribbon, navigation","type":"text"},{"text":" ","type":"text"},{"text":"bar, page browser, etc.). To disable it globally:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var globalConfig = PSReaderUI.GlobalConfiguration(apiKey: apiKey, accountGUID: accountGUID)","globalConfig.liquidGlassPolicy = .disabled \/\/ disable Liquid Glass across the SDK"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Archive thumbnail layout","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"Archive thumbnails now offer a dynamic layout mode:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ImageContentMode.flexibleHeight"},{"text":". It lets edition artwork (including the","type":"text"},{"text":" ","type":"text"},{"text":"latest\/hero card) grow or shrink to its true aspect ratio, keeping the full","type":"text"},{"text":" ","type":"text"},{"text":"image visible instead of cropping. Start with an estimated ratio for a steady","type":"text"},{"text":" ","type":"text"},{"text":"initial layout; the SDK tunes the size automatically once the real image","type":"text"},{"text":" ","type":"text"},{"text":"arrives. Example:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.9)"]},{"text":"v5.2.0","level":2,"type":"heading","anchor":"v520"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reader UI\/UX Changes"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In PDF-driven editions, PDF pages and articles are now segmented. Users can no"},{"type":"text","text":" "},{"type":"text","text":"longer swipe between them. Articles are accessed either via article hotspot"},{"type":"text","text":" "},{"type":"text","text":"links or through the content browser. The content browser is also segmented in"},{"type":"text","text":" "},{"type":"text","text":"the same way, with a toggle that allows switching between pages and articles."},{"type":"text","text":" "},{"type":"text","text":"This behavior now matches the web reader."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The navigation bar layout has also been updated:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The right-side back arrow has been removed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The left-side icon now adapts to the current context:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Dismiss Article – If the user opened an article from a hotspot link, this","type":"text"},{"text":" ","type":"text"},{"text":"action returns them to the PDF page containing that article.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dismiss Reader – In all other cases, this action dismisses the reader"},{"type":"text","text":" "},{"type":"text","text":"view controller."}]}]}],"type":"unorderedList"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can customize the icons for these actions via your "},{"type":"codeVoice","code":"AssetDelegate"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["ImageResourceName.dismiss        \/\/ Default: back arrow","ImageResourceName.dismissArticle \/\/ Default: xmark"]},{"text":"v5.0.0","level":2,"type":"heading","anchor":"v500"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Edition Download Behavior","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"5.0.0"},{"type":"text","text":" introduces the ability to read editions without downloading them."},{"type":"text","text":" "},{"type":"text","text":"This is the new default behavior. It can be customized by users via the reader"},{"type":"text","text":" "},{"type":"text","text":"settings menu. To retain the original default:"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.settings.downloadWhileReadingDefault = false","","\/\/ To hide the user facing setting","archiveConfig.readerConfig.settings.isDownloadWhileReadingToggleEnabled = false","archiveConfig.readerConfig.settings.isDownloadWhileReadingPreferenceAlertEnabled = false"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edition Date Formatting"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Breaking Change: "},{"type":"codeVoice","code":"DateFormatter"},{"type":"text","text":" objects in configuration structs have been"},{"type":"text","text":" "},{"type":"text","text":"replaced with the "},{"type":"codeVoice","code":"EditionDateFormatter"},{"type":"text","text":" protocol. This enables more fine"},{"type":"text","text":" "},{"type":"text","text":"grained customization and allows for alternative naming strategies such as"},{"type":"text","text":" "},{"type":"text","text":"edition names, identifiers, or any other custom labeling approach."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK provides a "},{"type":"codeVoice","code":"DefaultEditionDateFormatter"},{"type":"text","text":" that wraps a"},{"type":"text","text":" "},{"type":"codeVoice","code":"DateFormatter"},{"type":"text","text":". This allows"}]},{"type":"codeListing","syntax":"swift","code":["let dateFormatter = DateFormatter()","dateFormatter.dateFormat = \"d MMMM yyyy\"","dateFormatter.timeZone = .current","archiveConfig.dateFormatter = DefaultEditionDateFormatter(dateFormatter: dateFormatter)","","\/\/ Alternative initializer","archiveConfig.dateFormatter = DefaultEditionDateFormatter(dateFormat: \"d MMMM yyyy\", timeZone: .current)"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Asset Customization","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"Breaking Change: The ","type":"text"},{"type":"codeVoice","code":"imageResourceForName"},{"text":" callbacks have been removed. They","type":"text"},{"text":" ","type":"text"},{"text":"have been replaced by ","type":"text"},{"type":"codeVoice","code":"AssetDelegate"},{"text":". To migrate to the new system implement","type":"text"},{"text":" ","type":"text"},{"text":"the delegate and set it as needed.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["\/\/ Customize assets as desired","struct MyAssetDelegate: PSReaderUI.AssetDelegate {","    func imageResource(for name: ImageResourceName) -> UIImage? {","        return name.defaultImage()","    }","}","","var globalConfig = PSReaderUI.GlobalConfiguration(apiKey: apiKey, accountGUID: accountGUID)","globalConfig.assetDelegate = MyAssetDelegate()"]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","abstract":[{"type":"text","text":"Guidance to help you smoothly transition your app to newer versions of the SDK."},{"type":"text","text":" "},{"text":"This page highlights breaking changes, necessary updates, and recommended","type":"text"},{"text":" ","type":"text"},{"text":"practices when migrating between versions.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"metadata":{"modules":[{"name":"PSReaderUI"}],"title":"Migration Guides","roleHeading":"Article","role":"article"},"seeAlsoSections":[{"anchor":"Release-Notes","title":"Release Notes","generated":true,"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Migration-Guides"},"variants":[{"paths":["\/documentation\/psreaderui\/migration-guides"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/migration-guides"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/CarouselViewController":{"kind":"symbol","url":"\/documentation\/psreaderui\/carouselviewcontroller","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CarouselViewController"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CarouselViewController"}],"abstract":[{"type":"text","text":"The primary view controller provided by the SDK for presenting digital publication"},{"type":"text","text":" "},{"type":"text","text":"content through an intuitive carousel interface."}],"title":"CarouselViewController"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/SearchType":{"kind":"symbol","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchType","url":"\/documentation\/psreaderui\/searchtype","abstract":[{"text":"The type of content to search for.","type":"text"}],"title":"SearchType","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SearchType"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SearchType"}],"role":"symbol"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/CarouselViewController/init(globalConfig:carouselConfig:header:sections:)":{"role":"symbol","url":"\/documentation\/psreaderui\/carouselviewcontroller\/init(globalconfig:carouselconfig:header:sections:)","abstract":[{"type":"text","text":"Creates a "},{"type":"codeVoice","code":"CarouselViewController"},{"type":"text","text":" with the given config and content."}],"type":"topic","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/init(globalConfig:carouselConfig:header:sections:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"globalConfig","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10PSReaderUI19GlobalConfigurationV","text":"GlobalConfiguration","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"carouselConfig","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10PSReaderUI21CarouselConfigurationV","text":"CarouselConfiguration","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"header","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UIViewController","text":"UIViewController","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"sections","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:10PSReaderUI22CarouselViewControllerC11SectionItemO","text":"SectionItem","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"kind":"symbol","title":"init(globalConfig:carouselConfig:header:sections:)"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/FeedSearchService":{"abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","isActive":true},{"type":"text","text":" for searching PageSuite feed edition content."}],"navigatorTitle":[{"text":"FeedSearchService","kind":"identifier"}],"title":"FeedSearchService","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeedSearchService","kind":"identifier"}],"role":"symbol","url":"\/documentation\/psreaderui\/feedsearchservice","kind":"symbol","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedSearchService","type":"topic"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/DismissHeaderViewController":{"title":"DismissHeaderViewController","navigatorTitle":[{"kind":"identifier","text":"DismissHeaderViewController"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController","kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/psreaderui\/dismissheaderviewcontroller","abstract":[{"type":"text","text":"A prebuilt carousel header containing a single dismiss (close) button."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissHeaderViewController"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/SearchService":{"kind":"symbol","title":"SearchService","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SearchService","kind":"identifier"}],"role":"symbol","url":"\/documentation\/psreaderui\/searchservice","abstract":[{"type":"text","text":"A service for searching PageSuite edition content."}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","navigatorTitle":[{"text":"SearchService","kind":"identifier"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ButtonConfiguration/dismissButton(size:insets:position:tintColor:image:)":{"abstract":[{"text":"Creates a preconfigured dismiss button suitable for use with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController"},{"text":".","type":"text"}],"title":"dismissButton(size:insets:position:tintColor:image:)","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismissButton","kind":"identifier"},{"text":"(","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@S@CGSize","text":"CGSize","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"insets","kind":"ext