{"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Migration-Guides","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"v26.7.0","anchor":"v2670"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Carousel headers replace "},{"code":"dismissButton","type":"codeVoice"}]}]},{"type":"paragraph","inlineContent":[{"text":"Breaking change: ","type":"text"},{"type":"codeVoice","code":"CarouselConfiguration.dismissButton"},{"text":" has been removed. The","type":"text"},{"text":" ","type":"text"},{"text":"carousel now accepts a full header view controller, pinned above the carousel","type":"text"},{"text":" ","type":"text"},{"text":"content, via the new ","type":"text"},{"type":"codeVoice","code":"header"},{"text":" parameter on the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference"},{"text":" ","type":"text"},{"text":"initializer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To retain the previous dismiss button behavior, pass a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController","isActive":true,"type":"reference"},{"text":" as the header. It accepts the same","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ButtonConfiguration\/dismissButton(size:insets:position:tintColor:image:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"configuration as before, and by default dismisses the carousel on tap. Supply","type":"text"},{"text":" ","type":"text"},{"code":"onClose","type":"codeVoice"},{"text":" to run custom behaviour instead (for example when the carousel is","type":"text"},{"text":" ","type":"text"},{"text":"embedded rather than presented).","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Before","var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    sections: sections",")","","\/\/ After","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: DismissHeaderViewController(config: .dismissButton(position: .leading())),","    sections: sections",")"]},{"type":"paragraph","inlineContent":[{"text":"Headers can also hide as the content scrolls via","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration\/hidesHeaderOnScroll","isActive":true,"type":"reference"},{"text":". Leave it ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" (the default)","type":"text"},{"text":" ","type":"text"},{"text":"when using a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController","isActive":true,"type":"reference"},{"text":" so the close button stays","type":"text"},{"text":" ","type":"text"},{"text":"reachable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Search API changes","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"To support replica search, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","type":"reference"},{"text":" is now a protocol with two","type":"text"},{"text":" ","type":"text"},{"text":"implementations:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedSearchService","isActive":true,"type":"reference"},{"text":" — the previous ","type":"text"},{"code":"SearchService","type":"codeVoice"},{"text":" struct, renamed. It","type":"text"},{"text":" ","type":"text"},{"text":"searches feed edition publications.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReplicaSearchService","type":"reference","isActive":true},{"type":"text","text":" — new. It searches replica publications."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"If you use the service directly, replace ","type":"text"},{"code":"SearchService()","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"code":"FeedSearchService()","type":"codeVoice"},{"text":"; the ","type":"text"},{"code":"search","type":"codeVoice"},{"text":" method signature is unchanged. The nested","type":"text"},{"text":" ","type":"text"},{"text":"types have moved to the top level: ","type":"text"},{"code":"SearchService.SearchType","type":"codeVoice"},{"text":" is now","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchType","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"code":"SearchService.Response","type":"codeVoice"},{"text":" is now ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResponse","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Advert pages and analytics"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Advert pages join the feed edition page flow as a new page type"},{"type":"text","text":" "},{"type":"text","text":"(see "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements#Full-Page-Advert-Pages","isActive":true},{"type":"text","text":"). If your editions contain"},{"type":"text","text":" "},{"type":"text","text":"them, be aware of the analytics implications:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An advert page settling on screen fires "},{"type":"codeVoice","code":"feedEditionOtherPageView"},{"type":"text","text":", the same"},{"type":"text","text":" "},{"type":"text","text":"event as other non-article, non-section pages. If you report page views"},{"type":"text","text":" "},{"type":"text","text":"downstream, decide whether advert views should count — the event context’s"},{"type":"text","text":" "},{"type":"text","text":"page spread identifies advert pages ("},{"type":"codeVoice","code":"referencePage()?.isAdvertPage"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In double-page mode, a spread’s reference page prefers editorial content: a","type":"text"},{"text":" ","type":"text"},{"text":"spread pairing an advert with an editorial page reports the editorial page,","type":"text"},{"text":" ","type":"text"},{"text":"so only advert-only spreads report an advert. The page-zero advert always","type":"text"},{"text":" ","type":"text"},{"text":"shares its spread with the cover, so it never produces its own page-view","type":"text"},{"text":" ","type":"text"},{"text":"event; single-page mode does not include the page-zero advert at all.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"v26.1.0","anchor":"v2610"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Archive limit defaults","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"archiveLimit"},{"text":" now defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", with type-specific behavior:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replica archives: 30 editions (unchanged from previous releases)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Feed archives: unbounded — shows the full backend archive (usually ~1 year)."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a behavior change for feed edition clients who previously saw a default"},{"type":"text","text":" "},{"type":"text","text":"of 30 editions. To restore the old behavior, explicitly set "},{"type":"codeVoice","code":"archiveLimit"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.archiveLimit = 30"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modern replica reader"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A modern replacement for the legacy replica reader is now available. It shares"},{"type":"text","text":" "},{"type":"text","text":"delegates and navigation with the feed edition reader, giving end users the same"},{"type":"text","text":" "},{"type":"text","text":"experience regardless of backend. Replica-specific analytics events still fire."}]},{"type":"paragraph","inlineContent":[{"text":"Opt in by setting ","type":"text"},{"type":"codeVoice","code":"useLegacyReplicaReader"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" (defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"now). The modern reader will become the default in a future release, and the","type":"text"},{"text":" ","type":"text"},{"text":"legacy reader will be removed further out.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.useLegacyReplicaReader = false"]},{"type":"aside","content":[{"inlineContent":[{"text":"The legacy reader’s content browser next\/previous button events are","type":"text"},{"text":" ","type":"text"},{"text":"not reported in the modern reader:","type":"text"},{"text":" ","type":"text"},{"code":"replicaPageBrowserNextTapped","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"replicaPageBrowserPreviousTapped","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"replicaArticleBrowserNextTapped","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"replicaArticleBrowserPreviousTapped","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important"},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"LegacyReaderConfiguration"},{"text":" properties (e.g. ","type":"text"},{"type":"codeVoice","code":"shareTemplater"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"prefersStatusBarHidden"},{"text":", ","type":"text"},{"type":"codeVoice","code":"navigationBarItems"},{"text":") do not apply to the modern","type":"text"},{"text":" ","type":"text"},{"text":"reader — it uses the standard ","type":"text"},{"type":"codeVoice","code":"ReaderConfiguration"},{"text":" delegates instead.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"heading","level":2,"text":"v5.5.0","anchor":"v550"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Liquid Glass UI defaults"}]}]},{"type":"paragraph","inlineContent":[{"text":"On iOS 26 and later, the SDK defaults to a new Liquid Glass design. The SDK","type":"text"},{"text":" ","type":"text"},{"text":"respects the host app’s ","type":"text"},{"code":"UIDesignRequiresCompatibility","type":"codeVoice"},{"text":" flag and will fall back","type":"text"},{"text":" ","type":"text"},{"text":"automatically on older OS versions. The new design can also be controlled via","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"LiquidGlassPolicy","type":"codeVoice"},{"text":" option. You can apply this globally or more granularly","type":"text"},{"text":" ","type":"text"},{"text":"on specific configuration objects (for example, subsection ribbon, navigation","type":"text"},{"text":" ","type":"text"},{"text":"bar, page browser, etc.). To disable it globally:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var globalConfig = PSReaderUI.GlobalConfiguration(apiKey: apiKey, accountGUID: accountGUID)","globalConfig.liquidGlassPolicy = .disabled \/\/ disable Liquid Glass across the SDK"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Archive thumbnail layout"}]}]},{"type":"paragraph","inlineContent":[{"text":"Archive thumbnails now offer a dynamic layout mode:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ImageContentMode.flexibleHeight"},{"text":". It lets edition artwork (including the","type":"text"},{"text":" ","type":"text"},{"text":"latest\/hero card) grow or shrink to its true aspect ratio, keeping the full","type":"text"},{"text":" ","type":"text"},{"text":"image visible instead of cropping. Start with an estimated ratio for a steady","type":"text"},{"text":" ","type":"text"},{"text":"initial layout; the SDK tunes the size automatically once the real image","type":"text"},{"text":" ","type":"text"},{"text":"arrives. Example:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.9)"]},{"type":"heading","level":2,"text":"v5.2.0","anchor":"v520"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reader UI\/UX Changes"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"In PDF-driven editions, PDF pages and articles are now segmented. Users can no","type":"text"},{"text":" ","type":"text"},{"text":"longer swipe between them. Articles are accessed either via article hotspot","type":"text"},{"text":" ","type":"text"},{"text":"links or through the content browser. The content browser is also segmented in","type":"text"},{"text":" ","type":"text"},{"text":"the same way, with a toggle that allows switching between pages and articles.","type":"text"},{"text":" ","type":"text"},{"text":"This behavior now matches the web reader.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The navigation bar layout has also been updated:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The right-side back arrow has been removed."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The left-side icon now adapts to the current context:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dismiss Article – If the user opened an article from a hotspot link, this"},{"type":"text","text":" "},{"type":"text","text":"action returns them to the PDF page containing that article."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Dismiss Reader – In all other cases, this action dismisses the reader","type":"text"},{"text":" ","type":"text"},{"text":"view controller.","type":"text"}]}]}],"type":"unorderedList"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can customize the icons for these actions via your "},{"type":"codeVoice","code":"AssetDelegate"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["ImageResourceName.dismiss        \/\/ Default: back arrow","ImageResourceName.dismissArticle \/\/ Default: xmark"]},{"type":"heading","level":2,"text":"v5.0.0","anchor":"v500"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edition Download Behavior"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"5.0.0"},{"type":"text","text":" introduces the ability to read editions without downloading them."},{"type":"text","text":" "},{"type":"text","text":"This is the new default behavior. It can be customized by users via the reader"},{"type":"text","text":" "},{"type":"text","text":"settings menu. To retain the original default:"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.settings.downloadWhileReadingDefault = false","","\/\/ To hide the user facing setting","archiveConfig.readerConfig.settings.isDownloadWhileReadingToggleEnabled = false","archiveConfig.readerConfig.settings.isDownloadWhileReadingPreferenceAlertEnabled = false"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edition Date Formatting"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"Breaking Change: ","type":"text"},{"type":"codeVoice","code":"DateFormatter"},{"text":" objects in configuration structs have been","type":"text"},{"text":" ","type":"text"},{"text":"replaced with the ","type":"text"},{"type":"codeVoice","code":"EditionDateFormatter"},{"text":" protocol. This enables more fine","type":"text"},{"text":" ","type":"text"},{"text":"grained customization and allows for alternative naming strategies such as","type":"text"},{"text":" ","type":"text"},{"text":"edition names, identifiers, or any other custom labeling approach.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK provides a "},{"type":"codeVoice","code":"DefaultEditionDateFormatter"},{"type":"text","text":" that wraps a"},{"type":"text","text":" "},{"type":"codeVoice","code":"DateFormatter"},{"type":"text","text":". This allows"}]},{"type":"codeListing","syntax":"swift","code":["let dateFormatter = DateFormatter()","dateFormatter.dateFormat = \"d MMMM yyyy\"","dateFormatter.timeZone = .current","archiveConfig.dateFormatter = DefaultEditionDateFormatter(dateFormatter: dateFormatter)","","\/\/ Alternative initializer","archiveConfig.dateFormatter = DefaultEditionDateFormatter(dateFormat: \"d MMMM yyyy\", timeZone: .current)"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Asset Customization"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"Breaking Change: The ","type":"text"},{"code":"imageResourceForName","type":"codeVoice"},{"text":" callbacks have been removed. They","type":"text"},{"text":" ","type":"text"},{"text":"have been replaced by ","type":"text"},{"code":"AssetDelegate","type":"codeVoice"},{"text":". To migrate to the new system implement","type":"text"},{"text":" ","type":"text"},{"text":"the delegate and set it as needed.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["\/\/ Customize assets as desired","struct MyAssetDelegate: PSReaderUI.AssetDelegate {","    func imageResource(for name: ImageResourceName) -> UIImage? {","        return name.defaultImage()","    }","}","","var globalConfig = PSReaderUI.GlobalConfiguration(apiKey: apiKey, accountGUID: accountGUID)","globalConfig.assetDelegate = MyAssetDelegate()"]}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"sections":[],"seeAlsoSections":[{"anchor":"Release-Notes","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log"],"title":"Release Notes","generated":true}],"abstract":[{"type":"text","text":"Guidance to help you smoothly transition your app to newer versions of the SDK."},{"type":"text","text":" "},{"type":"text","text":"This page highlights breaking changes, necessary updates, and recommended"},{"type":"text","text":" "},{"type":"text","text":"practices when migrating between versions."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/migration-guides"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/migration-guides"]}],"metadata":{"title":"Migration Guides","roleHeading":"Article","role":"article","modules":[{"name":"PSReaderUI"}]},"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/SearchResponse":{"title":"SearchResponse","type":"topic","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResponse","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SearchResponse","kind":"identifier"}],"url":"\/documentation\/psreaderui\/searchresponse","kind":"symbol","navigatorTitle":[{"text":"SearchResponse","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The response from a search request."}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/SearchType":{"kind":"symbol","url":"\/documentation\/psreaderui\/searchtype","abstract":[{"text":"The type of content to search for.","type":"text"}],"title":"SearchType","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchType","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SearchType"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SearchType","kind":"identifier"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/CarouselViewController/init(globalConfig:carouselConfig:header:sections:)":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/init(globalConfig:carouselConfig:header:sections:)","role":"symbol","url":"\/documentation\/psreaderui\/carouselviewcontroller\/init(globalconfig:carouselconfig:header:sections:)","type":"topic","title":"init(globalConfig:carouselConfig:header:sections:)","kind":"symbol","abstract":[{"text":"Creates a ","type":"text"},{"code":"CarouselViewController","type":"codeVoice"},{"text":" with the given config and content.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"globalConfig","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GlobalConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:10PSReaderUI19GlobalConfigurationV"},{"text":", ","kind":"text"},{"text":"carouselConfig","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CarouselConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:10PSReaderUI21CarouselConfigurationV"},{"text":"?, ","kind":"text"},{"text":"header","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UIViewController","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UIViewController"},{"text":"?, ","kind":"text"},{"text":"sections","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"SectionItem","kind":"typeIdentifier","preciseIdentifier":"s:10PSReaderUI22CarouselViewControllerC11SectionItemO"},{"text":"])","kind":"text"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Advertisements#Full-Page-Advert-Pages":{"kind":"section","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements#Full-Page-Advert-Pages","abstract":[],"type":"topic","title":"Full Page Advert Pages","url":"\/documentation\/psreaderui\/advertisements#Full-Page-Advert-Pages"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/CarouselConfiguration/hidesHeaderOnScroll":{"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hidesHeaderOnScroll","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"text":"Controls whether the carousel header (supplied via","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/init(globalConfig:carouselConfig:header:sections:)"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"hides as the content scrolls and reappears when scrolling back up or","type":"text"},{"text":" ","type":"text"},{"text":"changing page.","type":"text"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration\/hidesHeaderOnScroll","title":"hidesHeaderOnScroll","role":"symbol","kind":"symbol","url":"\/documentation\/psreaderui\/carouselconfiguration\/hidesheaderonscroll"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ReplicaSearchService":{"role":"symbol","abstract":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","type":"reference"},{"type":"text","text":" for searching legacy replica edition content."}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReplicaSearchService","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReplicaSearchService"}],"url":"\/documentation\/psreaderui\/replicasearchservice","kind":"symbol","title":"ReplicaSearchService","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ReplicaSearchService"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/SearchService":{"url":"\/documentation\/psreaderui\/searchservice","abstract":[{"text":"A service for searching PageSuite edition content.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SearchService"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchService","type":"topic","kind":"symbol","title":"SearchService","navigatorTitle":[{"kind":"identifier","text":"SearchService"}],"role":"symbol"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/DismissHeaderViewController":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DismissHeaderViewController"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\