{"abstract":[{"type":"text","text":"Guidance to help you smoothly transition your app to newer versions of the SDK."},{"type":"text","text":" "},{"type":"text","text":"This page highlights breaking changes, necessary updates, and recommended"},{"type":"text","text":" "},{"type":"text","text":"practices when migrating between versions."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Migration-Guides"},"kind":"article","seeAlsoSections":[{"title":"Release Notes","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log"],"generated":true,"anchor":"Release-Notes"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"v2610","type":"heading","level":2,"text":"v26.1.0"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Archive limit defaults"}]}]},{"type":"paragraph","inlineContent":[{"code":"archiveLimit","type":"codeVoice"},{"type":"text","text":" now defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", with type-specific behavior:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Replica archives: 30 editions (unchanged from previous releases).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Feed archives: unbounded — shows the full backend archive (usually ~1 year)."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a behavior change for feed edition clients who previously saw a default"},{"type":"text","text":" "},{"type":"text","text":"of 30 editions. To restore the old behavior, explicitly set "},{"type":"codeVoice","code":"archiveLimit"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.archiveLimit = 30"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Modern replica reader","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A modern replacement for the legacy replica reader is now available. It shares"},{"type":"text","text":" "},{"type":"text","text":"delegates and navigation with the feed edition reader, giving end users the same"},{"type":"text","text":" "},{"type":"text","text":"experience regardless of backend. Replica-specific analytics events still fire."}]},{"type":"paragraph","inlineContent":[{"text":"Opt in by setting ","type":"text"},{"code":"useLegacyReplicaReader","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" (defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"now). The modern reader will become the default in a future release, and the","type":"text"},{"text":" ","type":"text"},{"text":"legacy reader will be removed further out.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.useLegacyReplicaReader = false"]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"The legacy reader’s content browser next\/previous button events are"},{"type":"text","text":" "},{"type":"text","text":"not reported in the modern reader:"},{"type":"text","text":" "},{"type":"codeVoice","code":"replicaPageBrowserNextTapped"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"replicaPageBrowserPreviousTapped"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"replicaArticleBrowserNextTapped"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"replicaArticleBrowserPreviousTapped"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"important","name":"Important"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"LegacyReaderConfiguration"},{"text":" properties (e.g. ","type":"text"},{"type":"codeVoice","code":"shareTemplater"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"prefersStatusBarHidden"},{"text":", ","type":"text"},{"type":"codeVoice","code":"navigationBarItems"},{"text":") do not apply to the modern","type":"text"},{"text":" ","type":"text"},{"text":"reader — it uses the standard ","type":"text"},{"type":"codeVoice","code":"ReaderConfiguration"},{"text":" delegates instead.","type":"text"}]}]},{"text":"v5.5.0","type":"heading","level":2,"anchor":"v550"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Liquid Glass UI defaults"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS 26 and later, the SDK defaults to a new Liquid Glass design. The SDK"},{"type":"text","text":" "},{"type":"text","text":"respects the host app’s "},{"code":"UIDesignRequiresCompatibility","type":"codeVoice"},{"type":"text","text":" flag and will fall back"},{"type":"text","text":" "},{"type":"text","text":"automatically on older OS versions. The new design can also be controlled via"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"LiquidGlassPolicy","type":"codeVoice"},{"type":"text","text":" option. You can apply this globally or more granularly"},{"type":"text","text":" "},{"type":"text","text":"on specific configuration objects (for example, subsection ribbon, navigation"},{"type":"text","text":" "},{"type":"text","text":"bar, page browser, etc.). To disable it globally:"}]},{"type":"codeListing","syntax":"swift","code":["var globalConfig = PSReaderUI.GlobalConfiguration(apiKey: apiKey, accountGUID: accountGUID)","globalConfig.liquidGlassPolicy = .disabled \/\/ disable Liquid Glass across the SDK"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Archive thumbnail layout"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"Archive thumbnails now offer a dynamic layout mode:","type":"text"},{"text":" ","type":"text"},{"code":"ImageContentMode.flexibleHeight","type":"codeVoice"},{"text":". It lets edition artwork (including the","type":"text"},{"text":" ","type":"text"},{"text":"latest\/hero card) grow or shrink to its true aspect ratio, keeping the full","type":"text"},{"text":" ","type":"text"},{"text":"image visible instead of cropping. Start with an estimated ratio for a steady","type":"text"},{"text":" ","type":"text"},{"text":"initial layout; the SDK tunes the size automatically once the real image","type":"text"},{"text":" ","type":"text"},{"text":"arrives. Example:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.9)"]},{"text":"v5.2.0","type":"heading","level":2,"anchor":"v520"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Reader UI\/UX Changes","type":"text"}]}]},{"inlineContent":[{"type":"text","text":"In PDF-driven editions, PDF pages and articles are now segmented. Users can no"},{"type":"text","text":" "},{"type":"text","text":"longer swipe between them. Articles are accessed either via article hotspot"},{"type":"text","text":" "},{"type":"text","text":"links or through the content browser. The content browser is also segmented in"},{"type":"text","text":" "},{"type":"text","text":"the same way, with a toggle that allows switching between pages and articles."},{"type":"text","text":" "},{"type":"text","text":"This behavior now matches the web reader."}],"type":"paragraph"},{"inlineContent":[{"text":"The navigation bar layout has also been updated:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The right-side back arrow has been removed.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The left-side icon now adapts to the current context:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dismiss Article – If the user opened an article from a hotspot link, this"},{"type":"text","text":" "},{"type":"text","text":"action returns them to the PDF page containing that article."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Dismiss Reader – In all other cases, this action dismisses the reader"},{"type":"text","text":" "},{"type":"text","text":"view controller."}],"type":"paragraph"}]}]}]}]},{"inlineContent":[{"type":"text","text":"You can customize the icons for these actions via your "},{"code":"AssetDelegate","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["ImageResourceName.dismiss        \/\/ Default: back arrow","ImageResourceName.dismissArticle \/\/ Default: xmark"]},{"level":2,"type":"heading","anchor":"v500","text":"v5.0.0"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Edition Download Behavior"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"code":"5.0.0","type":"codeVoice"},{"text":" introduces the ability to read editions without downloading them.","type":"text"},{"text":" ","type":"text"},{"text":"This is the new default behavior. It can be customized by users via the reader","type":"text"},{"text":" ","type":"text"},{"text":"settings menu. To retain the original default:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var archiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.readerConfig.settings.downloadWhileReadingDefault = false","","\/\/ To hide the user facing setting","archiveConfig.readerConfig.settings.isDownloadWhileReadingToggleEnabled = false","archiveConfig.readerConfig.settings.isDownloadWhileReadingPreferenceAlertEnabled = false"]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Edition Date Formatting"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"Breaking Change: ","type":"text"},{"code":"DateFormatter","type":"codeVoice"},{"text":" objects in configuration structs have been","type":"text"},{"text":" ","type":"text"},{"text":"replaced with the ","type":"text"},{"code":"EditionDateFormatter","type":"codeVoice"},{"text":" protocol. This enables more fine","type":"text"},{"text":" ","type":"text"},{"text":"grained customization and allows for alternative naming strategies such as","type":"text"},{"text":" ","type":"text"},{"text":"edition names, identifiers, or any other custom labeling approach.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The SDK provides a "},{"code":"DefaultEditionDateFormatter","type":"codeVoice"},{"type":"text","text":" that wraps a"},{"type":"text","text":" "},{"code":"DateFormatter","type":"codeVoice"},{"type":"text","text":". This allows"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let dateFormatter = DateFormatter()","dateFormatter.dateFormat = \"d MMMM yyyy\"","dateFormatter.timeZone = .current","archiveConfig.dateFormatter = DefaultEditionDateFormatter(dateFormatter: dateFormatter)","","\/\/ Alternative initializer","archiveConfig.dateFormatter = DefaultEditionDateFormatter(dateFormat: \"d MMMM yyyy\", timeZone: .current)"]},{"inlineContent":[{"inlineContent":[{"text":"Asset Customization","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Breaking Change: The "},{"code":"imageResourceForName","type":"codeVoice"},{"type":"text","text":" callbacks have been removed. They"},{"type":"text","text":" "},{"type":"text","text":"have been replaced by "},{"code":"AssetDelegate","type":"codeVoice"},{"type":"text","text":". To migrate to the new system implement"},{"type":"text","text":" "},{"type":"text","text":"the delegate and set it as needed."}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["\/\/ Customize assets as desired","struct MyAssetDelegate: PSReaderUI.AssetDelegate {","    func imageResource(for name: ImageResourceName) -> UIImage? {","        return name.defaultImage()","    }","}","","var globalConfig = PSReaderUI.GlobalConfiguration(apiKey: apiKey, accountGUID: accountGUID)","globalConfig.assetDelegate = MyAssetDelegate()"]}]}],"metadata":{"title":"Migration Guides","modules":[{"name":"PSReaderUI"}],"role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/migration-guides"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/migration-guides"]}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI":{"role":"collection","title":"PSReaderUI","abstract":[{"type":"text","text":"A UI framework for building digital newspaper and magazine reader experiences on iOS."}],"url":"\/documentation\/psreaderui","type":"topic","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI","kind":"symbol"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Change-Log":{"abstract":[{"type":"text","text":"Track new features, improvements, bug fixes, and other updates in each"},{"type":"text","text":" "},{"type":"text","text":"PSReaderUI SDK release."}],"type":"topic","title":"Change Log","role":"article","url":"\/documentation\/psreaderui\/change-log","kind":"article","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log"}},"variantOverrides":[{"patch":[{"value":"occ","op":"replace","path":"\/identifier\/interfaceLanguage"},{"value":null,"op":"add","path":"\/topicSections"},{"value":[{"anchor":"Release-Notes","generated":true,"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log"],"title":"Release Notes"}],"op":"replace","path":"\/seeAlsoSections"}],"traits":[{"interfaceLanguage":"occ"}]}]}