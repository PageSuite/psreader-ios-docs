{"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"When your app receives a push notification, handles a URL scheme, or responds","type":"text"},{"text":" ","type":"text"},{"text":"to a universal link, you often want to jump straight to a specific edition","type":"text"},{"text":" ","type":"text"},{"text":"rather than showing the archive grid first. ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedReaderViewController","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"provides a standalone reader that loads a single edition and presents its own","type":"text"},{"text":" ","type":"text"},{"text":"dismiss button, making it ideal for these entry points.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/FeedReaderViewController","type":"reference","isActive":true},{"type":"text","text":" supports feed editions only. Replica"},{"type":"text","text":" "},{"type":"text","text":"editions are not supported. See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","type":"reference","isActive":true},{"type":"text","text":" to determine"},{"type":"text","text":" "},{"type":"text","text":"which system your publication uses."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"inlineContent":[{"text":"For general SDK setup and credentials, see ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started","type":"reference","isActive":true},{"text":". For other","type":"text"},{"text":" ","type":"text"},{"text":"standalone view controllers like ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documen