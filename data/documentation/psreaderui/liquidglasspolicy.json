{"relationshipsSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/SQ","doc:\/\/com.pagesuite.PSReaderUI\/SH"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"A policy describing how the SDK adopts the iOS Liquid Glass UI effect.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LiquidGlassPolicy","kind":"identifier"}],"platforms":["iOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization"]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this type to control whether the SDK applies the Liquid Glass appearance","type":"text"},{"text":" ","type":"text"},{"text":"on devices running iOS 26 or later. This policy acts as a global preference,","type":"text"},{"text":" ","type":"text"},{"text":"and may be overridden by more granular configuration objects.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Liquid Glass effect is only available at runtime on iOS 26+ devices,","type":"text"},{"text":" ","type":"text"},{"text":"and will not be applied if the host application opts into design compatibility","type":"text"},{"text":" ","type":"text"},{"text":"using the ","type":"text"},{"code":"\"UIDesignRequiresCompatibility\"","type":"codeVoice"},{"text":" Info.plist key.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default policy is "},{"type":"codeVoice","code":".automatic"},{"type":"text","text":", which enables Liquid Glass when supported."},{"type":"text","text":" "},{"type":"text","text":"Set this to "},{"type":"codeVoice","code":".disabled"},{"type":"text","text":" to prevent use of the effect even on capable systems."}]},{"style":"note","ty