ype":"text","text":"not a dismissal command. Always call "},{"type":"codeVoice","code":"dismiss(animated:)"},{"type":"text","text":" yourself,"},{"type":"text","text":" "},{"type":"text","text":"invoke "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallViewController\/onDismiss","isActive":true,"type":"reference"},{"type":"text","text":" exactly once "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" dismissal completes (the SDK"},{"type":"text","text":" "},{"type":"text","text":"resumes the originating action the moment the closure fires), and make"},{"type":"text","text":" "},{"type":"text","text":"sure it runs for any interactive dismissal your presentation style"},{"type":"text","text":" "},{"type":"text","text":"allows (e.g. swiping a sheet down). See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the recommended pattern."}]}],"style":"important","type":"aside"},{"name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration"}]}],"style":"note","type":"aside"},{"name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","isActive":true}]}],"style":"note","type":"aside"}],"kind":"content"}],"metadata":{"modules":[{"name":"PSReaderUI"}],"navigatorTitle":[{"kind":"identifier","text":"PaywallViewController"}],"externalID":"s:10PSReaderUI21PaywallViewControllerP","symbolKind":"protocol","role":"symbol","title":"PaywallViewController","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","