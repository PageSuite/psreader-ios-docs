r presentation style"},{"type":"text","text":" "},{"type":"text","text":"allows (e.g. swiping a sheet down). See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the recommended pattern."}],"type":"paragraph"}],"name":"Important","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration"}]}],"name":"See Also","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","type":"reference","isActive":true}]}],"name":"See Also","type":"aside"}]}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AudioDelegate","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/MediaDelegate","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CommentingDelegate","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/NavigationDelegate","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchDelegate"],"generated":true,"title":"Delegates","anchor":"Delegates"}],"variants":[{"paths":["\/documentation\/psreaderui\/paywallviewcontroller"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Protocol","modules":[{"name":"PSReaderUI"}],"title":"PaywallViewController","externalID":"s:10PSRe