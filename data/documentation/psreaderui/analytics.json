ference"},{"text":" ","type":"text"},{"text":"and subscribe it to the shared channel:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import PSReaderUI","","class AnalyticsHandler: PSReaderUI.EventSubscriber {","    func analytics(event: PSReaderUI.EventChannel.AnalyticsEvent) {","        switch event {","        \/\/ handle events","        }","    }","}","","let subscriber = AnalyticsHandler()","PSReaderUI.EventChannel.shared.subscribe(subscriber)"]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel"},{"text":" holds a ","type":"text"},{"inlineContent":[{"text":"weak","type":"text"}],"type":"strong"},{"text":" reference to each","type":"text"},{"text":" ","type":"text"},{"text":"subscriber. Maintain a strong reference to your subscriber (for example, as a","type":"text"},{"text":" ","type":"text"},{"text":"property on your app delegate or coordinator) to prevent it from being","type":"text"},{"text":" ","type":"text"},{"text":"deallocated. You do not need to explicitly unsubscribe.","type":"text"}]}],"style":"important"},{"inlineContent":[{"text":"Events are always delivered on the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"main thread"}]},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Replica vs Feed Events","level":2,"anchor":"Replica-vs-Feed-Events"},{"inlineContent":[{"text":"Which events the SDK fires depends on the backend system your publication uses.","type":"text"},{"text":" ","type":"text"},{"text":"Replica editions produce ","type":"text"},{"code":"replica*","type":"codeVoice"},{"text":" events while feed editions produce","type":"text"},{"text":" ","type":"text"},{"code":"feedEdition*","type":"codeVoice"},{"text":" events. Some events (such as carousel views and bookmark","type":"text"},{"text":" ","type":"text"},{"text":"operations) apply to both systems.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Consult the PageSuite portal or your account manager to determine which system","type":"text"},{"text":" ","type":"text"},{"text":"applies to your publications. See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","isActive":true,"type":"reference"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"background.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Event Categories","level":2,"anchor":"Event-Categories"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/AnalyticsEvent"},{"type":"text","text":" enumeration defines every event the SDK"},{"type":"text","text":" "},{"type":"text","text":"reports. Below is a summary of the main categories. See the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/AnalyticsEvent"},{"type":"text","text":" symbol page for the complete list."}],"type":"paragraph"},{"type":"heading","text":"Carousel Events","level":3,"anchor":"Carousel-Events"},{"inlineContent":[{"text":"Fired when a carousel section becomes visible, providing the section index,","type":"text"},{"text":" ","type":"text"},{"text":"name, and content type through ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/CarouselEventContext","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Edition-Lifecycle","text":"Edition Lifecycle","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Events for edition launches, downloads, and deletions. For example,"},{"type":"text","text":" "},{"code":"replicaLaunch","type":"codeVoice"},{"type":"text","text":" fires when a user opens a replica edition, and"},{"type":"text","text":" "},{"code":"feedEditionDownloaded","type":"codeVoice"},{"type":"text","text":" fires when a feed edition finishes downloading."}],"type":"paragraph"},{"anchor":"Page-View-and-Navigation","text":"Page View and Navigation","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Page view events fire as the user navigates through an edition. Replica"},{"type":"text","text":" "},{"type":"text","text":"editions report "},{"code":"replicaPageView","type":"codeVoice"},{"type":"text","text":" with page numbers; feed editions report"},{"type":"text","text":" "},{"code":"feedEditionArticleView","type":"codeVoice"},{"type":"text","text":", "},{"code":"feedEditionSectionView","type":"codeVoice"},{"type":"text","text":", or"},{"type":"text","text":" "},{"code":"feedEditionOtherPageView","type":"codeVoice"},{"type":"text","text":" depending on the page type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The content browser also emits events when the user opens it or taps"},{"type":"text","text":" "},{"type":"text","text":"navigation controls within it."}],"type":"paragraph"},{"anchor":"Bookmark-Events","text":"Bookmark Events","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Bookmark and unbookmark events fire for both pages and articles. Each event"},{"type":"text","text":" "},{"type":"text","text":"includes the bookmark object with edition and page metadata."}],"type":"paragraph"},{"anchor":"Share-and-Print-Events","text":"Share and Print Events","level":3,"type":"heading"},{"inlineContent":[{"text":"Share and print actions are tracked separately for replica pages, replica","type":"text"},{"text":" ","type":"text"},{"text":"articles, and feed edition pages. These fire when the user initiates the","type":"text"},{"text":" ","type":"text"},{"text":"action from the navigation bar.","type":"text"}],"type":"paragraph"},{"text":"Search Events","level":3,"type":"heading","anchor":"Search-Events"},{"inlineContent":[{"text":"Search events track user queries and result interactions. ","type":"text"},{"code":"searchCompleted","type":"codeVoice"},{"text":" ","type":"text"},{"text":"fires when a search query returns results (not on pagination), and","type":"text"},{"text":" ","type":"text"},{"code":"searchResultTapped","type":"codeVoice"},{"text":" fires when a user taps a result. Both carry a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/SearchEventContext"},{"text":" with the query, search type filter, result","type":"text"},{"text":" ","type":"text"},{"text":"count, and the publications that were searched.","type":"text"}],"type":"paragraph"},{"text":"Article-Specific Events","level":3,"type":"heading","anchor":"Article-Specific-Events"},{"inlineContent":[{"text":"In replica editions, additional events track article taps, article link taps,","type":"text"},{"text":" ","type":"text"},{"text":"and text size changes. Each carries a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/ReplicaArticleEventContext","type":"reference"},{"text":" ","type":"text"},{"text":"with the edition and article details.","type":"text"}],"type":"paragraph"},{"text":"Context Objects","level":2,"type":"heading","anchor":"Context-Objects"},{"inlineContent":[{"text":"Each event carries an associated context object that provides the relevant","type":"text"},{"text":" ","type":"text"},{"text":"metadata. The five context types are:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/CarouselEventContext","isActive":true},{"type":"text","text":" — section index, name, and content"},{"type":"text","text":" "},{"type":"text","text":"type. Use "},{"type":"codeVoice","code":"sectionName"},{"type":"text","text":" to identify which tab the user is viewing and"},{"type":"text","text":" "},{"type":"codeVoice","code":"contentType"},{"type":"text","text":" to distinguish between archive, bookmarks, and downloads."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/ReplicaEventContext","type":"reference"},{"text":" — edition, page number, and spread page","type":"text"},{"text":" ","type":"text"},{"text":"numbers for double-page mode. The ","type":"text"},{"code":"edition","type":"codeVoice"},{"text":" property gives you access to","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"PSEdition","type":"codeVoice"},{"text":" model, and ","type":"text"},{"code":"pageNumber","type":"codeVoice"},{"text":" identifies the current page.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/ReplicaArticleEventContext"},{"type":"text","text":" — edition and article. The"},{"type":"text","text":" "},{"type":"codeVoice","code":"article"},{"type":"text","text":" property contains the article headline, ID, and share link."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/FeedEditionEventContext","isActive":true},{"type":"text","text":" — published object, edition, and"},{"type":"text","text":" "},{"type":"text","text":"current page spread. The "},{"type":"codeVoice","code":"published"},{"type":"text","text":" property provides the "},{"type":"codeVoice","code":"PSEPublished"},{"type":"text","text":" "},{"type":"text","text":"model with edition metadata, and "},{"type":"codeVoice","code":"edition"},{"type":"text","text":" contains page-level details."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/SearchEventContext","type":"reference"},{"text":" — query string, search type filter,","type":"text"},{"text":" ","type":"text"},{"text":"total result count, and the publications that were searched. The","type":"text"},{"text":" ","type":"text"},{"code":"searchResultTapped","type":"codeVoice"},{"text":" event also includes the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult","type":"reference"},{"text":" that was","type":"text"},{"text":" ","type":"text"},{"text":"tapped.","type":"text"}]}]}]},{"inlineContent":[{"text":"See the symbol pages for each context type for the full list of properties.","type":"text"}],"type":"paragraph"},{"name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Map SDK event names to your analytics provider’s conventions in one"},{"type":"text","text":" "},{"type":"text","text":"central place. A "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" over "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/AnalyticsEvent","type":"reference","isActive":true},{"type":"text","text":" with a"},{"type":"text","text":" "},{"code":"default","type":"codeVoice"},{"type":"text","text":" case ensures you gracefully handle new events added in future SDK"},{"type":"text","text":" "},{"type":"text","text":"versions without a compile error."}]}],"type":"aside"},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"inlineContent":[{"type":"text","text":"A practical example mapping common events to an analytics provider:"}],"type":"paragraph"},{"code":["class MyAnalyticsSubscriber: PSReaderUI.EventSubscriber {","    func analytics(event: PSReaderUI.EventChannel.AnalyticsEvent) {","        switch event {","        case .carouselView(let context):","            trackScreen(\"carousel_\\(context.sectionName)\")","","        case .replicaLaunch(let context):","            trackEvent(\"edition_open\", properties: [","                \"page\": context.pageNumber ?? 0","            ])","","        case .feedEditionLaunch(let published):","            trackEvent(\"edition_open\", properties: [","                \"edition\": published.guid","            ])","","        case .replicaPageView(let context):","            trackEvent(\"page_view\", properties: [","                \"page\": context.pageNumber ?? 0","            ])","","        case .feedEditionArticleView(let context):","            trackEvent(\"article_view\", properties: [","                \"edition\": context.edition?.guid ?? \"\"","            ])","","        case .replicaPageBookmark, .feedEditionPageBookmark,","             .feedEditionArticleBookmark, .replicaArticleBookmark:","            trackEvent(\"bookmark_added\")","","        case .replicaPageShare, .feedEditionShare:","            trackEvent(\"share\")","","        case .searchCompleted(let context):","            trackEvent(\"search\", properties: [","                \"query\": context.query,","                \"results\": context.totalCount","            ])","","        case .searchResultTapped(let result, _):","            trackEvent(\"search_result_tapped\", properties: [","                \"type\": result.type ?? \"\",","                \"headline\": result.headline ?? \"\"","            ])","","        default:","            break","        }","    }","","    private func trackEvent(_ name: String, properties: [String: Any] = [:]) {","        \/\/ Forward to your analytics provider","    }","","    private func trackScreen(_ name: String) {","        \/\/ Forward to your analytics provider","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"c