ype":"paragraph"},{"code":["import PSReaderUI","","class AnalyticsHandler: PSReaderUI.EventSubscriber {","    func analytics(event: PSReaderUI.EventChannel.AnalyticsEvent) {","        switch event {","        \/\/ handle events","        }","    }","}","","let subscriber = AnalyticsHandler()","PSReaderUI.EventChannel.shared.subscribe(subscriber)"],"syntax":"swift","type":"codeListing"},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel","type":"reference","isActive":true},{"type":"text","text":" holds a "},{"type":"strong","inlineContent":[{"text":"weak","type":"text"}]},{"type":"text","text":" reference to each"},{"type":"text","text":" "},{"type":"text","text":"subscriber. Maintain a strong reference to your subscriber (for example, as a"},{"type":"text","text":" "},{"type":"text","text":"property on your app delegate or coordinator) to prevent it from being"},{"type":"text","text":" "},{"type":"text","text":"deallocated. You do not need to explicitly unsubscribe."}],"type":"paragraph"}]},{"inlineContent":[{"text":"Events are always delivered on the ","type":"text"},{"inlineContent":[{"text":"main thread","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Replica vs Feed Events","anchor":"Replica-vs-Feed-Events"},{"inlineContent":[{"text":"Which events the SDK fires depends on the backend system your publication uses.","type":"text"},{"text":" ","type":"text"},{"text":"Replica editions produce ","type":"text"},{"code":"replica*","type":"codeVoice"},{"text":" events while feed editions produce","type":"text"},{"text":" ","type":"text"},{"code":"feedEdition*","type":"codeVoice"},{"text":" events. Some events (such as carousel views and bookmark","type":"text"},{"text":" ","type":"text"},{"text":"operations) apply to both systems.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Consult the PageSuite portal or your account manager to determine which system"},{"type":"text","text":" "},{"type":"text","text":"applies to your publications. See "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","type":"reference"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"background."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Event Categories","anchor":"Event-Categories"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/AnalyticsEvent"},{"text":" enumeration defines every event the SDK","type":"text"},{"text":" ","type":"text"},{"text":"reports. Below is a summary of the main categories. See the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/AnalyticsEvent"},{"text":" symbol page for the complete list.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Carousel Events","anchor":"Carousel-Events"},{"inlineContent":[{"text":"Fired when a carousel section becomes visible, providing the section index,","type":"text"},{"text":" ","type":"text"},{"text":"name, and content type through ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/CarouselEventContext","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Edition Lifecycle","anchor":"Edition-Lifecycle"},{"inlineContent":[{"text":"Events for edition launches, downloads, and deletions. For example,","type":"text"},{"text":" ","type":"text"},{"code":"replicaLaunch","type":"codeVoice"},{"text":" fires when a user opens a replica edition, and","type":"text"},{"text":" ","type":"text"},{"code":"feedEditionDownloaded","type":"codeVoice"},{"text":" fires when a feed edition finishes downloading.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Page View and Navigation","anchor":"Page-View-and-Navigation"},{"inlineContent":[{"type":"text","text":"Page view events fire as the user navigates through an edition. Replica"},{"type":"text","text":" "},{"type":"text","text":"editions report "},{"type":"codeVoice","code":"replicaPageView"},{"type":"text","text":" with page numbers; feed editions report"},{"type":"text","text":" "},{"type":"codeVoice","code":"feedEditionArticleView"},{"type":"text","text":", "},{"type":"codeVoice","code":"feedEditionSectionView"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"feedEditionOtherPageView"},{"type":"text","text":" depending on the page type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The content browser also emits events when the user opens it or taps"},{"type":"text","text":" "},{"type":"text","text":"navigation controls within it."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Bookmark Events","anchor":"Bookmark-Events"},{"inlineContent":[{"type":"text","text":"Bookmark and unbookmark events fire for both pages and articles. Each event"},{"type":"text","text":" "},{"type":"text","text":"includes the bookmark object with edition and page metadata."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Share and Print Events","anchor":"Share-and-Print-Events"},{"inlineContent":[{"text":"Share and print actions are tracked separately for replica pages, replica","type":"text"},{"text":" ","type":"text"},{"text":"articles, and feed edition pages. These fire when the user initiates the","type":"text"},{"text":" ","type":"text"},{"text":"action from the navigation bar.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Search Events","anchor":"Search-Events"},{"inlineContent":[{"type":"text","text":"Search events track user queries and result interactions. "},{"code":"searchCompleted","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"fires when a search query returns results (not on pagination), and"},{"type":"text","text":" "},{"code":"searchResultTapped","type":"codeVoice"},{"type":"text","text":" fires when a user taps a result. Both carry a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/SearchEventContext"},{"type":"text","text":" with the query, search type filter, result"},{"type":"text","text":" "},{"type":"text","text":"count, and the publications that were searched."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Article-Specific Events","anchor":"Article-Specific-Events"},{"inlineContent":[{"type":"text","text":"In replica editions, additional events track article taps, article link taps,"},{"type":"text","text":" "},{"type":"text","text":"and text size changes. Each carries a "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/ReplicaArticleEventContext","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"with the edition and article details."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Context Objects","anchor":"Context-Objects"},{"inlineContent":[{"type":"text","text":"Each event carries an associated context object that provides the relevant"},{"type":"text","text":" "},{"type":"text","text":"metadata. The five context types are:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/CarouselEventContext"},{"text":" — section index, name, and content","type":"text"},{"text":" ","type":"text"},{"text":"type. Use ","type":"text"},{"type":"codeVoice","code":"sectionName"},{"text":" to identify which tab the user is viewing and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"contentType"},{"text":" to distinguish between archive, bookmarks, and downloads.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/ReplicaEventContext"},{"type":"text","text":" — edition, page number, and spread page"},{"type":"text","text":" "},{"type":"text","text":"numbers for double-page mode. The "},{"type":"codeVoice","code":"edition"},{"type":"text","text":" property gives you access to"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"PSEdition"},{"type":"text","text":" model, and "},{"type":"codeVoice","code":"pageNumber"},{"type":"text","text":" identifies the current page."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/ReplicaArticleEventContext","isActive":true,"type":"reference"},{"text":" — edition and article. The","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"article"},{"text":" property contains the article headline, ID, and share link.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/FeedEditionEventContext"},{"text":" — published object, edition, and","type":"text"},{"text":" ","type":"text"},{"text":"current page spread. The ","type":"text"},{"type":"codeVoice","code":"published"},{"text":" property provides the ","type":"text"},{"type":"codeVoice","code":"PSEPublished"},{"text":" ","type":"text"},{"text":"model with edition metadata, and ","type":"text"},{"type":"codeVoice","code":"edition"},{"text":" contains page-level details.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/SearchEventContext"},{"text":" — query string, search type filter,","type":"text"},{"text":" ","type":"text"},{"text":"total result count, and the publications that were searched. The","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"searchResultTapped"},{"text":" event also includes the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchResult"},{"text":" that was","type":"text"},{"text":" ","type":"text"},{"text":"tapped.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"See the symbol pages for each context type for the full list of properties."}],"type":"paragraph"},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Map SDK event names to your analytics provider’s conventions in one"},{"type":"text","text":" "},{"type":"text","text":"central place. A "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/EventChannel\/AnalyticsEvent"},{"type":"text","text":" with a"},{"type":"text","text":" "},{"type":"codeVoice","code":"default"},{"type":"text","text":" case ensures you gracefully handle new events added in future SDK"},{"type":"text","text":" "},{"type":"text","text":"versions without a compile error."}]}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"inlineContent":[{"text":"A practical example mapping common events to an analytics provider:","type":"text"}],"type":"paragraph"},{"code":["class MyAnalyticsSubscriber: PSReaderUI.EventSubscriber {","    func analytics(event: PSReaderUI.EventChannel.AnalyticsEvent) {","        switch event {","        case .carouselView(let context):","            trackScreen(\"carousel_\\(context.sectionName)\")","","        case .replicaLaunch(let context):","            trackEvent(\"edition_open\", properties: [","                \"page\": context.pageNumber ?? 0","            ])","","        case .feedEditionLaunch(let published):","            trackEvent(\"edition_open\", properties: [","                \"edition\": published.guid","            ])","","        case .replicaPageView(let context):","            trackEvent(\"page_view\", properties: [","                \"page\": context.pageNumber ?? 0","            ])","","        case .feedEditionArticleView(let context):","            trackEvent(\"article_view\", properties: [","                \"edition\": context.edition?.guid ?? \"\"","            ])","","        case .replicaPageBookmark, .feedEditionPageBookmark,","             .feedEditionArticleBookmark, .replicaArticleBookmark:","            trackEvent(\"bookmark_added\")","","        case .replicaPageShare, .feedEditionShare:","            trackEvent(\"share\")","","        case .searchCompleted(let context):","            trackEvent(\"search\", properties: [","                \"query\": context.query,","                \"results\": context.totalCount","            ])","","        case .searchResultTapped(let result, _):","            trackEvent(\"search_result_tapped\", properties: [","                \"type\": result.type ?? \"\",","                \"headline\": result.headline ?? \"\"","            ])","","        default:","            break","        }","    }","","    private func trackEvent(_ name: String, properties: [String: Any] = [:]) {","        \/\/ Forward to your analytics provider","    }","","    private func trackScreen(_ name: String) {","        \/\/ Forward to your analytics provider","    }","}"],"syntax":"swift","type":"codeListing"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/An