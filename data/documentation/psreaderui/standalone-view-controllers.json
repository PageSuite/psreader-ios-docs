{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"text":" is the primary way to present SDK content, but","type":"text"},{"text":" ","type":"text"},{"text":"the SDK also exposes four standalone view controllers for use outside the","type":"text"},{"text":" ","type":"text"},{"text":"carousel. These are useful when you want to embed a specific view in your own","type":"text"},{"text":" ","type":"text"},{"text":"navigation hierarchy or present it independently.","type":"text"}]},{"type":"heading","level":2,"text":"When to Use Standalone View Controllers","anchor":"When-to-Use-Standalone-View-Controllers"},{"type":"paragraph","inlineContent":[{"text":"Use standalone view controllers when you need to embed a single content view","type":"text"},{"text":" ","type":"text"},{"text":"in your own navigation hierarchy — for example, a bookmarks tab in a custom","type":"text"},{"text":" ","type":"text"},{"text":"tab bar controller. Prefer ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"text":" when you want the full","type":"text"},{"text":" ","type":"text"},{"text":"tabbed experience with section ribbons, since it manages navigation and layout","type":"text"},{"text":" ","type":"text"},{"text":"internally.","type":"text"}]},{"type":"heading","level":2,"text":"ArchiveViewController","anchor":"ArchiveViewController"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ArchiveViewController","isActive":true},{"type":"text","text":" displays a publication’s edition archive in a grid"},{"type":"text","text":" "},{"type":"text"