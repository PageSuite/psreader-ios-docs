{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started"},"metadata":{"modules":[{"name":"PSReaderUI"}],"role":"article","title":"Getting Started","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide walks you through installation, credentials, SDK initialization, and"},{"type":"text","text":" "},{"type":"text","text":"launching your first reader experience. By the end you will have a working"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true,"type":"reference"},{"type":"text","text":" displaying your publication editions."}]},{"anchor":"Installation","type":"heading","level":2,"text":"Installation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"We support three installation methods for integrating the SDK into your iOS app:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Manual installation"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Swift Package Manager (SPM)"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CocoaPods"}]}]}]}]},{"type":"thematicBreak"},{"anchor":"1-Manual-Installation","type":"heading","level":3,"text":"1. Manual Installation"},{"type":"paragraph","inlineContent":[{"text":"Manually install the provided ","type":"text"},{"type":"codeVoice","code":"PSReaderUI.xcframework"},{"text":" and its dependencies by dragging and dropping them into your Xcode project.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"PSReaderUI.xcframework","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"PSReader.xcframework"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"PDFNet.xcframework"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tools.xcframework","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the frameworks are set to "},{"type":"strong","inlineContent":[{"text":"Embed and Sign","type":"text"}]},{"type":"text","text":" in your Xcode project settings."}]},{"type":"thematicBreak"},{"anchor":"2-Swift-Package-Manager","type":"heading","level":3,"text":"2. Swift Package Manager"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Package URL:","type":"text"}]}]},{"syntax":null,"type":"codeListing","code":["https:\/\/github.com\/PageSuite\/psreader-swift-package.git"]},{"type":"paragraph","inlineContent":[{"text":"To integrate:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"type":"text","text":"File > Add Packages…"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enter the repository URL above."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the desired version\/range and add the package to your target.","type":"text"}]}]}]},{"type":"thematicBreak"},{"anchor":"3-CocoaPods","type":"heading","level":3,"text":"3. CocoaPods"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Specs repository:","type":"text"}],"type":"strong"}]},{"syntax":null,"type":"codeListing","code":["https:\/\/github.com\/PageSuite\/psreader-specs.git"]},{"type":"paragraph","inlineContent":[{"text":"Example ","type":"text"},{"code":"Podfile","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"ruby","type":"codeListing","code":["source 'https:\/\/github.com\/PageSuite\/psreader-specs.git'","","target 'YourAppTarget' do","  use_frameworks!","","  pod 'PDFTron', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron\/11.5.0.85515.podspec'","  pod 'PDFTronTools', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron-tools\/11.5.0.85515.podspec'","  pod 'PSReaderUI2'","end"]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Note","type":"text"}],"type":"strong"},{"text":": The Apryse SDK integration is slightly non-standard. We recommend pinning it to version ","type":"text"},{"code":"11.5.0.85515","type":"codeVoice"},{"text":", as this is the version we have tested internally.","type":"text"}]}]},{"anchor":"Versioning","type":"heading","level":2,"text":"Versioning"},{"type":"paragraph","inlineContent":[{"text":"Starting in 2026, the SDK uses a calendar-based versioning scheme to align","type":"text"},{"text":" ","type":"text"},{"text":"with the rest of the PageSuite product line. Versions follow the format","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"year.month.patch"}],"type":"strong"},{"text":" — for example, ","type":"text"},{"code":"26.1.0","type":"codeVoice"},{"text":" is the first January 2026","type":"text"},{"text":" ","type":"text"},{"text":"release.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This scheme does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" follow semantic versioning. While we strive to","type":"text"},{"text":" ","type":"text"},{"text":"maintain API stability, breaking changes may occur in any release without a","type":"text"},{"text":" ","type":"text"},{"text":"major version bump. We recommend pinning to a specific version and reviewing","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log","type":"reference"},{"text":" before upgrading.","type":"text"}]},{"anchor":"Credentials","type":"heading","level":2,"text":"Credentials"},{"type":"paragraph","inlineContent":[{"text":"To use the PSReaderUI SDK you need the following credentials. Contact your","type":"text"},{"text":" ","type":"text"},{"text":"PageSuite account manager or check the PageSuite portal to obtain them.","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Credential"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"API Key","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Authenticates your app with the PageSuite backend."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Account GUID"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Identifies your account."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Shortcode","type":"text"}]},{"type":"text","text":" (recommended)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A short identifier that maps to your publication configuration. Use with ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":" to load content automatically.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Application GUID"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Identifies a specific feed edition publication.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Publication GUID","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Identifies a specific replica publication."}],"type":"paragraph"}]]]},{"name":"Tip","type":"aside","style":"tip","content":[{"inlineContent":[{"text":"","type":"text"},{"inlineContent":[{"type":"text","text":"Shortcode is the recommended approach."}],"type":"strong"},{"text":" It lets the SDK fetch your","type":"text"},{"text":" ","type":"text"},{"text":"publication configuration dynamically, so you don’t need to manage GUIDs","type":"text"},{"text":" ","type":"text"},{"text":"yourself.","type":"text"}],"type":"paragraph"}]},{"anchor":"Initialize-the-SDK","type":"heading","level":2,"text":"Initialize the SDK"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The PSReader SDK must be globally initialized before it can be used. Call this"},{"type":"text","text":" "},{"type":"text","text":"method early in your app lifecycle to optimize reader launch speed. You only"},{"type":"text","text":" "},{"type":"text","text":"need to call this method once."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The completion handler is only used to return a status flag. It is not required"},{"type":"text","text":" "},{"type":"text","text":"and it is not necessary to wait for the completion handler before continuing."}]},{"type":"paragraph","inlineContent":[{"text":"This method will only fail if the API key is invalid.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import PSReaderUI","","PSReader.initialize(apiKey: apiKey, completion: { success in","    \/\/ Note: The completion handler may be called on any thread.","})"]},{"anchor":"Quick-Start","type":"heading","level":2,"text":"Quick Start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"type":"text","text":" with your credentials and basic theming:"}]},{"syntax":"swift","type":"codeListing","code":["import PSReaderUI","","let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID,","    primaryFont: .systemFont(ofSize: 12),","    secondaryFont: .systemFont(ofSize: 12),","    brandColor: UIColor(dynamicProvider: {","        $0.userInterfaceStyle == .dark ? .white : .black","    })",")"]},{"type":"paragraph","inlineContent":[{"text":"The primary font is used for titles, headlines, and publication names. The","type":"text"},{"text":" ","type":"text"},{"text":"secondary font covers the remaining UI. The brand color is used as an accent","type":"text"},{"text":" ","type":"text"},{"text":"throughout the SDK.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Then create a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference"},{"text":" using a ","type":"text"},{"inlineContent":[{"type":"text","text":"shortcode"}],"type":"strong"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":".dynamicArchive","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can now push, present, or embed the "},{"code":"CarouselViewController","type":"codeVoice"},{"type":"text","text":" as needed."},{"type":"text","text":" "},{"type":"text","text":"See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference","isActive":true},{"type":"text","text":" for more detail on sections, content types, and layout"},{"type":"text","text":" "},{"type":"text","text":"options."}]},{"anchor":"Manual-Configuration","type":"heading","level":3,"text":"Manual Configuration"},{"type":"paragraph","inlineContent":[{"text":"If you need to use explicit GUIDs instead of a shortcode, replace","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":".section"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".subsections"},{"text":" entry using the","type":"text"},{"text":" ","type":"text"},{"text":"appropriate content type:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Feed edition archive with an application GUID",".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))","","\/\/ Replica archive with a publication GUID",".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","isActive":true,"type":"reference"},{"text":" to determine which content type matches","type":"text"},{"text":" ","type":"text"},{"text":"your publication.","type":"text"}]},{"anchor":"Dark-Mode","type":"heading","level":2,"text":"Dark Mode"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK fully supports dark mode. To provide distinct light and dark brand"},{"type":"text","text":" "},{"type":"text","text":"colors, use a dynamic "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let brandColor = UIColor(dynamicProvider: {","    $0.userInterfaceStyle == .dark ? .white : .black","})"]},{"type":"paragraph","inlineContent":[{"text":"Alternatively, define a color in your asset catalog so the system resolves it","type":"text"},{"text":" ","type":"text"},{"text":"automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To force a specific appearance across the entire SDK, set"},{"type":"text","text":" "},{"type":"codeVoice","code":"overrideUserInterfaceStyle"},{"type":"text","text":" on the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["carouselVC.overrideUserInterfaceStyle = .dark"]},{"anchor":"Embedding-in-SwiftUI","type":"heading","level":2,"text":"Embedding in SwiftUI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrap the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"UIViewControllerRepresentable"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"use it in a SwiftUI view hierarchy:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","}"]},{"anchor":"Using-a-Coordinator-as-a-Delegate","type":"heading","level":3,"text":"Using a Coordinator as a Delegate"},{"type":"paragraph","inlineContent":[{"text":"The SDK makes wide use of delegate protocols (see ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference","isActive":true},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"When embedding in SwiftUI, you can implement delegates on a ","type":"text"},{"type":"codeVoice","code":"Coordinator"},{"text":" so their","type":"text"},{"text":" ","type":"text"},{"text":"lifecycle is tied to the representable:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ReaderView: UIViewControllerRepresentable {","    func makeCoordinator() -> Coordinator {","        Coordinator()","    }","","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\",","            navigationDelegate: context.coordinator","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","","    class Coordinator: NavigationDelegate {","        func willPresentReplicaReader() {","            \/\/ Track analytics, adjust UI state, etc.","        }","","        func willDismissReplicaReader() {","            \/\/ Restore UI state, etc.","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The same approach works for any delegate — have ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"text":" conform to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","type":"reference"},{"text":", or any combination you need and","type":"text"},{"text":" ","type":"text"},{"text":"pass ","type":"text"},{"code":"context.coordinator","type":"codeVoice"},{"text":" to the corresponding ","type":"text"},{"code":"GlobalConfiguration","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter.","type":"text"}]},{"anchor":"Headers","type":"heading","level":2,"text":"Headers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass your own header view controller, pinned above the carousel content (for"},{"type":"text","text":" "},{"type":"text","text":"example a branded title bar). Set "},{"type":"codeVoice","code":"hidesHeaderOnScroll"},{"type":"text","text":" to have the SDK slide it"},{"type":"text","text":" "},{"type":"text","text":"away as the content scrolls and reveal it again when scrolling back up or"},{"type":"text","text":" "},{"type":"text","text":"changing page:"}]},{"syntax":"swift","type":"codeListing","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.hidesHeaderOnScroll = true","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: myHeaderViewController,","    sections: [ \/* ... *\/ ]",")"]},{"anchor":"Presenting-Modally","type":"heading","level":2,"text":"Presenting Modally"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you present the carousel modally, you’ll need to give users a way to close"},{"type":"text","text":" "},{"type":"text","text":"it — typically a close button in your header, which you’re free to build"},{"type":"text","text":" "},{"type":"text","text":"yourself."}]},{"type":"paragraph","inlineContent":[{"text":"For this common case the SDK also offers a prebuilt option:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController"},{"text":" provides a ready-made close button that dismisses","type":"text"},{"text":" ","type":"text"},{"text":"the carousel on tap (or calls your ","type":"text"},{"code":"onClose","type":"codeVoice"},{"text":"). Keep ","type":"text"},{"code":"hidesHeaderOnScroll","type":"codeVoice"},{"text":" at its","type":"text"},{"text":" ","type":"text"},{"text":"default of ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" so the button stays reachable:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: PSReaderUI.DismissHeaderViewController(),","    sections: [ \/* ... *\/ ]",")","","present(carouselVC, animated: true)"]},{"type":"paragraph","inlineContent":[{"text":"If you are embedding the carousel inside your own ","type":"text"},{"code":"UINavigationController","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"set ","type":"text"},{"code":"embedInNavigationController","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" on the carousel configuration","type":"text"},{"text":" ","type":"text"},{"text":"to prevent the SDK from creating a second navigation controller, which would","type":"text"},{"text":" ","type":"text"},{"text":"result in double navigation bars:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["carouselConfig.embedInNavigationController = false"]},{"anchor":"App-Store-Compliance","type":"heading","level":2,"text":"App Store Compliance"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Export Compliance","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" use any non-standard encryption and will not affect export controls."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Privacy Compliance","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The SDK does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" collect any private information and will not affect privacy compliance.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Required Info.plist Keys","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"The SDK uses the Apryse library to render PDFs, which is preferred over Core","type":"text"},{"text":" ","type":"text"},{"text":"Graphics for its closer adherence to PDF standards. Add the following keys to","type":"text"},{"text":" ","type":"text"},{"text":"your app’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"Info.plist","type":"text"}]},{"text":":","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For more information, see the Apryse documentation:","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/docs.apryse.com\/ios\/guides\/get-started\/integration?tab=spm","isActive":true}]},{"syntax":"xml","type":"codeListing","code":["<key>NSCameraUsageDescription<\/key>","<string>This will allow you to use the image from your camera.<\/string>","<key>NSPhotoLibraryAddUsageDescription<\/key>","<string>This will allow you to add images to your photo library.<\/string>","<key>NSPhotoLibraryUsageDescription<\/key>","<string>This will allow you to create signatures and annotations from images in your photo library.<\/string>","<key>NSBluetoothAlwaysUsageDescription<\/key>","<string>This will allow us to detect if an Apple Pencil is paired, enabling palm rejection and the ability to scroll with one finger while annotating.<\/string>","<key>NSBluetoothPeripheralUsageDescription<\/key>","<string>This will allow us detect if an Apple Pencil is paired, enabling palm rejection and the ability t