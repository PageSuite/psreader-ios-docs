{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/getting-started"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/getting-started"]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"role":"article","modules":[{"name":"PSReaderUI"}],"title":"Getting Started","roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Demo-Project"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"abstract":[{"type":"text","text":"The PSReaderUI SDK provides a flexible, modern UI for integrating the PageSuite"},{"type":"text","text":" "},{"type":"text","text":"PSReader SDK into your application."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"This guide walks you through installation, credentials, SDK initialization, and"},{"type":"text","text":" "},{"type":"text","text":"launching your first reader experience. By the end you will have a working"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"type":"text","text":" displaying your publication editions."}],"type":"paragraph"},{"text":"Installation","type":"heading","level":2,"anchor":"Installation"},{"inlineContent":[{"type":"text","text":"We support three installation methods for integrating the SDK into your iOS app:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual installation","type":"text"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Swift Package Manager (SPM)"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"CocoaPods","type":"text"}]}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"text":"1. Manual Installation","type":"heading","level":3,"anchor":"1-Manual-Installation"},{"inlineContent":[{"text":"Manually install the provided ","type":"text"},{"code":"PSReaderUI.xcframework","type":"codeVoice"},{"text":" and its dependencies by dragging and dropping them into your Xcode project.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"PSReaderUI.xcframework","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"PSReader.xcframework"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"PDFNet.xcframework"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Tools.xcframework"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Ensure the frameworks are set to "},{"type":"strong","inlineContent":[{"type":"text","text":"Embed and Sign"}]},{"type":"text","text":" in your Xcode project settings."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"2-Swift-Package-Manager","type":"heading","text":"2. Swift Package Manager","level":3},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Package URL:","type":"text"}]}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["https:\/\/github.com\/PageSuite\/psreader-swift-package.git"]},{"inlineContent":[{"type":"text","text":"To integrate:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > Add Packages…"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enter the repository URL above."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the desired version\/range and add the package to your target."}]}]}]},{"type":"thematicBreak"},{"anchor":"3-CocoaPods","type":"heading","text":"3. CocoaPods","level":3},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Specs repository:","type":"text"}]}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["https:\/\/github.com\/PageSuite\/psreader-specs.git"]},{"inlineContent":[{"text":"Example ","type":"text"},{"type":"codeVoice","code":"Podfile"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"ruby","type":"codeListing","code":["source 'https:\/\/github.com\/PageSuite\/psreader-specs.git'","","target 'YourAppTarget' do","  use_frameworks!","","  pod 'PDFTron', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron\/11.5.0.85515.podspec'","  pod 'PDFTronTools', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron-tools\/11.5.0.85515.podspec'","  pod 'PSReaderUI2'","end"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Note","type":"text"}]},{"type":"text","text":": The Apryse SDK integration is slightly non-standard. We recommend pinning it to version "},{"type":"codeVoice","code":"11.5.0.85515"},{"type":"text","text":", as this is the version we have tested internally."}]}],"style":"note","type":"aside","name":"Note"},{"level":2,"text":"Versioning","type":"heading","anchor":"Versioning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Starting in 2026, the SDK uses a calendar-based versioning scheme to align"},{"type":"text","text":" "},{"type":"text","text":"with the rest of the PageSuite product line. Versions follow the format"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"year.month.patch"}],"type":"strong"},{"type":"text","text":" — for example, "},{"code":"26.1.0","type":"codeVoice"},{"type":"text","text":" is the first January 2026"},{"type":"text","text":" "},{"type":"text","text":"release."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This scheme does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" follow semantic versioning. While we strive to"},{"type":"text","text":" "},{"type":"text","text":"maintain API stability, breaking changes may occur in any release without a"},{"type":"text","text":" "},{"type":"text","text":"major version bump. We recommend pinning to a specific version and reviewing"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log","isActive":true},{"type":"text","text":" before upgrading."}]},{"level":2,"text":"Credentials","type":"heading","anchor":"Credentials"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use the PSReaderUI SDK you need the following credentials. Contact your"},{"type":"text","text":" "},{"type":"text","text":"PageSuite account manager or check the PageSuite portal to obtain them."}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Credential","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"API Key"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Authenticates your app with the PageSuite backend."}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Account GUID","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Identifies your account.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shortcode"}]},{"text":" (recommended)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A short identifier that maps to your publication configuration. Use with ","type":"text"},{"code":".dynamicArchive","type":"codeVoice"},{"text":" to load content automatically.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Application GUID"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Identifies a specific feed edition publication."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Publication GUID"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Identifies a specific replica publication.","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"inlineContent":[{"text":"Shortcode is the recommended approach.","type":"text"}],"type":"strong"},{"text":" It lets the SDK fetch your","type":"text"},{"text":" ","type":"text"},{"text":"publication configuration dynamically, so you don’t need to manage GUIDs","type":"text"},{"text":" ","type":"text"},{"text":"yourself.","type":"text"}]}],"style":"tip","type":"aside","name":"Tip"},{"level":2,"text":"Initialize the SDK","type":"heading","anchor":"Initialize-the-SDK"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The PSReader SDK must be globally initialized before it can be used. Call this"},{"type":"text","text":" "},{"type":"text","text":"method early in your app lifecycle to optimize reader launch speed. You only"},{"type":"text","text":" "},{"type":"text","text":"need to call this method once."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The completion handler is only used to return a status flag. It is not required"},{"type":"text","text":" "},{"type":"text","text":"and it is not necessary to wait for the completion handler before continuing."}]},{"type":"paragraph","inlineContent":[{"text":"This method will only fail if the API key is invalid.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import PSReaderUI","","PSReader.initialize(apiKey: apiKey, completion: { success in","    \/\/ Note: The completion handler may be called on any thread.","})"]},{"level":2,"text":"Quick Start","type":"heading","anchor":"Quick-Start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true},{"type":"text","text":" with your credentials and basic theming:"}]},{"syntax":"swift","type":"codeListing","code":["import PSReaderUI","","let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID,","    primaryFont: .systemFont(ofSize: 12),","    secondaryFont: .systemFont(ofSize: 12),","    brandColor: UIColor(dynamicProvider: {","        $0.userInterfaceStyle == .dark ? .white : .black","    })",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The primary font is used for titles, headlines, and publication names. The"},{"type":"text","text":" "},{"type":"text","text":"secondary font covers the remaining UI. The brand color is used as an accent"},{"type":"text","text":" "},{"type":"text","text":"throughout the SDK."}]},{"type":"paragraph","inlineContent":[{"text":"Then create a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"text":" using a ","type":"text"},{"type":"strong","inlineContent":[{"text":"shortcode","type":"text"}]},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can now push, present, or embed the "},{"code":"CarouselViewController","type":"codeVoice"},{"type":"text","text":" as needed."},{"type":"text","text":" "},{"type":"text","text":"See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference","isActive":true},{"type":"text","text":" for more detail on sections, content types, and layout"},{"type":"text","text":" "},{"type":"text","text":"options."}]},{"level":3,"text":"Manual Configuration","type":"heading","anchor":"Manual-Configuration"},{"type":"paragraph","inlineContent":[{"text":"If you need to use explicit GUIDs instead of a shortcode, replace","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":".section"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".subsections"},{"text":" entry using the","type":"text"},{"text":" ","type":"text"},{"text":"appropriate content type:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Feed edition archive with an application GUID",".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))","","\/\/ Replica archive with a publication GUID",".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","isActive":true,"type":"reference"},{"type":"text","text":" to determine which content type matches"},{"type":"text","text":" "},{"type":"text","text":"your publication."}]},{"level":2,"text":"Dark Mode","type":"heading","anchor":"Dark-Mode"},{"type":"paragraph","inlineContent":[{"text":"The SDK fully supports dark mode. To provide distinct light and dark brand","type":"text"},{"text":" ","type":"text"},{"text":"colors, use a dynamic ","type":"text"},{"type":"codeVoice","code":"UIColor"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let brandColor = UIColor(dynamicProvider: {","    $0.userInterfaceStyle == .dark ? .white : .black","})"]},{"type":"paragraph","inlineContent":[{"text":"Alternatively, define a color in your asset catalog so the system resolves it","type":"text"},{"text":" ","type":"text"},{"text":"automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To force a specific appearance across the entire SDK, set","type":"text"},{"text":" ","type":"text"},{"code":"overrideUserInterfaceStyle","type":"codeVoice"},{"text":" on the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["carouselVC.overrideUserInterfaceStyle = .dark"]},{"level":2,"text":"Embedding in SwiftUI","type":"heading","anchor":"Embedding-in-SwiftUI"},{"type":"paragraph","inlineContent":[{"text":"Wrap the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true,"type":"reference"},{"text":" in a ","type":"text"},{"code":"UIViewControllerRepresentable","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"use it in a SwiftUI view hierarchy:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","}"]},{"level":3,"text":"Using a Coordinator as a Delegate","type":"heading","anchor":"Using-a-Coordinator-as-a-Delegate"},{"type":"paragraph","inlineContent":[{"text":"The SDK makes wide use of delegate protocols (see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"When embedding in SwiftUI, you can implement delegates on a ","type":"text"},{"type":"codeVoice","code":"Coordinator"},{"text":" so their","type":"text"},{"text":" ","type":"text"},{"text":"lifecycle is tied to the representable:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ReaderView: UIViewControllerRepresentable {","    func makeCoordinator() -> Coordinator {","        Coordinator()","    }","","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\",","            navigationDelegate: context.coordinator","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","","    class Coordinator: NavigationDelegate {","        func willPresentReplicaReader() {","            \/\/ Track analytics, adjust UI state, etc.","        }","","        func willDismissReplicaReader() {","            \/\/ Restore UI state, etc.","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The same approach works for any delegate — have ","type":"text"},{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" conform to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate"},{"type":"text","text":", or any combination you need and"},{"type":"text","text":" "},{"type":"text","text":"pass "},{"type":"codeVoice","code":"context.coordinator"},{"text":" to the corresponding ","type":"text"},{"code":"GlobalConfiguration","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter.","type":"text"}]},{"level":2,"text":"Headers","type":"heading","anchor":"Headers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass your own header view controller, pinned above the carousel content (for"},{"type":"text","text":" "},{"type":"text","text":"example a branded title bar). Set "},{"type":"codeVoice","code":"hidesHeaderOnScroll"},{"type":"text","text":" to have the SDK slide it"},{"type":"text","text":" "},{"type":"text","text":"away as the content scrolls and reveal it again when scrolling back up or"},{"type":"text","text":" "},{"type":"text","text":"changing page:"}]},{"syntax":"swift","type":"codeListing","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.hidesHeaderOnScroll = true","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: myHeaderViewController,","    sections: [ \/* ... *\/ ]",")"]},{"level":2,"text":"Presenting Modally","type":"heading","anchor":"Presenting-Modally"},{"type":"paragraph","inlineContent":[{"text":"When you present the carousel modally, you’ll need to give users a way to close","type":"text"},{"text":" ","type":"text"},{"text":"it — typically a close button in your header, which you’re free to build","type":"text"},{"text":" ","type":"text"},{"text":"yourself.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For this common case the SDK also offers a prebuilt option:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController","isActive":true,"type":"reference"},{"text":" provides a ready-made close button that dismisses","type":"text"},{"text":" ","type":"text"},{"text":"the carousel on tap (or calls your ","type":"text"},{"type":"codeVoice","code":"onClose"},{"text":"). Keep ","type":"text"},{"type":"codeVoice","code":"hidesHeaderOnScroll"},{"text":" at its","type":"text"},{"text":" ","type":"text"},{"text":"default of ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" so the button stays reachable:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: PSReaderUI.DismissHeaderViewController(),","    sections: [ \/* ... *\/ ]",")","","present(carouselVC, animated: true)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are embedding the carousel inside your own "},{"code":"UINavigationController","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"set "},{"code":"embedInNavigationController","type":"codeVoice"},{"type":"text","text":" to "},{"code":"false","type":"codeVoice"},{"type":"text","text":" on the carousel configuration"},{"type":"text","text":" "},{"type":"text","text":"to prevent the SDK from creating a second navigation controller, which would"},{"type":"text","text":" "},{"type":"text","text":"result in double navigation bars:"}]},{"syntax":"swift","type":"codeListing","code":["carouselConfig.embedInNavigationController = false"]},{"level":2,"text":"App Store Compliance","type":"heading","anchor":"App-Store-Compliance"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Export Compliance"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" use any non-standard encryption and will not affect export controls."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Privacy Compliance"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The SDK does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" collect any private information and will not affect privacy compliance.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Required Info.plist Keys"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"The SDK uses the Apryse library to render PDFs, which is preferred over Core","type":"text"},{"text":" ","type":"text"},{"text":"Graphics for its closer adherence to PDF standards. Add the following keys to","type":"text"},{"text":" ","type":"text"},{"text":"your app’s ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Info.plist"}]},{"text":":","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information, see the Apryse documentation:"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/docs.apryse.com\/ios\/guides\/get-started\/integration?tab=spm","isActive":true}]},{"syntax":"xml","type":"codeListing","code":["<key>NSCameraUsageDescription<\/key>","<string>This will allow you to use the image from your camera.<\/string>","<key>NSPhotoLibraryAddUsageDescription<\/key>","<string>This will allow you to add images to your photo library.<\/string>","<key>NSPhotoLibraryUsageDescription<\/key>","<string>This will allow you to create signatures and annotations from images in your photo library.<\/string>","<key>NSBluetoothAlwaysUsageDescription<\/key>","<string>This will allow us to detect if an Apple Pencil is paired, enabling palm rejection and the ability to scroll with one finger while annotating.<\/string>","<key>NSBluetoothPeripheralUsageDescription<\/key>","<string>This will allow us detect if an Apple Pencil is paired, enabling palm rejection and the ability to scroll with one finger while annotating.<\/string>"]}]}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Replica-and-Feed-Editions":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","kind":"article","abstract":[{"type":"text","text":"Understand the two backend systems that power PSReaderUI content."}],"role":"article","title":"Replica and Feed Editions","type":"topic","url":"\/documentation\/psreaderui\/replica-and-feed-editions"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/DismissHeaderViewController":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DismissHeaderViewController"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController","abstract":[{"text":"A prebuilt carousel header containing a single dismiss (close) button.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissHeaderViewController"}],"title":"DismissHeaderViewController","type":"topic","kind":"symbol","url":"\/documentation\/psreaderui\/dismis