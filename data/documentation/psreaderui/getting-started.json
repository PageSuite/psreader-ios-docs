sing a "},{"type":"strong","inlineContent":[{"text":"shortcode","type":"text"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can now push, present, or embed the "},{"type":"codeVoice","code":"CarouselViewController"},{"type":"text","text":" as needed."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup"},{"type":"text","text":" for more detail on sections, content types, and layout"},{"type":"text","text":" "},{"type":"text","text":"options."}]},{"type":"heading","anchor":"Manual-Configuration","text":"Manual Configuration","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to use explicit GUIDs instead of a shortcode, replace"},{"type":"text","text":" "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":" with a "},{"type":"codeVoice","code":".section"},{"type":"text","text":" or "},{"type":"codeVoice","code":".subsections"},{"type":"text","text":" entry using the"},{"type":"text","text":" "},{"type":"text","text":"appropriate content type:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Feed edition archive with an application GUID",".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))","","\/\/ Replica archive with a publication GUID",".section(.init(name: \"Editions\", type: .rep