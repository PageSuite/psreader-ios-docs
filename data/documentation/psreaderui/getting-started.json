anager (SPM)"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"CocoaPods"}],"type":"strong"}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"anchor":"1-Manual-Installation","type":"heading","level":3,"text":"1. Manual Installation"},{"inlineContent":[{"type":"text","text":"Manually install the provided "},{"code":"PSReaderUI.xcframework","type":"codeVoice"},{"type":"text","text":" and its dependencies by dragging and dropping them into your Xcode project."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"PSReaderUI.xcframework"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"PSReader.xcframework"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"PDFNet.xcframework"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tools.xcframework","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Ensure the frameworks are set to ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed and Sign"}],"type":"strong"},{"text":" in your Xcode project settings.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"2-Swift-Package-Manager","type":"heading","level":3,"text":"2. Swift Package Manager"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Package URL:"}]}],"type":"paragraph"},{"syntax":null,"code":["https:\/\/github.com\/PageSuite\/psreader-swift-package.git"],"type":"codeListing"},{"inlineContent":[{"text":"To integrate:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"text":"File > Add Packages…","type":"text"}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Enter the repository URL above."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the de