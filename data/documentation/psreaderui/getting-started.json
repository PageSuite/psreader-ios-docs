x":null},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note"}]},{"text":": Access to the Specs repository is granted via SSH. Send your public","type":"text"},{"text":" ","type":"text"},{"text":"SSH key to our team to be provisioned.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"Example ","type":"text"},{"code":"Podfile","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["source 'git@bitbucket.org:pagesuite\/psreader-specs.git'","","target 'YourAppTarget' do","  use_frameworks!","","  pod 'PDFTron', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron\/11.5.0.85515.podspec'","  pod 'PDFTronTools', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron-tools\/11.5.0.85515.podspec'","  pod 'PSReaderUI2'","end"],"type":"codeListing","syntax":"ruby"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"inlineContent":[{"text":"Note","type":"text"}],"type":"strong"},{"text":": The Apryse SDK integration is slightly non-standard. We recommend pinning it to version ","type":"text"},{"code":"11.5.0.85515","type":"codeVoice"},{"text":", as this is the version we have tested internally.","type":"text"}],"type":"paragraph"}]},{"level":2,"type":"heading","text":"Versioning","anchor":"Versioning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Starting in 2026, the SDK uses a calendar-based versioning scheme to align"},{"type":"text","text":" "},{"type":"text","text":"with the rest of the PageSuite product line. Versions follow the format"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"year.month.patch"}]},{"type":"text","text":" — for example, "},{"code":"26.1.0","type":"codeVoice"},{"type":"text","text":" is the first January 2026"},{"type":"text","text":" "},{"type":"text","text":"release."}]},{"type":"paragraph","inlineContent":[{"text":"This scheme does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" follow semantic versioning. While we strive to","type":"text"},{"text":" ","type":"text"},{"text":"maintain API stability, breaking changes may occur in any release without a","type":"text"},{"text":" ","type":"text"},{"text":"major version bump. We recommend pinning to a specific version and reviewing","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log","type":"reference"},{"text":" before upgrading.","type":"text"}]},{"level":2,"type":"heading","text":"Credentials","anchor":"Credentials"},{"type":"paragraph","inlineContent":[{"text":"To use the PSReaderUI SDK you need the following credentials. Contact your","type":"text"},{"type":"text","text":" "},{"type":"text","text":"PageSuite account manager or check the PageSuite portal to obtain them."}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Credential","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"API Key","type":"text"}]}]}],[{"inlineContent":[{"type":"text","text":"Authenticates your app with the PageSuite backend."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Account GUID"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Identifies your account.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Shortcode","type":"text"}],"type":"strong"},{"type":"text","text":" (recommended)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A short identifier that maps to your publication configuration. Use with "},{"code":".dynamicArchive","type":"codeVoice"},{"type":"text","text":" to load content automatically."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Application GUID"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Identifies a specific feed edition publication.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Publication GUID"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Identifies a specific replica publication.","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Shortcode is the recommended approach."}]},{"text":" It lets the SDK fetch your","type":"text"},{"text":" ","type":"text"},{"text":"publication configuration dynamically, so you don’t need to manage GUIDs","type":"text"},{"text":" ","type":"text"},{"text":"yourself.","type":"text"}],"type":"paragraph"}]},{"level":2,"type":"heading","text":"Initialize the SDK","anchor":"Initialize-the-SDK"},{"type":"paragraph","inlineContent":[{"text":"The PSReader SDK must be globally initialized before it can be used. Call this","type":"text"},{"text":" ","type":"text"},{"text":"method early in your app lifecycle to optimize reader launch speed. You only","type":"text"},{"text":" ","type":"text"},{"text":"need to call this method once.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The completion handler is only used to return a status flag. It is not required"},{"type":"text","text":" "},{"type":"text","text":"and it is not necessary to wait for the completion handler before continuing."}]},{"type":"paragraph","inlineContent":[{"text":"This method will only fail if the API key is invalid.","type":"text"}]},{"code":["import PSReaderUI","","PSReader.initialize(apiKey: apiKey, completion: { success in","    \/\/ Note: The completion handler may be called on any thread.","})"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Quick Start","anchor":"Quick-Start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"type":"text","text":" with your credentials and basic theming:"}]},{"code":["import PSReaderUI","","let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID,","    primaryFont: .systemFont(ofSize: 12),","    secondaryFont: .systemFont(ofSize: 12),","    brandColor: UIColor(dynamicProvider: {","        $0.userInterfaceStyle == .dark ? .white : .black","    })",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The primary font is used for titles, headlines, and publication names. The"},{"type":"text","text":" "},{"type":"text","text":"secondary font covers the remaining UI. The brand color is used as an accent"},{"type":"text","text":" "},{"type":"text","text":"throughout the SDK."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":" using a "},{"type":"strong","inlineContent":[{"type":"text","text":"shortcode"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":":"}]},{"code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can now push, present, or embed the "},{"type":"codeVoice","code":"CarouselViewController"},{"type":"text","text":" as needed."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","isActive":true},{"type":"text","text":" for more detail on sections, content types, and layout"},{"type":"text","text":" "},{"type":"text","text":"options."}]},{"level":3,"type":"heading","text":"Manual Configuration","anchor":"Manual-Configuration"},{"type":"paragraph","inlineContent":[{"text":"If you need to use explicit GUIDs instead of a shortcode, replace","type":"text"},{"text":" ","type":"text"},{"code":".dynamicArchive","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":".section","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".subsections","type":"codeVoice"},{"text":" entry using the","type":"text"},{"text":" ","type":"text"},{"text":"appropriate content type:","type":"text"}]},{"code":["\/\/ Feed edition archive with an application GUID",".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))","","\/\/ Replica archive with a publication GUID",".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},{"type":"text","text":" to determine which content type matches"},{"type":"text","text":" "},{"type":"text","text":"your publication."}]},{"level":2,"type":"heading","text":"Dark Mode","anchor":"Dark-Mode"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK fully supports dark mode. To provide distinct light and dark brand"},{"type":"text","text":" "},{"type":"text","text":"colors, use a dynamic "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":":"}]},{"code":["let brandColor = UIColor(dynamicProvider: {","    $0.userInterfaceStyle == .dark ? .white : .black","})"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, define a color in your asset catalog so the system resolves it"},{"type":"text","text":" "},{"type":"text","text":"automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To force a specific appearance across the entire SDK, set"},{"type":"text","text":" "},{"code":"overrideUserInterfaceStyle","type":"codeVoice"},{"type":"text","text":" on the "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"type":"text","text":":"}]},{"code":["carouselVC.overrideUserInterfaceStyle = .dark"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Embedding in SwiftUI","anchor":"Embedding-in-SwiftUI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrap the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true},{"type":"text","text":" in a "},{"type":"codeVoice","code":"UIViewControllerRepresentable"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"use it in a SwiftUI view hierarchy:"}]},{"code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )",