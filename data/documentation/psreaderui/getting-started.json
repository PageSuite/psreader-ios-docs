e same approach works for any delegate — have "},{"type":"codeVoice","code":"Coordinator"},{"text":" conform to","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true},{"text":", or any combination you need and","type":"text"},{"text":" ","type":"text"},{"text":"pass ","type":"text"},{"type":"codeVoice","code":"context.coordinator"},{"type":"text","text":" to the corresponding "},{"type":"codeVoice","code":"GlobalConfiguration"},{"type":"text","text":" "},{"type":"text","text":"parameter."}]},{"level":2,"type":"heading","text":"Presenting Modally","anchor":"Presenting-Modally"},{"type":"paragraph","inlineContent":[{"text":"When presenting the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"text":" modally, add a dismiss button","type":"text"},{"text":" ","type":"text"},{"text":"so users can close it:","type":"text"}]},{"code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    sections: [ \/* ... *\/ ]",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are embedding the carousel inside your own "},{"type":"codeVoice","code":"UINavigationController"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"set "},{"type":"codeVoice","code":"embedInNavigationController"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on the carousel configurat