Config = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\",","            navigationDelegate: context.coordinator","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","","    class Coordinator: NavigationDelegate {","        func willPresentReplicaReader() {","            \/\/ Track analytics, adjust UI state, etc.","        }","","        func willDismissReplicaReader() {","            \/\/ Restore UI state, etc.","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The same approach works for any delegate — have "},{"code":"Coordinator","type":"codeVoice"},{"text":" conform to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true,"type":"reference"},{"text":", or any combination you need and","type":"text"},{"text":" ","type":"text"},{"text":"pass ","type":"text"},{"code":"context.coordinator","type":"codeVoice"},{"text":" to the corresponding ","type":"text"},{"type":"codeVoice","code":"GlobalConfiguration"},{"text":" ","type":"text"},{"text":"parameter.","type":"text"}],"type":"paragraph"},{"anchor":"Presenting-Modally","type":"heading","text":"Presenting Modally","level":2},{"inlineContent":[{"text":"When presenting the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference"},{"text":" modally, add a dismiss button","type":"text"},{"text":" ","type":"text"},{"text":"so users can close it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    sections: [ \/* ... *\/ ]",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you are embedding the carousel inside your own "},{"code":"UINavigationController","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"set "},{"code":"embedInNavigationController","type":"codeVoice"},{"type":"text","text":" to "},{"code":"false","type":"codeVoice"},{"type":"text","text":" on the carousel configuration"},{"type":"text","text":" "},{"type":"text","text":"to prevent the SDK from creating a second navigation controller, which would"},{"type":"text","text":" "},{"type":"text","text":"result in double navigation bars:"}],"type":"paragraph"},{"syntax":"swift","code":["carouselConfig.embedInNavigationController = false"],"type":"codeListing"},{"anchor":"App-Store-Compliance","type":"heading","text":"App Store Compliance","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Export Compliance","type":"text"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The SDK does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" use any non-standard encryption and will not affect export controls."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Privacy Compliance","type":"text"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The SDK does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}]