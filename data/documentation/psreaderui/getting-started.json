f the PageSuite product line. Versions follow the format","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"year.month.patch","type":"text"}],"type":"strong"},{"text":" — for example, ","type":"text"},{"code":"26.1.0","type":"codeVoice"},{"text":" is the first January 2026","type":"text"},{"text":" ","type":"text"},{"text":"release.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This scheme does ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" follow semantic versioning. While we strive to","type":"text"},{"text":" ","type":"text"},{"text":"maintain API stability, breaking changes may occur in any release without a","type":"text"},{"text":" ","type":"text"},{"text":"major version bump. We recommend pinning to a specific version and reviewing","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log","isActive":true,"type":"reference"},{"text":" before upgrading.","type":"text"}],"type":"paragraph"},{"anchor":"Credentials","type":"heading","level":2,"text":"Credentials"},{"inlineContent":[{"type":"text","text":"To use the PSReaderUI SDK you need the following credentials. Contact your"},{"type":"text","text":" "},{"type":"text","text":"PageSuite account manager or check the PageSuite portal to obtain them."}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Credential"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"API Key","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Authenticates your app with the PageSuite backend."}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Account GUID","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Identifies your account."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shortcode"}]},{"type":"text","text":" (recommended)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A short identifier that maps to your publication configuration. Use with "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":" to load content automatically."}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Application GUID"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Identifies a specific feed edition publication.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Publication GUID","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Identifies a specific replica publication."}],"type":"paragraph"}]]]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"strong","inlineContent":[{"type":"text","text":"Shortcode is the recommended approach."}]},{"type":"text","text":" It lets the SDK fetch your"},{"type":"text","text":" "},{"type":"text","text":"publication configuration dynamically, so you don’t need to manage GUIDs"},{"type":"text","text":" "},{"type":"text","text":"yourself."}]}],"type":"aside","style":"tip","name":"Tip"},{"anchor":"Initialize-the-SDK","type":"heading","level":2,"text":"Initialize the SDK"},{"inlineContent":[{"text":"The PSReader SDK must be globally initialized before it can be used. Call this","type":"text"},{"text":" ","type":"text"},{"text":"method early in your app lifecycle to optimize reader launch speed. You only","type":"text"},{"text":" ","type":"text"},{"text":"need to call this method once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The completion handler is only used to return a status flag. It is not required"},{"type":"text","text":" "},{"type":"text","text":"and it is not necessary to wait for the completion handler before continuing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method will only fail if the API key is invalid."}],"type":"paragraph"},{"syntax":"swift","code":["import PSReaderUI","","PSReader.initialize(apiKey: apiKey, completion: { success in","    \/\/ Note: The completion handler may be called on any thread.","})"],"type":"codeListing"},{"anchor":"Quick-Start","type":"heading","level":2,"text":"Quick Start"},{"inlineContent":[{"type":"text","text":"Create a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true,"type":"reference"},{"type":"text","text":" with your credentials and basic theming:"}],"type":"paragraph"},{"syntax":"swift","code":["import PSReaderUI","","let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID,","    primaryFont: .systemFont(ofSize: 12),","    secondaryFont: .systemFont(ofSize: 12),","    brandColor: UIColor(dynamicProvider: {","        $0.userInterfaceStyle == .dark ? .white : .black","    })",")"],"type":"codeListing"},{"inlineContent":[{"text":"The primary font is used for titles, headlines, and publication names. The","type":"text"},{"text":" ","type":"text"},{"text":"secondary font covers the remaining UI. The brand color is used as an accent","type":"text"},{"text":" ","type":"text"},{"text":"throughout the SDK.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Then create a "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true,"type":"reference"},{"type":"text","text":" using a "},{"inlineContent":[{"type":"text","text":"shortcode"}],"type":"strong"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":".dynamicArchive","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"type":"codeListing"},{"inlineContent":[{"text":"You can now push, present, or embed the ","type":"text"},{"type":"codeVoice","code":"CarouselViewController"},{"type":"text","text":" as needed."},{"type":"text","text":" "},{"type":"text","text":"See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference","isActive":true},{"type":"text","text":" for more detail on sections, content types, and layout"},{"type":"text","text":" "},{"type":"text","text":"options."}],"type":"paragraph"},{"anchor":"Manual-Configuration","type":"heading","level":3,"text":"Manual Configuration"},{"inlineContent":[{"type":"text","text":"If you need to use explicit GUIDs instead of a shortcode, replace"},{"type":"text","text":" "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":" with a "},{"type":"codeVoice","code":".section"},{"type":"text","text":" or "},{"type":"codeVoice","code":".subsections"},{"type":"text","text":" entry using the"},{"type":"text","text":" "},{"type":"text","text":"appropriate content type:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Feed edition archive with an application GUID",".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))","","\/\/ Replica archive with a publication GUID",".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"],"type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","type":"reference"},{"text":" to determine which content type matches","type":"text"},{"text":" ","type":"text"},{"text":"your publication.","type":"text"}],"type":"paragraph"},{"anchor":"Dark-Mode","type":"heading","level":2,"text":"Dark Mode"},{"inlineContent":[{"type":"text","text":"The SDK fully supports dark mode. To provide distinct light and dark brand"},{"type":"text","text":" "},{"type":"text","text":"colors, use a dynamic "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let brandColor = UIColor(dynamicProvider: {","    $0.userInterfaceStyle == .dark ? .white : .black","})"],"type":"codeListing"},{"inlineContent":[{"text":"Alternatively, define a color in your asset catalog so the system resolves it","type":"text"},{"text":" ","type":"text"},{"text":"automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To force a specific appearance across the entire SDK, set","type":"text"},{"text":" ","type":"text"},{"code":"overrideUserInterfaceStyle","type":"codeVoice"},{"text":" on the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["carouselVC.overrideUserInterfaceStyle = .dark"],"type":"codeListing"},{"anchor":"Embedding-in-SwiftUI","type":"heading","level":2,"text":"Embedding in SwiftUI"},{"inlineContent":[{"type":"text","text":"Wrap the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":" in a "},{"code":"UIViewControllerRepresentable","type":"codeVoice"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"use it in a SwiftUI view hierarchy:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(contex