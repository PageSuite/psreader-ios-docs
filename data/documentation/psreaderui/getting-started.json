I.CarouselViewController, context: Context) {}","","    class Coordinator: NavigationDelegate {","        func willPresentReplicaReader() {","            \/\/ Track analytics, adjust UI state, etc.","        }","","        func willDismissReplicaReader() {","            \/\/ Restore UI state, etc.","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The same approach works for any delegate — have ","type":"text"},{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" conform to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","isActive":true},{"type":"text","text":", or any combination you need and"},{"type":"text","text":" "},{"type":"text","text":"pass "},{"type":"codeVoice","code":"context.coordinator"},{"text":" to the corresponding ","type":"text"},{"type":"codeVoice","code":"GlobalConfiguration"},{"text":" ","type":"text"},{"text":"parameter.","type":"text"}],"type":"paragraph"},{"anchor":"Presenting-Modally","type":"heading","level":2,"text":"Presenting Modally"},{"inlineContent":[{"type":"text","text":"When presenting the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":" modally, add a dismiss button"},{"type":"text","text":" "},{"type":"text","text":"so users can close it:"}],"type":"paragraph"},{"syntax":"swift","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    sections: [ \/* ... *\/ ]",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you are embedding the carousel inside your own "},{"type":"codeVoice","code":"UINavigationController"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"set "},{"type":"codeVoice","code":"embedInNavigationController"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" on the carousel configuration"},{"type":"text","text":" "},{"type":"text","text":"to prevent the SDK from creating a second navigation controller, which would"},{"type":"text","text":" "},{"type":"text","text":"result in double navigation bars:"}],"type":"paragraph"},{"syntax":"swift","code":["carouselConfig.embedInNavigationController = false"],"type":"codeListing"},{"anchor":"App-Store-Compliance","type":"heading","level":2,"text":"App Store Compliance"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Export Compliance"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" use any non-standard encryption and will not affect export controls."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Privacy Compliance"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The SDK does ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" collect any private information and will not affect privacy compliance.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Required Info.plist Keys","type":"text"}]}],"type":"paragraph"},{"inlineContent":[{"text":"The SDK uses the Apryse library to render PDFs, which is preferred over Core","type":"text"},{"text":" ","type":"text"},{"text":"Graphics for its closer adherence to PDF standards. Add the following keys to","