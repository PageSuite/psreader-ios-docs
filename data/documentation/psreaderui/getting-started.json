ods"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Specs repository:"}],"type":"strong"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["git@bitbucket.org:pagesuite\/psreader-specs.git"]},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Note"}],"type":"strong"},{"text":": The Apryse SDK integration is slightly non-standard. We recommend pinning it to version ","type":"text"},{"code":"11.6.0.85755","type":"codeVoice"},{"text":", as this is the version we have tested internally.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"text":"Example ","type":"text"},{"code":"Podfile","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"ruby","code":["source 'git@bitbucket.org:pagesuite\/psreader-specs.git'","","target 'YourAppTarget' do","  use_frameworks!","","  pod 'PDFTron', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron\/11.3.0.85075.podspec'","  pod 'PDFTronTools', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron-tools\/11.3.0.85075.podspec'","  pod 'PSReaderUI2'","end"]},{"type":"thematicBreak"},{"level":3,"text":"3. Swift Package Manager","type":"heading","anchor":"3-Swift-Package-Manager"},{"inlineContent":[{"inlineContent":[{"text":"Package URL:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["git@bitbucket.org:pagesuite\/psreader-swift-package.git"]},{"inlineContent":[{"text":"To integrate:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"type":"text","text":"File > Add Packages…"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enter the repository URL above.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Authenticate via SSH (make sure you have been granted access).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the desired version\/range and add the package to your target."}],"type":"paragraph"}]}]},{"level":2,"text":"Versioning","type":"heading","anchor":"Versioning"},{"inlineContent":[{"text":"Starting in 2026, the SDK uses a calendar-based versioning scheme to align","type":"text"},{"text":" ","type":"text"},{"text":"with the rest of the PageSuite product line. Versions follow the format","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"year.month.patch"}]},{"text":" — for example, ","type":"text"},{"type":"codeVoice","code":"26.1.0"},{"text":" is the first January 2026","type":"text"},{"text":" ","type":"text"},{"text":"release.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This scheme does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" follow semantic versioning. While we strive to","type":"text"},{"text":" ","type":"text"},{"text":"maintain API stability, breaking changes may occur in any release without a","type":"text"},{"text":" ","type":"text"},{"text":"major version bump. We recommend pinning to a specific version and reviewing","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Change-Log","type":"reference","isActive":true},{"text":" before upgrading.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Credentials","type":"heading","anchor":"Credentials"},{"inlineContent":[{"text":"To use the PSReaderUI SDK you need the following credentials. Contact your","type":"text"},{"text":" ","type":"text"},{"text":"PageSuite account manager or check the PageSuite portal to obtain them.","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Credential","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"API Key"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Authenticates your app with the PageSuite backend."}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Account GUID"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Identifies your account.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shortcode"}]},{"text":" (recommended)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A short identifier that maps to your publication configuration. Use with "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":" to load content automatically."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Application GUID"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Identifies a specific feed edition publication."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Publication GUID","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Identifies a specific replica publication."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"strong","inlineContent":[{"type":"text","text":"Shortcode is the recommended approach."}]},{"type":"text","text":" It lets the SDK fetch your"},{"type":"text","text":" "},{"type":"text","text":"publication configuration dynamically, so you don’t need to manage GUIDs"},{"text":" ","type":"text"},{"text":"yourself.","type":"text"}]}],"type":"aside"},{"level":2,"text":"Initialize the SDK","type":"heading","anchor":"Initialize-the-SDK"},{"inlineContent":[{"type":"text","text":"The PSReader SDK must be globally initialized before it can be used. Call this"},{"type":"text","text":" "},{"type":"text","text":"method early in your app lifecycle to optimize reader launch speed. You only"},{"type":"text","text":" "},{"type":"text","text":"need to call this method once."}],"type":"paragraph"},{"inlineContent":[{"text":"The completion handler is only used to return a status flag. It is not required","type":"text"},{"text":" ","type":"text"},{"text":"and it is not necessary to wait for the completion handler before continuing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method will only fail if the API key is invalid.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import PSReaderUI","","PSReader.initialize(apiKey: apiKey, completion: { success in","    \/\/ Note: The completion handler may be called on any thread.","})"]},{"level":2,"text":"Quick Start","type":"heading","anchor":"Quick-Start"},{"inlineContent":[{"type":"text","text":"Create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration"},{"type":"text","text":" with your credentials and basic theming:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import PSReaderUI","","let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID,","    primaryFont: .systemFont(ofSize: 12),","    secondaryFont: .systemFont(ofSize: 12),","    brandColor: UIColor(dynamicProvider: {","        $0.userInterfaceStyle == .dark ? .white : .black","    })",")"]},{"inlineContent":[{"type":"text","text":"The primary font is used for titles, headlines, and publication names. The"},{"type":"text","text":" "},{"type":"text","text":"secondary font covers the remaining UI. The brand color is used as an accent"},{"type":"text","text":" "},{"type":"text","text":"throughout the SDK."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Then create a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true},{"type":"text","text":" using a "},{"type":"strong","inlineContent":[{"type":"text","text":"shortcode"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"]},{"inlineContent":[{"type":"text","text":"You can now push, present, or embed the "},{"code":"CarouselViewController","type":"codeVoice"},{"type":"text","text":" as needed."},{"type":"text","text":" "},{"type":"text","text":"See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference","isActive":true},{"type":"text","text":" for more detail on sections, content types, and layout"},{"type":"text","text":" "},{"type":"text","text":"options."}],"type":"paragraph"},{"level":3,"text":"Manual Configuration","type":"heading","anchor":"Manual-Configuration"},{"inlineContent":[{"text":"If you need to use explicit GUIDs instead of a shortcode, replace","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":".section"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".subsections"},{"text":" entry using the","type":"text"},{"text":" ","type":"text"},{"text":"appropriate content type:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Feed edition archive with an application GUID",".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))","","\/\/ Replica archive with a publication GUID",".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"]},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","isActive":true},{"type":"text","text":" to determine which content type matches"},{"type":"text","text":" "},{"type":"text","text":"your publication."}],"type":"paragraph"},{"level":2,"text":"Dark Mode","type":"heading","anchor":"Dark-Mode"},{"inlineContent":[{"type":"text","text":"The SDK fully supports dark mode. To provide distinct light and dark brand"},{"type":"text","text":" "},{"type":"text","text":"colors, use a dynamic "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let brandColor = UIColor(dynamicProvider: {","    $0.userInterfaceStyle == .dark ? .white : .black","})"]},{"inlineContent":[{"type":"text","text":"Alternatively, define a color in your asset catalog so the system resolves it"},{"type":"text","text":" "},{"type":"text","text":"automatically."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To force a specific appearance across the entire SDK, set"},{"type":"text","text":" "},{"type":"codeVoice","code":"overrideUserInterfaceStyle"},{"type":"text","text":" on the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["carouselVC.overrideUserInterfaceStyle = .dark"]},{"level":2,"text":"Embedding in SwiftUI","type":"heading","anchor":"Embedding-in-SwiftUI"},{"inlineContent":[{"text":"Wrap the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"text":" in a ","type":"text"},{"code":"UIViewControllerRepresentable","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"use it in a SwiftUI view hierarchy:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","}"]},{"level":3,"text":"Using a Coordinator as a Delegate","type":"heading","anchor":"Using-a-Coordinator-as-a-Delegate"},{"inlineContent":[{"type":"text","text":"The SDK makes wide use of delegate protocols (see "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"When embedding in SwiftUI, you can implement delegates on a "},{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" so their"},{"type":"text","text":" "},{"type":"text","text":"lifecycle is tied to the representable:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ReaderView: UIViewControllerRepresentable {","    func makeCoordinator() -> Coordinator {","        Coordinator()","    }","","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\",","            navigationDelegate: context.coordinator","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","","    class Coordinator: NavigationDelegate {","        func willPresentReplicaReader() {","            \/\/ Track analytics, adjust UI state, etc.","        }","","        func willDismissReplicaReader() {","            \/\/ Restore UI state, etc.","        }","    }","}"]},{"inlineContent":[{"text":"The same approach works for any delegate — have ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"type":"text","text":" conform to"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/PaywallDelegate","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ShareDelegate","type":"reference","isActive":true},{"type":"text","text":", or any combination you need and"},{"type":"text","text":" "},{"type":"text","text":"pass "},{"code":"context.coordinator","type":"codeVoice"},{"type":"text","text":" to the corresponding "},{"type":"codeVoice","code":"GlobalConfiguration"},{"type":"text","text":" "},{"type":"text","text":"parameter."}],"type":"paragraph"},{"level":2,"text":"Presenting Modally","type":"heading","anchor":"Presenting-Modally"},{"inlineContent":[{"type":"text","text":"When presenting the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":" modally, add a dismiss button"},{"type":"text","text":" "},{"type":"text","text":"so users can close it:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    sections: [ \/* ... *\/ ]",")"]},{"inlineContent":[{"text":"If you are embedding the carousel inside your own ","type":"text"},{"type":"codeVoice","code":"UINavigationController"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"set ","type":"text"},{"type":"codeVoice","code":"embedInNavigationController"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" on the carousel configuration","type":"text"},{"text":" ","type":"text"},{"text":"to prevent the SDK from creating a second navigation controller, which would","type":"text"},{"text":" ","type":"text"},{"text":"result in double navigation bars:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["carouselConfig.embedInNavigationController = false"]},{"level":2,"text":"App Store Compliance","type":"heading","anchor":"App-Store-Compliance"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Export Compliance"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The SDK does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" use any non-standard encryption and will not affect export controls.","type":"text"}]}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Privacy Compliance"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The SDK does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"te