 must be globally initialized before it can be used. Call this","type":"text"},{"text":" ","type":"text"},{"text":"method early in your app lifecycle to optimize reader launch speed. You only","type":"text"},{"text":" ","type":"text"},{"text":"need to call this method once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The completion handler is only used to return a status flag. It is not required"},{"type":"text","text":" "},{"type":"text","text":"and it is not necessary to wait for the completion handler before continuing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method will only fail if the API key is invalid."}],"type":"paragraph"},{"syntax":"swift","code":["import PSReaderUI","","PSReader.initialize(apiKey: apiKey, completion: { success in","    \/\/ Note: The completion handler may be called on any thread.","})"],"type":"codeListing"},{"anchor":"Quick-Start","type":"heading","text":"Quick Start","level":2},{"inlineContent":[{"text":"Create a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference"},{"text":" with your credentials and basic theming:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import PSReaderUI","","let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID,","    primaryFont: .systemFont(ofSize: 12),","    secondaryFont: .systemFont(ofSize: 12),","    brandColor: UIColor(dynamicProvider: {","        $0.userInterfaceStyle == .dark ? .white : .black","    })",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The primary font is used for titles, headlines, and publication names. The"},{"type":"text","text":" "},{"type":"text","text":"secondary font covers the remaining UI. The brand color is used as an accent"},{"type":"text","text":" "},{"type":"text","text":"throughout the SDK."}],"type":"paragraph"},{"inlineContent":[{"text":"Then create a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"text":" using a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"shortcode"}]},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can now push, present, or embed the "},{"type":"codeVoice","code":"CarouselViewController"},{"type":"text","text":" as needed."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","isActive":true},{"type":"text","text":" for more detail on sections, content types, and layout"},{"type":"text","text":" "},{"type":"text","text":"options."}],"type":"paragraph"},{"anchor":"Manual-Configuration","type":"heading","text":"Manual Configuration","level":3},{"inlineContent":[{"text":"If you need to use explicit GUIDs instead of a shortcode, replace","type":"text"},{"text":" ","type":"text"},{"code":".dynamicArchive","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":".section","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".subsections","type":"codeVoice"},{"text":" entry using the","type":"text"},{"text":" ","type":"text"},{"text":"appropriate content type:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Feed edition archive with an application GUID",".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))","","\/\/ Replica archive with a publication GUID",".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"],"type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","type":"reference"},{"text":" to determine which content type matches","type":"text"},{"text":" ","type":"text"},{"text":"your publication.","type":"text"}],"type":"paragraph"},{"anchor":"Dark-Mode","type":"heading","text":"Dark Mode","level":2},{"inlineContent":[{"type":"text","text":"The SDK fully supports dark mode. To provide distinct light and dark brand"},{"type":"text","text":" "},{"type":"text","text":"colors, use a dynamic "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let brandColor = UIColor(dynamicProvider: {","    $0.userInterfaceStyle == .dark ? .white : .black","})"],"type":"codeListing"},{"inlineContent":[{"text":"Alternatively, define a color in your asset catalog so the system resolves it","type":"text"},{"text":" ","type":"text"},{"text":"automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To force a specific appearance across the entire SDK, set","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"overrideUserInterfaceStyle"},{"text":" on the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["carouselVC.overrideUserInterfaceStyle = .dark"],"type":"codeListing"},{"anchor":"Embedding-in-SwiftUI","type":"heading","text":"Embedding in SwiftUI","level":2},{"inlineContent":[{"text":"Wrap the ","type":"text"},{"isActive":true,"type":"reference","id