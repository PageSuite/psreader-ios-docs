or","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CarouselViewController","kind":"identifier"}]}],"kind":"declarations"},{"mentions":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization"],"kind":"mentions"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"CarouselViewController","type":"codeVoice"},{"text":" serves as the central UI component of the SDK, offering","type":"text"},{"text":" ","type":"text"},{"text":"users seamless navigation between multiple content sources such as replica (PDF-based)","type":"text"},{"text":" ","type":"text"},{"text":"editions, feed (HTML\/PDF) editions, archives, bookmarked content, and downloaded editions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The interface supports two levels of paging, sections and subsections, with"},{"type":"text","text":" "},{"type":"text","text":"horizontal ribbons, allowing quick and intuitive browsing through publications."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view controller can be configured via a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration"},{"type":"text","text":" object."},{"type":"text","text":" "},{"type":"text","text":"Utilize this configuration to align the visual presentation, navigation behavior,"},{"type":"text","text":" "},{"type":"text","text":"theming, branding, and various delegate interactions (e.g., sharing, paywalls,"},{"type":"text","text":" "},{"type":"text","text":"advertisements, and media playback)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The content in the carousel can be:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"A Responsive feed edition archive."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Replica PDF archive."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A Dynamic archive loaded from an app shortcode."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Local bookmarks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Local downloads.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Usage","anchor":"Usage","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recommended approach uses a "},{"type":"strong","inlineContent":[{"text":"dynamic archive","type":"text"}]},{"type":"text","text":" that loads content from a"},{"type":"text","text":" "},{"type":"text","text":"shortcode configured in the PageSuite portal:"}]},{"code":["let globalConfig = GlobalConfiguration(","    apiKey: \"YOUR_API_KEY\",","    accountGUID: \"YOUR_ACCOUNT_GUID\"",")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"YOUR_SHORTCODE\")","    ]",")","","present(carousel, animated: true)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can also configure sections manually to combine multiple content sources:","type":"text"}]},{"code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .subsections(\"Editions\", [","            .init(name: \"Daily\", type: .feedArchive(guid: \"DAILY_GUID\")),","            .init(name: \"Weekend\", type: .feedArchive(guid: \"WEEKEND_GUID\"))","        ]),","        .section(.init(name: \"Bookmarks\", type: .bookmarks(type: .all))),","        .section(.init(name: \"Downloads\", type: .downloads(type: .all)))","    ]",")"],"type":"codeListing","syntax":"swift"},{"name":"Tip","type":"aside","style":"tip","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"CarouselViewController","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"PSReader.initialize(apiKey:)","type":"codeVoice"},{"text":" internally.","type":"text"},{"text":" ","type":"text"},{"text":"For faster launches, call it earlier in your app lifecycle (e.g., in","type":"text"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"name":"See Also","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"name":"See Also","type":"aside","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference"}],"type":"paragraph"}]},{"name":"See Also","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true}]}]},{"name":"See Also","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","type":"reference","isActive":true}]}]}],"kind":"content"}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Standalone-View-Controllers":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","title":"Standalone View Controllers","abstract":[{"t