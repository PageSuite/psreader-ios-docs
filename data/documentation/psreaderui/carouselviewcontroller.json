xt"}]},{"type":"paragraph","inlineContent":[{"text":"The view controller can be configured via a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","type":"reference","isActive":true},{"text":" object.","type":"text"},{"text":" ","type":"text"},{"text":"Utilize this configuration to align the visual presentation, navigation behavior,","type":"text"},{"text":" ","type":"text"},{"text":"theming, branding, and various delegate interactions (e.g., sharing, paywalls,","type":"text"},{"text":" ","type":"text"},{"text":"advertisements, and media playback).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The content in the carousel can be:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"A Responsive feed edition archive.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A Replica PDF archive."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Dynamic archive loaded from an app shortcode."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local bookmarks."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Local downloads."}],"type":"paragraph"}]}]},{"type":"heading","text":"Usage","anchor":"Usage","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recommended approach uses a "},{"type":"strong","inlineContent":[{"type":"text","text":"dynamic archive"}]},{"type":"text","text":" that loads content from a"},{"type":"text","text":" "},{"type":"text","text":"shortcode configured in the PageSuite portal:"}]},{"type":"codeListing","code":["let globalConfig = GlobalConfiguration(","    apiKey: \"YOUR_API_KEY\",","    accountGUID: \"YOUR_ACCOUNT_GUID\"",")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"YOUR_SHORTCODE\")","    ]",")","","present(carousel, animated: true)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can also configure sections manually to combine multiple content sources:","type":"text"}]},{"type":"codeListing","code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .subsections(\"Editions\", [","            .init(name: \"Daily\", type: .feedArchive(guid: \"DAILY_GUID\")),","            .init(name: \"Weekend\", type: .feedArchive(guid: \"WEEKEND_GUID\"))","        ]),","        .section(.init(name: \"Bookmarks\", type: .bookmarks(type: .all))),","        .section(.init(name: \"Downloads\", type: .downloads(type: .all)))","    ]",")"],"syntax":"swift"},{"type":"aside","name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"CarouselViewController"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"PSReader.initialize(apiKey:)"},{"type":"text","text":" internally."},{"type":"text","text":" "},{"type":"text","text":"For faster launches, call it earlier in your app lifecycle (e.g., in"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":")."}]}]},{"type":"aside","name":"See Also","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started","isActive":true}]}]},{"type":"aside","name":"See Also","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference","isActive":true}]}]},{"type":"aside","name":"See Also","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSRe