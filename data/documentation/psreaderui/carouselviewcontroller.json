{"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Demo-Project"],"generated":true,"title":"Essentials"}],"variants":[{"paths":["\/documentation\/psreaderui\/carouselviewcontroller"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},"kind":"symbol","topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/Content"],"generated":true,"title":"Structures"},{"anchor":"Initializers","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/init(globalConfig:carouselConfig:sections:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Enumerations","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/Layout","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem"],"generated":true,"title":"Enumerations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CarouselViewController","kind":"identifier"}],"platforms":["iOS"]}]},{"kind":"mentions","mentions":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization"]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CarouselViewController"},{"text":" serves as the central UI component of the SDK, offering","type":"text"},{"text":" ","type":"text"},{"text":"users seamless navigation between multiple content sources such as replica (PDF-based)","type":"text"},{"text":" ","type":"text"},{"text":"editions, feed (HTML\/PDF) editions, archives, bookmarked content, and downloaded editions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The interface supports two levels of paging, sections and subsections, with","type":"text"},{"text":" ","type":"text"},{"text":"horizontal ribbons, allowing quick and intuitive browsing through publications.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view controller can be configured via a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration"},{"type":"text","text":" object."},{"type":"text","text":" "},{"type":"text","text":"Utilize this configuration to align the visual presentation, navigation behavior,"},{"type":"text","text":" "},{"type":"text","text":"theming, branding, and various delegate interactions (e.g., sharing, paywalls,"},{"type":"text","text":" "},{"type":"text","text":"advertisements, and media playback)."}]},{"type":"paragraph","inlineContent":[{"text":"The content in the carousel can be:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Responsive feed edition archive."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Replica PDF archive.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A Dynamic archive loaded from an app shortcode."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Local bookmarks.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local downloads."}]}]}]},{"level":2,"text":"Usage","type":"heading","anchor":"Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recommended approach uses a "},{"inlineContent":[{"type":"text","text":"dynamic archive"}],"type":"strong"},{"type":"text","text":" that loads content from a"},{"type":"text","text":" "},{"type":"text","text":"shortcode configured in the PageSuite portal:"}]},{"type":"codeListing","syntax":"swift","code":["let globalConfig = GlobalConfiguration(","    apiKey: \"YOUR_API_KEY\",","    accountGUID: \"YOUR_ACCOUNT_GUID\"",")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"YOUR_SHORTCODE\")","    ]",")","","present(carousel, animated: true)"]},{"type":"paragraph","inlineContent":[{"text":"You can also configure sections manually to combine multiple content sources:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .subsections(\"Editions\", [","            .init(name: \"Daily\", type: .feedArchive(guid: \"DAILY_GUID\")),","            .init(name: \"Weekend\", type: .feedArchive(guid: \"WEEKEND_GUID\"))","        ]),","        .section(.init(name: \"Bookmarks\", type: .bookmarks(type: .all))),","        .section(.init(name: \"Downloads\", type: .downloads(type: .all)))","    ]",")"]},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"CarouselViewController"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"PSReader.initialize(apiKey:)"},{"type":"text","text":" internally."},{"type":"text","text":" "},{"type":"text","text":"For faster launches, call it earlier in your app lifecycle (e.g., in"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":")."}],"type":"paragraph"}]},{"style":"note","name":"See Also","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started"}],"type":"paragraph"}]},{"style":"note","name":"See Also","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference"}]}]},{"style":"note","name":"See Also","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference","isActive":true}]}]},{"style":"note","name":"See Also","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration"}],"type":"paragraph"}]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/objc(cs)UIViewController"],"type":"inheritsFrom","title":"Inherits From"},{"kind":"relationships","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/objc(pl)NSCoding","doc:\/\/com.pagesuite.PSReaderUI\/objc(pl)NSExtensionRequestHandling","doc:\/\/com.pagesuite.PSReaderUI\/objc(pl)NSObject","doc:\/\/com.pagesuite.PSReaderUI\/s7CVarArgP","doc:\/\/com.page