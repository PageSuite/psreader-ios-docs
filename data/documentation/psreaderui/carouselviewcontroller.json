erUI\/documentation\/PSReaderUI\/Theming-and-Customization"]},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"code":"CarouselViewController","type":"codeVoice"},{"type":"text","text":" serves as the central UI component of the SDK, offering"},{"type":"text","text":" "},{"type":"text","text":"users seamless navigation between multiple content sources such as replica (PDF-based)"},{"type":"text","text":" "},{"type":"text","text":"editions, feed (HTML\/PDF) editions, archives, bookmarked content, and downloaded editions."}],"type":"paragraph"},{"inlineContent":[{"text":"The interface supports two levels of paging, sections and subsections, with","type":"text"},{"text":" ","type":"text"},{"text":"horizontal ribbons, allowing quick and intuitive browsing through publications.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The view controller can be configured via a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","type":"reference","isActive":true},{"text":" object.","type":"text"},{"text":" ","type":"text"},{"text":"Utilize this configuration to align the visual presentation, navigation behavior,","type":"text"},{"text":" ","type":"text"},{"text":"theming, branding, and various delegate interactions (e.g., sharing, paywalls,","type":"text"},{"text":" ","type":"text"},{"text":"advertisements, and media playback).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The content in the carousel can be:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Responsive feed edition archive."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Replica PDF archive.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A Dynamic archive loaded from an app shortcode."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local bookmarks."}]}]},{"content":[{"inlineContent":[{"text":"Local downloads.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Usage","level":2,"type":"heading","text":"Usage"},{"inlineContent":[{"text":"The recommended approach uses a ","type":"text"},{"inlineContent":[{"type":"text","text":"dynamic archive"}],"type":"strong"},{"text":" that loads content from a","type":"text"},{"text":" ","type":"text"},{"text":"shortcode configured in the PageSuite portal:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let globalConfig = GlobalConfiguration(","    apiKey: \"YOUR_API_KEY\",","    accountGUID: \"YOUR_ACCOUNT_GUID\"",")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"YOUR_SHORTCODE\")","    ]",")","","present(carousel, animated: true)"],"type":"codeListing"},{"inlineContent":[{"text":"You can also configure sections manually to combine multiple content sources:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .subsections(\"Editions\", [","            .init(name: \"Daily\", type: .feedArchive(guid: \"DAILY_GUID\")),","            .init(name: \"Weekend\", type: .feedArchive(guid: \"WEEKEND_GUID\"))","        ]),","        .section(.init(name: \"Bookmarks\", type: .bookmarks(type: .all))),","        .section(.init(name: \"Downloads\", type: .downloads(type: .all)))","    ]",")"],"type":"codeListing"},{"style":"tip","type":"aside","name":"Tip","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"CarouselViewController","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"PSReader.initialize(apiKey:)","type":"codeVoice"},{"text":" internally.","type":"text"},{"text":" ","type":"text"},{"text":"For faster launches, call it earlier in your app lifecycle (e.g., in","type":"