 and intuitive browsing through publications.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The view controller can be configured via a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","type":"reference"},{"text":" object.","type":"text"},{"text":" ","type":"text"},{"text":"Utilize this configuration to align the visual presentation, navigation behavior,","type":"text"},{"text":" ","type":"text"},{"text":"theming, branding, and various delegate interactions (e.g., sharing, paywalls,","type":"text"},{"text":" ","type":"text"},{"text":"advertisements, and media playback).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The content in the carousel can be:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"A Responsive feed edition archive."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Replica PDF archive.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Dynamic archive loaded from an app shortcode.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Local bookmarks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Local downloads."}],"type":"paragraph"}]}]},{"anchor":"Usage","type":"heading","level":2,"text":"Usage"},{"type":"paragraph","inlineContent":[{"text":"The recommended approach uses a ","type":"text"},{"inlineContent":[{"type":"text","text":"dynamic archive"}],"type":"strong"},{"text":" that loads content from a","type":"text"},{"text":" ","type":"text"},{"text":"shortcode configured in the PageSuite portal:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let globalConfig = GlobalConfiguration(","    apiKey: \"YOUR_API_KEY\",","    accountGUID: \"YOUR_ACCOUNT_GUID\"",")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    secti