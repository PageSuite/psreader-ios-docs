{"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","interfaceLanguage":"swift"},"abstract":[{"text":"The primary view controller provided by the SDK for presenting digital publication","type":"text"},{"text":" ","type":"text"},{"text":"content through an intuitive carousel interface.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/Content"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/init(globalConfig:carouselConfig:header:sections:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/Layout","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem"],"title":"Enumerations","generated":true,"anchor":"Enumerations"}],"kind":"symbol","variants":[{"paths":["\/documentation\/psreaderui\/carouselviewcontroller"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"navigatorTitle":[{"text":"CarouselViewController","kind":"identifier"}],"title":"CarouselViewController","role":"symbol","externalID":"c:@M@PSReaderUI@objc(cs)CarouselViewController","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CarouselViewController","kind":"identifier"}],"modules":[{"name":"PSReaderUI"}],"symbolKind":"class","roleHeading":"Class"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Demo-Project"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CarouselViewController"}],"languages":["swift"],"platforms":["iOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Migration-Guides","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CarouselViewController"},{"text":" serves as the central UI component of the SDK, offering","type":"text"},{"text":" ","type":"text"},{"text":"users seamless navigation between multiple content sources such as replica (PDF-based)","type":"text"},{"text":" ","type":"text"},{"text":"editions, feed (HTML\/PDF) editions, archives, bookmarked content, and downloaded editions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The interface supports two levels of paging, sections and subsections, with"},{"type":"text","text":" "},{"type":"text","text":"horizontal ribbons, allowing quick and intuitive browsing through publications."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view controller can be configured via a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration","isActive":true},{"type":"text","text":" object."},{"type":"text","text":" "},{"type":"text","text":"Utilize this configuration to align the visual presentation, navigation behavior,"},{"type":"text","text":" "},{"type":"text","text":"theming, branding, and various delegate interactions (e.g., sharing, paywalls,"},{"type":"text","text":" "},{"type":"text","text":"advertisements, and media playback)."}]},{"type":"paragraph","inlineContent":[{"text":"The content in the carousel can be:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A Responsive feed edition archive.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Replica PDF archive."}]}]},{"content":[{"inlineContent":[{"text":"A Dynamic archive loaded from an app shortcode.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local bookmarks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local downloads."}]}]}]},{"type":"heading","level":2,"text":"Usage","anchor":"Usage"},{"type":"paragraph","inlineContent":[{"text":"The recommended approach uses a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"dynamic archive"}]},{"text":" that loads content from a","type":"text"},{"text":" ","type":"text"},{"text":"shortcode configured in the PageSuite portal:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let globalConfig = GlobalConfiguration(","    apiKey: \"YOUR_API_KEY\",","    accountGUID: \"YOUR_ACCOUNT_GUID\"",")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"YOUR_SHORTCODE\")","    ]",")","","present(carousel, animated: true)"]},{"type":"paragrap