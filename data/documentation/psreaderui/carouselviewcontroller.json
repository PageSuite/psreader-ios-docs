ements, and media playback).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The content in the carousel can be:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A Responsive feed edition archive.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"A Replica PDF archive.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A Dynamic archive loaded from an app shortcode."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Local bookmarks.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Local downloads.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Usage","anchor":"Usage"},{"type":"paragraph","inlineContent":[{"text":"The recommended approach uses a ","type":"text"},{"inlineContent":[{"text":"dynamic archive","type":"text"}],"type":"strong"},{"text":" that loads content from a","type":"text"},{"text":" ","type":"text"},{"text":"shortcode configured in the PageSuite portal:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let globalConfig = GlobalConfiguration(","    apiKey: \"YOUR_API_KEY\",","    accountGUID: \"YOUR_ACCOUNT_GUID\"",")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"YOUR_SHORTCODE\")","    ]",")","","present(carousel, animated: true)"]},{"type":"paragraph","inlineContent":[{"text":"You can also configure sections manually to combine multiple content sources:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .subsections(\"Editions\", [","            .init(name: \"Daily\", type: .feedArchive(guid: \"DAILY_GUID\")),","            .init(name: \"Weekend\", type: .feedArchive(guid: \"WEEKEND_GUID\"))","        ]),","        .section(.init(name: \"Bookmarks\", type: .bookmarks(type: .all))),","        .section(.init(name: \"Downloads\", type: .downloads(type: .all)))","    ]",")"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"CarouselViewController","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"PSReader.initialize(apiKey:)","type":"codeVoice"},{"text":" internally.","type":"text"},{"text":" ","type":"text"},{"text":"For faster launches, call it earlier in your app lifecycle (e.g., in","type":"text"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":").","type":"text"}]}],"name":"Tip","type":"aside","style":"tip"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Getting-Started"}],"type":"paragraph"}],"name":"See Also","type":"aside","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup"}],"type":"paragraph"}],"name":"See Also","type":"aside","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","type":"reference"}]}],"name":"See Also","type":"aside","style":"note"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselConfiguration"}],"type":"paragraph"}],"name":"See Also","type":"aside","style":"note"}]}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Standalone-View-Controllers":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","abstract":[{"type":"text","text":"Use archive, bookm