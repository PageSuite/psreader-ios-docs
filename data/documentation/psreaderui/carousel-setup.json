{"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Localization"],"generated":true,"title":"Customization","anchor":"Customization"}],"abstract":[{"text":"Configure the carousel’s sections, content sources, and layout.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":" is the primary entry point for the PSReaderUI SDK."},{"type":"text","text":" "},{"type":"text","text":"It presents a tabbed interface with horizontal section ribbons at the top and"},{"type":"text","text":" "},{"type":"text","text":"content grids below. Each section can display edition archives, bookmarks,"},{"type":"text","text":" "},{"type":"text","text":"downloads, or kiosk grids."}]},{"type":"paragraph","inlineContent":[{"text":"Sections are defined as an array of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem"},{"text":" ","type":"text"},{"text":"values passed to the initializer. The SDK supports three kinds of section","type":"text"},{"text":" ","type":"text"},{"text":"items: dynamic archives, single sections, and subsection groups.","type":"text"}]},{"type":"heading","text":"Dynamic Archives (Recommended)","level":2,"anchor":"Dynamic-Archives-Recommended"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest way to populate the carousel is with a "},{"type":"strong","inlineContent":[{"type":"text","text":"shortcode"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":".dynamicArchive","type":"codeVoice"},{"type":"text","text":". The SDK fetches publication configuration from the"},{"type":"text","text":" "},{"type":"text","text":"PageSuite backend and automatically creates the appropriate content sections:"}]},{"type":"codeListing","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)"},{"text":" at any","type":"text"},{"text":" ","type":"text"},{"text":"time to re-fetch the remote configuration and update the carousel content.","type":"text"}]},{"type":"heading","text":"Manual Sections","level":2,"anchor":"Manual-Sections"},{"type":"paragraph","inlineContent":[{"text":"For full control, define sections explicitly using ","type":"text"},{"code":".section","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":".subsections","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    .section(.init(name: \"Latest\", type: .feedArchive(guid: \"APP_GUID\"))),","    .subsections(\"More\", [","        .init(name: \"Archive\", type: .replicaArchive(guid: \"PUB_GUID\")),","        .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","        .init(name: \"Downloads\", type: .downloads(type: .all))","    ])","]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":".section"},{"text":" creates a top-level tab with a single content view. A","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".subsections"},{"text":" creates a top-level tab with a secondary ribbon that lets","type":"text"},{"text":" ","type":"text"},{"text":"users switch between multiple content views.","type":"text"}]},{"level":2,"anchor":"Content-Types","text":"Content Types","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType","type":"reference","isActive":true},{"text":" enum defines all available content","type":"text"},{"text":" ","type":"text"},{"text":"sources:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Content Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".feedArchive(guid:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Feed edition archive identified by an application GUID."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".replicaArchive(guid:, supplements:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replica edition archive identified by a publication GUID. Pass an optional "},{"type":"codeVoice","code":"supplements"},{"type":"text","text":" array of publication GUIDs to include supplemental editions alongside the main archive."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".feedPublicationKiosk(publications:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Grid of multiple feed publications (kiosk layout). Each cell represents a different publication and tapping one opens its archive.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".replicaPublicationKiosk(publications:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grid of multiple replica publications (kiosk layout). Same multi-publication grid for replica editions."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".bookmarks(type:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"User’s bookmarked pages and articles. Filter by type.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".downloads(type:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"User’s downloaded editions. Filter by type.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".search(config:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full-text search across feed edition articles and pages. Requires a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration","type":"reference","isActive":true},{"text":". See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search","type":"reference","isActive":true},{"text":".","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","type":"reference"},{"text":" to determine whether your publications use","type":"text"},{"text":" ","type":"text"},{"text":"feed or replica content types.","type":"text"}]},{"type":"heading","level":2,"text":"Per-Section Configuration Overrides","anchor":"Per-Section-Configuration-Overrides"},{"type":"paragraph","inlineContent":[{"text":"Each content type accepts an optional configuration parameter. Use this to","type":"text"},{"text":" ","type":"text"},{"text":"override the global defaults for a specific section — for example, to use a","type":"text"},{"text":" ","type":"text"},{"text":"different date formatter or thumbnail aspect ratio:","type":"text"}]},{"type