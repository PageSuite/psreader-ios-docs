{"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","title":"Carousel Setup","role":"article","modules":[{"name":"PSReaderUI"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Configure the carousel’s sections, content sources, and layout.","type":"text"}],"variants":[{"paths":["\/documentation\/psreaderui\/carousel-setup"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/carousel-setup"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"kind":"article","sections":[],"seeAlsoSections":[{"anchor":"Customization","generated":true,"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Localization"],"title":"Customization"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true},{"text":" is the primary entry point for the PSReaderUI SDK.","type":"text"},{"text":" ","type":"text"},{"text":"It presents a tabbed interface with horizontal section ribbons at the top and","type":"text"},{"text":" ","type":"text"},{"text":"content grids below. Each section can display edition archives, bookmarks,","type":"text"},{"text":" ","type":"text"},{"text":"downloads, or kiosk grids.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Sections are defined as an array of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem","type":"reference"},{"text":" ","type":"text"},{"text":"values passed to the initializer. The SDK supports three kinds of section","type":"text"},{"text":" ","type":"text"},{"text":"items: dynamic archives, single sections, and subsection groups.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Dynamic Archives (Recommended)","anchor":"Dynamic-Archives-Recommended","type":"heading"},{"inlineContent":[{"type":"text","text":"The simplest way to populate the carousel is with a "},{"type":"strong","inlineContent":[{"text":"shortcode","type":"text"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":". The SDK fetches publication configuration from the"},{"type":"text","text":" "},{"type":"text","text":"PageSuite backend and automatically creates the appropriate content sections:"}],"type":"paragraph"},{"code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Call "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)","isActive":true,"type":"reference"},{"type":"text","text":" at any"},{"type":"text","text":" "},{"type":"text","text":"time to re-fetch the remote configuration and update the carousel content."}],"type":"paragraph"},{"level":2,"text":"Manual Sections","anchor":"Manual-Sections","type":"heading"},{"inlineContent":[{"type":"text","text":"For full control, define sections explicitly using "},{"type":"codeVoice","code":".section"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":".subsections"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    .section(.init(name: \"Latest\", type: .feedArchive(guid: \"APP_GUID\"))),","    .subsections(\"More\", [","        .init(name: \"Archive\", type: .replicaArchive(guid: \"PUB_GUID\")),","        .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","        .init(name: \"Downloads\", type: .downloads(type: .all))","    ])","]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"code":".section","type":"codeVoice"},{"type":"text","text":" creates a top-level tab with a single content view. A"},{"type":"text","text":" "},{"code":".subsections","type":"codeVoice"},{"type":"text","text":" creates a top-level tab with a secondary ribbon that lets"},{"type":"text","text":" "},{"type":"text","text":"users switch between multiple content views."}],"type":"paragraph"},{"level":2,"text":"Content Types","anchor":"Content-Types","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType","isActive":true,"type":"reference"},{"text":" enum defines all available content","type":"text"},{"text":" ","type":"text"},{"text":"sources:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Content Type"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".feedArchive(guid:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed edition archive identified by an application GUID."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".replicaArchive(guid:, supplements:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replica edition archive identified by a publication GUID. Pass an optional "},{"type":"codeVoice","code":"supplements"},{"type":"text","text":" array of publication GUIDs to include supplemental editions alongside the main archive."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".feedPublicationKiosk(publications:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grid of multiple feed publications (kiosk layout). Each cell represents a different publication and tapping one opens its archive."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".replicaPublicationKiosk(publications:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Grid of multiple replica publications (kiosk layout). Same multi-publication grid for replica editions.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".bookmarks(type:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"User’s bookmarked pages and articles. Filter by type."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".downloads(type:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"User’s downloaded editions. Filter by type."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".search(config:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full-text search across feed edition articles and pages. Requires a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration"},{"type":"text","text":". See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"},{"type":"text","text":"."}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","type":"reference","isActive":true},{"type":"text","text":" to determine whether your publications use"},{"type":"text","text":" "},{"type":"text","text":"feed or replica content types."}],"type":"paragraph"},{"level":2,"text":"Per-Section Configuration Overrides","anchor":"Per-Section-Configuration-Overrides","type":"heading"},{"inlineContent":[{"text":"Each content type accepts an optional configuration parameter. Use this to","type":"text"},{"text":" ","type":"text"},{"text":"override the global defaults for a specific section — for example, to use a","type":"text"},{"text":" ","type":"text"},{"text":"different date formatter or thumbnail aspect ratio:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var specialArchiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","specialArchiveConfig.aspectRatio = 0.75","specialArchiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)","",".section(.init(","    name: \"Special Edition\",","    type: .feedArchive(guid: \"GUID\", config: specialArchiveConfig)","))"]},{"level":2,"text":"Dismiss Button and Safe Area","anchor":"Dismiss-Button-and-Safe-Area","type":"heading"},{"inlineContent":[{"type":"text","text":"When presenting the carousel modally, add a dismiss button:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())"]},{"inlineContent":[{"text":"Control which safe area edges the carousel ignores. This is useful when","type":"text"},{"text":" ","type":"text"},{"text":"embedding the carousel in a container that already provides its own safe","type":"text"},{"text":" ","type":"text"},{"text":"area handling:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["carouselConfig.ignoreSafeArea = .bottom"]},{"level":2,"text":"Complete Example","anchor":"Complete-Example","type":"heading"},{"inlineContent":[{"text":"A carousel combining a dynamic archive, a manual section with a per-section","type":"text"},{"text":" ","type":"text"},{"text":"configuration override, and a subsection group:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","","\/\/ Per-section override for the premium archive","var premiumConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","premiumConfig.aspectRatio = 0.75","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        \/\/ Dynamic archive populated from a shortcode","        .dynamicArchive(\"Latest\", shortcode: \"SHORTCODE\"),","","        \/\/ Manual section with a per-section configuration","        .section(.init(","            name: \"Premium\",","            type: .replicaArchive(","                guid: \"PUB_GUID\",","                supplements: [\"SUPPLEMENT_PUB_GUID\"],","                config: premiumConfig","            )","        )),","","        \/\/ Subsection group for user content","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"]},{"level":2,"text":"SwiftUI Integration","anchor":"SwiftUI-Integration","type":"heading"},{"inlineContent":[{"type":"text","text":"Wrap "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"type":"text","text":" in a "},{"type":"codeVoice","code":"UIViewControllerRepresentable"},{"type":"text","text":" for use"},{"type":"text","text":" "},{"type":"text","text":"in SwiftUI:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","}"]}],"kind":"content"}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Localization":{"abstract":[{"text":"Localize all user-facing strings in the PSReaderUI SDK.","type":"text"}],"url":"\/documentation\/psreaderui\/localization","type":"topic","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Localization","kind":"article","title":"Localization","role":"article"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/CarouselViewController/refreshDynamicArchives(completion:)":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)","url":"\/documentation\/psreaderui\/carouselviewcontroller\/refreshdynamicarchives(completion:)","title":"refreshDynamicArchives(completion:)","type":"topic","abstract":[{"text":"Refreshes the publication lists in dynamic archives. Updates subsections if needed.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshDynamicArchives","kind":"identifier"},{"text":"(","kind":"text"},{"text":"completion","kind":"externalParam"},{"text":": ((","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")?)","kind":"text"}],"kind":"symbol"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI