{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Localization"],"title":"Customization","anchor":"Customization","generated":true}],"sections":[],"kind":"article","metadata":{"modules":[{"name":"PSReaderUI"}],"roleHeading":"Article","title":"Carousel Setup","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"type":"text","text":" is the primary entry point for the PSReaderUI SDK."},{"type":"text","text":" "},{"type":"text","text":"It presents a tabbed interface with horizontal section ribbons at the top and"},{"type":"text","text":" "},{"type":"text","text":"content grids below. Each section can display edition archives, bookmarks,"},{"type":"text","text":" "},{"type":"text","text":"downloads, or kiosk grids."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Sections are defined as an array of "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem","isActive":true},{"type":"text","text":" "},{"type":"text","text":"values passed to the initializer. The SDK supports three kinds of section"},{"type":"text","text":" "},{"type":"text","text":"items: dynamic archives, single sections, and subsection groups."}],"type":"paragraph"},{"anchor":"Dynamic-Archives-Recommended","text":"Dynamic Archives (Recommended)","level":2,"type":"heading"},{"inlineContent":[{"text":"The simplest way to populate the carousel is with a ","type":"text"},{"type":"strong","inlineContent":[{"text":"shortcode","type":"text"}]},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":". The SDK fetches publication configuration from the","type":"text"},{"text":" ","type":"text"},{"text":"PageSuite backend and automatically creates the appropriate content sections:","type":"text"}],"type":"paragraph"},{"code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)"},{"type":"text","text":" at any"},{"type":"text","text":" "},{"type":"text","text":"time to re-fetch the remote configuration and update the carousel content."}],"type":"paragraph"},{"anchor":"Manual-Sections","text":"Manual Sections","level":2,"type":"heading"},{"inlineContent":[{"text":"For full control, define sections explicitly using ","type":"text"},{"code":".section","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":".subsections","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    .section(.init(name: \"Latest\", type: .feedArchive(guid: \"APP_GUID\"))),","    .subsections(\"More\", [","        .init(name: \"Archive\", type: .replicaArchive(guid: \"PUB_GUID\")),","        .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","        .init(name: \"Downloads\", type: .downloads(type: .all))","    ])","]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":".section"},{"type":"text","text":" creates a top-level tab with a single content view. A"},{"type":"text","text":" "},{"type":"codeVoice","code":".subsections"},{"type":"text","text":" creates a top-level tab with a secondary ribbon that lets"},{"type":"text","text":" "},{"type":"text","text":"users switch between multiple content views."}],"type":"paragraph"},{"anchor":"Content-Types","text":"Content Types","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType","type":"reference"},{"type":"text","text":" enum defines all available content"},{"type":"text","text":" "},{"type":"text","text":"sources:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Content Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".feedArchive(guid:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Feed edition archive identified by an application GUID."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".replicaArchive(guid:, supplements:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Replica edition archive identified by a publication GUID. Pass an optional ","type":"text"},{"type":"codeVoice","code":"supplements"},{"text":" array of publication GUIDs to include supplemental editions alongside the main archive.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".feedPublicationKiosk(publications:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Grid of multiple feed publications (kiosk layout). Each cell represents a different publication and tapping one opens its archive.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".replicaPublicationKiosk(publications:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grid of multiple replica publications (kiosk layout). Same multi-publication grid for replica editions."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".bookmarks(type:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"User’s bookmarked pages and articles. Filter by type.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".downloads(type:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"User’s downloaded editions. Filter by type.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".search(config:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Full-text search across feed edition articles and pages. Requires a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration","isActive":true},{"type":"text","text":". See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","type":"reference","isActive":true},{"type":"text","text":" to determine whether your publications use"},{"type":"text","text":" "},{"type":"text","text":"feed or replica content types."}],"type":"paragraph"},{"anchor":"Per-Section-Configuration-Overrides","text":"Per-Section Configuration Overrides","level":2,"type":"heading"},{"inlineContent":[{"text":"Each content type accepts an optional configuration parameter. Use this to","type":"text"},{"text":" ","type":"text"},{"text":"override the global defaults for a specific section — for example, to use a","type":"text"},{"text":" ","type":"text"},{"text":"different date formatter or thumbnail aspect ratio:","type":"text"}],"type":"paragraph"},{"code":["var specialArchiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","specialArchiveConfig.aspectRatio = 0.75","specialArchiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)","",".section(.init(","    name: \"Special Edition\",","    type: .feedArchive(guid: \"GUID\", config: specialArchiveConfig)","))"],"syntax":"swift","type":"codeListing"},{"anchor":"Headers","text":"Headers","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Supply your own header view controller, pinned above the carousel content. Set"},{"type":"text","text":" "},{"type":"codeVoice","code":"hidesHeaderOnScroll"},{"type":"text","text":" to have the SDK hide it as the content scrolls and reveal"},{"type":"text","text":" "},{"type":"text","text":"it again when scrolling back up or changing page:"}],"type":"paragraph"},{"code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.hidesHeaderOnScroll = true","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: myHeaderViewController,","    sections: sections",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Dismissing-a-Modal-Carousel","text":"Dismissing a Modal Carousel","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"When the carousel is presented modally, give users a way to close it — usually a"},{"type":"text","text":" "},{"type":"text","text":"close button in your header, which you can build yourself."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"As a convenience for this common case, the SDK provides a prebuilt option:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController"},{"type":"text","text":" renders a close button that dismisses the carousel"},{"type":"text","text":" "},{"type":"text","text":"on tap (or calls your "},{"type":"codeVoice","code":"onClose"},{"type":"text","text":"). Style it with a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ButtonConfiguration"},{"type":"text","text":" and keep"},{"type":"text","text":" "},{"type":"codeVoice","code":"hidesHeaderOnScroll"},{"type":"text","text":" at its default of "},{"type":"codeVoice","code":"false"},{"type":"text","text":" so the button stays reachable:"}],"type":"paragraph"},{"code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: DismissHeaderViewController(config: .dismissButton(position: .leading())),","    sections: sections",")","present(carousel, animated: true)"],"syntax":"swift","type":"codeListing"},{"anchor":"Safe-Area","text":"Safe Area","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Control which safe area edges the carousel ignores. This is useful when"},{"type":"text","text":" "},{"type":"text","text":"embedding the carousel in a container that already provides its own safe"},{"type":"text","text":" "},{"type":"text","text":"area handling:"}],"type":"paragraph"},{"code":["carouselConfig.ignoreSafeArea = .bottom"],"syntax":"swift","type":"codeListing"},{"anchor":"Complete-Example","text":"Complete Example","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A carousel combining a dynamic archive, a manual section with a per-section"},{"type":"text","text":" "},{"type":"text","text":"configuration override, and a subsection group:"}],"type":"paragraph"},{"code":["let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","","\/\/ Per-section override for the premium archive","var premiumConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","premiumConfig.aspectRatio = 0.75","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        \/\/ Dynamic archive populated from a shortcode","        .dynamicArchive(\"Latest\", shortcode: \"SHORTCODE\"),","","        \/\/ Manual section with a per-section configuration","        .section(.init(","            name: \"Premium\",","            type: .replicaArchive(","                guid: \"PUB_GUID\",","                supplements: [\"SUPPLEMENT_PUB_GUID\"],","                config: premiumConfig","            )","        )),","","        \/\/ Subsection group for user content","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"syntax":"swift","type":"codeListing"},{"anchor":"SwiftUI-Integration","text":"SwiftUI Integration","level":2,"type":"heading"},{"inlineContent":[{"text":"Wrap ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"UIViewControllerRepresentable"},{"text":" for use","type":"text"},{"text":" ","type":"text"},{"text":"in SwiftUI:","type":"text"}],"type":"paragraph"},{"code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","}"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"text":"Configure the carousel’s sections, content sources, and layout.","type":"text"}],"variants":[{"paths":["\/documentation\/psreaderui\/carousel-setup"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/carousel-setup"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/CarouselViewController/ContentType":{"navigatorTitle":[{"kind":"identifier","text":"ContentType"}],"abstract":[{"type":"text","text":"Describes the content type of a section or subsection page."}],"url":"\/documentation\/psreaderui\/carouselviewcontroller\/contenttype","title":"CarouselViewController.ContentType","type":"topic","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentType","kind":"identifier"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/DismissHeaderViewController":{"title":"DismissHeaderViewController","navigatorTitle":[{"kind":"identifier","text":"DismissHeaderViewController"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController","kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/psreaderui\/dismissheaderviewcontroller","abstract":[{"type":"text","text":"A prebuilt carousel header containing a single dismiss (close) button."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DismissHeaderViewController"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSRe