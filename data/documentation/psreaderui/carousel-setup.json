{"sections":[],"abstract":[{"text":"Configure the carousel’s sections, content sources, and layout.","type":"text"}],"metadata":{"roleHeading":"Article","title":"Carousel Setup","modules":[{"name":"PSReaderUI"}],"role":"article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true,"type":"reference"},{"text":" is the primary entry point for the PSReaderUI SDK.","type":"text"},{"text":" ","type":"text"},{"text":"It presents a tabbed interface with horizontal section ribbons at the top and","type":"text"},{"text":" ","type":"text"},{"text":"content grids below. Each section can display edition archives, bookmarks,","type":"text"},{"text":" ","type":"text"},{"text":"downloads, or kiosk grids.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Sections are defined as an array of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem"},{"text":" ","type":"text"},{"text":"values passed to the initializer. The SDK supports three kinds of section","type":"text"},{"text":" ","type":"text"},{"text":"items: dynamic archives, single sections, and subsection groups.","type":"text"}],"type":"paragraph"},{"text":"Dynamic Archives (Recommended)","anchor":"Dynamic-Archives-Recommended","level":2,"type":"heading"},{"inlineContent":[{"text":"The simplest way to populate the carousel is with a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"shortcode"}]},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":". The SDK fetches publication configuration from the","type":"text"},{"text":" ","type":"text"},{"text":"PageSuite backend and automatically creates the appropriate content sections:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)"},{"type":"text","text":" at any"},{"type":"text","text":" "},{"type":"text","text":"time to re-fetch the remote configuration and update the carousel content."}],"type":"paragraph"},{"text":"Manual Sections","anchor":"Manual-Sections","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"For full control, define sections explicitly using "},{"type":"codeVoice","code":".section"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":".subsections"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    .section(.init(name: \"Latest\", type: .feedArchive(guid: \"APP_GUID\"))),","    .subsections(\"More\", [","        .init(name: \"Archive\", type: .replicaArchive(guid: \"PUB_GUID\")),","        .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","        .init(name: \"Downloads\", type: .downloads(type: .all))","    ])","]"],"type":"codeListing"},{"inlineContent":[{"text":"A ","type":"text"},{"code":".section","type":"codeVoice"},{"text":" creates a top-level tab with a single content view. A","type":"text"},{"text":" ","type":"text"},{"code":".subsections","type":"codeVoice"},{"text":" creates a top-level tab with a secondary ribbon that lets","type":"text"},{"text":" ","type":"text"},{"text":"users switch between multiple content views.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Content Types","type":"heading","anchor":"Content-Types"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType"},{"text":" enum defines all available content","type":"text"},{"text":" ","type":"text"},{"text":"sources:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Content Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".feedArchive(guid:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Feed edition archive identified by an application GUID.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".replicaArchive(guid:, supplements:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replica edition archive identified by a publication GUID. Pass an optional "},{"type":"codeVoice","code":"supplements"},{"type":"text","text":" array of publication GUIDs to include supplemental editions alongside the main archive."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".feedPublicationKiosk(publications:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Grid of multiple feed publications (kiosk layout). Each cell represents a different publication and tapping one opens its archive.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".replicaPublicationKiosk(publications:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grid of multiple replica publications (kiosk layout). Same multi-publication grid for replica editions."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".bookmarks(type:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"User’s bookmarked pages and articles. Filter by type."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".downloads(type:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"User’s downloaded editions. Filter by type."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".search(config:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full-text search across feed edition articles and pages. Requires a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration"},{"text":". See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"},{"text":".","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},{"type":"text","text":" to determine whether your publications use"},{"type":"text","text":" "},{"type":"text","text":"feed or replica content types."}]},{"level":2,"text":"Per-Section Configuration Overrides","type":"heading","anchor":"Per-Section-Configuration-Overrides"},{"type":"paragraph","inlineContent":[{"text":"Each content type accepts an optional configuration parameter. Use this to","type":"text"},{"text":" ","type":"text"},{"text":"override the global defaults for a specific section — for example, to use a","type":"text"},{"text":" ","type":"text"},{"text":"different date formatter or thumbnail aspect ratio:","type":"text"}]},{"syntax":"swift","code":["var specialArchiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","specialArchiveConfig.aspectRatio = 0.75","specialArchiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)","",".section(.init(","    name: \"Special Edition\",","    type: .feedArchive(guid: \"GUID\", config: specialArchiveConfig)","))"],"type":"codeListing"},{"level":2,"text":"Dismiss Button and Safe Area","type":"heading","anchor":"Dismiss-Button-and-Safe-Area"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When presenting the carousel modally, add a dismiss button:"}]},{"syntax":"swift","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Control which safe area edges the carousel ignores. This is useful when","type":"text"},{"text":" ","type":"text"},{"text":"embedding the carousel in a container that already provides its own safe","type":"text"},{"text":" ","type":"text"},{"text":"area handling:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["carouselConfig.ignoreSafeArea = .bottom"]},{"type":"heading","anchor":"Complete-Example","level":2,"text":"Complete Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A carousel combining a dynamic archive, a manual section with a per-section"},{"type":"text","text":" "},{"type":"text","text":"configuration override, and a subsection group:"}]},{"syntax":"swift","type":"codeListing","code":["let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","","\/\/ Per-section override for the premium archive","var premiumConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","premiumConfig.aspectRatio = 0.75","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        \/\/ Dynamic archive populated from a shortcode","        .dynamicArchive(\"Latest\", shortcode: \"SHORTCODE\"),","","        \/\/ Manual section with a per-section configuration","        .section(.init(","            name: \"Premium\",","            type: .replicaArchive(","                guid: \"PUB_GUID\",","                supplements: [\"SUPPLEMENT_PUB_GUID\"],","                config: premiumConfig","            )","        )),","","        \/\/ Subsection group for user content","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"]},{"type":"heading","anchor":"SwiftUI-Integration","level":2,"text":"SwiftUI Integration"},{"type":"paragraph","inlineContent":[{"text":"Wrap ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"UIViewControllerRepresentable"},{"text":" for use","type":"text"},{"text":" ","type":"text"},{"text":"in SwiftUI:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","}"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/psreaderui\/carousel-setup"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/carousel-setup"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/com.pag