{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true},{"type":"text","text":" is the primary entry point for the PSReaderUI SDK."},{"type":"text","text":" "},{"type":"text","text":"It presents a tabbed interface with horizontal section ribbons at the top and"},{"type":"text","text":" "},{"type":"text","text":"content grids below. Each section can display edition archives, bookmarks,"},{"type":"text","text":" "},{"type":"text","text":"downloads, or kiosk grids."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Sections are defined as an array of "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem","isActive":true},{"type":"text","text":" "},{"type":"text","text":"values passed to the initializer. The SDK supports three kinds of section"},{"type":"text","text":" "},{"type":"text","text":"items: dynamic archives, single sections, and subsection groups."}],"type":"paragraph"},{"text":"Dynamic Archives (Recommended)","anchor":"Dynamic-Archives-Recommended","level":2,"type":"heading"},{"inlineContent":[{"text":"The simplest way to populate the carousel is with a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"shortcode"}]},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":".dynamicArchive","type":"codeVoice"},{"text":". The SDK fetches publication configuration from the","type":"text"},{"text":" ","type":"text"},{"text":"PageSuite backend and automatically creates the appropriate content sections:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)","isActive":true},{"type":"text","text":" at any"},{"type":"text","text":" "},{"type":"text","text":"time to re-fetch the remote configuration and update the carousel content."}],"type":"paragraph"},{"text":"Manual Sections","anchor":"Manual-Sections","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"For full control, define sections explicitly using "},{"type":"codeVoice","code":".section"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":".subsections"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    .section(.init(name: \"Latest\", type: .feedArchive(guid: \"APP_GUID\"))),","    .subsections(\"More\", [","        .init(name: \"Archive\", type: .replicaArchive(guid: \"PUB_GUID\")),","        .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","        .init(name: \"Downloads\", type: .downloads(type: .all))","    ])","]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":".section"},{"type":"text","text":" creates a top-level tab with a single content view. A"},{"type":"text","text":" "},{"type":"codeVoice","code":".subsections"},{"type":"text","text":" creates a top-level tab with a secondary ribbon that lets"},{"type":"text","text":" "},{"type":"text","text":"users switch between multiple content views."}],"type":"paragraph"},{"text":"Content Types","anchor":"Content-Types","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType"},{"type":"text","text":" enum defines all available content"},{"type":"text","text":" "},{"type":"text","text":"sources:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Content Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".feedArchive(guid:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Feed edition archive identified by an application GUID.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".replicaArchive(guid:, supplements:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replica edition archive identified by a publication GUID. Pass an optional "},{"type":"codeVoice","code":"supplements"},{"type":"text","text":" array of publication GUIDs to include supplemental editions alongside the main archive."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".feedPublicationKiosk(publications:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grid of multiple feed publications (kiosk layout). Each cell represents a different publication and tapping one opens its archive."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".replicaPublicationKiosk(publications:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Grid of multiple replica publications (kiosk layout). Same multi-publication grid for replica editions.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".bookmarks(type:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"User’s bookmarked pages and articles. Filter by type."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".downloads(type:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"User’s downloaded editions. Filter by type.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".search(config:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full-text search across feed edition articles and pages. Requires a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration","isActive":true,"type":"reference"},{"text":". See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},{"type":"text","text":" to determine whether your publications use"},{"type":"text","text":" "},{"type":"text","text":"feed or replica content types."}],"type":"paragraph"},{"text":"Per-Section Configuration Overrides","anchor":"Per-Section-Configuration-Overrides","level":2,"type":"heading"},{"inlineContent":[{"text":"Each content type accepts an optional configuration parameter. Use this to","type":"text"},{"text":" ","type":"text"},{"text":"override the global defaults for a specific section — for example, to use a","type":"text"},{"text":" ","type":"text"},{"text":"different date formatter or thumbnail aspect ratio:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var specialArchiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","specialArchiveConfig.aspectRatio = 0.75","specialArchiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)","",".section(.init(","    name: \"Special Edition\",","    type: .feedArchive(guid: \"GUID\", config: specialArchiveConfig)","))"],"type":"codeListing"},{"text":"Headers","anchor":"Headers","level":2,"type":"heading"},{"inlineContent":[{"text":"Supply your own header view controller, pinned above the carousel content. Set","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"hidesHeaderOnScroll"},{"text":" to have the SDK hide it as the content scrolls and reveal","type":"text"},{"text":" ","type":"text"},{"text":"it again when scrolling back up or changing page:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.hidesHeaderOnScroll = true","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: myHeaderViewController,","    sections: sections",")"],"type":"codeListing"},{"text":"Dismissing a Modal Carousel","anchor":"Dismissing-a-Modal-Carousel","level":3,"type":"heading"},{"inlineContent":[{"text":"When the carousel is presented modally, give users a way to close it — usually a","type":"text"},{"text":" ","type":"text"},{"text":"close button in your header, which you can build yourself.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As a convenience for this common case, the SDK provides a prebuilt option:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/DismissHeaderViewController","type":"reference","isActive":true},{"text":" renders a close button that dismisses the carousel","type":"text"},{"text":" ","type":"text"},{"text":"on tap (or calls your ","type":"text"},{"code":"onClose","type":"codeVoice"},{"text":"). Style it with a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ButtonConfiguration","type":"reference","isActive":true},{"text":" and keep","type":"text"},{"text":" ","type":"text"},{"code":"hidesHeaderOnScroll","type":"codeVoice"},{"text":" at its default of ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" so the button stays reachable:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    carouselConfig: carouselConfig,","    header: DismissHeaderViewController(config: .dismissButton(position: .leading())),","    sections: sections",")","present(carousel, animated: true)"],"type":"codeListing"},{"text":"Safe Area","anchor":"Safe-Area","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Control which safe area edges the carousel ignores. This is useful when"},{"type":"text","text":" "},{"type":"text","text":"embedding the carousel in a container that already provides its own safe"},{"type":"text","text":" "},{"type":"text","text":"area handling:"}],"type":"paragraph"},{"syntax":"swift","code":["carouselConfig.ignoreSafeArea = .bottom"],"type":"codeListing"},{"text":"Complete Example","anchor":"Complete-Example","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A carousel combining a dynamic archive, a manual section with a per-section"},{"type":"text","text":" "},{"type":"text","text":"configuration override, and a subsection group:"}],"type":"paragraph"},{"syntax":"swift","code":["let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","","\/\/ Per-section override for the premium archive","var premiumConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","premiumConfig.aspectRatio = 0.75","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        \/\/ Dynamic archive populated from a shortcode","        .dynamicArchive(\"Latest\", shortcode: \"SHORTCODE\"),","","        \/\/ Manual section with a per-section configuration","        .section(.init(","            name: \"Premium\",","            type: .replicaArchive(","                guid: \"PUB_GUID\",","                supplements: [\"SUPPLEMENT_PUB_GUID\"],","                config: premiumConfig","            )","        )),","","        \/\/ Subsection group for user content","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"type":"codeListing"},{"text":"SwiftUI Integration","anchor":"SwiftUI-Integration","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Wrap "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"UIViewControllerRepresentable"},{"type":"text","text":" for use"},{"type":"text","text":" "},{"type":"text","text":"in SwiftUI:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","}"],"type":"codeListing"}]}],"metadata":{"title":"Carousel Setup","modules":[{"name":"PSReaderUI"}],"roleHeading":"Article","role":"article"},"abstract":[{"text":"Configure the carousel’s sections, content sources, and layout.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Customization","id