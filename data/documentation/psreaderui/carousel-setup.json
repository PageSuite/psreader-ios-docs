{"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController"},{"text":" is the primary entry point for the PSReaderUI SDK.","type":"text"},{"text":" ","type":"text"},{"text":"It presents a tabbed interface with horizontal section ribbons at the top and","type":"text"},{"text":" ","type":"text"},{"text":"content grids below. Each section can display edition archives, bookmarks,","type":"text"},{"text":" ","type":"text"},{"text":"downloads, or kiosk grids.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sections are defined as an array of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem"},{"type":"text","text":" "},{"type":"text","text":"values passed to the initializer. The SDK supports three kinds of section"},{"type":"text","text":" "},{"type":"text","text":"items: dynamic archives, single sections, and subsection groups."}]},{"type":"heading","text":"Dynamic Archives (Recommended)","anchor":"Dynamic-Archives-Recommended","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest way to populate the carousel is with a "},{"type":"strong","inlineContent":[{"text":"shortcode","type":"text"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":".dynamicArchive","type":"codeVoice"},{"type":"text","text":". The SDK fetches publication configuration from the"},{"type":"text","text":" "},{"type":"text","text":"PageSuite backend and automatically creates the appropriate content sections:"}]},{"syntax":"swift","type":"codeListing","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)","isActive":true},{"type":"text","text":" at any"},{"type":"text","text":" "},{"type":"text","text":"time to re-fetch the remote configuration and update the carousel content."}]},{"type":"heading","text":"Manual Sections","anchor":"Manual-Sections","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For full control, define sections explicitly using "},{"type":"codeVoice","code":".section"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":".subsections"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    .section(.init(name: \"Latest\", type: .feedArchive(guid: \"APP_GUID\"))),","    .subsections(\"More\", [","        .init(name: \"Archive\", type: .replicaArchive(guid: \"PUB_GUID\")),","        .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","        .init(name: \"Downloads\", type: .downloads(type: .all))","    ])","]"]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":".section","type":"codeVoice"},{"text":" creates a top-level tab with a single content view. A","type":"text"},{"text":" ","type":"text"},{"code":".subsections","type":"codeVoice"},{"text":" creates a top-level tab with a secondary ribbon that lets","type":"text"},{"text":" ","type":"text"},{"text":"users switch between multiple content views.","type":"text"}]},{"type":"heading","text":"Content Types","anchor":"Content-Types","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType","isActive":true},{"type":"text","text":" enum defines all available content"},{"type":"text","text":" "},{"type":"text","text":"sources:"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Content Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".feedArchive(guid:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Feed edition archive identified by an application GUID.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".replicaArchive(guid:, supplements:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Replica edition archive identified by a publication GUID. Pass an optional ","type":"text"},{"code":"supplements","type":"codeVoice"},{"text":" array of publication GUIDs to include supplemental editions alongside the main archive.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".feedPublicationKiosk(publications:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grid of multiple feed publications (kiosk layout). Each cell represents a different publication and tapping one opens its archive."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".replicaPublicationKiosk(publications:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grid of multiple replica publications (kiosk layout). Same multi-publication grid for replica editions."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".bookmarks(type:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"User’s bookmarked pages and articles. Filter by type.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".downloads(type:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"User’s downloaded editions. Filter by type."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".search(config:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Full-text search across feed edition articles and pages. Requires a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration"},{"type":"text","text":". See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"},{"type":"text","text":"."}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},{"type":"text","text":" to determine whether your publications use"},{"type":"text","text":" "},{"type":"text","text":"feed or replica content types."}]},{"type":"heading","text":"Per-Section Configuration Overrides","anchor":"Per-Section-Configuration-Overrides","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each content type accepts an optional configuration parameter. Use this to"},{"type":"text","text":" "},{"type":"text","text":"override the global defaults for a specific section — for example, to use a"},{"type":"text","text":" "},{"type":"text","text":"different date formatter or thumbnail aspect ratio:"}]},{"syntax":"swift","type":"codeListing","code":["var specialArchiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","specialArchiveConfig.aspectRatio = 0.75","specialArchiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)","",".section(.init(","    name: \"Special Edition\",","    type: .feedArchive(guid: \"GUID\", config: specialArchiveConfig)","))"]},{"type":"heading","text":"Dismiss Button and Safe Area","anchor":"Dismiss-Button-and-Safe-Area","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When presenting the carousel modally, add a dismiss button:"}]},{"syntax":"swift","type":"codeListing","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control which safe area edges the carousel ignores. This is useful when"},{"type":"text","text":" "},{"type":"text","text":"embedding the carousel in a container that already provides its own safe"},{"type":"text","text":" "},{"type":"text","text":"area handling:"}]},{"syntax":"swift","type":"codeListing","code":["carouselConfig.ignoreSafeArea = .bottom"]},{"type":"heading","text":"Complete Example","anchor":"Complete-Example","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A carousel combining a dynamic archive, a manual section with a per-section"},{"type":"text","text":" "},{"type":"text","text":"configuration override, and a subsection group:"}]},{"syntax":"swift","type":"codeListing","code":["let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","","\/\/ Per-section override for the premium archive","var premiumConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","premiumConfig.aspectRatio = 0.75","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        \/\/ Dynamic archive populated from a shortcode","        .dynamicArchive(\"Latest\", shortcode: \"SHORTCODE\"),","","        \/\/ Manual section with a per-section configuration","        .section(.init(","            name: \"Premium\",","            type: .replicaArchive(","                guid: \"PUB_GUID\",","                supplements: [\"SUPPLEMENT_PUB_GUID\"],","                config: premiumConfig","            )","        )),","","        \/\/ Subsection group for user content","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"]},{"type":"heading","text":"SwiftUI Integration","anchor":"SwiftUI-Integration","level":2},{"type":"paragraph","inlineContent":[{"text":"Wrap ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference"},{"text":" in a ","type":"text"},{"code":"UIViewControllerRepresentable","type":"codeVoice"},{"text":" for use","type":"text"},{"text":" ","type":"text"},{"text":"in SwiftUI:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","}"]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Localization"],"generated":true,"title":"Customization","anchor":"Customization"}],"abstract":[{"type":"text","text":"