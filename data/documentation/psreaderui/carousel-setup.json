{"abstract":[{"text":"Configure the carousel’s sections, content sources, and layout.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"kind":"article","metadata":{"modules":[{"name":"PSReaderUI"}],"role":"article","title":"Carousel Setup","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"title":"Customization","anchor":"Customization","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Theming-and-Customization","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Standalone-View-Controllers","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Localization"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference"},{"text":" is the primary entry point for the PSReaderUI SDK.","type":"text"},{"text":" ","type":"text"},{"text":"It presents a tabbed interface with horizontal section ribbons at the top and","type":"text"},{"text":" ","type":"text"},{"text":"content grids below. Each section can display edition archives, bookmarks,","type":"text"},{"text":" ","type":"text"},{"text":"downloads, or kiosk grids.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Sections are defined as an array of ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"values passed to the initializer. The SDK supports three kinds of section","type":"text"},{"text":" ","type":"text"},{"text":"items: dynamic archives, single sections, and subsection groups.","type":"text"}]},{"type":"heading","text":"Dynamic Archives (Recommended)","level":2,"anchor":"Dynamic-Archives-Recommended"},{"type":"paragraph","inlineContent":[{"text":"The simplest way to populate the carousel is with a ","type":"text"},{"inlineContent":[{"type":"text","text":"shortcode"}],"type":"strong"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":".dynamicArchive","type":"codeVoice"},{"text":". The SDK fetches publication configuration from the","type":"text"},{"text":" ","type":"text"},{"text":"PageSuite backend and automatically creates the appropriate content sections:","type":"text"}]},{"type":"codeListing","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)","isActive":true},{"type":"text","text":" at any"},{"type":"text","text":" "},{"type":"text","text":"time to re-fetch the remote configuration and update the carousel content."}]},{"type":"heading","text":"Manual Sections","level":2,"anchor":"Manual-Sections"},{"type":"paragraph","inlineContent":[{"text":"For full control, define sections explicitly using ","type":"text"},{"code":".section","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":".subsections","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    .section(.init(name: \"Latest\", type: .feedArchive(guid: \"APP_GUID\"))),","    .subsections(\"More\", [","        .init(name: \"Archive\", type: .replicaArchive(guid: \"PUB_GUID\")),","        .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","        .init(name: \"Downloads\", type: .downloads(type: .all))","    ])","]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":".section"},{"type":"text","text":" creates a top-level tab with a single content view. A"},{"type":"text","text":" "},{"type":"codeVoice","code":".subsections"},{"type":"text","text":" creates a top-level tab with a secondary ribbon that lets"},{"type":"text","text":" "},{"type":"text","text":"users switch between multiple content views."}]},{"text":"Content Types","level":2,"type":"heading","anchor":"Content-Types"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType"},{"text":" enum defines all available content","type":"text"},{"text":" ","type":"text"},{"text":"sources:","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Content Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".feedArchive(guid:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Feed edition archive identified by an application GUID.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".replicaArchive(guid:, supplements:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Replica edition archive identified by a publication GUID. Pass an optional ","type":"text"},{"code":"supplements","type":"codeVoice"},{"text":" array of publication GUIDs to include supplemental editions alongside the main archive.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".feedPublicationKiosk(publications:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Grid of multiple feed publications (kiosk layout). Each cell represents a different publication and tapping one opens its archive.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".replicaPublicationKiosk(publications:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Grid of multiple replica publications (kiosk layout). Same multi-publication grid for replica editions.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".bookmarks(type:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"User’s bookmarked pages and articles. Filter by type.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".downloads(type:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"User’s downloaded editions. Filter by type."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".search(config:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Full-text search across feed edition articles and pages. Requires a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration"},{"type":"text","text":". See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"},{"type":"text","text":"."}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","isActive":true},{"type":"text","text":" to determine whether your publications use"},{"type":"text","text":" "},{"type":"text","text":"feed or replica content types."}],"type":"paragraph"},{"text":"Per-Section Configuration Overrides","level":2,"type":"heading","anchor":"Per-Sect