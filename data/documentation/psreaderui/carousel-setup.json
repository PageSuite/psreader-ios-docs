{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","type":"reference","isActive":true},{"text":" is the primary entry point for the PSReaderUI SDK.","type":"text"},{"text":" ","type":"text"},{"text":"It presents a tabbed interface with horizontal section ribbons at the top and","type":"text"},{"text":" ","type":"text"},{"text":"content grids below. Each section can display edition archives, bookmarks,","type":"text"},{"text":" ","type":"text"},{"text":"downloads, or kiosk grids.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Sections are defined as an array of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/SectionItem"},{"type":"text","text":" "},{"type":"text","text":"values passed to the initializer. The SDK supports three kinds of section"},{"type":"text","text":" "},{"type":"text","text":"items: dynamic archives, single sections, and subsection groups."}],"type":"paragraph"},{"anchor":"Dynamic-Archives-Recommended","text":"Dynamic Archives (Recommended)","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The simplest way to populate the carousel is with a "},{"type":"strong","inlineContent":[{"type":"text","text":"shortcode"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":". The SDK fetches publication configuration from the"},{"type":"text","text":" "},{"type":"text","text":"PageSuite backend and automatically creates the appropriate content sections:"}],"type":"paragraph"},{"syntax":"swift","code":["let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"type":"codeListing"},{"inlineContent":[{"text":"Call ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/refreshDynamicArchives(completion:)"},{"type":"text","text":" at any"},{"type":"text","text":" "},{"type":"text","text":"time to re-fetch the remote configuration and update the carousel content."}],"type":"paragraph"},{"level":2,"text":"Manual Sections","type":"heading","anchor":"Manual-Sections"},{"inlineContent":[{"text":"For full control, define sections explicitly using ","type":"text"},{"type":"codeVoice","code":".section"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".subsections"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let sections: [PSReaderUI.CarouselViewController.SectionItem] = [","    .section(.init(name: \"Latest\", type: .feedArchive(guid: \"APP_GUID\"))),","    .subsections(\"More\", [","        .init(name: \"Archive\", type: .replicaArchive(guid: \"PUB_GUID\")),","        .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","        .init(name: \"Downloads\", type: .downloads(type: .all))","    ])","]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"code":".section","type":"codeVoice"},{"type":"text","text":" creates a top-level tab with a single content view. A"},{"type":"text","text":" "},{"code":".subsections","type":"codeVoice"},{"type":"text","text":" creates a top-level tab with a secondary ribbon that lets"},{"type":"text","text":" "},{"type":"text","text":"users switch between multiple content views."}],"type":"paragraph"},{"level":2,"text":"Content Types","type":"heading","anchor":"Content-Types"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController\/ContentType","type":"reference"},{"text":" enum defines all available content","type":"text"},{"text":" ","type":"text"},{"text":"sources:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Content Type"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".feedArchive(guid:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Feed edition archive identified by an application GUID.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".replicaArchive(guid:, supplements:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replica edition archive identified by a publication GUID. Pass an optional "},{"type":"codeVoice","code":"supplements"},{"type":"text","text":" array of publication GUIDs to include supplemental editions alongside the main archive."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".feedPublicationKiosk(publications:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grid of multiple feed publications (kiosk layout). Each cell represents a different publication and tapping one opens its archive."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".replicaPublicationKiosk(publications:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grid of multiple replica publications (kiosk layout). Same multi-publication grid for replica editions."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".bookmarks(type:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"User’s bookmarked pages and articles. Filter by type.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".downloads(type:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"User’s downloaded editions. Filter by type."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".search(config:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full-text search across feed edition articles and pages. Requires a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/SearchConfiguration"},{"text":". See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"},{"text":".","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},{"text":" to determine whether your publications use","type":"text"},{"text":" ","type":"text"},{"text":"feed or replica content types.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Per-Section Configuration Overrides","type":"heading","anchor":"Per-Section-Configuration-Overrides"},{"inlineContent":[{"type":"text","text":"Each content type accepts an optional configuration parameter. Use this to"},{"type":"text","text":" "},{"type":"text","text":"override the global defaults for a specific section — for example, to use a"},{"type":"text","text":" "},{"type":"text","text":"different date formatter or thumbnail aspect ratio:"}],"type":"paragraph"},{"syntax":"swift","code":["var specialArchiveConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","specialArchiveConfig.aspectRatio = 0.75","specialArchiveConfig.thumbnailContentMode = .flexibleHeight(estimatedAspectRatio: 0.75)","",".section(.init(","    name: \"Special Edition\",","    type: .feedArchive(guid: \"GUID\", config: specialArchiveConfig)","))"],"type":"codeListing"},{"level":2,"text":"Dismiss Button and Safe Area","type":"heading","anchor":"Dismiss-Button-and-Safe-Area"},{"inlineContent":[{"type":"text","text":"When presenting the carousel modally, add a dismiss button:"}],"type":"paragraph"},{"syntax":"swift","code":["var carouselConfig = PSReaderUI.CarouselConfiguration(globalConfig: globalConfig)","carouselConfig.dismissButton = .dismissButton(position: .leading())"],"type":"codeListing"},{"inlineContent":[{"text":"Control which safe area edges the carousel ignores. This is useful when","type":"text"},{"type":"text","text":" "},{"type":"text","text":"embedding the carousel in a container that already provides its own safe"},{"type":"text","text":" "},{"type":"text","text":"area handling:"}],"type":"paragraph"},{"syntax":"swift","code":["carouselConfig.ignoreSafeArea = .bottom"],"type":"codeListing"},{"level":2,"text":"Complete Example","type":"heading","anchor":"Complete-Example"},{"inlineContent":[{"text":"A carousel combining a dynamic archive, a manual section with a per-section","type":"text"},{"text":" ","type":"text"},{"text":"configuration override, and a subsection group:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let globalConfig = PSReaderUI.GlobalConfiguration(","    apiKey: apiKey,","    accountGUID: accountGUID",")","","\/\/ Per-section override for the premium archive","var premiumConfig = PSReaderUI.ArchiveConfiguration(globalConfig: globalConfig)","premiumConfig.aspectRatio = 0.75","","let carouselVC = PSReaderUI.CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        \/\/ Dynamic archive populated from a shortcode","        .dynamicArchive(\"Latest\", shortcode: \"SHORTCODE\"),","","        \/\/ Manual section with a per-section configuration","        .section(.init(","            name: \"Premium\",","            type: .replicaArchive(","                guid: \"PUB_GUID\",","                supplements: [\"SUPPLEMENT_PUB_GUID\"],","                config: premiumConfig","            )","        )),","","        \/\/ Subsection group for user content","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"type":"codeListing"},{"level":2,"text":"SwiftUI Integration","type":"heading","anchor":"SwiftUI-Integration"},{"inlineContent":[{"type":"text","text":"Wrap "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/CarouselViewController","isActive":true},{"type":"text","text":" in a "},{"type":"codeVoice","code":"UIViewControllerRepresentable"},{"type":"text","text":" for use"},{"type":"text","text":" "},{"type":"text","text":"in SwiftUI:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import PSReaderUI","","struct ReaderView: UIViewControllerRepresentable {","    func makeUIViewController(context: Context) -> PSReaderUI.CarouselViewController {","        let globalConfig = PSReaderUI.GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\"","        )","        return PSReaderUI.CarouselViewController(","            globalConfig: globalConfig,","            sections: [","                .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","            ]","        )","    }","","    func updateUIViewController(_ uiViewController: PSReaderUI.CarouselViewController, context: Context) {}","}"],"type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/psreaderui\/carousel-setup"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/carousel-setup"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"role":"article","title":"Carousel Setup","roleHeading":"Article","modules":[{"name":"PSReaderUI"}]},"abstract":[{"text":"Configure th