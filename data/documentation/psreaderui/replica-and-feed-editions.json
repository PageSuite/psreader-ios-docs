{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The PSReaderUI SDK supports two distinct backend systems for delivering digital","type":"text"},{"text":" ","type":"text"},{"text":"publication content. Which system your publications use determines the content","type":"text"},{"text":" ","type":"text"},{"text":"types you configure, the analytics events you receive, and which delegate","type":"text"},{"text":" ","type":"text"},{"text":"methods the SDK calls.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consult the PageSuite portal or your account manager to determine which system"},{"type":"text","text":" "},{"type":"text","text":"applies to your publications."}]},{"type":"heading","text":"Shortcodes","level":2,"anchor":"Shortcodes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"type":"text","text":"shortcode"}]},{"type":"text","text":" is a remote configuration set up in the PageSuite portal that"},{"type":"text","text":" "},{"type":"text","text":"maps to your publication setup. When you use a shortcode with "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the SDK fetches this configuration and automatically populates the correct"},{"type":"text","text":" "},{"type":"text","text":"publications — routing to either the feed or replica system as appropriate."}]},{"code":[".dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is the ","type":"text"},{"type":"strong","inlineContent":[{"text":"recommended approach","type":"text"}]},{"text":" for loading content. You don’t need to","type":"text"},{"text":" ","type":"text"},{"text":"manage GUIDs yourself or know which backend system your publications use — the","type":"text"},{"text":" ","type":"text"},{"text":"shortcode handles it. See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference","isActive":true},{"text":" for more detail on configuring","type":"text"},{"text":" ","type":"text"},{"text":"sections.","type":"text"}]},{"type":"heading","text":"Feed Editions","level":2,"anchor":"Feed-Editions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed editions are the "},{"type":"strong","inlineContent":[{"text":"modern","type":"text"}]},{"type":"text","text":" content system. They deliver a mix of HTML"},{"type":"text","text":" "},{"type":"text","text":"article templates and PDF pages, enabling responsive layouts that adapt to"},{"type":"text","text":" "},{"type":"text","text":"different screen sizes and orientations. Key advantages over replica editions"},{"type":"text","text":" "},{"type":"text","text":"include:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rich templates"}]},{"type":"text","text":" — elaborate article layouts such as multi-column templates"},{"type":"text","text":" "},{"type":"text","text":"that go beyond a static PDF reproduction."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"In-flow advertising"}],"type":"strong"},{"text":" — greater support for ads placed directly within","type":"text"},{"text":" ","type":"text"},{"text":"article content.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Faster backend"}]},{"type":"text","text":" — improved content delivery for quicker load times."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Feed edition publications are identified by an ","type":"text"},{"type":"strong","inlineContent":[{"text":"application GUID","type":"text"}]},{"text":". When","type":"text"},{"text":" ","type":"text"},{"text":"configuring sections manually (without a shortcode), use the ","type":"text"},{"type":"codeVoice","code":".feedArchive"},{"text":" ","type":"text"},{"text":"content type:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))"]},{"type":"heading","level":2,"anchor":"Replica-Editions","text":"Replica Editions"},{"type":"paragraph","inlineContent":[{"text":"Replica editions are the ","type":"text"},{"inlineContent":[{"text":"legacy","type":"text"}],"type":"strong"},{"text":" content system. They deliver PDF-only","type":"text"},{"text":" ","type":"text"},{"text":"pages that reproduce the print layout of a publication. Users navigate through","type":"text"},{"text":" ","type":"text"},{"text":"a faithful digital replica of the printed product.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replica publications are identified by a "},{"inlineContent":[{"type":"text","text":"publication GUID"}],"type":"strong"},{"type":"text","text":". When configuring"},{"type":"text","text":" "},{"type":"text","text":"sections manually (without a shortcode), use the "},{"code":".replicaArchive","type":"codeVoice"},{"type":"text","text":" content type:"}]},{"type":"codeListing","syntax":"swift","code":[".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"]},{"type":"heading","level":2,"anchor":"Transition","text":"Transition"},{"type":"paragraph","inlineContent":[{"type":"text","text":"PageSuite is transitioning publications from the replica system to feed"},{"type":"text","text":" "},{"type":"text","text":"editions. New publications are typically set up as feed editions, while"},{"type":"text","text":" "},{"type":"text","text":"existing replica publications may be migrated over time. Your account manager"},{"type":"text","text":" "},{"type":"text","text":"can advise on the timeline and steps for any migration."}]},{"type":"heading","level":2,"anchor":"Impact-on-the-SDK","text":"Impact on the SDK"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The backend system affects several areas of the SDK:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Content types"}]},{"type":"text","text":" — Use "},{"type":"codeVoice","code":".feedArchive"},{"type":"text","text":" for feed editions and"},{"type":"text","text":" "},{"type":"codeVoice","code":".replicaArchive"},{"type":"text","text":" for replica editions when configuring sections manually."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":".dynamicArchive"},{"text":" with a shortcode to let the SDK choose automatically.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Analytics events","type":"text"}]},{"text":" — Feed editions emit ","type":"text"},{"code":"feedEdition*","type":"codeVoice"},{"text":" events; replica","type":"text"},{"text":" ","type":"text"},{"text":"editions emit ","type":"text"},{"code":"replica*","type":"codeVoice"},{"text":" events. See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Paywall delegate methods"}]},{"type":"text","text":" — Separate delegate methods exist for opening"},{"type":"text","text":" "},{"type":"text","text":"and downloading feed vs replica editions. See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Share delegate methods","type":"text"}]},{"type":"text","text":" — Separate methods handle sharing for feed pages"},{"type":"text","text":" "},{"type":"text","text":"and replica spreads. See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Audio delegate methods"}],"type":"strong"},{"type":"text","text":" — Separate methods handle TTS for feed pages"},{"type":"text","text":" "},{"type":"text","text":"and replica spreads. See "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","isActive":true,"type":"reference"},{"type":"text","text":"."}]}]}]},{"level":2,"type":"heading","text":"Replica Reader Variants","anchor":"Replica-Reader-Variants"},{"inlineContent":[{"type":"text","text":"Replica editions can be displayed using one of two reader implementations:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Legacy reader","type":"text"}]},{"type":"text","text":" — the original PDF reader with its own navigation and"},{"type":"text","text":" "},{"type":"text","text":"toolbar UI. Configured via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Modern reader"}],"type":"strong"},{"text":" — a newer implementation whose look and feel matches the","type":"text"},{"text":" ","type":"text"},{"text":"feed edition reader, providing a consistent experience across both systems.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The active reader is controlled by "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The default is currently "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (legacy), but will change to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (modern)"},{"type":"text","text":" "},{"type":"text","text":"in a future release. If you are starting a new integration, consider using the"},{"type":"text","text":" "},{"type":"text","text":"modern reader from the outset."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Understand the two backend systems that power PSReaderUI content.","type":"text"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"PSReaderUI"}],"title":"Replica and Feed Editions"},"kind":"article","references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Analytics":{"url":"\/documentation\/psreaderui\/analytics","kind":"article","type":"topic","abstract":[{"text":"Track user interactions and content engagement across the PSReaderUI SDK.","type":"text"}],"role":"article","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","title":"Analytics"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI":{"title":"PSReaderUI","role":"collection","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI","url":"\/documentation\/psreaderui","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A UI framework for building digital newspaper and magazine reader experiences on iOS."}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Paywall-Integration":{"kind":"article","role":"article","title":"Paywall Integration","url":"\/documentation\/psreaderui\/paywall-integration","type":"topic","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","abstract":[{"type":"text","text":"Restrict access to premium content with custom paywall screens."}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ReaderConfiguration/useLegacyReplicaReader":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader","abstract":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", uses the legacy replica reader instead of the modern implementation."}],"kind":"symbol","url":"\/documentation\/psreaderui\/readerconfiguration\/uselegacyreplicareader","title":"useLegacyReplicaReader","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"useLegacyReplicaReader"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Text-to-Speech":{"title":"Text-to-Speech","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","abstract":[{"text":"Add audio playback of article content using the SDK’s text-to-speech system.","type":"text"}],"type":"topic","url":"\/documentation\/psreaderui\/text-to-speech","kind":"article","role":"article"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Carousel-Setup":{"url":"\/documentation\/psreaderui\/carousel-setup","role":"article","title":"Carousel Setup","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","abstract":[{"type":"text","text":"Configure the carousel’s sections, content sources, and layout."}],"kind":"article","type":"topic"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Sharing":{"title":"Sharing","url":"\/documentation\/psreaderui\/sharing","role":"article","kind":"article","abstract":[{"text":"Configure how users share edition content from the reader.","type":"text"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","type":"topic"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/LegacyReaderConfiguration":{"type":"topic","url":"\/documentation\/psreaderui\/legacyreaderconfiguration","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LegacyReaderConfiguration"}],"title":"LegacyReaderConfiguration","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"LegacyReaderConfiguration"}],"abstract":[{"type":"text","text":"Configuration object for customizing the appearance, behavior, and sharing"},{"type":"text","text":" "},{"type":"text","text":"strategies of the legacy replica reader."}]}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"op":"replace","path":"\/identifier\/interfaceLanguage","value":"occ"},{"op":"add","path":"\/topicSections","value":null},{"op":"add","path":"\/seeAlsoSections","value":null}]}]}