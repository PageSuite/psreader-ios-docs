{"abstract":[{"type":"text","text":"Understand the two backend systems that power PSReaderUI content."}],"metadata":{"title":"Replica and Feed Editions","modules":[{"name":"PSReaderUI"}],"role":"article","roleHeading":"Article"},"kind":"article","identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The PSReaderUI SDK supports two distinct backend systems for delivering digital","type":"text"},{"text":" ","type":"text"},{"text":"publication content. Which system your publications use determines the content","type":"text"},{"text":" ","type":"text"},{"text":"types you configure, the analytics events you receive, and which delegate","type":"text"},{"text":" ","type":"text"},{"text":"methods the SDK calls.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consult the PageSuite portal or your account manager to determine which system"},{"type":"text","text":" "},{"type":"text","text":"applies to your publications."}]},{"anchor":"Shortcodes","level":2,"type":"heading","text":"Shortcodes"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"shortcode"}],"type":"strong"},{"text":" is a remote configuration set up in the PageSuite portal that","type":"text"},{"text":" ","type":"text"},{"text":"maps to your publication setup. When you use a shortcode with ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the SDK fetches this configuration and automatically populates the correct","type":"text"},{"text":" ","type":"text"},{"text":"publications — routing to either the feed or replica system as appropriate.","type":"text"}]},{"code":[".dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is the ","type":"text"},{"inlineContent":[{"type":"text","text":"recommended approach"}],"type":"strong"},{"text":" for loading content. You don’t need to","type":"text"},{"text":" ","type":"text"},{"text":"manage GUIDs yourself or know which backend system your publications use — the","type":"text"},{"text":" ","type":"text"},{"text":"shortcode handles it. See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","isActive":true,"type":"reference"},{"text":" for more detail on configuring","type":"text"},{"text":" ","type":"text"},{"text":"sections.","type":"text"}]},{"anchor":"Feed-Editions","level":2,"type":"heading","text":"Feed Editions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed editions are the "},{"inlineContent":[{"text":"modern","type":"text"}],"type":"strong"},{"type":"text","text":" content system. They deliver a mix of HTML"},{"type":"text","text":" "},{"type":"text","text":"article templates and PDF pages, enabling responsive layouts that adapt to"},{"type":"text","text":" "},{"type":"text","text":"different screen sizes and orientations. Key advantages over replica editions"},{"type":"text","text":" "},{"type":"text","text":"include:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Rich templates"}],"type":"strong"},{"text":" — elaborate article layouts such as multi-column templates","type":"text"},{"text":" ","type":"text"},{"text":"that go beyond a static PDF reproduction.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"In-flow advertising","type":"text"}],"type":"strong"},{"type":"text","text":" — greater support for ads placed directly within"},{"type":"text","text":" "},{"type":"text","text":"article content."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Faster backend","type":"text"}]},{"text":" — improved content delivery for quicker load times.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed edition publications are identified by an "},{"type":"strong","inlineContent":[{"text":"application GUID","type":"text"}]},{"type":"text","text":". When"},{"type":"text","text":" "},{"type":"text","text":"configuring sections manually (without a shortcode), use the "},{"type":"codeVoice","code":".feedArchive"},{"type":"text","text":" "},{"type":"text","text":"content type:"}]},{"code":[".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))"],"type":"codeListing","syntax":"swift"},{"anchor":"Replica-Editions","level":2,"type":"heading","text":"Replica Editions"},{"type":"paragraph","inlineContent":[{"text":"Replica editions are the ","type":"text"},{"inlineContent":[{"text":"legacy","type":"text"}],"type":"strong"},{"text":" content system. They deliver PDF-only","type":"text"},{"text":" ","type":"text"},{"text":"pages that reproduce the print layout of a publication. Users navigate through","type":"text"},{"text":" ","type":"text"},{"text":"a faithful digital replica of the printed product.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Replica publications are identified by a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"publication GUID"}]},{"text":". When configuring","type":"text"},{"text":" ","type":"text"},{"text":"sections manually (without a shortcode), use the ","type":"text"},{"code":".replicaArchive","type":"codeVoice"},{"text":" content type:","type":"text"}]},{"code":[".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"],"type":"codeListing","syntax":"swift"},{"anchor":"Transition","level":2,"type":"heading","text":"Transition"},{"type":"paragraph","inlineContent":[{"text":"PageSuite is transitioning publications from the replica system to feed","type":"text"},{"text":" ","type":"text"},{"text":"editions. New publications are typically set up as feed editions, while","type":"text"},{"text":" ","type":"text"},{"text":"existing replica publications may be migrated over time. Your account manager","type":"text"},{"text":" ","type":"text"},{"text":"can advise on the timeline and steps for any migration.","type":"text"}]},{"anchor":"Impact-on-the-SDK","level":2,"type":"heading","text":"Impact on the SDK"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The backend system affects several areas of the SDK:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Content types"}]},{"text":" — Use ","type":"text"},{"code":".feedArchive","type":"codeVoice"},{"text":" for feed editions and","type":"text"},{"text":" ","type":"text"},{"code":".replicaArchive","type":"codeVoice"},{"text":" for replica editions when configuring sections manually.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":".dynamicArchive","type":"codeVoice"},{"text":" with a shortcode to let the SDK choose automatically.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Analytics events"}],"type":"strong"},{"type":"text","text":" — Feed editions emit "},{"type":"codeVoice","code":"feedEdition*"},{"type":"text","text":" events; replica"},{"type":"text","text":" "},{"type":"text","text":"editions emit "},{"type":"codeVoice","code":"replica*"},{"type":"text","text":" events. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Paywall delegate methods"}]},{"type":"text","text":" — Separate delegate methods exist for opening"},{"type":"text","text":" "},{"type":"text","text":"and downloading feed vs replica editions. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Share delegate methods","type":"text"}],"type":"strong"},{"text":" — Separate methods handle sharing for feed pages","type":"text"},{"text":" ","type":"text"},{"text":"and replica spreads. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Audio delegate methods","type":"text"}]},{"type":"text","text":" — Separate methods handle TTS for feed pages"},{"type":"text","text":" "},{"type":"text","text":"and replica spreads. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Replica-Reader-Variants","level":2,"type":"heading","text":"Replica Reader Variants"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replica editions can be displayed using one of two reader implementations:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Legacy reader"}]},{"text":" — the original PDF reader with its own navigation and","type":"text"},{"text":" ","type":"text"},{"text":"toolbar UI. Configured via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Modern reader","type":"text"}]},{"type":"text","text":" — a newer implementation whose look and feel matches the"},{"type":"text","text":" "},{"type":"text","text":"feed edition reader, providing a consistent experience across both systems."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The active reader is controlled by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The default is currently "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (legacy), but will change to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (modern)"},{"type":"text","text":" "},{"type":"text","text":"in a future release. If you are starting a new integration, consider using the"},{"type":"text","text":" "},{"type":"text","text":"modern reader from the outset."}]}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"variants":[{"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Analytics":{"kind":"article","abstract":[{"type":"text","text":"Track user interactions and content engagement across the PSReaderUI SDK."}],"url":"\/documentation\/psreaderui\/analytics","title":"Analytics","type":"topic","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","role":"article"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ReaderConfiguration/useLegacyReplicaReader":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader","url":"\/documentation\/psreaderui\/readerconfigur