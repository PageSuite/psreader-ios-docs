{"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The PSReaderUI SDK supports two distinct backend systems for delivering digital","type":"text"},{"text":" ","type":"text"},{"text":"publication content. Which system your publications use determines the content","type":"text"},{"text":" ","type":"text"},{"text":"types you configure, the analytics events you receive, and which delegate","type":"text"},{"text":" ","type":"text"},{"text":"methods the SDK calls.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Consult the PageSuite portal or your account manager to determine which system"},{"type":"text","text":" "},{"type":"text","text":"applies to your publications."}],"type":"paragraph"},{"level":2,"text":"Shortcodes","type":"heading","anchor":"Shortcodes"},{"inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"shortcode"}],"type":"strong"},{"text":" is a remote configuration set up in the PageSuite portal that","type":"text"},{"text":" ","type":"text"},{"text":"maps to your publication setup. When you use a shortcode with ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the SDK fetches this configuration and automatically populates the correct","type":"text"},{"text":" ","type":"text"},{"text":"publications — routing to either the feed or replica system as appropriate.","type":"text"}],"type":"paragraph"},{"code":[".dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is the "},{"inlineContent":[{"type":"text","text":"recommended approach"}],"type":"strong"},{"type":"text","text":" for loading content. You don’t need to"},{"type":"text","text":" "},{"type":"text","text":"manage GUIDs yourself or know which backend system your publications use — the"},{"type":"text","text":" "},{"type":"text","text":"shortcode handles it. See "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference"},{"type":"text","text":" for more detail on configuring"},{"type":"text","text":" "},{"type":"text","text":"sections."}],"type":"paragraph"},{"level":2,"text":"Feed Editions","type":"heading","anchor":"Feed-Editions"},{"inlineContent":[{"text":"Feed editions are the ","type":"text"},{"inlineContent":[{"text":"modern","type":"text"}],"type":"strong"},{"text":" content system. They deliver a mix of HTML","type":"text"},{"text":" ","type":"text"},{"text":"article templates and PDF pages, enabling responsive layouts that adapt to","type":"text"},{"text":" ","type":"text"},{"text":"different screen sizes and orientations. Key advantages over replica editions","type":"text"},{"text":" ","type":"text"},{"text":"include:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Rich templates"}],"type":"strong"},{"text":" — elaborate article layouts such as multi-column templates","type":"text"},{"text":" ","type":"text"},{"text":"that go beyond a static PDF reproduction.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"In-flow advertising","type":"text"}]},{"type":"text","text":" — greater support for ads placed directly within"},{"type":"text","text":" "},{"type":"text","text":"article content."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Faster backend"}]},{"type":"text","text":" — improved content delivery for quicker load times."}]}]}]},{"inlineContent":[{"text":"Feed edition publications are identified by an ","type":"text"},{"type":"strong","inlineContent":[{"text":"application GUID","type":"text"}]},{"text":". When","type":"text"},{"text":" ","type":"text"},{"text":"configuring sections manually (without a shortcode), use the ","type":"text"},{"code":".feedArchive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"content type:","type":"text"}],"type":"paragraph"},{"code":[".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Replica Editions","type":"heading","anchor":"Replica-Editions"},{"inlineContent":[{"type":"text","text":"Replica editions are the "},{"inlineContent":[{"type":"text","text":"legacy"}],"type":"strong"},{"type":"text","text":" content system. They deliver PDF-only"},{"type":"text","text":" "},{"type":"text","text":"pages that reproduce the print layout of a publication. Users navigate through"},{"type":"text","text":" "},{"type":"text","text":"a faithful digital replica of the printed product."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Replica publications are identified by a "},{"inlineContent":[{"type":"text","text":"publication GUID"}],"type":"strong"},{"type":"text","text":". When configuring"},{"type":"text","text":" "},{"type":"text","text":"sections manually (without a shortcode), use the "},{"type":"codeVoice","code":".replicaArchive"},{"type":"text","text":" content type:"}],"type":"paragraph"},{"code":[".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Transition","type":"heading","anchor":"Transition"},{"inlineContent":[{"text":"PageSuite is transitioning publications from the replica system to feed","type":"text"},{"text":" ","type":"text"},{"text":"editions. New publications are typically set up as feed editions, while","type":"text"},{"text":" ","type":"text"},{"text":"existing replica publications may be migrated over time. Your account manager","type":"text"},{"text":" ","type":"text"},{"text":"can advise on the timeline and steps for any migration.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Impact on the SDK","type":"heading","anchor":"Impact-on-the-SDK"},{"inlineContent":[{"text":"The backend system affects several areas of the SDK:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Content types"}],"type":"strong"},{"text":" — Use ","type":"text"},{"type":"codeVoice","code":".feedArchive"},{"text":" for feed editions and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".replicaArchive"},{"text":" for replica editions when configuring sections manually.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":" with a shortcode to let the SDK choose automatically.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Analytics events"}]},{"type":"text","text":" — Feed editions emit "},{"type":"codeVoice","code":"feedEdition*"},{"type":"text","text":" events; replica"},{"type":"text","text":" "},{"type":"text","text":"editions emit "},{"type":"codeVoice","code":"replica*"},{"type":"text","text":" events. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Paywall delegate methods"}],"type":"strong"},{"type":"text","text":" — Separate delegate methods exist for opening"},{"type":"text","text":" "},{"type":"text","text":"and downloading feed vs replica editions. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Share delegate methods"}],"type":"strong"},{"text":" — Separate methods handle sharing for feed pages","type":"text"},{"text":" ","type":"text"},{"text":"and replica spreads. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Audio delegate methods","type":"text"}],"type":"strong"},{"text":" — Separate methods handle TTS for feed pages","type":"text"},{"text":" ","type":"text"},{"text":"and replica spreads. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"level":2,"text":"Replica Reader Variants","type":"heading","anchor":"Replica-Reader-Variants"},{"inlineContent":[{"text":"Replica editions can be displayed using one of two reader implementations:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Legacy reader"}],"type":"strong"},{"text":" — the original PDF reader with its own navigation and","type":"text"},{"text":" ","type":"text"},{"text":"toolbar UI. Configured via ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modern reader"}]},{"type":"text","text":" — a newer implementation whose look and feel matches the"},{"type":"text","text":" "},{"type":"text","text":"feed edition reader, providing a consistent experience across both systems."}]}]}]},{"inlineContent":[{"text":"The active reader is controlled by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The default is currently ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" (legacy), but will change to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" (modern)","type":"text"},{"text":" ","type":"text"},{"text":"in a future release. If you are starting a new integration, consider using the","type":"text"},{"text":" ","type":"text"},{"text":"modern reader from the outset.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Understand the two backend systems that power PSReaderUI content.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"PSReaderUI"}],"title":"Replica and Feed Editions"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"]}],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ReaderConfiguration/useLegacyReplicaReader":{"type":"topic","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader","title":"useLegacyReplicaReader","abstract":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", uses the legacy replica reader instead of the modern implementation.","type":"text"}],"role":"symbol","url":"\/documentation\/psreaderui\/readerconfiguration\/uselegacyreplicareader","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"useLegacyReplicaReader"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Carousel-Setup":{"kind":"article","title":"Carousel Setup","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","url":"\/documentation\/psreaderui\/carousel-setup","role":"article","abstract":[{"type":"text","text":"Configure the carousel’s sections, content sources, and layout."}],"type":"topic"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/LegacyReaderConfiguration":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LegacyReaderConfiguration"}],"url":"\/documentation\/psreaderui\/legacyreaderconfiguration","navigatorTitle":[{"kind":"identifier","text":"LegacyReaderConfiguration"}],"type":"topic","kind":"symbol","abstract":[{"text":"Configuration object for customizing the appearance, behavior, and sharing","type":"text"},{"text":" ","type":"text"},{"text":"strategies of the legacy replica reader.","type":"text"}],"title":"LegacyReaderConfiguration"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI","title":"PSReaderUI","abstract":[{"type":"text","text":"A UI framework for building digital newspaper and magazine reader experiences on iOS."}],"kind":"symbol","url":"\/documentation\/psreaderui","type":"topic","role":"collection"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Text-to-Speech":{"role":"article","title":"Text-to-Speech","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","abstract":[{"text":"Add audio playback of article content using the SDK’s text-to-speech system.","type":"text"}],"url":"\/documentation\/psreaderui\/text-to-speech","kind":"article","type":"topic"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Sharing":{"abstract":[{"text":"Configure how users share edition content from the reader.","type":"text"}],"kind":"article","url":"\/documentation\/psreaderui\/sharing","title":"Sharing","type":"topic","role":"article","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Paywall-Integration":{"role":"article","url":"\/documentation\/psreaderui\/paywall-integration","type":"topic","title":"Paywall Integration","abstract":[{"text":"Restrict access to premium content with custom paywall screens.","type":"text"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","kind":"article"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Analytics":{"kind":"article","title":"Analytics","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","abstract":[{"type":"text","text":"Track user interactions and content engagement across the PSReaderUI SDK."}],"url":"\/documentation\/psreaderui\/analytics","role":"article","type":"topic"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"path":"\/identifier\/interfaceLanguage","value":"occ","op":"replace"},{"path":"\/topicSections","value":null,"op":"add"},{"path":"\/seeAlsoSections","value":null,"op":"add"}]}]}