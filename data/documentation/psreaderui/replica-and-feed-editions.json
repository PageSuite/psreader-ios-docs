{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The PSReaderUI SDK supports two distinct backend systems for delivering digital"},{"type":"text","text":" "},{"type":"text","text":"publication content. Which system your publications use determines the content"},{"type":"text","text":" "},{"type":"text","text":"types you configure, the analytics events you receive, and which delegate"},{"type":"text","text":" "},{"type":"text","text":"methods the SDK calls."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consult the PageSuite portal or your account manager to determine which system"},{"type":"text","text":" "},{"type":"text","text":"applies to your publications."}]},{"type":"heading","level":2,"text":"Shortcodes","anchor":"Shortcodes"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"shortcode"}]},{"text":" is a remote configuration set up in the PageSuite portal that","type":"text"},{"text":" ","type":"text"},{"text":"maps to your publication setup. When you use a shortcode with ","type":"text"},{"type":"codeVoice","code":".dynamicArchive"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the SDK fetches this configuration and automatically populates the correct","type":"text"},{"text":" ","type":"text"},{"text":"publications — routing to either the feed or replica system as appropriate.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the "},{"type":"strong","inlineContent":[{"text":"recommended approach","type":"text"}]},{"type":"text","text":" for loading content. You don’t need to"},{"type":"text","text":" "},{"type":"text","text":"manage GUIDs yourself or know which backend system your publications use — the"},{"type":"text","text":" "},{"type":"text","text":"shortcode handles it. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","isActive":true},{"type":"text","text":" for more detail on configuring"},{"type":"text","text":" "},{"type":"text","text":"sections."}]},{"type":"heading","level":2,"text":"Feed Editions","anchor":"Feed-Editions"},{"type":"paragraph","inlineContent":[{"text":"Feed editions are the ","type":"text"},{"inlineContent":[{"type":"text","text":"modern"}],"type":"strong"},{"text":" content system. They deliver a mix of HTML","type":"text"},{"text":" ","type":"text"},{"text":"article templates and PDF pages, enabling responsive layouts that adapt to","type":"text"},{"text":" ","type":"text"},{"text":"different screen sizes and orientations. Key advantages over replica editions","type":"text"},{"text":" ","type":"text"},{"text":"include:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Rich templates","type":"text"}]},{"type":"text","text":" — elaborate article layouts such as multi-column templates"},{"type":"text","text":" "},{"type":"text","text":"that go beyond a static PDF reproduction."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"In-flow advertising","type":"text"}]},{"text":" — greater support for ads placed directly within","type":"text"},{"text":" ","type":"text"},{"text":"article content.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Faster backend"}]},{"type":"text","text":" — improved content delivery for quicker load times."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Feed edition publications are identified by an ","type":"text"},{"inlineContent":[{"text":"application GUID","type":"text"}],"type":"strong"},{"text":". When","type":"text"},{"text":" ","type":"text"},{"text":"configuring sections manually (without a shortcode), use the ","type":"text"},{"code":".feedArchive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"content type:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))"]},{"text":"Replica Editions","level":2,"type":"heading","anchor":"Replica-Editions"},{"inlineContent":[{"type":"text","text":"Replica editions are the "},{"type":"strong","inlineContent":[{"text":"legacy","type":"text"}]},{"type":"text","text":" content system. They deliver PDF-only"},{"type":"text","text":" "},{"type":"text","text":"pages that reproduce the print layout of a publication. Users navigate through"},{"type":"text","text":" "},{"type":"text","text":"a faithful digital replica of the printed product."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Replica publications are identified by a "},{"type":"strong","inlineContent":[{"type":"text","text":"publication GUID"}]},{"type":"text","text":". When configuring"},{"type":"text","text":" "},{"type":"text","text":"sections manually (without a shortcode), use the "},{"type":"codeVoice","code":".replicaArchive"},{"type":"text","text":" content type:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"]},{"text":"Transition","level":2,"type":"heading","anchor":"Transition"},{"inlineContent":[{"text":"PageSuite is transitioning publications from the replica system to feed","type":"text"},{"text":" ","type":"text"},{"text":"editions. New publications are typically set up as feed editions, while","type":"text"},{"text":" ","type":"text"},{"text":"existing replica publications may be migrated over time. Your account manager","type":"text"},{"text":" ","type":"text"},{"text":"can advise on the timeline and steps for any migration.","type":"text"}],"type":"paragraph"},{"text":"Impact on the SDK","level":2,"type":"heading","anchor":"Impact-on-the-SDK"},{"inlineContent":[{"text":"The backend system affects several areas of the SDK:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Content types","type":"text"}],"type":"strong"},{"type":"text","text":" — Use "},{"code":".feedArchive","type":"codeVoice"},{"type":"text","text":" for feed editions and"},{"type":"text","text":" "},{"code":".replicaArchive","type":"codeVoice"},{"type":"text","text":" for replica editions when configuring sections manually."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"code":".dynamicArchive","type":"codeVoice"},{"type":"text","text":" with a shortcode to let the SDK choose automatically."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Analytics events"}],"type":"strong"},{"type":"text","text":" — Feed editions emit "},{"code":"feedEdition*","type":"codeVoice"},{"type":"text","text":" events; replica"},{"type":"text","text":" "},{"type":"text","text":"editions emit "},{"code":"replica*","type":"codeVoice"},{"type":"text","text":" events. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Paywall delegate methods","type":"text"}]},{"type":"text","text":" — Separate delegate methods exist for opening"},{"type":"text","text":" "},{"type":"text","text":"and downloading feed vs replica editions. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Share delegate methods","type":"text"}]},{"text":" — Separate methods handle sharing for feed pages","type":"text"},{"text":" ","type":"text"},{"text":"and replica spreads. See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Audio delegate methods"}],"type":"strong"},{"text":" — Separate methods handle TTS for feed pages","type":"text"},{"text":" ","type":"text"},{"text":"and replica spreads. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","type":"reference"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"text":"Replica Reader Variants","level":2,"type":"heading","anchor":"Replica-Reader-Variants"},{"inlineContent":[{"type":"text","text":"Replica editions can be displayed using one of two reader implementations:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Legacy reader","type":"text"}]},{"text":" — the original PDF reader with its own navigation and","type":"text"},{"text":" ","type":"text"},{"text":"toolbar UI. Configured via ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Modern reader"}],"type":"strong"},{"text":" — a newer implementation whose look and feel matches the","type":"text"},{"text":" ","type":"text"},{"text":"feed edition reader, providing a consistent experience across both systems.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The active reader is controlled by ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The default is currently ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (legacy), but will change to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" (modern)","type":"text"},{"text":" ","type":"text"},{"text":"in a future release. If you are starting a new integration, consider using the","type":"text"},{"text":" ","type":"text"},{"text":"modern reader from the outset.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Understand the two backend systems that power PSReaderUI content."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"]}],"metadata":{"role":"article","title":"Replica and Feed Editions","modules":[{"name":"PSReaderUI"}],"roleHeading":"Article"},"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Sharing":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","url":"\/documentation\/psreaderui\/sharing","abstract":[{"text":"Configure how users share edition content from the reader.","type":"text"}],"type":"topic","role":"article","kind":"article","title":"Sharing"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ReaderConfiguration/useLegacyReplicaReader":{"url":"\/documentation\/psreaderui\/readerconfiguration\/uselegacyreplicareader","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"useLegacyReplicaReader","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"useLegacyReplicaReader","role":"symbol","kind":"symbol","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader","type":"topic","abstract":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", uses the legacy replica reader instead of the modern implementation.","type":"text"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Carousel-Setup":{"abstract":[{"text":"Configure the carousel’s sections, content sources, and layout.","type":"text"}],"type":"topic","url":"\/documentation\/psreaderui\/carousel-setup","kind":"article","role":"article","title":"Carousel Setup","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/LegacyReaderConfiguration":{"kind":"symbol","role":"symbol","title":"LegacyReaderConfiguration","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LegacyReaderConfiguration"}],"abstract":[{"type":"text","text":"Configuration object for customizing the appearance, behavior, and sharing"},{"type":"text","text":" "},{"type":"text","text":"strategies of the legacy replica reader."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"LegacyReaderConfiguration"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration","url":"\/documentation\/psreaderui\/legacyreaderconfiguration"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Analytics":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","kind":"article","role":"article","type":"topic","url":"\/documentation\/psreaderui\/analytics","title":"Analytics","abstract":[{"type":"text","text":"Track user interactions and content engagement across the PSReaderUI SDK."}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI","abstract":[{"text":"A UI framework for building digital newspaper and magazine reader experiences on iOS.","type":"text"}],"url":"\/documentation\/psreaderui","role":"collection","title":"PSReaderUI"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Text-to-Speech":{"title":"Text-to-Speech","url":"\/documentation\/psreaderui\/text-to-speech","type":"topic","role":"article","abstract":[{"text":"Add audio playback of article content using the SDK’s text-to-speech system.","type":"text"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","kind":"article"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Paywall-Integration":{"abstract":[{"text":"Restrict access to premium content with custom paywall screens.","type":"text"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","type":"topic","role":"article","title":"Paywall Integration","url":"\/documentation\/psreaderui\/paywall-integration","kind":"article"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"op":"replace","value":"occ","path":"\/identifier\/interfaceLanguage"},{"op":"add","value":null,"path":"\/topicSections"},{"op":"add","value":null,"path":"\/seeAlsoSections"}]}]}