{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The PSReaderUI SDK supports two distinct backend systems for delivering digital"},{"type":"text","text":" "},{"type":"text","text":"publication content. Which system your publications use determines the content"},{"type":"text","text":" "},{"type":"text","text":"types you configure, the analytics events you receive, and which delegate"},{"type":"text","text":" "},{"type":"text","text":"methods the SDK calls."}]},{"type":"paragraph","inlineContent":[{"text":"Consult the PageSuite portal or your account manager to determine which system","type":"text"},{"text":" ","type":"text"},{"text":"applies to your publications.","type":"text"}]},{"type":"heading","text":"Shortcodes","anchor":"Shortcodes","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"text":"shortcode","type":"text"}]},{"type":"text","text":" is a remote configuration set up in the PageSuite portal that"},{"type":"text","text":" "},{"type":"text","text":"maps to your publication setup. When you use a shortcode with "},{"type":"codeVoice","code":".dynamicArchive"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the SDK fetches this configuration and automatically populates the correct"},{"type":"text","text":" "},{"type":"text","text":"publications — routing to either the feed or replica system as appropriate."}]},{"type":"codeListing","code":[".dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is the ","type":"text"},{"inlineContent":[{"text":"recommended approach","type":"text"}],"type":"strong"},{"text":" for loading content. You don’t need to","type":"text"},{"text":" ","type":"text"},{"text":"manage GUIDs yourself or know which backend system your publications use — the","type":"text"},{"text":" ","type":"text"},{"text":"shortcode handles it. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","type":"reference"},{"text":" for more detail on configuring","type":"text"},{"text":" ","type":"text"},{"text":"sections.","type":"text"}]},{"type":"heading","text":"Feed Editions","anchor":"Feed-Editions","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed editions are the "},{"type":"strong","inlineContent":[{"text":"modern","type":"text"}]},{"type":"text","text":" content system. They deliver a mix of HTML"},{"type":"text","text":" "},{"type":"text","text":"article templates and PDF pages, enabling responsive layouts that adapt to"},{"type":"text","text":" "},{"type":"text","text":"different screen sizes and orientations. Key advantages over replica editions"},{"type":"text","text":" "},{"type":"text","text":"include:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rich templates"}]},{"type":"text","text":" — elaborate article layouts such as multi-column templates"},{"type":"text","text":" "},{"type":"text","text":"that go beyond a static PDF reproduction."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"In-flow advertising","type":"text"}]},{"text":" — greater support for ads placed directly within","type":"text"},{"text":" ","type":"text"},{"text":"article content.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Faster backend"}],"type":"strong"},{"text":" — improved content delivery for quicker load times.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Feed edition publications are identified by an ","type":"text"},{"inlineContent":[{"type":"text","text":"application GUID"}],"type":"strong"},{"text":". When","type":"text"},{"text":" ","type":"text"},{"text":"configuring sections manually (without a shortcode), use the ","type":"text"},{"type":"codeVoice","code":".feedArchive"},{"text":" ","type":"text"},{"text":"content type:","type":"text"}]},{"type":"codeListing","code":[".section(.init(name: \"Editions\", type: .feedArchive(guid: \"APP_GUID\")))"],"syntax":"swift"},{"type":"heading","text":"Replica Editions","anchor":"Replica-Editions","level":2},{"type":"paragraph","inlineContent":[{"text":"Replica editions are the ","type":"text"},{"inlineContent":[{"type":"text","text":"legacy"}],"type":"strong"},{"text":" content system. They deliver PDF-only","type":"text"},{"text":" ","type":"text"},{"text":"pages that reproduce the print layout of a publication. Users navigate through","type":"text"},{"text":" ","type":"text"},{"text":"a faithful digital replica of the printed product.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Replica publications are identified by a ","type":"text"},{"inlineContent":[{"text":"publication GUID","type":"text"}],"type":"strong"},{"text":". When configuring","type":"text"},{"text":" ","type":"text"},{"text":"sections manually (without a shortcode), use the ","type":"text"},{"type":"codeVoice","code":".replicaArchive"},{"text":" content type:","type":"text"}]},{"type":"codeListing","code":[".section(.init(name: \"Editions\", type: .replicaArchive(guid: \"PUB_GUID\")))"],"syntax":"swift"},{"type":"heading","text":"Transition","anchor":"Transition","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"PageSuite is transitioning publications from the replica system to feed"},{"type":"text","text":" "},{"type":"text","text":"editions. New publications are typically set up as feed editions, while"},{"type":"text","text":" "},{"type":"text","text":"existing replica publications may be migrated over time. Your account manager"},{"type":"text","text":" "},{"type":"text","text":"can advise on the timeline and steps for any migration."}]},{"type":"heading","text":"Impact on the SDK","anchor":"Impact-on-the-SDK","level":2},{"type":"paragraph","inlineContent":[{"text":"The backend system affects several areas of the SDK:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Content types"}]},{"type":"text","text":" — Use "},{"code":".feedArchive","type":"codeVoice"},{"type":"text","text":" for feed editions and"},{"type":"text","text":" "},{"code":".replicaArchive","type":"codeVoice"},{"type":"text","text":" for replica editions when configuring sections manually."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"code":".dynamicArchive","type":"codeVoice"},{"type":"text","text":" with a shortcode to let the SDK choose automatically."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Analytics events"}],"type":"strong"},{"text":" — Feed editions emit ","type":"text"},{"code":"feedEdition*","type":"codeVoice"},{"text":" events; replica","type":"text"},{"text":" ","type":"text"},{"text":"editions emit ","type":"text"},{"code":"replica*","type":"codeVoice"},{"text":" events. See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Paywall delegate methods","type":"text"}],"type":"strong"},{"type":"text","text":" — Separate delegate methods exist for opening"},{"type":"text","text":" "},{"type":"text","text":"and downloading feed vs replica editions. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Share delegate methods","type":"text"}],"type":"strong"},{"type":"text","text":" — Separate methods handle sharing for feed pages"},{"type":"text","text":" "},{"type":"text","text":"and replica spreads. See "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","type":"reference"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Audio delegate methods","type":"text"}],"type":"strong"},{"type":"text","text":" — Separate methods handle TTS for feed pages"},{"type":"text","text":" "},{"type":"text","text":"and replica spreads. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","isActive":true},{"type":"text","text":"."}]}]}]},{"level":2,"anchor":"Replica-Reader-Variants","text":"Replica Reader Variants","type":"heading"},{"inlineContent":[{"type":"text","text":"Replica editions can be displayed using one of two reader implementations:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Legacy reader","type":"text"}],"type":"strong"},{"type":"text","text":" — the original PDF reader with its own navigation and"},{"type":"text","text":" "},{"type":"text","text":"toolbar UI. Configured via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Modern reader","type":"text"}]},{"type":"text","text":" — a newer implementation whose look and feel matches the"},{"type":"text","text":" "},{"type":"text","text":"feed edition reader, providing a consistent experience across both systems."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The active reader is controlled by "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The default is currently "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (legacy), but will change to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (modern)"},{"type":"text","text":" "},{"type":"text","text":"in a future release. If you are starting a new integration, consider using the"},{"type":"text","text":" "},{"type":"text","text":"modern reader from the outset."}],"type":"paragraph"}]}],"abstract":[{"text":"Understand the two backend systems that power PSReaderUI content.","type":"text"}],"variants":[{"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/replica-and-feed-editions"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Replica-and-Feed-Editions"},"metadata":{"role":"article","modules":[{"name":"PSReaderUI"}],"title":"Replica and Feed Editions","roleHeading":"Article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Sharing":{"kind":"article","abstract":[{"type":"text","text":"Configure how users share edition content from the reader."}],"role":"article","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","type":"topic","url":"\/documentation\/psreaderui\/sharing","title":"Sharing"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/LegacyReaderConfiguration":{"url":"\/documentation\/psreaderui\/legacyreaderconfiguration","type":"topic","title":"LegacyReaderConfiguration","navigatorTitle":[{"kind":"identifier","text":"LegacyReaderConfiguration"}],"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LegacyReaderConfiguration","role":"symbol","abstract":[{"type":"text","text":"Configuration object for customizing the appearance, behavior, and sharing"},{"type":"text","text":" "},{"type":"text","text":"strategies of the legacy replica reader."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LegacyReaderConfiguration"}]},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Carousel-Setup":{"url":"\/documentation\/psreaderui\/carousel-setup","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Carousel-Setup","role":"article","abstract":[{"type":"text","text":"Configure the carousel’s sections, content sources, and layout."}],"type":"topic","title":"Carousel Setup","kind":"article"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI":{"title":"PSReaderUI","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI","kind":"symbol","abstract":[{"text":"A UI framework for building digital newspaper and magazine reader experiences on iOS.","type":"text"}],"type":"topic","role":"collection","url":"\/documentation\/psreaderui"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Text-to-Speech":{"kind":"article","abstract":[{"type":"text","text":"Add audio playback of article content using the SDK’s text-to-speech system."}],"title":"Text-to-Speech","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","url":"\/documentation\/psreaderui\/text-to-speech","type":"topic","role":"article"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Analytics":{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","abstract":[{"type":"text","text":"Track user interactions and content engagement across the PSReaderUI SDK."}],"type":"topic","url":"\/documentation\/psreaderui\/analytics","kind":"article","role":"article","title":"Analytics"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Paywall-Integration":{"url":"\/documentation\/psreaderui\/paywall-integration","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","title":"Paywall Integration","type":"topic","abstract":[{"type":"text","text":"Restrict access to premium content with custom paywall screens."}],"role":"article","kind":"article"},"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/ReaderConfiguration/useLegacyReplicaReader":{"url":"\/documentation\/psreaderui\/readerconfiguration\/uselegacyreplicareader","role":"symbol","kind":"symbol","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderConfiguration\/useLegacyReplicaReader","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"useLegacyReplicaReader"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","abstract":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", uses the legacy replica reader instead of the modern implementation.","type":"text"}],"title":"useLegacyReplicaReader"}},"variantOverrides":[{"patch":[{"path":"\/identifier\/interfaceLanguage","value":"occ","op":"replace"},{"path":"\/topicSections","value":null,"op":"add"},{"path":"\/seeAlsoSections","value":null,"op":"add"}],"traits":[{"interfaceLanguage":"occ"}]}]}