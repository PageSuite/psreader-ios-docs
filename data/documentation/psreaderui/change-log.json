{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Versioning-Scheme","text":"Versioning Scheme"},{"type":"aside","name":"Note","content":[{"inlineContent":[{"text":"Starting in 2026, the SDK uses a calendar-based versioning scheme to","type":"text"},{"text":" ","type":"text"},{"text":"align with the rest of the PageSuite product line. Versions follow the format","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"year.month.patch"}],"type":"strong"},{"text":" — for example, ","type":"text"},{"code":"26.1.0","type":"codeVoice"},{"text":" is the first January 2026","type":"text"},{"text":" ","type":"text"},{"text":"release. This scheme does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" follow semantic versioning. While we strive"},{"type":"text","text":" "},{"type":"text","text":"to maintain API stability, breaking changes may occur in any release without a"},{"type":"text","text":" "},{"type":"text","text":"major version bump. We recommend pinning to a specific version and reviewing"},{"type":"text","text":" "},{"type":"text","text":"this change log before upgrading."}],"type":"paragraph"}],"style":"note"},{"type":"heading","level":2,"anchor":"v2660","text":"v26.6.0"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Extended hide-on-swipe behavior to PDF pages and the replica reader.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Behavior change:","type":"text"}],"type":"strong"},{"text":" Navigation bars now also collapse on scroll in PDF","type":"text"},{"text":" ","type":"text"},{"text":"pages and replica editions by default.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/ReaderNavigationBarConfiguration\/hidesBarsOnSwipe","type":"reference"},{"text":".","t