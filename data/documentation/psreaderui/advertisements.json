{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"abstract":[{"text":"Display custom advertisements within the reader.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By default the PSReaderUI SDK does not display any advertisements.","type":"text"},{"text":" ","type":"text"},{"text":"Advertisement support is opt-in through the ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate","isActive":true,"type":"reference"},{"text":" protocol.","type":"text"},{"text":" ","type":"text"},{"text":"Implement this delegate to provide view controllers that the SDK embeds as","type":"text"},{"text":" ","type":"text"},{"text":"banner ads within the reader.","type":"text"}]},{"type":"heading","anchor":"Protocol-Methods","level":2,"text":"Protocol Methods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate","isActive":true},{"type":"text","text":" protocol defines three methods, each returning an"},{"type":"text","text":" "},{"type":"text","text":"optional "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController","isActive":true},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate\/advertViewControllerForBottomBanner(inPublished:edition:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"— bottom banner in "},{"inlineContent":[{"type":"text","text":"feed edition"}],"type":"strong"},{"type":"text","text":" readers."}]}]},{"content":[{"inlineConten