{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"metadata":{"role":"article","title":"Advertisements","modules":[{"name":"PSReaderUI"}],"roleHeading":"Article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"By default the PSReaderUI SDK does not display any advertisements."},{"type":"text","text":" "},{"type":"text","text":"Advertisement support is opt-in through the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate","isActive":true},{"type":"text","text":" protocol."},{"type":"text","text":" "},{"type":"text","text":"Implement this delegate to provide view controllers that the SDK embeds as"},{"type":"text","text":" "},{"type":"text","text":"banner ads within the reader."}],"type":"paragraph"},{"text":"Protocol Methods","level":2,"anchor":"Protocol-Methods","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate","isActive":true,"type":"reference"},{"text":" protocol defines three methods, each returning an","type":"text"},{"text":" ","type":"text"},{"text":"optional ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate\/advertViewControllerForBottomBanner(inPublished:edition:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"— bottom banner in "},{"type":"strong","inlineContent":[{"text":"feed edition","type":"text"}]},{"type":"text","text":" readers."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"