{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"abstract":[{"type":"text","text":"Display custom advertisements within the reader."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK supports two kinds of advertising:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Banner ads"}],"type":"strong"},{"type":"text","text":" — fixed banners above or below the reader content. Banners"},{"type":"text","text":" "},{"type":"text","text":"are opt-in: implement the "},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate","type":"reference","isActive":true},{"type":"text","text":" protocol to provide the banner"},{"type":"text","text":" "},{"type":"text","text":"view controllers, otherwise no banners are displayed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Advert pages","type":"text"}],"type":"strong"},{"type":"text","text":" — dedicated full-page adverts in the page flow of feed"},{"type":"text","text":" "},{"type":"text","text":"editions. These are part of the edition content and render out of the box."},{"type":"text","text":" "},{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements#Full-Page-Advert-Pages"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Banner-Protocol-Methods","text":"Banner Protocol Methods","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\