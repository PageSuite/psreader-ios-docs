{"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The SDK supports two kinds of advertising:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Banner ads"}]},{"type":"text","text":" — fixed banners above or below the reader content. Banners"},{"type":"text","text":" "},{"type":"text","text":"are opt-in: implement the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate"},{"type":"text","text":" protocol to provide the banner"},{"type":"text","text":" "},{"type":"text","text":"view controllers, otherwise no banners are displayed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Advert pages"}],"type":"strong"},{"type":"text","text":" — dedicated full-page adverts in the page flow of feed"},{"type":"text","text":" "},{"type":"text","text":"editions. These are part of the edition content and render out of the box."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements#Full-Page-Advert-Pages"},{"type":"text","text":"."}]}]}]},{"text":"Banner Protocol Methods","anchor":"Banner-Protocol-Methods","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate","isActive":true},{"type":"text","text":" protocol defines three banner methods, each returning an"},{"type":"text","text":" "},{"type":"text","text":"optional "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate\/advertViewControllerForBottomBanner(inPublished:edition:)"},{"type":"text","text":" "},{"type":"text","text":"— bottom banner in "},{"type":"strong","inlineContent":[{"type":"text","text":"feed edition"}]},{"type":"text","text":" readers."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate\/advertViewControllerForBottomBanner(inReplicaEdition:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"— bottom banner in "},{"type":"strong","inlineContent":[{"type":"text","text":"replica edition"}]},{"type":"text","text":" readers."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate\/advertViewControllerForTopBanner(inReplicaEdition:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"— top banner in "},{"type":"strong","inlineContent":[{"type":"text","text":"replica edition"}]},{"type":"text","text":" readers."}]}]}]},{"inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" from any method to omit the ad placement for that context."}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"text":"Feed editions support bottom banners only. Replica editions support","type":"text"},{"text":" ","type":"text"},{"text":"both top and bottom banners.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"},{"text":"Creating an AdvertViewController","anchor":"Creating-an-AdvertViewController","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Your ad view controller must conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController"},{"type":"text","text":". The SDK"},{"type":"text","text":" "},{"type":"text","text":"embeds it as a "},{"type":"strong","inlineContent":[{"type":"text","text":"child view controller"}]},{"type":"text","text":" within the reader interface — it is"},{"type":"text","text":" "},{"type":"text","text":"added via "},{"code":"addChild","type":"codeVoice"},{"type":"text","text":" and its view is placed inside the reader’s view hierarchy."},{"type":"text","text":" "},{"type":"text","text":"This means your ad banner participates in the standard UIKit containment"},{"type":"text","text":" "},{"type":"text","text":"lifecycle ("},{"code":"willMove(toParent:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"didMove(toParent:)","type":"codeVoice"},{"type":"text","text":", etc.)."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import PSReaderUI","import PSReader","","class MyAdBanner: UIViewController, PSReaderUI.AdvertViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        \/\/ Load and display your ad content","    }","","    func didChangeTo(spread: PSEPageSpread?,","                     inEdition edition: PSEEdition,","                     inPublished published: PSEPublished) {","        refreshAd()","    }","","    func didChangeTo(spread: PSReplicaPageSpread?,","                     inReplicaEdition replicaEdition: PSReplicaEdition) {","        refreshAd()","    }","","    private func refreshAd(forPage pageNumber: Int) {","        \/\/ Refresh your ad or update section targeting","    }","}"]},{"inlineContent":[{"text":"The banner’s height is determined by your view’s Auto Layout constraints. Set","type":"text"},{"text":" ","type":"text"},{"text":"an intrinsic content size or explicit height constraint on your ad view to","type":"text"},{"text":" ","type":"text"},{"text":"control how tall the banner appears in the reader.","type":"text"}],"type":"paragraph"},{"text":"Assigning the Delegate","anchor":"Assigning-the-Delegate","type":"heading","level":2},{"inlineContent":[{"text":"Set the delegate on your ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyAdvertDelegate: PSReaderUI.AdvertDelegate {","    func advertViewControllerForBottomBanner(","        inPublished published: PSEPublished,","        edition: PSEEdition","    ) -> AdvertViewController? {","        return MyAdBanner()","    }","","    func advertViewControllerForBottomBanner(","        inReplicaEdition edition: PSEdition","    ) -> AdvertViewController? {","        return MyAdBanner()","    }","","    func advertViewControllerForTopBanner(","        inReplicaEdition edition: PSEdition","    ) -> AdvertViewController? {","        return nil \/\/ No top banner","    }","}","","globalConfig.advertDelegate = MyAdvertDelegate()"]},{"inlineContent":[{"text":"The delegate is inherited by all reader configurations created from the","type":"text"},{"text":" ","type":"text"},{"text":"global configuration.","type":"text"}],"type":"paragraph"},{"text":"Responding to Page Changes","anchor":"Responding-to-Page-Changes","type":"heading","level":2},{"inlineContent":[{"text":"The SDK notifies your ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController","type":"reference","isActive":true},{"text":" when the reader’s visible page","type":"text"},{"text":" ","type":"text"},{"text":"changes. This is useful for refreshing ad content or updating section-level","type":"text"},{"text":" ","type":"text"},{"text":"ad targeting as the user navigates through an edition.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController"},{"type":"text","text":" defines two page change callbacks — one for each"},{"type":"text","text":" "},{"type":"text","text":"edition type:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController\/didChangeTo(spread:inEdition:inPublished:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"— called in "},{"type":"strong","inlineContent":[{"type":"text","text":"feed edition"}]},{"type":"text","text":" readers."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController\/didChangeTo(spread:inReplicaEdition:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"— called in ","type":"text"},{"inlineContent":[{"text":"replica edition","type":"text"}],"type":"strong"},{"text":" readers.","type":"text"}]}]}]},{"inlineContent":[{"text":"Both methods receive the current page spread and edition context. The ","type":"text"},{"type":"codeVoice","code":"spread"},{"text":" ","type":"text"},{"text":"parameter is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when there is no active page (for example, during a","type":"text"},{"text":" ","type":"text"},{"text":"transition). Use ","type":"text"},{"type":"codeVoice","code":"referencePage()"},{"text":" on the spread to get the primary page:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func didChangeTo(spread: PSEPageSpread?,","                 inEdition edition: PSEEdition,","                 inPublished published: PSEPublished) {","    guard let page = spread?.referencePage() else { return }","    \/\/ Use page.pageNumber for ad targeting or to trigger an ad refresh","    adView.setTargeting(page: page.pageNumber)","    adView.loadNewAd()","}","","func didChangeTo(spread: PSReplicaPageSpread?,","                 inReplicaEdition replicaEdition: PSReplicaEdition) {","    guard let page = spread?.referencePage() else { return }","    \/\/ Use page.num for the page number in replica editions","    adView.setTargeting(page: page.num)","    adView.loadNewAd()","}"]},{"inlineContent":[{"text":"Both methods have default implementations that do nothing, so you only need to","type":"text"},{"text":" ","type":"text"},{"text":"implement the ones relevant to your ad setup. If you only serve ads in feed","type":"text"},{"text":" ","type":"text"},{"text":"editions, you can omit the replica variant and vice versa.","type":"text"}],"type":"paragraph"},{"text":"Full Page Advert Pages","anchor":"Full-Page-Advert-Pages","type":"heading","level":2},{"inlineContent":[{"text":"Feed editions can contain dedicated advert pages, including one at the","type":"text"},{"text":" ","type":"text"},{"text":"page-zero position — displayed beside the cover in double-page mode. Advert","type":"text"},{"text":" ","type":"text"},{"text":"pages render out of the box; no setup is required.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For third-party adverts the built-in rendering shows an “Advertisement” label","type":"text"},{"text":" ","type":"text"},{"text":"above the ad. The label text is localizable through","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LocalizedStringKey\/advertisementLabel","type":"reference","isActive":true},{"text":". Other advert flows — HTML","type":"text"},{"text":" ","type":"text"},{"text":"templates, external URLs, and images — display full bleed without a label.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"text":"Google Ad Manager advert pages have no built-in rendering — they","type":"text"},{"text":" ","type":"text"},{"text":"are left blank unless your ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate","type":"reference"},{"text":" supplies a view controller.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important"},{"text":"Custom Advert Page Rendering","anchor":"Custom-Advert-Page-Rendering","type":"heading","level":3},{"inlineContent":[{"text":"Implement","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertDelegate\/advertViewController(forAdvertPage:inPublished:edition:)"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"replace the built-in rendering with your own view controller, or return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ","type":"text"},{"text":"to keep the default. The returned view controller must conform to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PSEAdvertContentViewController"},{"text":" from the core PSReader SDK:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func advertViewController(","    forAdvertPage page: PSEPage,","    inPublished published: PSEPublished,","    edition: PSEEdition",") -> PSEAdvertContentViewController? {","    switch page.advertProvider {","    case .googleAdManager:","        return MyGAMPageAdViewController(config: page.advertConfig)","    default:","        return nil \/\/ built-in rendering","    }","}"]},{"inlineContent":[{"type":"text","text":"The reader preloads pages while they are still off screen, so UIKit appearance"},{"type":"text","text":" "},{"type":"text","text":"callbacks like "},{"type":"codeVoice","code":"viewDidAppear"},{"type":"text","text":" fire before the advert is actually visible."},{"type":"text","text":" "},{"type":"text","text":"Gate ad requests and impression tracking on the "},{"type":"codeVoice","code":"PSEAdvertContentViewController"},{"type":"text","text":" "},{"type":"text","text":"lifecycle hooks — "},{"type":"codeVoice","code":"advertPageInView()"},{"type":"text","text":", "},{"type":"codeVoice","code":"advertPageOutOfView()"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"advertPrepareForReuse()"},{"type":"text","text":" — instead."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Advertisements","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Display custom advertisements within the reader."}],"metadata":{"title":"Advertisements","modules":[{"name":"PSReaderUI"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI"]]},"seeAlsoSections":[{"generated":true,"anchor":"Features","title":"Features","identifiers":["doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Deep-Linking","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Paywall-Integration","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Sharing","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Commenting","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Text-to-Speech","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Media-Playback","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Analytics","doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/Search"]}],"variants":[{"paths":["\/documentation\/psreaderui\/advertisements"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreaderui\/advertisements"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"references":{"doc://com.pagesuite.PSReaderUI/documentation/PSReaderUI/Paywall-Integration":{"abstract":[{"text":"Restrict access to premium content with custom paywall screens.","type":"text"}],"identifier":"doc:\/\/com.pages