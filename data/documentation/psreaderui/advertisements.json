bottom banners only. Replica editions support"},{"type":"text","text":" "},{"type":"text","text":"both top and bottom banners."}]}]},{"type":"heading","anchor":"Creating-an-AdvertViewController","text":"Creating an AdvertViewController","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your ad view controller must conform to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController"},{"type":"text","text":". The SDK"},{"type":"text","text":" "},{"type":"text","text":"embeds it as a "},{"type":"strong","inlineContent":[{"text":"child view controller","type":"text"}]},{"type":"text","text":" within the reader interface — it is"},{"type":"text","text":" "},{"type":"text","text":"added via "},{"type":"codeVoice","code":"addChild"},{"type":"text","text":" and its view is placed inside the reader’s view hierarchy."},{"type":"text","text":" "},{"type":"text","text":"This means your ad banner participates in the standard UIKit containment"},{"type":"text","text":" "},{"type":"text","text":"lifecycle ("},{"type":"codeVoice","code":"willMove(toParent:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"didMove(toParent:)"},{"type":"text","text":", etc.)."}]},{"type":"codeListing","syntax":"swift","code":["import PSReaderUI","import PSReader","","class MyAdBanner: UIViewController, PSReaderUI.AdvertViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        \/\/ Load and display your ad content","    }","","    func didChangeTo(spread: PSEPageSpread?,","                     inEdition edition: PSEEdition,","                     inPublished published: PSEPublished) {","        refreshAd()","    }","","    func didChangeTo(spread: PSReplicaPageSpread?,","                     inReplicaEdition replicaEdition: PSReplicaEdition) {","        refreshAd()","    }","","    private func refreshAd(forPage pageNumber: Int) {","        \/\/ Refresh your ad or update section targeting","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The banner’s height is determined by your view’s Auto Layout constraints. Set"},{"type":"text","text":" "},{"type":"text","text":"an intrinsic content size or explicit height constraint on your ad view to"},{"type":"text","text":" "},{"type":"text","text":"control how tall the banner appears in the reader."}]},{"type":"heading","anchor":"Assigning-the-Delegate","text":"Assigning the Delegate","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the delegate on your "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct MyAdvertDelegate: PSReaderUI.AdvertDelegate {","    func advertViewControllerForBottomBanner(","        inPublished published: PSEPublished,","        edition: PSEEdition","    ) -> AdvertViewController? {","        return MyAdBanner()","    }","","    func advertViewControllerForBottomBanner(","        inReplicaEdition edition: PSEdition","    ) -> AdvertViewController? {","        return MyAdBanner()","    }","","    func advertViewControllerForTopBanner(","        inReplicaEdition edition: PSEdition","    ) -> AdvertViewController? {","        return nil \/\/ No top banner","    }","}","","globalConfig.advertDelegate = MyAdvertDelegate()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delegate is inherited by all reader configurations created from the"},{"type":"text","text":" "},{"type":"text","text":"global configuration."}]},{"type":"heading","anchor":"Responding-to-Page-Changes","text":"Responding to Page Changes","level":2},{"type":"paragraph","inlineContent":[{"text":"The SDK notifies your ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController"},{"text":" when the reader’s visible page","type":"text"},{"text":" ","type":"text"},{"text":"changes. This is useful for refreshing ad content or updating section-level","type":"text"},{"text":" ","type":"text"},{"text":"ad targeting as the user navigates through an edition.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController","type":"reference","isActive":true},{"type":"text","text":" defines two page change callbacks — one for each"},{"type":"text","text":" "},{"type":"text","text":"edition type:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController\/didChangeTo(spread:inEdition:inPublished:)","isActive":true},{"text":" ","type":"text"},{"text":"— called in ","type":"text"},{"type":"strong","inlineContent":[{"text":"feed edition","type":"text"}]},{"text":" readers.","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/AdvertViewController\/didChangeTo(spread:inReplicaEdition:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"— called in ","type":"text"},{"inlineContent":[{"type":"text","text":"replica edition"}],"type":"strong"},{"text":" readers.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Both methods receive the current page spread and edition context. The ","type":"text"},{"code":"spread","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when there is no active page (for example, during a","type":"text"},{"text":" ","type":"text"},{"text":"transition). Use ","type":"text"},{"code":"referencePage()","type":"codeVoice"},{"text":" on the spread to get the primary page:","type":"text"}]},{"type":"codeListi