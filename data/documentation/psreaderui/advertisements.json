"text":" and its view is placed inside the reader’s view hierarchy.","type":"text"},{"text":" ","type":"text"},{"text":"This means your ad banner participates in the standard UIKit containment","type":"text"},{"text":" ","type":"text"},{"text":"lifecycle (","type":"text"},{"code":"willMove(toParent:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"didMove(toParent:)","type":"codeVoice"},{"text":", etc.).","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import PSReaderUI","import PSReader","","class MyAdBanner: UIViewController, PSReaderUI.AdvertViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","        \/\/ Load and display your ad content","    }","","    func didChangeTo(spread: PSEPageSpread?,","                     inEdition edition: PSEEdition,","                     inPublished published: PSEPublished) {","        refreshAd()","    }","","    func didChangeTo(spread: PSReplicaPageSpread?,","                     inReplicaEdition replicaEdition: PSReplicaEdition) {","        refreshAd()","    }","","    private func refreshAd(forPage pageNumber: Int) {","        \/\/ Refresh your ad or update section targeting","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The banner’s height is determined by your view’s Auto Layout constraints. Set"},{"type":"text","text":" "},{"type":"text","text":"an intrinsic content size or explicit height constraint on your ad view to"},{"type":"text","text":" "},{"type":"text","text":"control how tall the banner appears in the reader."}]},{"type":"heading","anchor":"Assigning-the-Delegate","level":2,"text":"Assigning the Delegate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the delegate on your "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/GlobalConfiguration","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct MyAdvertDelegate: PS