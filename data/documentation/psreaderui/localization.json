esuite.PSReaderUI\/documentation\/PSReaderUI\/LocalizedStringKey","isActive":true,"type":"reference"},{"type":"text","text":" raw values. The SDK will pick them up"},{"type":"text","text":" "},{"type":"text","text":"at runtime."}]},{"type":"heading","anchor":"Subclassing-LocalizationManager","level":2,"text":"Subclassing LocalizationManager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more control, subclass "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LocalizationManager","isActive":true},{"type":"text","text":" and replace the shared"},{"type":"text","text":" "},{"type":"text","text":"singleton. This lets you load strings from a remote server, apply A\/B test"},{"type":"text","text":" "},{"type":"text","text":"variants, or fall through to the default behavior selectively:"}]},{"type":"codeListing","code":["import PSReaderUI","","class CustomLocalizationManager: PSReaderUI.LocalizationManager {","    override func localizedString(for key: LocalizedStringKey) -> String {","        switch key {","        case .bookmarksTitle:","            return \"Saved\"","        case .downloadsTitle:","            return \"Offline\"","        default:","            return super.localizedString(for: key)","        }","    }","}","","PSReaderUI.LocalizationManager.shared = CustomLocalizationManager()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Set the custom manager before creating any SDK view controllers so that the","type":"text"},{"text":" ","type":"text"},{"text":"overridden strings are used from the start.","type":"text"}]},{"type":"heading","anchor":"Reference","level":2,"text":"Reference"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReaderUI\/documentation\/PSReaderUI\/LocalizedStringKey","isActive":true},{"type":"text","text":" for the complete list of keys and their default"},{"type":"text","text":"