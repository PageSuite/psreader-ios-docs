{"variants":[{"paths":["\/documentation\/psreader\/adding-a-share-button"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreader\/adding-a-share-button"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt reader has a share button that offers a link to the page in"},{"type":"text","text":" "},{"type":"text","text":"view. Its share logic works on core models, so your reader screen can"},{"type":"text","text":" "},{"type":"text","text":"use it unchanged: a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareProvider","isActive":true},{"type":"text","text":" decides whether a page can be"},{"type":"text","text":" "},{"type":"text","text":"shared and builds what to share, and you add the button and present the"},{"type":"text","text":" "},{"type":"text","text":"share sheet."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the prebuilt UI? See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Sharing"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a provider and the button to "},{"type":"codeVoice","code":"ReaderScreenViewController"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"reader screen from "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","code":["private let sharing = ShareProvider(sharePolicy: .preferArticleLink(","    webProvider: WebReaderShareProvider(urlMask: nil, shortCode: \"SHORTCODE\")","))","","private lazy var shareButton = UIBarButtonItem(","    image: UIImage(systemName: \"square.and.arrow.up\"),","    style: .plain,","    target: self,","    action: #selector(shareTapped)",")"],"wrap":0,"copyToClipboard":true,"type":"codeListing","showLineNumbers":false,"lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The policy picks between web reader links, which open the page in"},{"type":"text","text":" "},{"type":"text","text":"PageSuite’s web reader, and article links, which open the story on the"},{"type":"text","text":" "},{"type":"text","text":"publisher’s website. "},{"type":"codeVoice","code":".onlyWebReader(webProvider:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":".onlyArticleLink()"},{"type":"text","text":" share one kind of link,"},{"type":"text","text":" "},{"type":"codeVoice","code":".preferWebReader(webProvider:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":".preferArticleLink(webProvider:)"},{"type":"text","text":" "},{"type":"text","text":"fall back to the other kind, and "},{"type":"codeVoice","code":".disabled"},{"type":"text","text":" shares nothing."},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Sharing#Choosing-a-Share-Policy","type":"reference","isActive":true},{"type":"text","text":" compares them, including the pages"},{"type":"text","text":" "},{"type":"text","text":"each one can share. To share web reader links from every page, create the"},{"type":"text","text":" "},{"type":"text","text":"provider with "},{"type":"codeVoice","code":".onlyWebReader(webProvider:)"},{"type":"text","text":" instead:"}]},{"syntax":"swift","code":["private let sharing = ShareProvider(sharePolicy: .onlyWebReader(","    webProvider: WebReaderShareProvider(urlMask: nil, shortCode: \"SHORTCODE\")","))"],"wrap":0,"copyToClipboard":true,"type":"codeListing","showLineNumbers":false,"lineAnnotations":[]},{"type":"heading","text":"Showing the Button on Shareable Pages","anchor":"Showing-the-Button-on-Shareable-Pages","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"addChrome()"},{"type":"text","text":", put the button in the navigation bar, disabled until"},{"type":"text","text":" "},{"type":"text","text":"the first page settles:"}]},{"code":["shareButton.isEnabled = false","navigationItem.rightBarButtonItems = (navigationItem.rightBarButtonItems ?? []) + [shareButton]"],"wrap":0,"showLineNumbers":false,"copyToClipboard":true,"type":"codeListing","syntax":"swift","lineAnnotations":[]},{"inlineContent":[{"type":"text","text":"Whether a page can be shared depends on the policy. With"},{"type":"text","text":" "},{"type":"codeVoice","code":".onlyArticleLink()"},{"type":"text","text":", for example, only article pages with a share link"},{"text":" ","type":"text"},{"text":"can. In ","type":"text"},{"code":"updateChrome()","type":"codeVoice"},{"text":", ask the provider about each page the reader","type":"text"},{"text":" ","type":"text"},{"text":"settles on:","type":"text"}],"type":"paragraph"},{"code":["if let source {","    shareButton.isEnabled = sharing.isShareable(","        page: page,","        inEdition: source.edition,","        inPublished: source.published","    )","}"],"wrap":0,"showLineNumbers":false,"copyToClipboard":true,"type":"codeListing","syntax":"swift","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like the bookmark button in "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","isActive":true},{"type":"text","text":", the button"},{"type":"text","text":" "},{"type":"text","text":"disables rather than disappearing, so the bar keeps its layout."}]},{"level":2,"type":"heading","text":"Presenting the Share Sheet","anchor":"Presenting-the-Share-Sheet"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the action in an extension, in the same file as the class. On a tap,"},{"type":"text","text":" "},{"type":"text","text":"ask the provider for the page’s "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareContext","isActive":true},{"type":"text","text":", and present the share"},{"type":"text","text":" "},{"type":"text","text":"sheet with its items, activities, and subject:"}]},{"wrap":0,"syntax":"swift","code":["extension ReaderScreenViewController {","","    @objc private func shareTapped() {","        guard let source,","              let page = reader.currentPage(),","              let context = sharing.shareContext(","                  forPage: page,","                  inEdition: source.edition,","                  inPublished: source.published","              ) else {","            return","        }","","        let sheet = UIActivityViewController(","            activityItems: context.activityItems.map { SharedItem($0, subject: context.subject) },","            applicationActivities: context.applicationActivities","        )","        sheet.popoverPresentationController?.barButtonItem = shareButton   \/\/ iPad","        present(sheet, animated: true)","    }","}"],"copyToClipboard":true,"showLineNumbers":false,"lineAnnotations":[],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The share sheet takes a subject, which mail uses, only from an item"},{"type":"text","text":" "},{"type":"text","text":"source. "},{"code":"SharedItem","type":"codeVoice"},{"type":"text","text":" wraps each item to supply one:"}]},{"wrap":0,"syntax":"swift","code":["final class SharedItem: NSObject, UIActivityItemSource {","    let item: Any","    let subject: String?","","    init(_ item: Any, subject: String?) {","        self.item = item","        self.subject = subject","    }","","    func activityViewControllerPlaceholderItem(_ controller: UIActivityViewController) -> Any {","        item","    }","","    func activityViewController(_ controller: UIActivityViewController,","                                itemForActivityType type: UIActivity.ActivityType?) -> Any? {","        item","    }","","    func activityViewController(_ controller: UIActivityViewController,","                                subjectForActivityType type: UIActivity.ActivityType?) -> String {","        subject ?? \"\"","    }","}"],"copyToClipboard":true,"showLineNumbers":false,"lineAnnotations":[],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The prebuilt UI’s share events don’t fire from your button, so report"},{"type":"text","text":" "},{"type":"text","text":"the share yourself; "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics#Reporting-Shares-Searches-and-Links","isActive":true},{"type":"text","text":" "},{"text":"shows where.","type":"text"}],"type":"paragraph"},{"anchor":"Using-Your-Own-Share-Logic","type":"heading","level":2,"text":"Using Your Own Share Logic"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate","isActive":true},{"type":"text","text":" works behind your button, not only"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareProvider","isActive":true},{"type":"text","text":": call its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate\/isShareable(page:inEdition:inPublished:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate\/shareContext(forPage:inEdition:inPublished:)"},{"text":" the same","type":"text"},{"text":" ","type":"text"},{"text":"way. ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Sharing#Writing-a-Custom-Share-Delegate"},{"text":" shows one that tags","type":"text"},{"text":" ","type":"text"},{"text":"each link for the publisher’s web analytics.","type":"text"}]},{"anchor":"Printing","level":2,"text":"Printing","type":"heading"},{"inlineContent":[{"type":"text","text":"The prebuilt reader adds a Print action to its share sheet. That action"},{"type":"text","text":" "},{"type":"text","text":"isn’t part of the share context, and the SDK has no print helper for a"},{"type":"text","text":" "},{"type":"text","text":"custom UI yet, so build printing from public pieces. PDF pages print"},{"type":"text","text":" "},{"type":"text","text":"from the files the reader is showing: each page’s"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/contenturl"},{"type":"text","text":" names its PDF, and the source’s"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEditionSource\/resourceManager"},{"type":"text","text":" returns the file’s data. This works"},{"type":"text","text":" "},{"type":"text","text":"for streamed and downloaded editions alike, since a page on screen has"},{"type":"text","text":" "},{"type":"text","text":"already been fetched."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add a print button the same way as the share button, with the action"},{"type":"text","text":" "},{"type":"codeVoice","code":"printPages"},{"type":"text","text":", and enable it in "},{"type":"codeVoice","code":"updateChrome()"},{"type":"text","text":" when "},{"type":"codeVoice","code":"page.isPDF"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":". Then add the action to the extension:"}],"type":"paragraph"},{"code":["@objc private func printPages() {","    guard let source, let (spread, _) = reader.currentPageSpread() else {","        return","    }","","    \/\/ The PDF of each page on screen, from the edition's storage.","    let pdfs = spread.nonAdvertPages().filter(\\.isPDF).compactMap { page in","        page.contenturl.flatMap { source.resourceManager.cachedData(for: $0) }","    }","    guard !pdfs.isEmpty, UIPrintInteractionController.isPrintingAvailable else {","        return","    }","","    let printInfo = UIPrintInfo.printInfo()","    printInfo.jobName = source.published.name","","    let printer = UIPrintInteractionController.shared","    printer.printInfo = printInfo","    printer.printingItems = pdfs","    printer.present(animated: true)","}"],"syntax":"swift","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"inlineContent":[{"type":"text","text":"To offer printing in the share sheet instead, wrap the same code in a"},{"type":"text","text":" "},{"type":"codeVoice","code":"UIActivity"},{"type":"text","text":" subclass and pass it with the context’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationActivities"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Templated pages, such as articles, have no PDF. The prebuilt reader"},{"type":"text","text":" "},{"type":"text","text":"prints them from the page’s "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/highRes","isActive":true,"type":"reference"},{"type":"text","text":" image, and from the"},{"type":"text","text":" "},{"type":"text","text":"extra images "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/pagesInImage","isActive":true,"type":"reference"},{"type":"text","text":" describes when there are several."},{"type":"text","text":" "},{"type":"text","text":"Those are web addresses, so printing a templated page this way needs a"},{"type":"text","text":" "},{"type":"text","text":"connection, even in a downloaded edition."}],"type":"paragraph"}]}],"kind":"arti