{"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt reader has a share button that offers a link to the page in"},{"text":" ","type":"text"},{"text":"view. Its share logic works on core models, so your reader screen can","type":"text"},{"text":" ","type":"text"},{"text":"use it unchanged: a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareProvider","isActive":true},{"type":"text","text":" decides whether a page can be"},{"type":"text","text":" "},{"type":"text","text":"shared and builds what to share, and you add the button and present the"},{"text":" ","type":"text"},{"text":"share sheet.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the prebuilt UI? See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Sharing","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a provider and the button to "},{"type":"codeVoice","code":"ReaderScreenViewController"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"reader screen from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","copyToClipboard":true,"wrap":0,"showLineNumbers":false,"code":["private let sharing = ShareProvider(sharePolicy: .preferArticleLink(","    webProvider: WebReaderShareProvider(urlMask: nil, shortCode: \"SHORTCODE\")","))","","private lazy var shareButton = UIBarButtonItem(","    image: UIImage(systemName: \"square.and.arrow.up\"),","    style: .plain,","    target: self,","    action: #selector(shareTapped)",")"],"lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"text":"The policy picks between web reader links, which open the page in","type":"text"},{"text":" ","type":"text"},{"text":"PageSuite’s web reader, and article links, which open the story on the","type":"text"},{"text":" ","type":"text"},{"text":"publisher’s website. ","type":"text"},{"code":".onlyWebReader(webProvider:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":".onlyArticleLink()","type":"codeVoice"},{"text":" share one kind of link,","type":"text"},{"text":" ","type":"text"},{"code":".preferWebReader(webProvider:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":".preferArticleLink(webProvider:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"fall back to the other kind, and "},{"code":".disabled","type":"codeVoice"},{"type":"text","text":" shares nothing."},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Sharing#Choosing-a-Share-Policy","isActive":true,"type":"reference"},{"type":"text","text":" compares them, including the pages"},{"type":"text","text":" "},{"type":"text","text":"each one can share. To share web reader links from every page, create the"},{"type":"text","text":" "},{"type":"text","text":"provider with "},{"code":".onlyWebReader(webProvider:)","type":"codeVoice"},{"type":"text","text":" instead:"}]},{"type":"codeListing","syntax":"swift","copyToClipboard":true,"wrap":0,"showLineNumbers":false,"code":["private let sharing = ShareProvider(sharePolicy: .onlyWebReader(","    webProvider: WebReaderShareProvider(urlMask: nil, shortCode: \"SHORTCODE\")","))"],"lineAnnotations":[]},{"anchor":"Showing-the-Button-on-Shareable-Pages","level":2,"text":"Showing the Button on Shareable Pages","type":"heading"},{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"addChrome()"},{"type":"text","text":", put the button in the navigation bar, disabled until"},{"type":"text","text":" "},{"type":"text","text":"the first page settles:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","copyToClipboard":true,"wrap":0,"showLineNumbers":false,"code":["shareButton.isEnabled = false","navigationItem.rightBarButtonItems = (navigationItem.rightBarButtonItems ?? []) + [shareButton]"],"lineAnnotations":[]},{"inlineContent":[{"type":"text","text":"Whether a page can be shared depends on the policy. With"},{"type":"text","text":" "},{"code":".onlyArticleLink()","type":"codeVoice"},{"type":"text","text":", for example, only article pages with a share link"},{"type":"text","text":" "},{"type":"text","text":"can. In "},{"code":"updateChrome()","type":"codeVoice"},{"type":"text","text":", ask the provider about each page the reader"},{"type":"text","text":" "},{"type":"text","text":"settles on:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","copyToClipboard":true,"wrap":0,"showLineNumbers":false,"code":["if let source {","    shareButton.isEnabled = sharing.isShareable(","        page: page,","        inEdition: source.edition,","        inPublished: source.published","    )","}"],"lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"text":"Like the bookmark button in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","type":"reference"},{"type":"text","text":", the button"},{"type":"text","text":" "},{"type":"text","text":"disables rather than disappearing, so the bar keeps its layout."}]},{"type":"heading","anchor":"Presenting-the-Share-Sheet","text":"Presenting the Share Sheet","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the action in an extension, in the same file as the class. On a tap,"},{"type":"text","text":" "},{"type":"text","text":"ask the provider for the page’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareContext"},{"type":"text","text":", and present the share"},{"type":"text","text":" "},{"type":"text","text":"sheet with its items, activities, and subject:"}]},{"type":"codeListing","syntax":"swift","copyToClipboard":true,"wrap":0,"showLineNumbers":false,"code":["extension ReaderScreenViewController {","","    @objc private func shareTapped() {","        guard let source,","              let page = reader.currentPage(),","              let context = sharing.shareContext(","                  forPage: page,","                  inEdition: source.edition,","                  inPublished: source.published","              ) else {","            return","        }","","        let sheet = UIActivityViewController(","            activityItems: context.activityItems.map { SharedItem($0, subject: context.subject) },","            applicationActivities: context.applicationActivities","        )","        sheet.popoverPresentationController?.barButtonItem = shareButton   \/\/ iPad","        present(sheet, animated: true)","    }","}"],"lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"text":"The share sheet takes a subject, which mail uses, only from an item","type":"text"},{"text":" ","type":"text"},{"text":"source. ","type":"text"},{"code":"SharedItem","type":"codeVoice"},{"text":" wraps each item to supply one:","type":"text"}]},{"type":"codeListing","syntax":"swift","copyToClipboard":true,"wrap":0,"showLineNumbers":false,"code":["final class SharedItem: NSObject, UIActivityItemSource {","    let item: Any","    let subject: String?","","    init(_ item: Any, subject: String?) {","        self.item = item","        self.subject = subject","    }","","    func activityViewControllerPlaceholderItem(_ controller: UIActivityViewController) -> Any {","        item","    }","","    func activityViewController(_ controller: UIActivityViewController,","                                itemForActivityType type: UIActivity.ActivityType?) -> Any? {","        item","    }","","    func activityViewController(_ controller: UIActivityViewController,","                                subjectForActivityType type: UIActivity.ActivityType?) -> String {","        subject ?? \"\"","    }","}"],"lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt UI’s share events don’t fire from your button, so report"},{"type":"text","text":" "},{"type":"text","text":"the share yourself; "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics#Reporting-Shares-Searches-and-Links","isActive":true},{"type":"text","text":" "},{"type":"text","text":"shows where."}]},{"type":"heading","anchor":"Using-Your-Own-Share-Logic","text":"Using Your Own Share Logic","level":2},{"type":"paragraph","inlineContent":[{"text":"Any ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate","type":"reference"},{"text":" works behind your button, not only","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareProvider","type":"reference"},{"text":": call its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate\/isShareable(page:inEdition:inPublished:)","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ShareDelegate\/shareContext(forPage:inEdition:inPublished:)","type":"reference"},{"text":" the same","type":"text"},{"text":" ","type":"text"},{"text":"way. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Sharing#Writing-a-Custom-Share-Delegate","type":"reference"},{"text":" shows one that tags","type":"text"},{"text":" ","type":"text"},{"text":"each link for the publisher’s web analytics.","type":"text"}]},{"level":2,"type":"heading","anchor":"Printing","text":"Printing"},{"type":"paragraph","inlineContent":[{"text":"The prebuilt reader adds a Print action to its share sheet. That action","type":"text"},{"text":" ","type":"text"},{"text":"isn’t part of the share context, and the SDK has no print helper for a","type":"text"},{"text":" ","type":"text"},{"text":"custom UI yet, so build printing from public pieces. PDF pages print","type":"text"},{"text":" ","type":"text"},{"text":"from the files the reader is showing: each page’s","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/contenturl","isActive":true},{"text":" names its PDF, and the source’s","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEditionSource\/resourceManager","isActive":true},{"text":" returns the file’s data. This works","type":"text"},{"text":" ","type":"text"},{"text":"for streamed and downloaded editions alike, since a page on screen has","type":"text"},{"text":" ","type":"text"},{"text":"already been fetched.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a print button the same way as the share button, with the action"},{"type":"text","text":" "},{"type":"codeVoice","code":"printPages"},{"type":"text","text":", and enable it in "},{"code":"updateChrome()","type":"codeVoice"},{"text":" when ","type":"text"},{"code":"page.isPDF","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":". Then add the action to the extension:"}]},{"code":["@objc private func printPages() {","    guard let source, let (spread, _) = reader.currentPageSpread() else {","        return","    }","","    \/\/ The PDF of each page on screen, from the edition's storage.","    let pdfs = spread.nonAdvertPages().filter(\\.isPDF).compactMap { page in","        page.contenturl.flatMap { source.resourceManager.cachedData(for: $0) }","    }","    guard !pdfs.isEmpty, UIPrintInteractionController.isPrintingAvailable else {","        return","    }","","    let printInfo = UIPrintInfo.printInfo()","    printInfo.jobName = source.published.name","","    let printer = UIPrintInteractionController.shared","    printer.printInfo = printInfo","    printer.printingItems = pdfs","    printer.present(animated: true)","}"],"type":"codeListing","lineAnnotations":[],"copyToClipboard":true,"syntax":"swift","wrap":0,"showLineNumbers":false},{"type":"paragraph","inlineContent":[{"type":"text","text":"To offer printing in the share sheet instead, wrap the same code in a"},{"type":"text","text":" "},{"type":"codeVoice","code":"UIActivity"},{"type":"text","text":" subclass and pass it with the context’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationActivities"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Templated pages, such as articles, have no PDF. The prebuilt reader"},{"type":"text","text":" "},{"type":"text","text":"prints them from the page’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/highRes"},{"type":"text","text":" image, and from the"},{"type":"text","text":" "},{"type":"text","text":"extra images "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/pagesInImage"},{"type":"text","text":" describes when there are several."},{"type":"text","text":" "},{"type":"text","text":"Those are web addresses, so printing a templated page this way needs a"},{"type":"text","text":" "},{"type":"text","text":"connection, even in a downloaded edition."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Add a share button to your own reader screen that shares the page in view, using the share providers the prebuilt reader uses."}],"variants":[{"paths":["\/documentation\/psreader\/adding-a-share-button"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/psreader\/adding-a-share-button"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"role":"article","title":"Adding a Share Button","modules":[{"name":"PSReader"}],"roleHeading":"Guide"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Adding Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Advert-Pages","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics"],"anchor":"Adding-Features"}],"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/ShareDelegate/isShareable(page:inEdition:inPublished:)":{"kind":"symbol","type":"topic","url":"\/documentation\/psreader\/sharedelegate\/isshareable(page:inedition:inpublished:)","role":"symbol","required":true,"title":"isShareable(page:inEdition:inPublished:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isShareable","kind":"identifier"},{"text":"(","kind":"text"},{"text":"page","kind":"externalPa