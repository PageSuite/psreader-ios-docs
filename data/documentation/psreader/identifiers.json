ocumentation\/PSReader\/FeedEditionService","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"showLineNumbers":false,"copyToClipboard":true,"type":"codeListing","wrap":0,"code":["let service = FeedEditionService(accountGUID: \"ACCOUNT_GUID\")"],"lineAnnotations":[],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"If you have a shortcode, its configuration names the account; see the"},{"type":"text","text":" "},{"type":"text","text":"next section."}],"type":"paragraph"},{"anchor":"Shortcode","level":2,"text":"Shortcode","type":"heading"},{"inlineContent":[{"type":"text","text":"A short code that names an app configuration in PageSuite: the"},{"type":"text","text":" "},{"type":"text","text":"publications your app shows, their archive settings, and the reader"},{"type":"text","text":" "},{"type":"text","text":"features they turn on. Give it to a dynamic archive and the carousel loads"},{"type":"text","text":" "},{"type":"text","text":"everything else itself:"}],"type":"paragraph"},{"showLineNumbers":false,"copyToClipboard":true,"type":"codeListing","wrap":0,"code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [.dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")]",")"],"lineAnnotations":[],"syntax":"swift"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedReaderViewController","isActive":true},{"type":"text","text":" also accepts a shortcode with an edition"},{"type":"text","text":" "},{"type":"text","text":"GUID, and "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ApplicationSearchDelegate","isActive":true},{"type":"text","text":" searches a shortcode’s"},{"type":"text","text":" "},{"type":"text","text":"publications. A shortcode is the simplest way to start, because you don’t"},{"type":"text","text":" "},{"type":"text","text":"handle publication GUIDs at all."}],"typ