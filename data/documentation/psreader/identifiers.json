guration in PageSuite: the"},{"type":"text","text":" "},{"type":"text","text":"publications your app shows, their archive settings, and the reader"},{"type":"text","text":" "},{"type":"text","text":"features they turn on. Give it to a dynamic archive and the carousel loads"},{"type":"text","text":" "},{"type":"text","text":"everything else itself:"}],"type":"paragraph"},{"syntax":"swift","showLineNumbers":false,"copyToClipboard":true,"code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [.dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")]",")"],"type":"codeListing","lineAnnotations":[],"wrap":0},{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedReaderViewController","isActive":true,"type":"reference"},{"type":"text","text":" also accepts a shortcode with an edition"},{"type":"text","text":" "},{"type":"text","text":"GUID, and "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ApplicationSearchDelegate","isActive":true,"type":"reference"},{"type":"text","text":" searches a shortcode’s"},{"type":"text","text":" "},{"type":"text","text":"publications. A shortcode is the simplest way to start, because you don’t"},{"type":"text","text":" "},{"type":"text","text":"handle publication GUIDs at all."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A custom UI can load the same configuration with "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AppConfigService","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It tells you the account the shortcode belongs to, and the reader takes the"},{"type":"text","text":" "},{"type":"text","text":"configuration for its advertising and templating settings:"}],"type":"paragraph"},{"syntax":"swift","showLineNumbers":false,"copyToClipboard":true,"code":["let config = try await AppConfigService().configuration(forShortcode: 