{"metadata":{"modules":[{"name":"PSReader"}],"roleHeading":"Guide","title":"Localization","role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Prebuilt-UI"]]},"seeAlsoSections":[{"generated":true,"anchor":"Customization","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Theming","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Configuring-the-Prebuilt-UI","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Customizing-the-Reader-Screen"],"title":"Customization"}],"abstract":[{"text":"Translate the prebuilt UI’s text, or replace any of its strings with your own.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Localization"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"text":"The prebuilt UI asks ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizationManager","type":"reference","isActive":true},{"text":" for every string it shows,","type":"text"},{"text":" ","type":"text"},{"text":"naming each one with a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey","type":"reference","isActive":true},{"text":". The shared manager looks","type":"text"},{"text":" ","type":"text"},{"text":"the string up in your app with ","type":"text"},{"code":"NSLocalizedString","type":"codeVoice"},{"text":", using the SDK’s","type":"text"},{"text":" ","type":"text"},{"text":"English text as the key, and falls back to that English text. So","type":"text"},{"text":" ","type":"text"},{"text":"translations in your app’s ","type":"text"},{"code":"Localizable","type":"codeVoice"},{"text":" strings file or String Catalog","type":"text"},{"text":" ","type":"text"},{"text":"reach the SDK without any code:","type":"text"}],"type":"paragraph"},{"copyToClipboard":true,"wrap":0,"lineAnnotations":[],"type":"codeListing","showLineNumbers":false,"syntax":null,"code":["\/* Localizable.strings (French) *\/","\"Contents\" = \"Sommaire\";","\"Bookmarks\" = \"Signets\";","\"Search\" = \"Rechercher\";","\"Most Recent\" = \"Les plus récentes\";"]},{"inlineContent":[{"type":"text","text":"Building your own reader screen? The core reader asks the same manager"},{"type":"text","text":" "},{"type":"text","text":"for the few strings it draws; see "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Localizing-the-Readers-Text","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Text that comes from you or from PageSuite isn’t the SDK’s to translate:","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the section names you give the carousel, archive names in a dynamic"},{"text":" ","type":"text"},{"text":"archive’s configuration, and the editions themselves.","type":"text"}]},{"type":"heading","anchor":"Adding-Translations","level":2,"text":"Adding Translations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey"},{"type":"text","text":" documents its English text. Use that"},{"type":"text","text":" "},{"type":"text","text":"text, exactly, as the key in a "},{"code":"Localizable.strings","type":"codeVoice"},{"type":"text","text":" file or a"},{"type":"text","text":" "},{"code":"Localizable.xcstrings","type":"codeVoice"},{"type":"text","text":" String Catalog in your app target. Xcode doesn’t"},{"type":"text","text":" "},{"type":"text","text":"find the SDK’s strings when it scans your code, so add the entries"},{"type":"text","text":" "},{"type":"text","text":"yourself."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two strings take a number: "},{"code":"\"%lld comments\"","type":"codeVoice"},{"type":"text","text":" and "},{"code":"\"View comments (%lld)\"","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"In a String Catalog, vary them by plural."}]},{"type":"paragraph","inlineContent":[{"text":"Some keys share their English text, so one translation covers both:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"English text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"Search\""}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey\/search","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey\/searchBarPlaceholder","isActive":true,"type":"reference"}]}]],[[{"inlineContent":[{"code":"\"You're offline\"","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey\/offlineTitle","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey\/errorLoadingOfflineTitle","type":"reference","isActive":true}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"\"Order by added\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey\/orderByDownloaded","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey\/orderByBookmarked","type":"reference"}]}]]]},{"inlineContent":[{"text":"To word them differently, replace them in code.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Replacing-Strings-in-Code","text":"Replacing Strings in Code","type":"heading"},{"inlineContent":[{"type":"text","text":"Subclass "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizationManager","type":"reference"},{"type":"text","text":" and override"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizationManager\/localizedString(for:)","type":"reference"},{"type":"text","text":" to supply your own text for"},{"type":"text","text":" "},{"type":"text","text":"some keys, from your own strings or your server, and call "},{"code":"super","type":"codeVoice"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"rest:"}],"type":"paragraph"},{"type":"codeListing","showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"code":["final class BrandLocalizationManager: LocalizationManager {","    override func localizedString(for key: LocalizedStringKey) -> String {","        switch key {","        case .bookmarks:","            return NSLocalizedString(\"Saved\", comment: \"Title of the saved pages screen\")","        case .searchBarPlaceholder:","            return NSLocalizedString(\"Search past editions\", comment: \"Search field placeholder\")","        case .commentButtonByline(let count?) where count > 99:","            return \"99+\"","        default:","            return super.localizedString(for: key)","        }","    }","}"],"wrap":0},{"inlineContent":[{"text":"Install it as the shared manager before you create any of the SDK’s view","type":"text"},{"text":" ","type":"text"},{"text":"controllers, for example when your app launches:","type":"text"}],"type":"paragraph"},{"syntax":"swift","lineAnnotations":[],"code":["LocalizationManager.shared = BrandLocalizationManager()"],"showLineNumbers":false,"type":"codeListing","wrap":0,"copyToClipboard":true},{"inlineContent":[{"text":"Screens created earlier keep the text they already showed.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"In the Swift 6 language mode, the compiler rejects setting"},{"type":"text","text":" "},{"type":"codeVoice","code":"shared"},{"type":"text","text":" because it’s mutable global state. Import the SDK with"},{"type":"text","text":" "},{"type":"codeVoice","code":"@preconcurrency import PSReader"},{"type":"text","text":" in the file that sets it."}],"type":"paragraph"}],"style":"note","type":"aside"},{"text":"Keeping Translations Current","type":"heading","anchor":"Keeping-Translations-Current","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"SDK releases sometimes add keys. After updating, check"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey"},{"type":"text","text":" for new cases and add their translations; until"},{"type":"text","text":" "},{"type":"text","text":"you do, those strings show in English."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Two strings don’t go through the manager yet: the Copy Link"},{"type":"text","text":" "},{"type":"text","text":"action in the share sheet, and the “Top stories” section that heads"},{"type":"text","text":" "},{"type":"text","text":"some editions in the content browser."}]}],"name":"Note"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Some of the legacy replica reader’s text is in English only"},{"type":"text","text":" "},{"type":"text","text":"and doesn’t go through the manager. The modern reader, which"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/doc