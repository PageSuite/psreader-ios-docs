t appear","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"again."}],"type":"paragraph"},{"inlineContent":[{"text":"Every string has a default, documented on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/LocalizedStringKey"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"the user’s ","type":"text"},{"type":"codeVoice","code":"Localizable"},{"text":" strings can translate. Set a string here to","type":"text"},{"text":" ","type":"text"},{"text":"replace the default outright, for example with wording from your","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"server. Buttons the reader isn’t showing are skipped."}],"type":"paragraph"},{"showLineNumbers":false,"copyToClipboard":true,"type":"codeListing","wrap":0,"code":["var readerConfig = ReaderConfiguration(globalConfig: globalConfig)","readerConfig.onboarding.eyebrow = \"WELCOME TO THE E-EDITION\"","readerConfig.onboarding.bookmark.title = \"Save it for later\"","readerConfig.onboarding.doneButtonTitle = \"Start reading\""],"lineAnnotations":[],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"To turn the walkthrough off, set "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReaderOnboardingConfiguration\/isEnabled"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"To customize the reader screen, see ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Customizing-the-Reader-Screen","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReaderConfiguration\/onboarding"}],"type":"paragraph"}],"style":"note"