{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A view controller protocol used by the SDK to present paywalls when","type":"text"},{"text":" ","type":"text"},{"text":"accessing restricted content.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallViewController","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"UIViewController","preciseIdentifier":"c:objc(cs)UIViewController","kind":"typeIdentifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"mentions","mentions":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall"]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement this protocol in a custom view controller that presents your"},{"type":"text","text":" "},{"type":"text","text":"paywall or subscription UI. The SDK presents the view controller modally"},{"type":"text","text":" "},{"type":"text","text":"but does not dismiss it — the view controller owns its own dismissal and"},{"type":"text","text":" "},{"type":"text","text":"presentation style. When the paywall flow ends, dismiss the view"},{"type":"text","text":" "},{"type":"text","text":"controller and then invoke "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController\/onDismiss"},{"text":" to tell the SDK whether to grant","type":"text"},{"type":"text","text":" "},{"type":"text","text":"access."}]},{"text":"Usage","level":2,"anchor":"Usage","type":"heading"},{"type":"codeListing","code":["class MyPaywallVC: UIViewController, PaywallViewController {","    var onDismiss: ((Bool) -> Void)?","","    @objc func subscribeTapped() {","        \/\/ After successful subscription...","        dismiss(animated: true) {","            self.onDismiss?(true)","        }","    }","","    @objc func cancelTapped() {","        dismiss(animated: true) {","            self.onDismiss?(false)","        }","    }","}"],"lineAnnotations":[],"wrap":0,"copyToClipboard":true,"showLineNumbers":false,"syntax":"swift"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController\/onDismiss"},{"type":"text","text":" is a callback that signals the access decision,"},{"type":"text","text":" "},{"type":"text","text":"not a dismissal command. Always call "},{"type":"codeVoice","code":"dismiss(animated:)"},{"type":"text","text":" yourself,"},{"type":"text","text":" "},{"type":"text","text":"invoke "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController\/onDismiss"},{"type":"text","text":" exactly once "},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"type":"text","text":" dismissal completes (the SDK"},{"type":"text","text":" "},{"type":"text","text":"resumes the originating action the moment the closure fires), and make"},{"type":"text","text":" "},{"type":"text","text":"sure it runs for any interactive dismissal your presentation style"},{"type":"text","text":" "},{"type":"text","text":"allows (e.g. swiping a sheet down). See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywalls"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the recommended pattern."}]}],"type":"aside"},{"style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywalls","type":"reference","isActive":true}]}],"type":"aside"},{"style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallDelegate"}]}],"type":"aside"}]}],"variants":[{"paths":["\/documentation\/psreader\/paywallviewcontroller"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"roleHeading":"Protocol","title":"PaywallViewController","externalID":"s:8PSReader21PaywallViewControllerP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallViewController","kind":"identifier"}],"symbolKind":"protocol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PaywallViewController"}],"modules":[{"name":"PSReader"}]},"topicSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController\/onDismiss"],"title":"Reporting the Decision","anchor":"Reporting-the-Decision"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/objc(cs)UIViewController"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"}],"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/PaywallDelegate":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallDelegate","kind":"symbol","title":"PaywallDelegate","role":"symbol","abstract":[{"type":"text","text":"A delegate protocol used to provide paywall view controllers for controlling"},{"type":"text","text":" "},{"type":"text","text":"access to premium content within the SDK."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ",