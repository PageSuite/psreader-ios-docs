{"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"abstract":[{"type":"text","text":"Add a listen button to your own reader screen that reads the article in view aloud, with the SDK’s text-to-speech provider."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt reader shows a listen button on pages with one article. A"},{"type":"text","text":" "},{"type":"text","text":"tap reads the article aloud and opens playback controls."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider"},{"type":"text","text":" does everything but the button, on core"},{"type":"text","text":" "},{"type":"text","text":"models, so your reader screen can use it unchanged: you add the button,"},{"type":"text","text":" "},{"type":"text","text":"tell the provider which page is on screen, and present the controls it"},{"type":"text","text":" "},{"type":"text","text":"returns."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the prebuilt UI? See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a provider and the button to "},{"code":"ReaderScreenViewController","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"reader screen from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader"},{"type":"text","text":":"}]},{"syntax":"swift","code":["private let textToSpeech = DefaultTextToSpeechProvider(","    configuration: AudioOverlayConfiguration(","        globalConfig: GlobalConfiguration(apiKey: \"API_KEY\", accountGUID: \"ACCOUNT_GUID\")","    )",")","","private lazy var listenButton = UIBarButtonItem(","    image: UIImage(systemName: \"headphones\"),","    style: .plain,","    target: self,","    action: #selector(listenTapped)",")"],"wrap":0,"copyToClipboard":true,"type":"codeListing","showLineNumbers":false,"lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"text":"Keep one provider for the life of the screen: it holds the article that’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"playing. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioOverlayConfiguration"},{"text":" takes the controls’ starting fonts,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"colors, and icons from a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration"},{"text":", which you can create","type":"text"},{"text":" ","type":"text"},{"text":"just for it; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button#Styling-the-Controls"},{"text":".","type":"text"}]},{"anchor":"Showing-the-Button-on-Listenable-Pages","type":"heading","level":2,"text":"Showing the Button on Listenable Pages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"code":"addChrome()","type":"codeVoice"},{"type":"text","text":", put the button in the navigation bar, disabled until"},{"type":"text","text":" "},{"type":"text","text":"the first page settles:"}]},{"showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"code":["listenButton.isEnabled = false","navigationItem.rightBarButtonItems = (navigationItem.rightBarButtonItems ?? []) + [listenButton]"],"type":"codeListing","lineAnnotations":[],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"code":"updateChrome()","type":"codeVoice"},{"type":"text","text":", report each page the reader settles on to the"},{"type":"text","text":" "},{"type":"text","text":"provider, and enable the button when the provider can read the page. It"},{"type":"text","text":" "},{"type":"text","text":"can read a page that carries exactly one article in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/articles"},{"type":"text","text":", as an article page does:"}]},{"syntax":"swift","showLineNumbers":false,"copyToClipboard":true,"code":["if let source {","    textToSpeech.didChangeTo(page: page, inEdition: source.edition, inPublished: source.published)","    listenButton.isEnabled = textToSpeech.isListenable(page: page, inEdition: source)","}"],"type":"codeListing","lineAnnotations":[],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reporting the page also keeps playback in step with the reader. When the"},{"type":"text","text":" "},{"type":"text","text":"reader settles on a page whose article isn’t the one playing, the"},{"text":" ","type":"text"},{"text":"provider lets the article go: playback stops and the audio session is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"deactivated. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Following-Page-Changes"},{"type":"text","text":" has the details."}]},{"anchor":"Starting-Playback","level":2,"type":"heading","text":"Starting Playback"},{"inlineContent":[{"type":"text","text":"Add the action in an extension, in the same file as the class. On a tap,"},{"type":"text","text":" "},{"type":"text","text":"ask the provider for the page’s overlay. The call starts the article,"},{"text":" ","type":"text"},{"type":"text","text":"and the overlay holds its controls: play and pause, 15-second skips, a"},{"type":"text","text":" "},{"type":"text","text":"progress bar the user can scrub, and elapsed and remaining times. It"},{"type":"text","text":" "},{"type":"text","text":"arrives sized to fit them and stays a popover in compact widths, so a"},{"type":"text","text":" "},{"type":"text","text":"popover from your button suits iPhone and iPad alike:"}],"type":"paragraph"},{"syntax":"swift","code":["extension ReaderScreenViewController {","","    @objc private func listenTapped() {","        guard let source,","              let page = reader.currentPage(),","              let overlay = textToSpeech.playAudio(for: page, inEdition: source) else {","            return","        }","","        overlay.modalPresentationStyle = .popover","        overlay.popoverPresentationController?.barButtonItem = listenButton","        present(overlay, animated: true)","    }","}"],"wrap":0,"copyToClipboard":true,"type":"codeListing","showLineNumbers":false,"lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default synthesizer renders the whole article before playback starts,"},{"type":"text","text":" "},{"type":"text","text":"so the overlay shows a loading state first. Closing the overlay doesn’t"},{"type":"text","text":" "},{"type":"text","text":"stop playback, and tapping the button again on the same article brings"},{"type":"text","text":" "},{"type":"text","text":"back its controls rather than starting over."}]},{"level":2,"type":"heading","text":"Stopping When the Screen Closes","anchor":"Stopping-When-the-Screen-Closes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt reader reports no page when its screen goes away, which"},{"type":"text","text":" "},{"type":"text","text":"stops playback. Do the same in your screen’s class:"}]},{"syntax":"swift","showLineNumbers":false,"copyToClipboard":true,"code":["override func viewWillDisappear(_ animated: Bool) {","    super.viewWillDisappear(animated)","","    if let source, isMovingFromParent || isBeingDismissed || parent?.isBeingDismissed == true {","        textToSpeech.didChangeTo(page: nil, inEdition: source.edition, inPublished: source.published)","    }","}"],"type":"codeListing","lineAnnotations":[],"wrap":0},{"level":2,"type":"heading","text":"Styling the Controls","anchor":"Styling-the-Controls"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The overlay takes its brand color, primary font, icons, and Liquid Glass"},{"type":"text","text":" "},{"type":"text","text":"policy from the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true},{"type":"text","text":" you give its configuration. Pass"},{"type":"text","text":" "},{"type":"text","text":"your own to match your chrome, then adjust any"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioOverlayConfiguration","isActive":true},{"type":"text","text":" property:"}]},{"syntax":"swift","showLineNumbers":false,"copyToClipboard":true,"code":["private let textToSpeech: DefaultTextToSpeechProvider = {","    var overlayConfig = AudioOverlayConfiguration(","        globalConfig: GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\",","            primaryFont: UIFont(name: \"Georgia\", size: 14) ?? .systemFont(ofSize: 14),","            brandColor: .systemIndigo","        )","    )","    overlayConfig.backgroundColor = .secondarySystemBackground","    return DefaultTextToSpeechProvider(configuration: overlayConfig)","}()"],"type":"codeListing","lineAnnotations":[],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Styling-the-Overlay","isActive":true},{"type":"text","text":" lists every property, and the"},{"type":"text","text":" "},{"type":"text","text":"localization keys for the overlay’s text. Your button is yours to design;"},{"type":"text","text":" "},{"type":"text","text":"to match the prebuilt reader’s, use its icon and title. In "},{"code":"addChrome()","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","showLineNumbers":false,"copyToClipboard":true,"code":["listenButton.image = ImageResourceName.listen.defaultImage()","listenButton.accessibilityLabel = LocalizationManager.shared.localizedString(for: .listen)"],"type":"codeListing","lineAnnotations":[],"wrap":0},{"level":2,"type":"heading","text":"Changing the Voice, Text, or Audio Session","anchor":"Changing-the-Voice-Text-or-Audio-Session"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The provider’s other parts change exactly as they do in the prebuilt"},{"type":"text","text":" "},{"type":"text","text":"reader: pass your own to its initializer, and it uses the SDK’s part for"},{"type":"text","text":" "},{"type":"text","text":"each one you leave out."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/TextToSpeechSynthesizer"},{"text":" for another voice, such as a cloud","type":"text"},{"text":" ","type":"text"},{"text":"service’s; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Choosing-a-Voice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/TextToSpeechArticleFormatter"},{"text":" to change what’s read; see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Changing-the-Spoken-Text"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioSessionProvider"},{"text":" to set up the audio session differently,","type":"text"},{"text":" ","type":"text"},{"text":"for example to lower other apps’ audio; see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Managing-the-Audio-Session"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Using Your Own Audio Delegate","anchor":"Using-Your-Own-Audio-Delegate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate","isActive":true},{"type":"text","text":" works behind your button, not only"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider","isActive":true},{"type":"text","text":": call its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate\/isListenable(page:inEdition:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate\/playAudio(for:inEdition:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate\/didChangeTo(page:inEdition:inPublished:)","isActive":true},{"text":" the same way.","type":"text"},{"text":" ","type":"text"},{"text":"Present the overlay when ","type":"text"},{"type":"codeVoice","code":"playAudio"},{"type":"text","text":" returns one; a delegate that returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" plays without one. Nothing in a custom UI asks for"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate\/audioBannerViewController()"},{"type":"text","text":", so put a delegate’s own"},{"type":"text","text":" "},{"text":"controls wherever your screen has room.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Writing-Your-Own-Audio-Delegate"},{"type":"text","text":" shows a delegate"},{"type":"text","text":" "},{"type":"text","text":"that plays through the app’s player."}]}]}],"seeAlsoSections":[{"title":"Adding Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Advert-Pages","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics"],"generated":true,"anchor":"Adding-Features"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/adding-a-listen-button"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/adding-a-listen-button"]}],"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor