{"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Add a listen button to your own reader screen that reads the article in view aloud, with the SDK’s text-to-speech provider."}],"sections":[],"seeAlsoSections":[{"title":"Adding Features","anchor":"Adding-Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Advert-Pages","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics"],"generated":true}],"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt reader shows a listen button on pages with one article. A"},{"type":"text","text":" "},{"type":"text","text":"tap reads the article aloud and opens playback controls."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider"},{"type":"text","text":" does everything but the button, on core"},{"type":"text","text":" "},{"type":"text","text":"models, so your reader screen can use it unchanged: you add the button,"},{"type":"text","text":" "},{"type":"text","text":"tell the provider which page is on screen, and present the controls it"},{"type":"text","text":" "},{"type":"text","text":"returns."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the prebuilt UI? See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Add a provider and the button to ","type":"text"},{"code":"ReaderScreenViewController","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"reader screen from ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader"},{"type":"text","text":":"}]},{"type":"codeListing","showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"code":["private let textToSpeech = DefaultTextToSpeechProvider(","    configuration: AudioOverlayConfiguration(","        globalConfig: GlobalConfiguration(apiKey: \"API_KEY\", accountGUID: \"ACCOUNT_GUID\")","    )",")","","private lazy var listenButton = UIBarButtonItem(","    image: UIImage(systemName: \"headphones\"),","    style: .plain,","    target: self,","    action: #selector(listenTapped)",")"],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep one provider for the life of the screen: it holds the article that’s"},{"type":"text","text":" "},{"type":"text","text":"playing. "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioOverlayConfiguration","isActive":true},{"type":"text","text":" takes the controls’ starting fonts,"},{"type":"text","text":" "},{"type":"text","text":"colors, and icons from a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true},{"type":"text","text":", which you can create"},{"text":" ","type":"text"},{"text":"just for it; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button#Styling-the-Controls"},{"type":"text","text":"."}]},{"level":2,"anchor":"Showing-the-Button-on-Listenable-Pages","type":"heading","text":"Showing the Button on Listenable Pages"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"addChrome()"},{"text":", put the button in the navigation bar, disabled until","type":"text"},{"text":" ","type":"text"},{"text":"the first page settles:","type":"text"}]},{"type":"codeListing","showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"code":["listenButton.isEnabled = false","navigationItem.rightBarButtonItems = (navigationItem.rightBarButtonItems ?? []) + [listenButton]"],"wrap":0},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"updateChrome()","type":"codeVoice"},{"text":", report each page the reader settles on to the","type":"text"},{"text":" ","type":"text"},{"text":"provider, and enable the button when the provider can read the page. It","type":"text"},{"text":" ","type":"text"},{"text":"can read a page that carries exactly one article in","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/articles","type":"reference"},{"text":", as an article page does:","type":"text"}]},{"type":"codeListing","showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"code":["if let source {","    textToSpeech.didChangeTo(page: page, inEdition: source.edition, inPublished: source.published)","    listenButton.isEnabled = textToSpeech.isListenable(page: page, inEdition: source)","}"],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reporting the page also keeps playback in step with the reader. When the"},{"type":"text","text":" "},{"type":"text","text":"reader settles on a page whose article isn’t the one playing, the"},{"type":"text","text":" "},{"type":"text","text":"provider lets the article go: playback stops and the audio session is"},{"type":"text","text":" "},{"type":"text","text":"deactivated. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Following-Page-Changes"},{"type":"text","text":" has the details."}]},{"anchor":"Starting-Playback","type":"heading","level":2,"text":"Starting Playback"},{"type":"paragraph","inlineContent":[{"text":"Add the action in an extension, in the same file as the class. On a tap,","type":"text"},{"text":" ","type":"text"},{"text":"ask the provider for the page’s overlay. The call starts the article,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and the overlay holds its controls: play and pause, 15-second skips, a"},{"type":"text","text":" "},{"type":"text","text":"progress bar the user can scrub, and elapsed and remaining times. It"},{"type":"text","text":" "},{"type":"text","text":"arrives sized to fit them and stays a popover in compact widths, so a"},{"type":"text","text":" "},{"type":"text","text":"popover from your button suits iPhone and iPad alike:"}]},{"type":"codeListing","showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"code":["extension ReaderScreenViewController {","","    @objc private func listenTapped() {","        guard let source,","              let page = reader.currentPage(),","              let overlay = textToSpeech.playAudio(for: page, inEdition: source) else {","            return","        }","","        overlay.modalPresentationStyle = .popover","        overlay.popoverPresentationController?.barButtonItem = listenButton","        present(overlay, animated: true)","    }","}"],"wrap":0},{"inlineContent":[{"text":"The default synthesizer renders the whole article before playback starts,","type":"text"},{"text":" ","type":"text"},{"text":"so the overlay shows a loading state first. Closing the overlay doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"stop playback, and tapping the button again on the same article brings","type":"text"},{"text":" ","type":"text"},{"text":"back its controls rather than starting over.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Stopping-When-the-Screen-Closes","type":"heading","text":"Stopping When the Screen Closes"},{"inlineContent":[{"type":"text","text":"The prebuilt reader reports no page when its screen goes away, which"},{"type":"text","text":" "},{"type":"text","text":"stops playback. Do the same in your screen’s class:"}],"type":"paragraph"},{"type":"codeListing","showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"code":["override func viewWillDisappear(_ animated: Bool) {","    super.viewWillDisappear(animated)","","    if let source, isMovingFromParent || isBeingDismissed || parent?.isBeingDismissed == true {","        textToSpeech.didChangeTo(page: nil, inEdition: source.edition, inPublished: source.published)","    }","}"],"wrap":0},{"level":2,"anchor":"Styling-the-Controls","type":"heading","text":"Styling the Controls"},{"inlineContent":[{"type":"text","text":"The overlay takes its brand color, primary font, icons, and Liquid Glass"},{"type":"text","text":" "},{"type":"text","text":"policy from the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true},{"type":"text","text":" you give its configuration. Pass"},{"type":"text","text":" "},{"type":"text","text":"your own to match your chrome, then adjust any"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioOverlayConfiguration","isActive":true},{"type":"text","text":" property:"}],"type":"paragraph"},{"showLineNumbers":false,"lineAnnotations":[],"copyToClipboard":true,"wrap":0,"type":"codeListing","code":["private let textToSpeech: DefaultTextToSpeechProvider = {","    var overlayConfig = AudioOverlayConfiguration(","        globalConfig: GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\",","            primaryFont: UIFont(name: \"Georgia\", size: 14) ?? .systemFont(ofSize: 14),","            brandColor: .systemIndigo","        )","    )","    overlayConfig.backgroundColor = .secondarySystemBackground","    return DefaultTextToSpeechProvider(configuration: overlayConfig)","}()"],"syntax":"swift"},{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Styling-the-Overlay","isActive":true,"type":"reference"},{"text":" lists every property, and the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"localization keys for the overlay’s text. Your button is yours to design;"},{"type":"text","text":" "},{"type":"text","text":"to match the prebuilt reader’s, use its icon and title. In "},{"type":"codeVoice","code":"addChrome()"},{"type":"text","text":":"}],"type":"paragraph"},{"showLineNumbers":false,"lineAnnotations":[],"copyToClipboard":true,"type":"codeListing","wrap":0,"code":["listenButton.image = ImageResourceName.listen.defaultImage()","listenButton.accessibilityLabel = LocalizationManager.shared.localizedString(for: .listen)"],"syntax":"swift"},{"anchor":"Changing-the-Voice-Text-or-Audio-Session","type":"heading","level":2,"text":"Changing the Voice, Text, or Audio Session"},{"inlineContent":[{"text":"The provider’s other parts change exactly as they do in the prebuilt","type":"text"},{"text":" ","type":"text"},{"text":"reader: pass your own to its initializer, and it uses the SDK’s part for","type":"text"},{"text":" ","type":"text"},{"text":"each one you leave out.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/TextToSpeechSynthesizer","isActive":true,"type":"reference"},{"type":"text","text":" for another voice, such as a cloud"},{"type":"text","text":" "},{"type":"text","text":"service’s; see "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Choosing-a-Voice","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/TextToSpeechArticleFormatter"},{"type":"text","text":" to change what’s read; see"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Changing-the-Spoken-Text"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioSessionProvider"},{"text":" to set up the audio session differently,","type":"text"},{"text":" ","type":"text"},{"text":"for example to lower other apps’ audio; see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Text-to-Speech#Managing-the-Audio-Session","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"level":2,"text":"Using Your Own Audio Delegate","anchor":"Using-Your-Own-Audio-Delegate","type":"heading"},{"inlineContent":[{"type":"text","text":"Any "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AudioDelegate","type":"reference","isActive":true},{"type":"text","text":" works behind your button, not only"},{"type":"text","text":" "},{"identifi