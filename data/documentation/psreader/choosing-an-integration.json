"type":"reference"},{"text":" build share content from a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage","type":"reference"},{"text":" ","type":"text"},{"text":"and its edition. See ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Text-to-speech:","type":"text"}]},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider"},{"text":" reads an article","type":"text"},{"text":" ","type":"text"},{"text":"aloud from any listen button you add. See ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Commenting:","type":"text"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultCommentingProvider","isActive":true},{"type":"text","text":" supplies the comment"},{"type":"text","text":" "},{"type":"text","text":"button, counts, and tooltips; forward the reader’s commenting delegate"},{"type":"text","text":" "},{"type":"text","text":"to it. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Search:"}]},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchService"},{"text":" and its implementations are plain","type":"text"},{"type":"text","text":" "},{"type":"text","text":"networking over public types. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","isActive":true},{"text":".","type":"text"}]}]}]}]}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Reader-App","type":"reference"},{"text":" shows both sides in one sample project, the","type":"text"},{"text":" ","type":"text"},{"text":"prebuilt reader opened from your own screen included.","type":"text"}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Choosing-an-Integration"},"abstract":[{"type":"text","text":"Decide who builds your app’s reader experience: the SDK, with its prebuilt UI, or you, with a custom UI on the core SDK."}],"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/Custom-UI":{"role":"collectionGroup","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI","url":"\/documentation\/psreader\/custom-ui","abstract":[{"type":"text","text":"Build your own reader screens on the SDK’s core: your archive, your reader screen, and the features you choose to add."}],"kind":"article","type":"topic","title":"Custom UI"},"doc://com.pagesuite.PSReader/documentation/PSReader/BookmarksViewController":{"url":"\/documentation\/psreader\/bookmarksviewcontroller","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"BookmarksViewController","kind":"identifier"}],"title":"BookmarksViewController","navigatorTitle":[{"kind":"identifier","text":"BookmarksViewController"}],"role":"symbol","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/BookmarksViewController","abstract":[{"ty