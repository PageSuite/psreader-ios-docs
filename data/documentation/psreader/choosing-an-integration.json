{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/choosing-an-integration"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/choosing-an-integration"]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK has two sides. The "},{"inlineContent":[{"type":"text","text":"prebuilt UI"}],"type":"strong"},{"type":"text","text":" is a complete reader app that"},{"type":"text","text":" "},{"type":"text","text":"you configure, brand, and connect to your services. A "},{"inlineContent":[{"type":"text","text":"custom UI"}],"type":"strong"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"your own design, built on the core SDK: the engine the prebuilt UI runs"},{"type":"text","text":" "},{"type":"text","text":"on, with the same page renderer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both sides work with every edition on PageSuite’s current system, classic"},{"type":"text","text":" "},{"type":"text","text":"PDF editions included, so a custom UI for a classic PDF edition is fully"},{"type":"text","text":" "},{"type":"text","text":"supported. “Feed” in API names such as "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService","isActive":true},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"current system’s old name, not a format. Editions on the legacy replica"},{"type":"text","text":" "},{"type":"text","text":"system open only in the prebuilt UI. To check which system a title is on,"},{"type":"text","text":" "},{"type":"text","text":"see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Edition-Platforms#Telling-Which-System-a-Publication-Is-On","isActive":true},{"type":"text","text":"."}]},{"header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Prebuilt UI"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Custom UI"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"You write"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Configuration and delegates, plus your own navigation if you place screens yourself"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Every screen: archive, reader chrome, page browser, settings"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Archive, bookmarks, downloads, and search screens"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Prebuilt"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yours"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Reader screen (navigation bar, content browser, loading screen, settings)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Prebuilt"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yours, around the SDK’s page renderer"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Features such as sharing, paywalls, and text-to-speech"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Built in: you switch them on and connect delegates"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"You build each one, from SDK parts where they exist"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Customization"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Theming, configuration, delegates"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Anything"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Analytics"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Ready-made events"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Your own, from the reader’s delegates"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Classic PDF and responsive editions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Editions on the legacy replica system"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the prebuilt UI when its screens, themed to your brand, fit your"},{"type":"text","text":" "},{"type":"text","text":"app: it’s the least code, and features arrive as configuration. Choose a"},{"type":"text","text":" "},{"type":"text","text":"custom UI when your design needs a reader screen of its own. The choice"},{"type":"text","text":" "},{"type":"text","text":"isn’t all or nothing; see "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Choosing-an-Integration#Mixing-Prebuilt-and-Custom-UI","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"The Prebuilt UI","anchor":"The-Prebuilt-UI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt UI gives you archives, the reader screen, offline downloads,"},{"type":"text","text":" "},{"type":"text","text":"bookmarks, search, and analytics events, all themed from one"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true},{"type":"text","text":". Delegates connect your paywall, sharing,"},{"type":"text","text":" "},{"type":"text","text":"text-to-speech, commenting, adverts, and media. You can show it whole, or"},{"type":"text","text":" "},{"type":"text","text":"place its screens one at a time in your own navigation."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Whole, as the carousel."}],"type":"strong"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController","isActive":true},{"type":"text","text":" is a complete"},{"type":"text","text":" "},{"type":"text","text":"reader app in one view controller. Give it a shortcode and it loads your"},{"type":"text","text":" "},{"type":"text","text":"publications, their archives, and their reader settings from PageSuite:"}]},{"showLineNumbers":false,"syntax":"swift","code":["let globalConfig = GlobalConfiguration(apiKey: \"API_KEY\", accountGUID: \"ACCOUNT_GUID\")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\"),","        .subsections(\"My Content\", [","            .init(name: \"Bookmarks\", type: .bookmarks(type: .all)),","            .init(name: \"Downloads\", type: .downloads(type: .all))","        ])","    ]",")"],"copyToClipboard":true,"type":"codeListing","lineAnnotations":[],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Setting-Up-the-Carousel","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Screen by screen, in your own navigation."}],"type":"strong"},{"type":"text","text":" Each screen the carousel"},{"type":"text","text":" "},{"type":"text","text":"shows is also a view controller you can place yourself:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveViewController","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/BookmarksViewController","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DownloadsViewController","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchViewController","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedReaderViewController","isActive":true},{"type":"text","text":" opens one edition in the prebuilt reader"},{"type":"text","text":" "},{"type":"text","text":"screen from anywhere, such as a button, a notification, or your own"},{"type":"text","text":" "},{"type":"text","text":"archive list:"}]},{"lineAnnotations":[],"wrap":0,"type":"codeListing","code":["\/\/ An archive screen inside your own navigation.","let archive = ArchiveViewController(","    globalConfig: globalConfig,","    archiveType: .feedArchive(guid: \"PUBLICATION_GUID\", publicationName: \"The Daily\")",")","navigationController?.pushViewController(archive, animated: true)","","\/\/ The latest edition, straight from a button.","let reader = FeedReaderViewController(","    globalConfig: globalConfig,","    latestEditionForPublication: \"PUBLICATION_GUID\"",")","reader.modalPresentationStyle = .fullScreen","present(reader, animated: true)"],"showLineNumbers":false,"syntax":"swift","copyToClipboard":true},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Embedding-Prebuilt-Screens","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Presenting-the-Prebuilt-Reader","isActive":true},{"type":"text","text":". Every screen takes the same"},{"type":"text","text":" "},{"type":"text","text":"configuration and delegates as the carousel, so you can start with one"},{"type":"text","text":" "},{"type":"text","text":"and move to the other."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"What it costs:"}],"type":"strong"},{"type":"text","text":" the layout is the SDK’s. You can restyle and configure"},{"type":"text","text":" "},{"type":"text","text":"every screen, but not rearrange it, and the reader screen is always the"},{"type":"text","text":" "},{"type":"text","text":"SDK’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Editions on the legacy replica system open from the carousel and the"},{"type":"text","text":" "},{"type":"text","text":"prebuilt screens, but not from "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedReaderViewController","isActive":true},{"type":"text","text":", which opens editions"},{"type":"text","text":" "},{"type":"text","text":"on the current system only."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Continue with "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Prebuilt-UI","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"A Custom UI","anchor":"A-Custom-UI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom UI is built on the core SDK, the engine the prebuilt UI runs on."},{"type":"text","text":" "},{"type":"text","text":"You fetch the catalog with "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService","isActive":true},{"type":"text","text":", open an edition, and"},{"type":"text","text":" "},{"type":"text","text":"host "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController","isActive":true},{"type":"text","text":", which renders pages and nothing"},{"type":"text","text":" "},{"type":"text","text":"else, inside a screen you design:"}]},{"lineAnnotations":[],"wrap":0,"type":"codeListing","code":["import PSReader","import UIKit","","final class LatestEditionViewController: UIViewController {","","    private let reader = PSEditionReaderViewController()","","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ Host the reader as a child; your chrome goes around it.","        addChild(reader)","        reader.view.frame = view.bounds","        reader.view.autoresizingMask = [.flexibleWidth, .flexibleHeight]","        view.addSubview(reader.view)","        reader.didMove(toParent: self)","","        Task {","            do {","                let service = FeedEditionService(accountGUID: \"ACCOUNT_GUID\")","                let published = try await service.latestEdition(publicationGUID: \"PUBLICATION_GUID\")","                let source = try await published.openEditionSource()","                reader.open(edition: source)","            } catch {","                \/\/ Show your own error state.","            }","        }","    }","}"],"showLineNumbers":false,"syntax":"swift","copyToClipboard":true},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"What you get:"}],"type":"strong"},{"type":"text","text":" full control. The archive, navigation bar, page"},{"type":"text","text":" "},{"type":"text","text":"browser, loading screen, and settings are yours. The SDK reports the"},{"type":"text","text":" "},{"type":"text","text":"state they need: paging through the reader’s delegates, download progress"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadObserver","isActive":true},{"type":"text","text":", and bookmark changes through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmarkObserver","isActive":true},{"type":"text","text":". "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmarkManager","isActive":true},{"type":"text","text":" "},{"type":"text","text":"handle offline reading and bookmarks."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"What it costs:"}],"type":"strong"},{"type":"text","text":" more code. There’s no configuration to theme,"},{"type":"text","text":" "},{"type":"text","text":"because every pixel outside the pages is yours, and you build each"},{"type":"text","text":" "},{"type":"text","text":"feature the prebuilt reader would have given you. Analytics come from the"},{"type":"text","text":" "},{"type":"text","text":"reader’s delegates; of the prebuilt UI’s ready-made events, only"},{"type":"text","text":" "},{"type":"text","text":"downloads and bookmarks still arrive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Continue with "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI","isActive":true},{"type":"text","text":", which lists what you build and what the"},{"type":"text","text":" "},{"type":"text","text":"SDK provides for each part. Moving from the legacy core SDK? Start with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Migrating-From-the-Legacy-Core-SDK","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Mixing Prebuilt and Custom UI","anchor":"Mixing-Prebuilt-and-Custom-UI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two sides share one module and one model, so one app can use both:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Your archive, the prebuilt reader."}]},{"type":"text","text":" List editions with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService","isActive":true},{"type":"text","text":" in a design of your own, then open the one the"},{"type":"text","text":" "},{"type":"text","text":"user taps in the prebuilt reader:"}],"type":"paragraph"},{"lineAnnotations":[],"wrap":0,"type":"codeListing","code":["let reader = FeedReaderViewController(globalConfig: globalConfig, published: published)","reader.modalPresentationStyle = .fullScreen","present(reader, animated: true)"],"showLineNumbers":false,"syntax":"swift","copyToClipboard":true}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"A custom UI with prebuilt parts."}]},{"type":"text","text":" Several prebuilt components take"},{"type":"text","text":" "},{"type":"text","text":"core models and work on their own:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sharing:"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/WebReaderShareProvider","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArticleLinkShareProvider","isActive":true},{"type":"text","text":" build share content from a "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and its edition. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Text-to-speech:"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultTextToSpeechProvider","isActive":true},{"type":"text","text":" reads an article"},{"type":"text","text":" "},{"type":"text","text":"aloud from any listen button you add. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Commenting:"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultCommentingProvider","isActive":true},{"type":"text","text":" supplies the comment"},{"type":"text","text":" "},{"type":"text","text":"button, counts, and tooltips; forward the reader’s commenting delegate"},{"type":"text","text":" "},{"type":"text","text":"to it. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Search:"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchService","isActive":true},{"type":"text","text":" and its implementations are plain"},{"type":"text","text":" "},{"type":"text","text":"networking over public types. See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","isActive":true},{"type":"text","text":"."}]}]}]}]}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Reader-App","isActive":true},{"type":"text","text":" shows both sides in one sample project, the"},{"ty