 commenting.trendingThreshold","        commenting.fetchCommentCount(forArticle: article, inEdition: source, cacheStrategy: .preferCache) { result in","            \/\/ A count that wasn't cached arrives later, maybe after the cell was reused.","            guard cell.article === article, let count = try? result.get() else {","                return","            }","            cell.countLabel.text = \"\\(count)\"","            cell.trendingIcon.isHidden = count < threshold","            cell.commentsView.isHidden = false","        }","    }","}"],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ArticleCell"},{"text":" stands for your page browser’s cell. The prebuilt content","type":"text"},{"text":" ","type":"text"},{"text":"browser introduces its counts with a second tooltip, above the first count","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"fully in view once the list comes to rest. Present the provider’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CommentingDelegate\/contentBrowserCommentTooltipViewController(inEdition:)"},{"type":"text","text":" "},{"type":"text","text":"the same way; like the article tooltip, it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" once seen. A"},{"type":"text","text":" "},{"type":"text","text":"popover adapts to a sheet in compact widths, so keep it a popover through"},{"type":"text","text":" "},{"type":"text","text":"its delegate:"}]},{"type":"codeListing","showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"code":["extension ReaderScreenViewController: UIPopoverPresentationControllerDelegate {","","    func showCommentTooltip(above countView: UIView) {","        guard let source,","              let tooltip = commenting.contentBrowserCommentTooltipViewController(inEdition: source) else {","            return","        }","","        tooltip.modalPresentationStyle = .popover","        if let popover = tooltip.popoverPresentationController {","            popover.sourceView = countView","            popover.sourceRect = countView.bounds","            popover.permittedArrowDirections = .down","            popover.delegate = self","        }","        present(tooltip, animated: true)","    }","","    func adaptivePresentationStyle(for controller: UIPresentationController,","                                   traitCollection: UITraitCollection) -> UIModalPresentationStyle {","        .none","    }","}"],"wrap":0},{"type":"heading","anchor":"Linking-Back-to-an-Article","text":"Linking Back to an Article","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To bring the user back to an article later, from a comment history or a"},{"type":"text","text":" "},{"type":"text","text":"notification about a reply, save "},{"type":"codeVoice","code":"source.published.editionGUID"},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"page.pageguid"},{"type":"text","text":" when they open the thread. Resolve the edition GUID with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/published(forEditionGUID:)"},{"type":"text","text":", and open your reader"},{"type":"text","text":" "},{"type":"text","text":"screen with "},{"code":"ReaderScreenViewController(published:openingPageGUID:)","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition#Routing-Links-and-Notifications"},{"type":"text","text":" shows the code."}]},{"text":"Commenting Without the Provider","anchor":"Commenting-Without-the-Provider","level":2,"type":"heading"},{"inlineContent":[{"text":"The reader’s protocol doesn’t need the SDK’s provider. To use your own","