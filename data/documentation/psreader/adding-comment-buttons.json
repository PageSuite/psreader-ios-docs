ue,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController"},{"type":"text","text":" pins a comment button to the foot of the"},{"type":"text","text":" "},{"type":"text","text":"page, adds one to the byline where the article’s template has a"},{"type":"text","text":" "},{"type":"text","text":"commenting widget, labels them with the comment count, and introduces"},{"type":"text","text":" "},{"type":"text","text":"them with a tooltip. It asks its commenting delegate for each of these,"},{"type":"text","text":" "},{"type":"text","text":"so your reader screen becomes that delegate and forwards each call to a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultCommentingProvider"},{"type":"text","text":", as the prebuilt reader does."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the prebuilt UI? See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the provider to "},{"code":"ReaderScreenViewController","type":"codeVoice"},{"type":"text","text":", the reader screen from"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader"},{"type":"text","text":", as a stored property, so it lives as long as"},{"type":"text","text":" "},{"type":"text","text":"the screen does:"}]},{"copyToClipboard":true,"wrap":0,"lineAnnotations":[],"type":"codeListing","showLineNumbers":false,"syntax":"swift","code":["private let commenting = DefaultCommentingProvider(","    service: CoralCommentingService(domain: \"talk.example.com\"),","    accentColor: .systemBlue,","    fontFamily: .systemFont(ofSize: 16),","    onCommentButtonTapped: { article, page, source, 