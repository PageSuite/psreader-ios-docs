eaderViewController\/CommentingDelegate-swift.protocol"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"smaller protocol than the prebuilt UI’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CommentingDelegate"},{"text":": it has no","type":"text"},{"text":" ","type":"text"},{"text":"edition parameter, and a count is optional. Conform in an extension, in","type":"text"},{"text":" ","type":"text"},{"text":"the same file as the class, and forward each call to the provider with","type":"text"},{"text":" ","type":"text"},{"text":"the screen’s ","type":"text"},{"code":"source","type":"codeVoice"},{"text":":","type":"text"}]},{"copyToClipboard":true,"wrap":0,"lineAnnotations":[],"type":"codeListing","code":["extension ReaderScreenViewController: PSEditionReaderViewController.CommentingDelegate {","","    func isCommentingEnabled(article: PSEArticle) -> Bool {","        guard let source else {","            return false","        }","        return commenting.isCommentingEnabled(article: article, inEdition: source)","    }","","    func commentButtonView(forArticle article: PSEArticle, onTap: @escaping () -> Void) -> UIView? {","        guard let source else {","            return nil","        }","        return commenting.commentButton(forArticle: article, inEdition: source, onTap: onTap)","    }","","    func commentButtonTapped(forArticle article: PSEArticle, onPage page: PSEPage, from viewController: UIViewController) {","        guard let source else {","            return","        }","        commenting.commentButtonTapped(forArticle: article, onPage: page, inEdition: source, from: viewController)","    }","","    func fetchCommentCount(forArticle article: PSEArticle, completion: @escaping (Int?) -> Void) {","        guard let source else {","            return completion(nil)","        }","        commenting.fetchCommentCount(forArticle: article, inEdition: source, cacheStrategy: .preferNetwork) { result in","            completion(try? result.get())","        }","    }","","    func articleCommentTooltipViewController() -> UIViewController? {","        guard let source else {","            return nil","        }","        return commenting.articleCommentTooltipViewController(inEdition: source)","    }","}"],"syntax":"swift","showLineNumbers":false},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reader asks only once an edition is open, so "},{"code":"source","type":"codeVoice"},{"type":"text","text":" is always set"},{"type":"text","text":" "},{"type":"text","text":"by then. In Swift 6 language mode, mark the conformance"},{"type":"text","text":" "},{"type":"codeVoice","code":"@preconcurrency"},{"type":"text","text":"; see "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Swift-6-Language-Mode","isActive":true},{"type":"text","text":". The buttons’ counts use "},{"type":"codeVoice","code":".preferNetwork"},{"type":"text","text":", as in the prebuilt"},{"type":"text","text":" "},{"type":"text","text":"reader, so the count on the page is fresh; if the fetch fails, the"},{"type":"text","text":" "},{"type":"text","text":"provider falls back to the count it cached."}]},{"level":2,"type":"heading","anchor":"Prefetching-Counts","text":"Prefetching Counts"},{"inlineContent":[{"type":"text","text":"The prebuilt reader clears the provider’s cache and prefetches the"},{"type":"text","text":" "},{"type":"text","text":"edition’s counts each time it opens an edition. In "},{"type":"codeVoice","code":"show(_:at:)"},{"type":"text","text":", add:"}],"type":"paragraph"},{"copyToClipboard":true,"wrap":0,"lineAnnotations":[],"type":"codeListing","showLineNumbers":false,"code":["commenting.clearCache()","let articles = (source.edition.pages ?? []).flatMap { $0.articles ?? [] }","commenting.prefetchCommentCounts(forArticles: articles, inEdition: source, completion: nil)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The provider passes its service only the articles that take comments, in"},{"type":"text","text":" "},{"type":"text","text":"one call. The cache it fills answers your page browser at once (see"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons#Showing-Counts-in-Your-Page-Browser","type":"reference","isActive":true},{"type":"text","text":"); the buttons on the page"},{"type":"text","text":" "},{"type":"text","text":"fetch their own counts either way."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"What-the-Reader-Draws","text":"What the Reader Draws"},{"inlineContent":[{"type":"text","text":"The reader offers commenting for the first article on each templated page"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"isCommentingEnabled(article:)"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":". PDF pages show no"},{"type":"text","text":" "},{"type":"text","text":"buttons."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The footer button"}]},{"type":"text","text":" is the view your delegate returns. The reader pins"},{"type":"text","text":" "},{"type":"text","text":"it full width to the bottom of the page and insets the page above it."},{"type":"text","text":" "},{"type":"text","text":"With a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEScrollCollapseController"},{"type":"text","text":" attached, it slides away with your"},{"type":"text","text":" "},{"type":"text","text":"chrome; see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Collapsing-Chrome-on-Scroll"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"The byline button","type":"text"}]},{"type":"text","text":" appears in templates with a commenting widget. The"},{"type":"text","text":" "},{"type":"text","text":"template draws it, and the reader sets its text."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The labels","type":"text"}],"type":"strong"},{"text":" change as each count arrives, through the commenting","type":"text"},{"text":" ","type":"text"},{"text":"localization keys (see ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Commenting#Localization","type":"reference","isActive":true},{"text":"). The reader","type":"text"},{"type":"text","text":" "},{"type":"text","text":"relabels the footer button only if it adopts "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CommentingButtonView","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultCommentingButton","type":"reference","isActive":true},{"text":" does.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"The tooltip","type":"text"}],"type":"strong"},{"text":" appears as a popover above the footer button once the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"page is in view. The provider returns it only until it has been seen."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tap on either button reaches "},{"type":"codeVoice","code":"commentButtonTapped"},{"type":"text","text":", and through it the"},{"type":"text","text":" "},{"text":"provider’s ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultCommentingProvider\/onCommentButtonTapped","isActive":true,"type":"reference"},{"text":". To 