       PSReader.initialize(apiKey: \"API_KEY\")","        return true","    }","}"],"lineAnnotations":[],"wrap":0,"syntax":"swift","copyToClipboard":true,"type":"codeListing","showLineNumbers":false},{"type":"paragraph","inlineContent":[{"type":"text","text":"The snippets in these docs put your first screen in the window your"},{"type":"text","text":" "},{"type":"text","text":"scene delegate creates. Xcode’s App template gives you a scene delegate"},{"text":" ","type":"text"},{"type":"text","text":"and names it in Info.plist’s Application Scene Manifest; this is the"},{"text":" ","type":"text"},{"text":"minimal version:","type":"text"}]},{"code":["import UIKit","","final class SceneDelegate: UIResponder, UIWindowSceneDelegate {","","    var window: UIWindow?","","    func scene(","        _ scene: UIScene,","        willConnectTo session: UISceneSession,","        options connectionOptions: UIScene.ConnectionOptions","    ) {","        guard let windowScene = scene as? UIWindowScene else { return }","","        let window = UIWindow(windowScene: windowScene)","        window.rootViewController = UIViewController()   \/\/ Your first screen; see below.","        window.makeKeyAndVisible()","        self.window = window","    }","}"],"lineAnnotations":[],"wrap":0,"syntax":"swift","copyToClipboard":true,"type":"codeListing","showLineNumbers":false},{"type":"paragraph","inlineContent":[{"text":"Everything the SDK offers, from the prebuilt carousel to the core SDK’s","type":"text"},{"text":" ","type":"text"},{"text":"page renderer, is in the one ","type":"text"},{"code":"PSReader","type":"codeVoice"},{"text":" module. Once it’s initialized,","type":"text"},{"text":" ","type":"text"},{"text":"continue with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Prebuilt-UI"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"},{"text":";","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Getting-Started#Choose-Prebuilt-or-Custom-UI"},{"text":" shows where each one starts.","type":"text"}]},{"type":"heading","text":"Requirements","level":2,"anchor":"Requirements"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"iOS 13 or later.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"An API key and an account GUID from PageSuite, plus either a shortcode","type":"text"},{"text":" ","type":"text"},{"text":"or the publication GUIDs of the titles you’ll show. ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Identifiers","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"explains each one.","type":"text"}],"type":"paragraph"}]}]},{"text":"Install the SDK","anchor":"Install-the-SDK","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The SDK is a binary framework, ","type":"text"},{"code":"PSReader.xcframework","type":"codeVoice"},{"text":". It depends on the","type":"text"},{"text":" ","type":"text"},{"text":"Apryse SDK, which renders PDF pages.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Swift Package Manager","type":"text"}]}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, choose File > Add Package Dependencies.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Enter ","type":"text"},{"code":"https:\/\/github.com\/PageSuite\/psreader-swift-package.git","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose Exact Version as the dependency rule, and enter the version.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"PSReaderSDK","type":"codeVoice"},{"text":" product to your app target.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The package brings in the Apryse SDK for you. In a ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}]},{"type":"codeListing","copyToClipboard":true,"syntax":"swift","showLineNumbers":false,"wrap":0,"lineAnnotations":[],"code":[".package(url: \"https:\/\/github.com\/PageSuite\/psreader-swift-package.git\", exact: \"26.8.0\")","","\/\/ In your target's dependencies:",".product(name: \"PSReaderSDK\", package: \"psreader-swift-package\")"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"CocoaPods","type":"text"}],"type":"strong"}]},{"inlineContent":[{"type":"text","text":"The pod is "},{"type":"codeVoice","code":"PSReaderUI2"},{"type":"text","text":", in PageSuite’s specs repository. Add the Apryse"},{"type":"text","text":" "},{"type":"text","text":"pods from their podspecs:"}],"type":"paragraph"},{"code":["source 'https:\/\/github.com\/PageSuite\/psreader-specs.git'","source 'https:\/\/cdn.cocoapods.org\/'","","target 'YourApp' do","  use_frameworks!","","  pod 'PDFTron', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron\/11.5.0.85515.podspec'","  pod 'PDFTronTools', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron-tools\/11.5.0.85515.podspec'","  pod 'PSReaderUI2', '26.8.0'","end"],"syntax":"ruby","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"inlineContent":[{"type":"text","text":"Either way, your code imports one module: "},{"type":"codeVoice","code":"import PSReader"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Manual Installation","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drag these frameworks into your project, and