{"kind":"article","identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Getting-Started","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Choosing-an-Integration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Reader-App","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Using-the-SDK-With-AI-Agents"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/getting-started"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/getting-started"]}],"metadata":{"modules":[{"name":"PSReader"}],"title":"Getting Started","roleHeading":"Guide","role":"collectionGroup"},"abstract":[{"text":"Install the SDK, initialize it, and continue with the prebuilt UI or a custom UI.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Add the PSReader package to your app, then initialize the SDK with your","type":"text"},{"text":" ","type":"text"},{"text":"API key in your app delegate, at launch:","type":"text"}]},{"code":["import PSReader","import UIKit","","@main","final class AppDelegate: UIResponder, UIApplicationDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","        PSReader.initialize(apiKey: \"API_KEY\")","        return true","    }","}"],"showLineNumbers":false,"wrap":0,"syntax":"swift","copyToClipboard":true,"type":"codeListing","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The snippets in these docs put your first screen in the window your"},{"type":"text","text":" "},{"type":"text","text":"scene delegate creates. Xcode’s App template gives you a scene delegate"},{"type":"text","text":" "},{"type":"text","text":"and names it in Info.plist’s Application Scene Manifest; this is the"},{"type":"text","text":" "},{"type":"text","text":"minimal version:"}]},{"code":["import UIKit","","final class SceneDelegate: UIResponder, UIWindowSceneDelegate {","","    var window: UIWindow?","","    func scene(","        _ scene: UIScene,","        willConnectTo session: UISceneSession,","        options connectionOptions: UIScene.ConnectionOptions","    ) {","        guard let windowScene = scene as? UIWindowScene else { return }","","        let window = UIWindow(windowScene: windowScene)","        window.rootViewController = UIViewController()   \/\/ Your first screen; see below.","        window.makeKeyAndVisible()","        self.window = window","    }","}"],"showLineNumbers":false,"wrap":0,"syntax":"swift","copyToClipboard":true,"type":"codeListing","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Everything the SDK offers, from the prebuilt carousel to the core SDK’s"},{"text":" ","type":"text"},{"text":"page renderer, is in the one ","type":"text"},{"code":"PSReader","type":"codeVoice"},{"text":" module. Once it’s initialized,","type":"text"},{"text":" ","type":"text"},{"text":"continue with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Prebuilt-UI","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI","type":"reference"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Getting-Started#Choose-Prebuilt-or-Custom-UI","isActive":true},{"type":"text","text":" shows where each one starts."}]},{"level":2,"text":"Requirements","type":"heading","anchor":"Requirements"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Xcode 27.2 or later.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"iOS 15 or later."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An API key and an account GUID from PageSuite, plus either a shortcode"},{"type":"text","text":" "},{"type":"text","text":"or the publication GUIDs of the titles you’ll show. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Identifiers"},{"type":"text","text":" "},{"type":"text","text":"explains each one."}]}]}]},{"level":2,"text":"Install the SDK","type":"heading","anchor":"Install-the-SDK"},{"inlineContent":[{"type":"text","text":"The SDK is a binary framework, "},{"type":"codeVoice","code":"PSReader.xcframework"},{"type":"text","text":". It depends on the"},{"type":"text","text":" "},{"text":"Apryse SDK, which renders PDF pages.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Swift Package Manager"}],"type":"strong"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, choose File > Add Package Dependencies.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enter ","type":"text"},{"code":"https:\/\/github.com\/PageSuite\/psreader-swift-package.git","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Choose Exact Version as the dependency rule, and enter the version.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"PSReaderSDK","type":"codeVoice"},{"text":" product to your app target.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package brings in the Apryse SDK for you. In a "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"code":[".package(url: \"https:\/\/github.com\/PageSuite\/psreader-swift-package.git\", exact: \"26.9.0\")","","\/\/ In your target's dependencies:",".product(name: \"PSReaderSDK\", package: \"psreader-swift-package\")"],"showLineNumbers":false,"wrap":0,"copyToClipboard":true,"syntax":"swift","type":"codeListing","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"CocoaPods","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"The pod is ","type":"text"},{"code":"PSReaderUI2","type":"codeVoice"},{"text":", in PageSuite’s specs repository. Add the Apryse","type":"text"},{"text":" ","type":"text"},{"text":"pods from their podspecs. Those declare iOS 10, which Xcode 27 can’t build","type":"text"},{"text":" ","type":"text"},{"text":"for, so the ","type":"text"},{"code":"post_install","type":"codeVoice"},{"text":" hook raises them to iOS 15:","type":"text"}]},{"code":["platform :ios, '15.0'","","source 'https:\/\/github.com\/PageSuite\/psreader-specs.git'","source 'https:\/\/cdn.cocoapods.org\/'","","target 'YourApp' do","  use_frameworks!","","  pod 'PDFTron', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron\/11.5.0.85515.podspec'","  pod 'PDFTronTools', podspec: 'https:\/\/www.pdftron.com\/downloads\/ios\/cocoapods\/xcframeworks\/pdftron-tools\/11.5.0.85515.podspec'","  pod 'PSReaderUI2', '26.9.0'","end","","post_install do |installer|","  installer.pods_project.targets.each do |target|","    target.build_configurations.each do |config|","      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0","        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'","      end","    end","  end","end"],"lineAnnotations":[],"copyToClipboard":true,"syntax":"ruby","type":"codeListing","wrap":0,"showLineNumbers":false},{"type":"paragraph","inlineContent":[{"type":"text","text":"Either way, your code imports one module: "},{"code":"import PSReader","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual Installation","type":"text"}]}],"type":"paragraph"},{"inlineContent":[{"text":"Drag these frameworks into your project, and set each one to ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed &"},{"type":"text","text":" "},{"type":"text","text":"Sign"}],"type":"strong"},{"text":" in your app target’s General settings:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"PSReader.xcframework"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"PDFNet.xcframework"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Tools.xcframework"},{"type":"text","text":", from the Apryse SDK"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The SDK is tested against Apryse 11.5.0.85515. Use that version if you","type":"text"},{"text":" ","type":"text"},{"text":"add Apryse yourself.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A clean build of your app shows a few deprecation warnings about"},{"type":"text","text":" "},{"code":"UIMenuController","type":"codeVoice"},{"type":"text","text":", from the headers of Apryse’s Tools framework. They"},{"type":"text","text":" "},{"type":"text","text":"come from Apryse’s code, not yours, and don’t affect the reader."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Versions"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Versions follow the calendar, as "},{"type":"strong","inlineContent":[{"text":"year.month.patch","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"26.1.0"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"first January 2026 release. They don’t follow semantic versioning, so a"},{"type":"text","text":" "},{"type":"text","text":"release can change the API without a major version bump. Pin an exact"},{"type":"text","text":" "},{"type":"text","text":"version, and read the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Change-Log","isActive":true},{"type":"text","text":" before you move to a new one."}]},{"text":"Initialize the SDK","type":"heading","level":2,"anchor":"Initialize-the-SDK"},{"inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/initialize(apiKey:completion:)","type":"reference","isActive":true},{"text":" once, at launch, as the snippet","type":"text"},{"text":" ","type":"text"},{"text":"above does, and carry on: there’s no need to wait for it or to pass a","type":"text"},{"text":" ","type":"text"},{"text":"completion. It sets your API key and prepares the PDF engine in the","type":"text"},{"text":" ","type":"text"},{"text":"background, and the SDK waits for it wherever it needs to, on both","type":"text"},{"text":" ","type":"text"},{"text":"sides. Calling it again is harmless.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Always pass your key. With "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the default, the call only prepares"},{"type":"text","text":" "},{"type":"text","text":"the PDF engine: it sets no key, and calls "},{"code":"completion","type":"codeVoice"},{"type":"text","text":" at once with"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":". "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/initialize(apiKey:)","isActive":true},{"type":"text","text":" is the same call as an "},{"code":"async","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"function."}],"type":"paragraph"},{"text":"Choose Prebuilt or Custom UI","type":"heading","level":2,"anchor":"Choose-Prebuilt-or-Custom-UI"},{"inlineContent":[{"text":"With the SDK initialized, decide who builds the interface. Both sides","type":"text"},{"text":" ","type":"text"},{"text":"show every edition on PageSuite’s current system, classic PDF and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"responsive alike, and one app can use both."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"The prebuilt UI","type":"text"}],"type":"strong"},{"type":"text","text":" is a complete reader app you configure and brand."},{"type":"text","text":" "},{"type":"text","text":"These lines, in your scene delegate in place of the placeholder root"},{"type":"text","text":" "},{"type":"text","text":"view controller, show your publications’ archives and open editions in"},{"type":"text","text":" "},{"type":"text","text":"the prebuilt reader:"}],"type":"paragraph"},{"showLineNumbers":false,"copyToClipboard":true,"syntax":"swift","lineAnnotations":[],"type":"codeListing","wrap":0,"code":["let globalConfig = GlobalConfiguration(apiKey: \"API_KEY\", accountGUID: \"ACCOUNT_GUID\")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [.dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")]",")","window.rootViewController = carousel"]},{"inlineContent":[{"type":"text","text":"Continue with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Prebuilt-UI"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"A custom UI"}],"type":"strong"},{"text":" is your own interface on the core SDK. You fetch the","type":"text"},{"text":" ","type":"text"},{"text":"catalog, open an edition, and host the SDK’s page renderer in screens you","type":"text"},{"text":" ","type":"text"},{"text":"design. It starts with a request like this one:","type":"text"}],"type":"paragraph"},{"code":["let service = FeedEditionService(accountGUID: \"ACCOUNT_GUID\")","let latest = try await service.latestEdition(publicationGUID: \"PUBLICATION_GUID\")"],"showLineNumbers":false,"wrap":0,"copyToClipboard":true,"syntax":"swift","type":"codeListing","lineAnnotations":[]},{"inlineContent":[{"type":"text","text":"Continue with "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Not sure which fits? "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Choosing-an-Integration","isActive":true},{"type":"text","text":" compares them, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Reader-App","isActive":true},{"type":"text","text":" runs both in one sample project. To set up a"},{"text":" ","type":"text"},{"text":"coding agent first, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Using-the-SDK-With-AI-Agents","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Prepare for App Store Submission","type":"heading","anchor":"Prepare-for-App-Store-Submission","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Export compliance."}]},{"type":"text","text":" The SDK uses no non-standard encryption and doesn’t"},{"type":"text","text":" "},{"type":"text","text":"affect your export compliance answers."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Privacy.","type":"text"}]},{"type":"text","text":" The SDK collects no private information and doesn’t affect"},{"type":"text","text":" "},{"type":"text","text":"your privacy answers."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Info.plist keys."}],"type":"strong"},{"type":"text","text":" The SDK renders PDF pages with the Apryse library,"},{"type":"text","text":" "},{"type":"text","text":"which needs these usage descriptions in your app’s Info.plist. Word them"},{"type":"text","text":" "},{"type":"text","text":"for your app:"}]},{"code":["<key>NSCameraUsageDescription<\/key>","<string>This will allow you to use the image from your camera.<\/string>","<key>NSPhotoLibraryAddUsageDescription<\/key>","<string>This will allow you to add images to your photo library.<\/string>","<key>NSPhotoLibraryUsageDescription<\/key>","<string>This will allow you to create signatures and annotations from images in your photo library.<\/string>","<key>NSBluetoothAlwaysUsageDescription<\/key>","<string>This will allow us to detect if an Apple Pencil is paired, enabling palm rejection and the ability to scroll with one finger while annotating.<\/string>","<key>NSBluetoothPeripheralUsageDescription<\/key>","<string>This will allow us to detect if an Apple Pencil is paired, enabling palm rejection and the ability to scroll with one finger while annotating.<\/string>"],"showLineNumbers":false,"wrap":0,"copyToClipboard":true,"syntax":"xml","type":"codeListing","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the "},{"identifier":"https:\/\/docs.apryse.com\/ios\/guides\/get-started\/integration?tab=spm","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"for details."}]}]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/initialize(apiKey:)","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/initialize(apiKey:completion:)"],"title":"Initializing the SDK","anchor":"Initializing-the-SDK"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader"]]},"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/Identifiers":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Identifiers","url":"\/documentation\/psreader\/identifiers","a