{"metadata":{"role":"collectionGroup","modules":[{"name":"PSReader"}],"title":"Fetching the Archive","roleHeading":"Guide"},"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Fetching-the-Archive","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/fetching-the-archive"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/fetching-the-archive"]}],"seeAlsoSections":[{"anchor":"Your-Reader","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Page-Browser"],"title":"Your Reader","generated":true}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Load a publication’s editions and draw your own archive screen.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService","isActive":true},{"text":" lists the editions a publication has published,","type":"text"},{"text":" ","type":"text"},{"text":"newest first. Each entry is a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished","isActive":true},{"text":": it carries the cover image,","type":"text"},{"text":" ","type":"text"},{"text":"name, and date an archive cell shows, and it opens straight into the","type":"text"},{"text":" ","type":"text"},{"text":"reader. The catalog works the same for every publication on PageSuite’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"current edition system, whether its editions are classic PDF pages,"},{"type":"text","text":" "},{"type":"text","text":"responsive pages, or a mix of both."}]},{"code":["import PSReader","","let service = FeedEditionService(accountGUID: \"ACCOUNT_GUID\")","let archive = try await service.publishedEditions(","    publicationGUID: \"PUBLICATION_GUID\",","    publicationName: \"The Daily\"",")","","for day in archive {","    for published in day.editions ?? [] {","        print(published.name, published.image)","    }","}"],"type":"codeListing","lineAnnotations":[],"copyToClipboard":true,"syntax":"swift","wrap":0,"showLineNumbers":false},{"inlineContent":[{"text":"Using the prebuilt UI? Its archive comes ready-made; see","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Setting-Up-the-Carousel","isActive":true},{"text":". For where the account and publication GUIDs","type":"text"},{"text":" ","type":"text"},{"text":"come from, see ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Identifiers","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Initialize the SDK","level":2,"anchor":"Initialize-the-SDK","type":"heading"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/initialize(apiKey:completion:)","isActive":true},{"type":"text","text":" once at launch, as"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Getting-Started","isActive":true,"type":"reference"},{"text":" shows. You don’t need to wait for it before you load the catalog.","type":"text"}],"type":"paragraph"},{"text":"Load the Catalog","level":2,"type":"heading","anchor":"Load-the-Catalog"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create one "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService"},{"type":"text","text":" for your account and ask it for a"},{"text":" ","type":"text"},{"text":"publication’s catalog by ","type":"text"},{"type":"strong","inlineContent":[{"text":"publication GUID","type":"text"}]},{"text":", with the publication’s","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"name:"}]},{"type":"codeListing","code":["let service = FeedEditionService(accountGUID: \"ACCOUNT_GUID\")","let archive = try await service.publishedEditions(","    publicationGUID: \"PUBLICATION_GUID\",","    publicationName: \"The Daily\"",")"],"lineAnnotations":[],"wrap":0,"copyToClipboard":true,"showLineNumbers":false,"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The result is an array of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublishedDate"},{"type":"text","text":" groups, newest first: each"},{"type":"text","text":" "},{"type":"text","text":"group’s "},{"code":"editions","type":"codeVoice"},{"type":"text","text":" are the editions published on its "},{"code":"date","type":"codeVoice"},{"type":"text","text":", ready to"},{"type":"text","text":" "},{"type":"text","text":"render as a dated grid. Editions published on the same day come in the"},{"type":"text","text":" "},{"type":"text","text":"backend’s order; sort them yourself, by "},{"code":"datePublished","type":"codeVoice"},{"type":"text","text":" for example, if"},{"type":"text","text":" "},{"type":"text","text":"your grid needs a particular order."}],"type":"paragraph"},{"inlineContent":[{"text":"The catalog doesn’t carry the publication’s name, so the service copies","type":"text"},{"text":" ","type":"text"},{"text":"the name you pass onto each edition’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/publicationName","isActive":true},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Your reader screen shows it as its title (see"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Presenting-the-Screen","type":"reference"},{"text":"); without it, the property","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is empty."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For a “read the latest issue” entry point, skip the grouping:","type":"text"}]},{"code":["let latest = try await service.latestEdition(","    publicationGUID: \"PUBLICATION_GUID\",","    publicationName: \"The Daily\"",")"],"type":"codeListing","lineAnnotations":[],"copyToClipboard":true,"syntax":"swift","wrap":0,"showLineNumbers":false},{"type":"paragraph","inlineContent":[{"text":"An archive you’ve already fetched gives the same answer through","type":"text"},{"text":" ","type":"text"},{"code":"archive.latestEdition","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Draw the Covers","type":"heading","anchor":"Draw-the-Covers","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished"},{"type":"text","text":" carries what an archive cell shows:"}]},{"code":["cell.title = published.name","cell.date = published.editionDate ?? published.datePublished","cell.coverURL = URL(string: published.image)   \/\/ the cover thumbnail"],"type":"codeListing","lineAnnotations":[],"copyToClipboard":true,"syntax":"swift","wrap":0,"showLineNumbers":false},{"type":"paragraph","inlineContent":[{"type":"text","text":"To show the date the way the prebuilt archive does, format it with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultEditionDateFormatter","isActive":true},{"type":"text","text":". Some editions are named rather than"},{"type":"text","text":" "},{"text":"dated, such as a special issue. When","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/useCustomEditionName","type":"reference"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", show the ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" where","type":"text"},{"text":" ","type":"text"},{"text":"you’d otherwise show the date.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Tapping a cell opens the edition in your reader screen:","type":"text"},{"text":" ","type":"text"},{"code":"ReaderScreenViewController(published:)","type":"codeVoice"},{"text":", from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"opens it with progress. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition","type":"reference"},{"text":" covers the other ways to","type":"text"},{"text":" ","type":"text"},{"text":"open one. To badge editions that are saved for offline reading, check","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager\/isDownloaded(published:)","type":"reference"},{"text":"; see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Handle-Errors-and-Offline-Use","text":"Handle Errors and Offline Use"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The catalog keeps working offline. When the request fails, the service"},{"type":"text","text":" "},{"type":"text","text":"answers with its cached copy of the last catalog it fetched for that"},{"type":"text","text":" "},{"type":"text","text":"publication, when it still has one. With nothing cached to fall back on, it"},{"type":"text","text":" "},{"text":"throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionServiceError\/invalidResponse","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/latestEdition(publicationGUID:publicationName:publishedDomain:)"},{"text":" ","type":"text"},{"text":"throws ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionServiceError\/editionNotFound"},{"text":" when the publication has","type":"text"},{"text":" ","type":"text"},{"text":"nothing published yet. The date-range listing","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Fetching-the-Archive#Browse-by-Date"},{"text":") has no offline fallback: it passes transport","type":"text"},{"text":" ","type":"text"},{"text":"errors, such as ","type":"text"},{"code":"URLError","type":"codeVoice"},{"text":" when the device is offline, through unchanged.","type":"text"}]},{"level":2,"type":"heading","text":"Browse by Date","anchor":"Browse-by-Date"},{"type":"paragraph","inlineContent":[{"text":"A month picker over a long archive shouldn’t load the whole catalog. Ask","type":"text"},{"text":" ","type":"text"},{"text":"for a range of calendar days instead:","type":"text"}]},{"code":["let page = try await service.publishedEditions(","    publicationGUID: \"PUBLICATION_GUID\",","    publicationName: \"The Daily\",","    startDate: \"2026-09-01\",","    endDate: \"2026-09-30\",","    pageSize: 100",")","let days = page.dates ?? []"],"type":"codeListing","lineAnnotations":[],"copyToClipboard":true,"syntax":"swift","wrap":0,"showLineNumbers":false},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both days are inclusive, written "},{"type":"codeVoice","code":"yyyy-MM-dd"},{"type":"text","text":", and read in the"},{"type":"text","text":" "},{"type":"text","text":"publication’s time zone. Results are paged by publishing date, not by"},{"type":"text","text":" "},{"type":"text","text":"edition: "},{"type":"codeVoice","code":"pageSize"},{"type":"text","text":" counts "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublishedDate"},{"type":"text","text":" groups, from 1 to 100"},{"type":"text","text":" "},{"type":"text","text":"(25 by default), so a calendar month always fits in one page of 100. For"},{"type":"text","text":" "},{"type":"text","text":"longer ranges, keep requesting the next "},{"type":"codeVoice","code":"pageNumber"},{"type":"text","text":" while"},{"type":"text","text":" "},{"type":"codeVoice","code":"page.pagination?.hasNext == true"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A range without editions returns an empty page, and so does a day the"},{"type":"text","text":" "},{"type":"text","text":"backend can’t read or an "},{"type":"codeVoice","code":"endDate"},{"type":"text","text":" before "},{"type":"codeVoice","code":"startDate"},{"type":"text","text":". Every field of the"},{"type":"text","text":" "},{"type":"text","text":"page is optional, so one malformed field never discards the rest. As with"},{"type":"text","text":" "},{"type":"text","text":"the full catalog, pass "},{"type":"codeVoice","code":"publicationName"},{"type":"text","text":" and the service sets it on each"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished","type":"reference","isActive":true},{"type":"text","text":"."}]},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"The date-range listing serves publications on PageSuite’s v1","type":"text"},{"text":" ","type":"text"},{"text":"publications API. For any other publication it throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionServiceError\/publicationNotFound","isActive":true,"type":"reference"},{"text":", even though the full","type":"text"},{"text":" ","type":"text"},{"text":"catalog loads. Catch that error and fall back to the full catalog,","type":"text"},{"text":" ","type":"text"},{"text":"filtering its editions by ","type":"text"},{"type":"codeVoice","code":"datePublished"},{"text":".","type":"text"}]}],"type":"aside"},{"type":"heading","text":"Listing One Month","level":3,"anchor":"Listing-One-Month"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a month picker, ask for the month’s first and last days, written as"},{"type":"text","text":" "},{"type":"codeVoice","code":"yyyy-MM-dd"},{"type":"text","text":". Publications the date-range listing doesn’t serve throw"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionServiceError\/publicationNotFound"},{"type":"text","text":"; for those, filter the"},{"type":"text","text":" "},{"type":"text","text":"full archive instead:"}]},{"syntax":"swift","type":"codeListing","lineAnnotations":[],"showLineNumbers":false,"copyToClipboard":true,"code":["func editions(inMonthOf month: Date) async throws -> [PSEPublished] {","    var calendar = Calendar(identifier: .gregorian)","    calendar.timeZone = .current","","    let formatter = DateFormatter()","    formatter.calendar = calendar","    formatter.locale = Locale(identifier: \"en_US_POSIX\")","    formatter.dateFormat = \"yyyy-MM-dd\"","","    guard let interval = calendar.dateInterval(of: .month, for: month),","          let lastDay = calendar.date(byAdding: .day, value: -1, to: interval.end) else {","        return []","    }","","    do {","        let page = try await service.publishedEditions(","            publicationGUID: \"PUBLICATION_GUID\",","            publicationName: \"The Daily\",","            startDate: formatter.string(from: interval.start),","            endDate: formatter.string(from: lastDay),","            pageSize: 100","        )","        return (page.dates ?? []).flatMap { $0.editions ?? [] }","    } catch FeedEditionServiceError.publicationNotFound {","        let archive = try await service.publishedEditions(","            publicationGUID: \"PUBLICATION_GUID\",","            publicationName: \"The Daily\"","        )","        return archive.flatMap { $0.editions ?? [] }.filter { published in","            guard let date = published.editionDate ?? published.datePublished else { return false }","            return calendar.isDate(date, equalTo: month, toGranularity: .month)","        }","    }","}"],"wrap":0},{"type":"heading","text":"Combine Several Publications","level":2,"anchor":"Combine-Several-Publications"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An account can host several publications. There’s no separate"},{"type":"text","text":" "},{"type":"text","text":"multi-publication call; compose one from the service. Fetch per publication"},{"type":"text","text":" "},{"type":"text","text":"GUID, then lay the results out however your product needs: a kiosk grid of"},{"type":"text","text":" "},{"type":"text","text":"latest covers, a combined list, or a tab per title."}]},{"syntax":"swift","type":"codeListing","lineAnnotations":[],"showLineNumbers":false,"copyToClipboard":true,"code":["let publications = [","    (guid: \"PUBLICATION_GUID\", name: \"The Daily\"),","    (guid: \"WEEKEND_PUBLICATION_GUID\", name: \"The Weekend\")","]","","let latestCovers = try await withThrowingTaskGroup(of: (String, PSEPublished).self) { group in","    for publication in publications {","        group.addTask {","            let latest = try await service.latestEdition(","                publicationGUID: publication.guid,","                publicationName: publication.name","            )","            return (publication.guid, latest)","        }","    }","    return try await group.reduce(into: [String: PSEPublished]()) { $0[$1.0] = $1.1 }","}"],"wrap":0},{"type":"heading","text":"Show Supplements","level":2,"anchor":"Show-Supplements"},{"type":"paragraph","inlineContent":[{"text":"A publication’s supplements are grouped in PageSuite as a publication","type":"text"},{"text":" ","type":"text"},{"text":"group. ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PublicationGroupService","isActive":true,"type":"reference"},{"type":"text","text":" lists the latest edition of each"},{"type":"text","text":" "},{"type":"text","text":"publication in a group, with a cover rendered at the width you ask for."},{"type":"text","text":" "},{"type":"text","text":"The listing only identifies editions, so resolve each one you open with"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/published(forEditionGUID:)","type":"reference","isActive":true},{"type":"text","text":" and fill in the"},{"type":"text","text":" "},{"type":"text","text":"publication from the listing:"}]},{"syntax":"swift","type":"codeListing","lineAnnotations":[],"showLineNumbers":false,"copyToClipboard":true,"code":["let supplements = try await PublicationGroupService().latestEditions(groupGUID: \"SUPPLEMENTS_GROUP_GUID\")","","for supplement in supplements {","    let published = try await service.published(forEditionGUID: supplement.editionGUID)","    published.applicationGUID = supplement.publicationGUID","    published.publicationName = supplement.publicationName","}"],"wrap":0},{"type":"paragraph","inlineContent":[{"type":"text","text":"A group of legacy replica publications, or an unknown GUID, lists nothing."}]},{"text":"Resolve an Edition GUID","type":"heading","anchor":"Resolve-an-Edition-GUID","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Search results and deep links often carry only an edition GUID. Resolve it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/published(forEditionGUID:)","type":"reference"},{"type":"text","text":", which also finds"},{"type":"text","text":" "},{"type":"text","text":"editions older than the catalog returns. The entry it returns has no"},{"type":"text","text":" "},{"type":"text","text":"publication name or publication GUID; see"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition#Opening-From-an-Edition-GUID","type":"reference"},{"type":"text","text":"."}]},{"text":"Load the Content Model","type":"heading","anchor":"Load-the-Content-Model","level":2},{"type":"paragraph","inlineContent":[{"text":"You don’t need the service to read an edition: the reader opens a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished","type":"reference","isActive":true},{"text":" directly (see ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition","type":"reference","isActive":true},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/edition(for:)","type":"reference","isActive":true},{"text":" loads an edition’s full content model,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEdition","type":"reference","isActive":true},{"type":"text","text":", for the rarer case of consuming its pages and articles"},{"type":"text","text":" "},{"type":"text","text":"yourself, such as building your own index or search over them."}]}],"kind":"content"}],"sections":[],"topicSections":[{"anchor":"Fetching-the-Catalog","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService"],"title":"Fetching the Catalog"},{"anchor":"Fetching-Supplements","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PublicationGroupService","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PublicationGroupEdition"],"title":"Fetching Supplements"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/FeedEditionService/latestEdition(publicationGUID:publicationName:publishedDomain:)":{"role":"symbol","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/latestEdition(publicationGUID:publicationName:publishedDomain:)","url":"\/documentation\/psreader\/feededitionservice\/latestedition(publicationguid:publicationname:publisheddomain:)","kind":"symbol","abstract":[{"type":"text","text":"Returns the most recently published edition for a publication."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"latestEdition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"publicationGUID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"publicationName","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"publishedDomain","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","k