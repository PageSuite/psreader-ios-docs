{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Fetching-the-Archive"},"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"metadata":{"title":"Fetching the Archive","modules":[{"name":"PSReader"}],"role":"collectionGroup","roleHeading":"Guide"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService"],"title":"Fetching the Catalog","anchor":"Fetching-the-Catalog"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Page-Browser"],"title":"Your Reader","generated":true,"anchor":"Your-Reader"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/fetching-the-archive"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/fetching-the-archive"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Load a publication’s editions and draw your own archive screen."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService"},{"text":" lists the editions a publication has published,","type":"text"},{"text":" ","type":"text"},{"text":"newest first. Each entry is a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished"},{"text":": it carries the cover image,","type":"text"},{"text":" ","type":"text"},{"text":"name, and date an archive cell shows, and it opens straight into the","type":"text"},{"text":" ","type":"text"},{"text":"reader. The catalog works the same for every publication on PageSuite’s","type":"text"},{"text":" ","type":"text"},{"text":"current edition system, whether its editions are classic PDF pages,","type":"text"},{"text":" ","type":"text"},{"text":"responsive pages, or a mix of both.","type":"text"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","code":["import PSReader","","let service = FeedEditionService(accountGUID: \"ACCOUNT_GUID\")","let archive = try await service.publishedEditions(","    publicationGUID: \"PUBLICATION_GUID\",","    publicationName: \"The Daily\"",")","","for day in archive {","    for published in day.editions ?? [] {","        print(published.name, published.image)","    }","}"],"wrap":0,"copyToClipboard":true,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"text":"Using the prebuilt UI? Its archive comes ready-made; see","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Setting-Up-the-Carousel"},{"text":". For where the account and publication GUIDs","type":"text"},{"text":" ","type":"text"},{"text":"come from, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Identifiers"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Initialize-the-SDK","type":"heading","level":2,"text":"Initialize the SDK"},{"inlineContent":[{"text":"Call ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/initialize(apiKey:completion:)"},{"text":" once at launch, as","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Getting-Started"},{"text":" shows. You don’t need to wait for it before you load the catalog.","type":"text"}],"type":"paragraph"},{"anchor":"Load-the-Catalog","type":"heading","level":2,"text":"Load the Catalog"},{"inlineContent":[{"text":"Create one ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService"},{"text":" for your account and ask it for a","type":"text"},{"text":" ","type":"text"},{"text":"publication’s catalog by ","type":"text"},{"type":"strong","inlineContent":[{"text":"publication GUID","type":"text"}]},{"text":", with the publication’s","type":"text"},{"text":" ","type":"text"},{"text":"name:","type":"text"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","code":["let service = FeedEditionService(accountGUID: \"ACCOUNT_GUID\")","let archive = try await service.publishedEditions(","    publicationGUID: \"PUBLICATION_GUID\",","    publicationName: \"The Daily\"",")"],"wrap":0,"copyToClipboard":true,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"text":"The result is an array of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublishedDate"},{"text":" groups, newest first: each","type":"text"},{"text":" ","type":"text"},{"text":"group’s ","type":"text"},{"code":"editions","type":"codeVoice"},{"text":" are the editions published on its ","type":"text"},{"code":"date","type":"codeVoice"},{"text":", ready to","type":"text"},{"text":" ","type":"text"},{"text":"render as a dated grid. Editions published on the same day come in the","type":"text"},{"text":" ","type":"text"},{"text":"backend’s order; sort them yourself, by ","type":"text"},{"code":"datePublished","type":"codeVoice"},{"text":" for example, if","type":"text"},{"text":" ","type":"text"},{"text":"your grid needs a particular order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The catalog doesn’t carry the publication’s name, so the service copies","type":"text"},{"text":" ","type":"text"},{"text":"the name you pass onto each edition’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/publicationName","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Your reader screen shows it as its title (see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Presenting-the-Screen","type":"reference"},{"text":"); without it, the property","type":"text"},{"text":" ","type":"text"},{"text":"is empty.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For a “read the latest issue” entry point, skip the grouping:","type":"text"}],"type":"paragraph"},{"code":["let latest = try await service.latestEdition(","    publicationGUID: \"PUBLICATION_GUID\",","    publicationName: \"The Daily\"",")"],"wrap":0,"type":"codeListing","syntax":"swift","copyToClipboard":true,"showLineNumbers":false,"lineAnnotations":[]},{"inlineContent":[{"text":"An archive you’ve already fetched gives the same answer through","type":"text"},{"text":" ","type":"text"},{"code":"archive.latestEdition","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Draw-the-Covers","type":"heading","level":2,"text":"Draw the Covers"},{"inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished","type":"reference"},{"text":" carries what an archive cell shows:","type":"text"}],"type":"paragraph"},{"code":["cell.title = published.name","cell.date = published.editionDate ?? published.datePublished","cell.coverURL = URL(string: published.image)   \/\/ the cover thumbnail"],"syntax":"swift","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"inlineContent":[{"text":"To show the date the way the prebuilt archive does, format it with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DefaultEditionDateFormatter","type":"reference"},{"text":". Some editions are named rather than","type":"text"},{"text":" ","type":"text"},{"text":"dated, such as a special issue. When","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/useCustomEditionName","type":"reference"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", show the ","type":"text"},{"type":"codeVoice","code":"name"},{"text":" where","type":"text"},{"text":" ","type":"text"},{"text":"you’d otherwise show the date.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Tapping a cell opens the edition in your reader screen:","type":"text"},{"text":" ","type":"text"},{"code":"ReaderScreenViewController(published:)","type":"codeVoice"},{"text":", from ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"opens it with progress. ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition","isActive":true,"type":"reference"},{"text":" covers the other ways to","type":"text"},{"text":" ","type":"text"},{"text":"open one. To badge editions that are saved for offline reading, check","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager\/isDownloaded(published:)","isActive":true,"type":"reference"},{"text":"; see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Handle Errors and Offline Use","anchor":"Handle-Errors-and-Offline-Use","level":2},{"type":"paragraph","inlineContent":[{"text":"The catalog keeps working offline. When the request fails, the service","type":"text"},{"text":" ","type":"text"},{"text":"answers with its cached copy of the last catalog it fetched for that","type":"text"},{"text":" ","type":"text"},{"text":"publication, when it still has one. With nothing cached to fall back on, it","type":"text"},{"text":" ","type":"text"},{"text":"throws","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionServiceError\/invalidResponse"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/latestEdition(publicationGUID:publicationName:publishedDomain:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"throws "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionServiceError\/editionNotFound","isActive":true},{"type":"text","text":" when the publication has"},{"type":"text","text":" "},{"type":"text","text":"nothing published yet. The date-range listing"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Fetching-the-Archive#Browse-by-Date","isActive":true},{"type":"text","text":") has no offline fallback: it passes transport"},{"type":"text","text":" "},{"type":"text","text":"errors, such as "},{"type":"codeVoice","code":"URLError"},{"type":"text","text":" when the device is offline, through unchanged."}]},{"text":"Browse by Date","level":2,"type":"heading","anchor":"Browse-by-Date"},{"inlineContent":[{"type":"text","text":"A month picker over a long archive shouldn’t load the whole catalog. Ask"},{"type":"text","text":" "},{"type":"text","text":"for a range of calendar days instead:"}],"type":"paragraph"},{"code":["let page = try await service.publishedEditions(","    publicationGUID: \"PUBLICATION_GUID\",","    publicationName: \"The Daily\",","    startDate: \"2026-09-01\",","    endDate: \"2026-09-30\",","    pageSize: 100",")","let days = page.dates ?? []"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"inlineContent":[{"type":"text","text":"Both days are inclusive, written "},{"type":"codeVoice","code":"yyyy-MM-dd"},{"type":"text","text":", and read in the"},{"type":"text","text":" "},{"type":"text","text":"publication’s time zone. Results are paged by publishing date, not by"},{"type":"text","text":" "},{"type":"text","text":"edition: "},{"type":"codeVoice","code":"pageSize"},{"type":"text","text":" counts "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublishedDate","isActive":true,"type":"reference"},{"type":"text","text":" groups, from 1 to 100"},{"type":"text","text":" "},{"type":"text","text":"(25 by default), so a calendar month always fits in one page of 100. For"},{"type":"text","text":" "},{"type":"text","text":"longer ranges, keep requesting the next "},{"type":"codeVoice","code":"pageNumber"},{"type":"text","text":" while"},{"type":"text","text":" "},{"type":"codeVoice","code":"page.pagination?.hasNext == true"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A range without editions returns an empty page, and so does a day the"},{"type":"text","text":" "},{"type":"text","text":"backend can’t read or an "},{"type":"codeVoice","code":"endDate"},{"type":"text","text":" before "},{"type":"codeVoice","code":"startDate"},{"type":"text","text":". Every field of the"},{"type":"text","text":" "},{"type":"text","text":"page is optional, so one malformed field never discards the rest. As with"},{"type":"text","text":" "},{"type":"text","text":"the full catalog, pass "},{"type":"codeVoice","code":"publicationName"},{"type":"text","text":" and the service sets it on each"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The date-range listing serves publications on PageSuite’s v1"},{"type":"text","text":" "},{"type":"text","text":"publications API. For any other publication it throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionServiceError\/publicationNotFound","isActive":true},{"type":"text","text":", even though the full"},{"type":"text","text":" "},{"type":"text","text":"catalog loads. Catch that error and fall back to the full catalog,"},{"type":"text","text":" "},{"type":"text","text":"filtering its editions by "},{"type":"codeVoice","code":"datePublished"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"heading","text":"Listing One Month","anchor":"Listing-One-Month","level":3},{"inlineContent":[{"type":"text","text":"For a month picker, ask for the month’s first and last days, written as"},{"type":"text","text":" "},{"type":"codeVoice","code":"yyyy-MM-dd"},{"type":"text","text":". Publications the date-range listing doesn’t serve throw"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionServiceError\/publicationNotFound","type":"reference","isActive":true},{"type":"text","text":"; for those, filter the"},{"type":"text","text":" "},{"type":"text","text":"full archive instead:"}],"type":"paragraph"},{"code":["func editions(inMonthOf month: Date) async throws -> [PSEPublished] {","    var calendar = Calendar(identifier: .gregorian)","    calendar.timeZone = .current","","    let formatter = DateFormatter()","    formatter.calendar = calendar","    formatter.locale = Locale(identifier: \"en_US_POSIX\")","    formatter.dateFormat = \"yyyy-MM-dd\"","","    guard let interval = calendar.dateInterval(of: .month, for: month),","          let lastDay = calendar.date(byAdding: .day, value: -1, to: interval.end) else {","        return []","    }","","    do {","        let page = try await service.publishedEditions(","            publicationGUID: \"PUBLICATION_GUID\",","            publicationName: \"The Daily\",","            startDate: formatter.string(from: interval.start),","            endDate: formatter.string(from: lastDay),","            pageSize: 100","        )","        return (page.dates ?? []).flatMap { $0.editions ?? [] }","    } catch FeedEditionServiceError.publicationNotFound {","        let archive = try await service.publishedEditions(","            publicationGUID: \"PUBLICATION_GUID\",","            publicationName: \"The Daily\"","        )","        return archive.flatMap { $0.editions ?? [] }.filter { published in","            guard let date = published.editionDate ?? published.datePublished else { return false }","            return calendar.isDate(date, equalTo: month, toGranularity: .month)","        }","    }","}"],"syntax":"swift","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"type":"heading","text":"Combine Several Publications","anchor":"Combine-Several-Publications","level":2},{"inlineContent":[{"type":"text","text":"An account can host several publications. There’s no separate"},{"type":"text","text":" "},{"type":"text","text":"multi-publication call; compose one from the service. Fetch per publication"},{"type":"text","text":" "},{"type":"text","text":"GUID, then lay the results out however your product needs: a kiosk grid of"},{"type":"text","text":" "},{"type":"text","text":"latest covers, a combined list, or a tab per title."}],"type":"paragraph"},{"code":["let publications = [","    (guid: \"PUBLICATION_GUID\", name: \"The Daily\"),","    (guid: \"WEEKEND_PUBLICATION_GUID\", name: \"The Weekend\")","]","","let latestCovers = try await withThrowingTaskGroup(of: (String, PSEPublished).self) { group in","    for publication in publications {","        group.addTask {","            let latest = try await service.latestEdition(","                publicationGUID: publication.guid,","                publicationName: publication.name","            )","            return (publication.guid, latest)","        }","    }","    return try await group.reduce(into: [String: PSEPublished]()) { $0[$1.0] = $1.1 }","}"],"syntax":"swift","lineAnnotations":[],"copyToClipboard":true,"showLineNumbers":false,"type":"codeListing","wrap":0},{"type":"heading","text":"Resolve an Edition GUID","anchor":"Resolve-an-Edition-GUID","level":2},{"inlineContent":[{"type":"text","text":"Search results and deep links often carry only an edition GUID. Resolve it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/published(forEditionGUID:)","type":"reference","isActive":true},{"type":"text","text":", which also finds"},{"type":"text","text":" "},{"type":"text","text":"editions older than the catalog returns. The entry it returns has no"},{"type":"text","text":" "},{"type":"text","text":"publication name or publication GUID; see"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition#Opening-From-an-Edition-GUID","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Load the Content Model","anchor":"Load-the-Content-Model","level":2},{"inlineContent":[{"type":"text","text":"You don’t need the service to read an edition: the reader opens a"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished","type":"reference","isActive":true},{"type":"text","text":" directly (see "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition","type":"reference","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/edition(for:)","type":"reference","isActive":true},{"type":"text","text":" loads an edition’s full content model,"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEdition","type":"reference","isActive":true},{"type":"text","text":", for the rarer case of consuming its pages and articles"},{"type":"text","text":" "},{"type":"text","text":"yourself, such as building your own index or search over them."}],"type":"paragraph"}]}],"kind":"article","references":{"doc://com.pagesuite.PSReader/documentation/PSReader/FeedEditionServiceError/publicationNotFound":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionServiceError\/publicationNotFound","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"publicationNotFound","kind":"identifier"}],"url":"\/documentation\/psreader\/feededitionserviceerror\/publicationnotfound","kind":"symbol","title":"FeedEditionServiceError.publicationNotFound","abstract":[{"text":"The backend does not recognize the publication GUID.","type":"text"}],"type":"topic","role":"symbol"},"doc://com.pagesuite.PSReader/documentation/PSReader/Identifiers":{"title":"Identifiers","kind":"article","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Identifiers","abstract":[{"text":"Know which identifier you have, where it comes from, and where it goes.","type":"text"}],"type":"topic","url":"\/documentation\/psreader\/identifiers","role":"collectionGroup"},"doc://com.pagesuite.PSReader/documentation/PSReader/initialize(apiKey:completion:)":{"kind":"symbol","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/initi