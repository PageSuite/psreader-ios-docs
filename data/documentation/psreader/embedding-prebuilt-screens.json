{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Place the prebuilt archive, bookmarks, downloads, and search screens in your own navigation."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Every screen the carousel shows is also a view controller you can place","type":"text"},{"type":"text","text":" "},{"type":"text","text":"yourself. Each is a plain "},{"type":"codeVoice","code":"UIViewController"},{"type":"text","text":": push it, put it in a tab,"},{"type":"text","text":" "},{"type":"text","text":"or embed it in a screen of your own. Each one opens editions in the"},{"type":"text","text":" "},{"type":"text","text":"prebuilt reader without any work from you."}],"type":"paragraph"},{"code":["import PSReader","import UIKit","","let globalConfig = GlobalConfiguration(apiKey: \"API_KEY\", accountGUID: \"ACCOUNT_GUID\")","","let archive = ArchiveViewController(","    globalConfig: globalConfig,","    archiveType: .feedArchive(guid: \"PUBLICATION_GUID\", publicationName: \"The Daily\")",")","archive.tabBarItem = UITabBarItem(title: \"Editions\", image: UIImage(systemName: \"newspaper\"), tag: 0)","","let bookmarks = BookmarksViewController(globalConfig: globalConfig, type: .all)","bookmarks.tabBarItem = UITabBarItem(title: \"Bookmarks\", image: UIImage(systemName: \"bookmark\"), tag: 1)","","let downloads = DownloadsViewController(globalConfig: globalConfig, downloadTypes: .all)","downloads.tabBarItem = UITabBarItem(title: \"Downloads\", image: UIImage(systemName: \"arrow.down.circle\"), tag: 2)","","let tabBarController = UITabBarController()","tabBarController.viewControllers = [archive, bookmarks, downloads]"],"lineAnnotations":[],"syntax":"swift","copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"View controller"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shows"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"More in"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveViewController","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"One publication’s editions, or a kiosk of publications","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"This guide","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/BookmarksViewController","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The user’s bookmarked pages and articles"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Bookmarks","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DownloadsViewController"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Editions downloaded for offline reading"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Downloads-and-Offline-Reading","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchViewController","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Search across your publications","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Search","isActive":true}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The screens take the same configurations and delegates as the carousel,"},{"text":" ","type":"text"},{"type":"text","text":"so one "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true,"type":"reference"},{"text":" themes them all. To open an edition from your own","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"interface instead, such as a button or a list you design, use"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedReaderViewController","isActive":true},{"type":"text","text":"; see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Presenting-the-Prebuilt-Reader"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"To show every screen at once, in the SDK’s own tabs, see"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Setting-Up-the-Carousel"},{"text":".","type":"text"}]},{"text":"Embedding a Screen","anchor":"Embedding-a-Screen","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"UIKit apps place the screens like any other view controller. In SwiftUI,","type":"text"},{"text":" ","type":"text"},{"text":"wrap one in a ","type":"text"},{"type":"codeVoice","code":"UIViewControllerRepresentable"},{"text":"; its coordinator is a good","type":"text"},{"type":"text","text":" "},{"type":"text","text":"home for delegates that need your app’s state, such as a paywall that"},{"text":" ","type":"text"},{"text":"checks the user’s subscription:","type":"text"}]},{"type":"tabNavigator","tabs":[{"title":"UIKit","content":[{"syntax":"swift","code":["let archive = ArchiveViewController(","    globalConfig: globalConfig,","    archiveType: .feedArchive(guid: \"PUBLICATION_GUID\", publicationName: \"The Daily\")",")","navigationController?.pushViewController(archive, animated: true)"],"lineAnnotations":[],"copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"type":"text","text":"Each screen fills its view, and your navigation bar and tab bar"},{"type":"text","text":" "},{"type":"text","text":"stay yours."}],"type":"paragraph"}]},{"title":"SwiftUI","content":[{"syntax":"swift","code":["import PSReader","import SwiftUI","","struct ArchiveView: UIViewControllerRepresentable {","    let isSubscribed: Bool","","    func makeCoordinator() -> Coordinator {","        Coordinator()","    }","","    func makeUIViewController(context: Context) -> ArchiveViewController {","        context.coordinator.isSubscribed = isSubscribed","","        let globalConfig = GlobalConfiguration(","            apiKey: \"API_KEY\",","            accountGUID: \"ACCOUNT_GUID\",","            paywallDelegate: context.coordinator","        )","        return ArchiveViewController(","            globalConfig: globalConfig,","            archiveType: .feedArchive(guid: \"PUBLICATION_GUID\", publicationName: \"The Daily\")","        )","    }","","    func updateUIViewController(_ archive: ArchiveViewController, context: Context) {","        context.coordinator.isSubscribed = isSubscribed","    }","","    final class Coordinator: PaywallDelegate {","        var isSubscribed = false","","        func paywallViewControllerForAction(openFeedEdition published: PSEPublished) -> PaywallViewController? {","            isSubscribed ? nil : SubscribeViewController()","        }","","        func paywallViewControllerForAction(openReplicaEdition edition: PSEdition) -> PaywallViewController? {","            nil","        }","    }","}"],"lineAnnotations":[],"copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"type":"codeVoice","code":"SubscribeViewController"},{"type":"text","text":" stands for your own paywall screen; see"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywalls","type":"reference","isActive":true},{"type":"text","text":". The same pattern works for any delegate: conform"},{"type":"text","text":" "},{"type":"text","text":"the coordinator and pass "},{"type":"codeVoice","code":"context.coordinator"},{"type":"text","text":" to the matching"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","type":"reference","isActive":true},{"type":"text","text":" parameter."}],"type":"paragraph"}]}]},{"text":"Setting the App Configuration","anchor":"Setting-the-App-Configuration","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Screens you embed have no dynamic archive to load your app configuration","type":"text"},{"text":" ","type":"text"},{"text":"from PageSuite, and a few reader features read it, in-article adverts","type":"text"},{"text":" ","type":"text"},{"text":"among them. If your editions use them, load the configuration with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/AppConfigService","type":"reference"},{"text":" and set it on your global configuration before you","type":"text"},{"text":" ","type":"text"},{"text":"create the screens, which copy the global configuration when you create","type":"text"},{"text":" ","type":"text"},{"text":"them:","type":"text"}]},{"code":["var globalConfig = GlobalConfiguration(apiKey: \"API_KEY\", accountGUID: \"ACCOUNT_GUID\")","globalConfig.remoteConfig = try? await AppConfigService().configuration(forShortcode: \"SHORTCODE\")","","let archive = ArchiveViewController(","    globalConfig: globalConfig,","    archiveType: .feedArchive(guid: \"PUBLICATION_GUID\", publicationName: \"The Daily\")",")"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run it in an async context, such as a "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" you start when your scene"},{"type":"text","text":" "},{"type":"text","text":"connects, and create the screens once it returns."},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Configuring-the-Prebuilt-UI#The-App-Configuration","type":"reference","isActive":true},{"type":"text","text":" lists the"},{"type":"text","text":" "},{"type":"text","text":"features that need it; if your editions use none of them, skip this step."}]},{"text":"Showing an Archive","anchor":"Showing-an-Archive","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveViewController","type":"reference","isActive":true},{"type":"text","text":" shows one publication’s editions in a grid, the"},{"type":"text","text":" "},{"type":"text","text":"latest edition first and largest. Create it with the publication GUID and"},{"type":"text","text":" "},{"type":"text","text":"a publication name, which becomes each edition’s"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/publicationName","type":"reference","isActive":true},{"type":"text","text":":"}]},{"code":["var archiveConfig = ArchiveConfiguration(globalConfig: globalConfig)","archiveConfig.maxContentWidth = 900","archiveConfig.datePicker = ArchiveDatePickerConfiguration(globalConfig: globalConfig)","","let archive = ArchiveViewController(","    globalConfig: globalConfig,","    archiveConfig: archiveConfig,","    archiveType: .feedArchive(guid: \"PUBLICATION_GUID\", publicationName: \"The Daily\")",")"],"type":"codeListing","copyToClipboard":true,"showLineNumbers":false,"wrap":0,"lineAnnotations":[],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveConfiguration","isActive":true},{"type":"text","text":" controls the grid: thumbnail shape"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveConfiguration\/cellAspectRatio","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveConfiguration\/thumbnailContentMode","isActive":true},{"type":"text","text":"), labels, the download"},{"text":" ","type":"text"},{"text":"button, how many editions to list, and the reader that editions open in.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Two values matter most when you embed the screen:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveConfiguration\/maxContentWidth","type":"reference","isActive":true},{"type":"text","text":" caps the grid’s width in a"},{"type":"text","text":" "},{"type":"text","text":"regular-width environment, such as a full-screen iPad, and centers it."},{"type":"text","text":" "},{"type":"text","text":"Compact widths ignore it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveConfiguration\/datePicker","isActive":true,"type":"reference"},{"type":"text","text":" adds a month picker above the grid."},{"text":" ","type":"text"},{"text":"The editions for a month come from the backend that","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveConfiguration\/feedPublicationType-swift.property","isActive":true,"type":"reference"},{"text":" names, which must match the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"publication’s type in PageSuite. The default, "},{"type":"codeVoice","code":".app"},{"type":"text","text":", suits most"},{"type":"text","text":" "},{"type":"text","text":"publications; ask PageSuite if you’re unsure."}]}]}]},{"style":"note","type":"aside","name":"Replica","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":".replicaArchive(guid:)","type":"codeVoice"},{"text":" shows a publication on the legacy","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"replica system, from its replica publication GUID. The archive lists the"},{"text":" ","type":"text"},{"type":"text","text":"latest 30 editions unless you set "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ArchiveConfiguration\/archiveLimit","isActive":true},{"type":"text","text":"."}]}]},{"type":"heading","text":"Showing a Kiosk","level":2,"anchor":"Showing-a-Kiosk"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A kiosk is a grid of publications, each shown by its cover."},{"type":"text","text":" "},{"type":"text","text":"Tapping one opens that publication’s archive: pushed onto your navigation"},{"type":"text","text":" "},{"type":"text","text":"controller if the kiosk is in one, presented otherwise."}]},{"code":["let kiosk = ArchiveViewController(","    globalConfig: globalConfig,","    archiveType: .feedPublicationKiosk(publications: [","        KioskFeedPublication(name: \"The Daily\", guid: \"PUBLICATION_GUID\"),","        KioskFeedPublication(name: \"The Weekend\", guid: \"WEEKEND_PUBLICATION_GUID\"),","        KioskFeedPublication(name: \"The Magazine\", guid: \"MAGAZINE_PUBLICATION_GUID\", archiveConfig: magazineConfig)","    ])",")"],"type":"codeListing","copyToClipboard":true,"wrap":0,"showLineNumbers":false,"lineAnnotations":[],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"kiosk-grid-ipad"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The kiosk’s own configuration styles the grid, and each publication’s"},{"type":"text","text":" "},{"type":"text","text":"archive uses it too, unless the "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/KioskFeedPublication","isActive":true},{"type":"text","text":" carries an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/KioskFeedPublication\/archiveConfig","isActive":true},{"type":"text","text":" of its own."}]},{"style":"note","type":"aside","name":"Replica","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":".replicaPublicationKiosk(publications:)"},{"text":" is a kiosk of","type":"text"},{"text":" ","type":"text"},{"text":"legacy replica publications, each a ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/KioskReplicaPublication","isActive":true,"type":"reference"},{"text":" created","type":"text"},{"text":" ","type":"text"},{"text":"from its replica publication GUID. A kiosk can’t mix them with","type":"text"},{"text":" ","type":"text"},{"text":"publications on the current system.","type":"text"}]}]},{"type":"heading","text":"Showing Bookmarks and Downloads","level":2,"anchor":"Showing-Bookmarks-and-Downloads"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/BookmarksViewController","isActive":true,"type":"reference"},{"text":" lists the pages and articles the user has","type":"text"},{"type":"text","text":" "},{"type":"text","text":"bookmarked, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DownloadsViewController"},{"type":"text","text":" the editions they’ve saved"},{"type":"text","text":" "},{"type":"text","text":"for offline reading. Both filter by kind:"}]},{"code":["let bookmarks = BookmarksViewController(","    globalConfig: globalConfig,","    type: [.feedPage, .feedArticle]",")","bookmarks.sortMode = .byDate","","let downloads = DownloadsViewController(","    globalConfig: globalConfig,","    downloadTypes: .feedEdition",")"],"lineAnnotations":[],"syntax":"swift","copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"type":"paragraph","inlineContent":[{"text":"In the carousel, a section whose first screen is bookmarks or downloads","type":"text"},{"text":" ","type":"text"},{"text":"has a menu in its ribbon that sorts these lists. On their own, the","type":"text"},{"text":" ","type":"text"},{"text":"screens have no menu, so let users change the order with a control of","type":"text"},{"text":" ","type":"text"},{"text":"your own that sets ","type":"text"},{"type":"codeVoice","code":"sortMode"},{"text":". Each screen remembers the order","type":"text"},{"text":" ","type":"text"},{"text":"across launches. The feature guides cover the rest, a sort button","type":"text"},{"text":" ","type":"text"},{"text":"included: ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Bookmarks","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Downloads-and-Offline-Reading","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Showing Search","level":2,"anchor":"Showing-Search"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchViewController"},{"type":"text","text":" searches a set of publications that a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchDelegate","isActive":true},{"type":"text","text":" supplies. "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ApplicationSearchDelegate","isActive":true},{"type":"text","text":" supplies the"},{"type":"text","text":" "},{"type":"text","text":"publications a shortcode names. Pass "},{"type":"codeVoice","code":"dismissible: true"},{"type":"text","text":" when you present"},{"type":"text","text":" "},{"type":"text","text":"the screen, so it shows a close button:"}]},{"code":["let searchDelegate = ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: ReaderConfiguration(globalConfig: globalConfig)",")","","let search = SearchViewController(","    globalConfig: globalConfig,","    delegate: searchDelegate,","    dismissible: true",")","present(search, animated: true)"],"type":"codeListing","copyToClipboard":true,"wrap":0,"showLineNumbers":false,"lineAnnotations":[],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Search","isActive":true},{"type":"text","text":" covers the prebuilt search in full, including search"},{"type":"text","text":" "},{"type":"text","text":"inside the reader. To design the search screen yourself, see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen"},{"type":"text","text":"."}]},{"type":"heading","text":"Choosing the Reader They Open","level":2,"anchor":"Choosing-the-Reader-They-Open"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each screen opens editions in a reader set up by its own configuration’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"readerConfig"},{"type":"text","text":". To make every screen open the same reader, with the same"},{"type":"text","text":" "},{"type":"text","text":"settings rows, for example, build one "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReaderConfiguration"},{"type":"text","text":" and assign"},{"type":"text","text":" "},{"type":"text","text":"it to each configuration. "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Configuring-the-Prebuilt-UI","isActive":true},{"type":"text","text":" shows how, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Customizing-the-Reader-Screen","isActive":true},{"type":"text","text":" covers what the reader configuration"},{"type":"text","text":" "},{"type":"text","text":"controls."}]},{"type":"heading","text":"Fitting Screens Into Your Layout","level":2,"anchor":"Fitting-Screens-Into-Your-Layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When something of yours covers part of a screen, such as a mini player"},{"type":"text","text":" "},{"type":"text","text":"along the bottom, add the space to the screen’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"additionalSafeAreaInsets"},{"type":"text","text":" so its content stays clear:"}]},{"code":["archive.additionalSafeAreaInsets = UIEdgeInsets(top: 0, left: 0, bottom: 64, right: 0)"],"lineAnnotations":[],"syntax":"swift","copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"type":"paragraph","inlineContent":[{"text":"The bookmarks and downloads screens re-lay out their grids when you set","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"it, and apply it even inside a SwiftUI paging "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":", where UIKit alone"},{"type":"text","text":" "},{"type":"text","text":"doesn’t."}]},{"type":"paragraph","inlineContent":[{"text":"To force a screen into light or dark mode, set its","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"overrideUserInterfaceStyle"},{"text":"; the bookmarks, downloads, and search screens","type":"text"},{"text":" ","type":"text"},{"text":"pass it on to everything they embed. To force one style everywhere, the","type":"text"},{"text":" ","type":"text"},{"text":"readers your screens open included, set it on your app’s window instead.","type":"text"},{"text":" ","type":"text"},{