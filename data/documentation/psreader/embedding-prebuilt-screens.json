carries an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/KioskFeedPublication\/archiveConfig"},{"type":"text","text":" of its own."}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"code":".replicaPublicationKiosk(publications:)","type":"codeVoice"},{"type":"text","text":" is a kiosk of"},{"type":"text","text":" "},{"type":"text","text":"legacy replica publications, each a "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/KioskReplicaPublication","type":"reference","isActive":true},{"type":"text","text":" created"},{"type":"text","text":" "},{"type":"text","text":"from its replica publication GUID. A kiosk can’t mix them with"},{"type":"text","text":" "},{"type":"text","text":"publications on the current system."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Replica"},{"level":2,"anchor":"Showing-Bookmarks-and-Downloads","type":"heading","text":"Showing Bookmarks and Downloads"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/BookmarksViewController","type":"reference"},{"text":" lists the pages and articles the user has","type":"text"},{"text":" ","type":"text"},{"text":"bookmarked, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/DownloadsViewController","type":"reference"},{"text":" the editions they’ve saved","type":"text"},{"text":" ","type":"text"},{"text":"for offline reading. Both filter by kind:","type":"text"}]},{"type":"codeListing","showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"code":["let bookmarks = BookmarksViewController(","    globalConfig: globalConfig,","    type: [.feedPage, .feedArticle]",")","bookmarks.sortMode = .byDate","","let downloads = DownloadsViewController(","    globalConfig: globalConfig,","    downloadTypes: .feedEdition",")"],"wrap":0},{"type":"paragraph","inlineContent":[{"text":"In the carousel, a section whose first screen is bookmarks or downloads","type":"text"},{"text":" ","type":"text"},{"text":"has a menu in its ribbon that sorts these lists. On their own, the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"screens have no menu, so let users change the order with a control of"},{"type":"text","text":" "},{"type":"text","text":"your own that sets "},{"type":"codeVoice","code":"sortMode"},{"type":"text","text":". Each screen remembers the order"},{"type":"text","text":" "},{"type":"text","text":"across launches. The feature guides cover the rest, a sort button"},{"type":"text","text":" "},{"type":"text","text":"included: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Bookmarks"},{"type":"text","text":" and "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Downloads-and-Offline-Reading","type":"reference","isActive":true},{"type":"text","text":"."}]},{"anchor":"Showing-Search","type":"heading","level":2,"text":"Showing Search"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchViewController","isActive":true},{"type":"text","text":" searches a set of publications that a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchDelegate","isActive":true},{"type":"text","text":" supplies. "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ApplicationSearchDelegate","isActive":true},{"type":"text","text":" supplies the"},{"type":"text","text":" "},{"type":"text","text":"publications a shortcode names. Pass "},{"type":"codeVoice","code":"dismissible: true"},{"type":"text","text":" when you present"},{"type":"text","text":" "},{"type":"text","text":"the screen, so it shows a close button:"}]},{"type":"codeListing","showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"code":["let searchDelegate = ApplicationSearchDelegate(","    shortcode: \"SHORTCODE\",","    readerConfig: ReaderConfiguration(globalConfig: globalConfig)",")","","let search = SearchViewController(","    globalConfig: globalConfig,","    delegate: searchDelegate,","    dismissible: true",")","present(search, animated: true)"],"wrap":0},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Search","type":"reference","isActive":true},{"type":"text","text":" covers the prebuilt search in full, including search"},{"type":"text","text":" "},{"type":"text","text":"inside the reader. To design the search screen yourself, see"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","anchor":"Choosing-the-Reader-They-Open","text":"Choosing the Reader They Open"},{"inlineContent":[{"type":"text","text":"Each screen opens editions in a reader set up by its own configuration’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"readerConfig"},{"type":"text","text":". To make every screen open the same reader, with the same"},{"type":"text","text":" "},{"type":"text","text":"settings rows, for example, build one "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/ReaderConfiguration","isActive":true},{"type":"text","text":" and assign"},{"type":"text","text":" "},{"type":"text","text":"it to each configuration. "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Configuring-the-Prebuilt-UI","isActive":true},{"type":"text","text":" shows how, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Customizing-the-Reader-Screen","isActive":true},{"type":"text","text":" covers what the reader configuration"},{"type":"text","text":" "},{"type":"text","text":"controls."}],"type":"paragraph"},{"level":2,"text":"Fitting Screens Into Your Layout","type":"heading","anchor":"Fitting-Screens-Into-Your-Layout"},{"type":"paragraph","inlineContent":[{"text":"When something of yours covers part of a screen, such as a mini player","type":"text"},{"text":" ","type":"text"},{"text":"along the bottom, add the space to the screen’s","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"additionalSafeAreaInsets"},{"type":"text","text":" so its content stays clear:"}]},{"wrap":0,"copyToClipboard":true,"lineAnnotations":[],"type":"codeListing","code":["archive.additionalSafeAreaInsets = UIEdgeInsets(top: 0, left: 0, bottom: 64, right: 0)"],"syntax":"swift","showLineNumbers":false},{"type":"paragraph","inlineContent":[{"type":"text","text":"The bookmarks and downloads screens re-lay out their grids when you set"},{"type":"text","text":" "},{"type":"text","text":"it, and apply it even inside a SwiftUI paging "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":", where UIKit alone"},{"type":"text","text":" "},{"type":"text","text":"doesn’t."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To force a screen into light or dark mode, set its"},{"type":"text","text":" "},{"type":"codeVoice","code":"overrideUserInterfaceStyle"},{"type":"text","text":"; the bookmarks, downloads, and search screens"},{"type":"text","text":" "},{"type":"text","text":"pass it on to everything they embed. To force one style everywhere, the"},{"type":"text","text":" "},{"type":"text","text":"readers your screens open included, set it on your app’s window instead."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Theming#Dark-Mode","isActive":true},{"type":"text","text":"