{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every screen the carousel shows is also a view controller you can place"},{"type":"text","text":" "},{"type":"text","text":"yourself. Each is a plain "},{"type":"codeVoice","code":"UIViewController"},{"type":"text","text":": push it, put it in a tab,"},{"type":"text","text":" "},{"type":"text","text":"or embed it in a screen of your own. Each one opens editions in the"},{"type":"text","text":" "},{"type":"text","text":"prebuilt reader without any work from you."}]},{"code":["import PSReader","import UIKit","","let globalConfig = GlobalConfiguration(apiKey: \"API_KEY\", accountGUID: \"ACCOUNT_GUID\")","","let archive = ArchiveViewController(","    globalConfig: globalConfig,","    archiveType: .feedArchive(guid: \"PUBLICATION_GUID\", publicationName: \"The Daily\")",")","archive.tabBarItem = UITabBarItem(title: \"Editions\", image: UIImage(systemName: \"newspaper\"), tag: 0)","","let bookmarks = BookmarksViewController(globalConfig: globalConfig, type: .all)","bookmarks.tabBarItem = UITabBarItem(title: \"Bookmarks\", image: UIImage(systemName: \"bookmark\"), tag: 1)","","let downloads = DownloadsViewController(globalConfig: globalConfig, downloadTypes: .all)","downloads.tabBarItem = UITabBarItem(title: \"Downloads\", image: UIImage(systemName: \"arrow.down.circle\"), tag: 2)","","let tabBarController = UITabBarController()","tabBarController.viewControllers = [archive, bookmarks, downloads]"],"lineAnnotations":[],"copyToClipboard":true,"syntax":"swift","type":"codeListing","wrap":0,"showLineNumbers":false},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"View controller","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shows","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"More in"}]}]],[[{"type":"paragraph","inlineCon