{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/building-a-page-browser"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/building-a-page-browser"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"A page browser, or contents view, shows the edition at a glance: page","type":"text"},{"text":" ","type":"text"},{"text":"thumbnails labeled the way the publisher prints them. Everything it needs","type":"text"},{"text":" ","type":"text"},{"text":"comes from the open ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEditionSource","type":"reference","isActive":true},{"text":", and a tap jumps the reader. The","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"same browser serves classic PDF editions, where the thumbnails are the"},{"type":"text","text":" "},{"type":"text","text":"printed pages, and responsive editions, where they’re section fronts and"},{"type":"text","text":" "},{"type":"text","text":"article cards. Using the prebuilt reader? Its content browser is built in;"},{"type":"text","text":" "},{"type":"text","text":"see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Customizing-the-Reader-Screen#The-Content-Browser"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"This browser lists the edition’s pages, with a thumbnail and label for","type":"text"},{"text":" ","type":"text"},{"text":"each:","type":"text"}],"type":"paragraph"},{"code":["import PSReader","import UIKit","","\/\/\/ The edition's pages, with a thumbnail and the printed label for each.","\/\/\/ Tapping a page calls `onSelect`.","final class PageBrowserViewController: UITableViewController {","","    private let source: PSEEditionSource","    private let pages: [PSEPage]","    private let onSelect: (PSEPage) -> Void","","    private var thumbnails: [String: UIImage] = [:]","    private var requested: Set<String> = []","","    init(source: PSEEditionSource, onSelect: @escaping (PSEPage) -> Void) {","        self.source = source","        \/\/ Advert pages aren't part of the edition's contents.","        self.pages = (source.edition.pages ?? []).filter { !$0.isAdvertPage }","        self.onSelect = onSelect","        super.init(style: .plain)","        title = \"Pages\"","    }","","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","","    override func viewDidLoad() {","        super.viewDidLoad()","        tableView.register(UITableViewCell.self, forCellReuseIdentifier: \"Page\")","    }","","    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {","        pages.count","    }","","    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {","        let page = pages[indexPath.row]","        let cell = tableView.dequeueReusableCell(withIdentifier: \"Page\", for: indexPath)","","        var content = UIListContentConfiguration.subtitleCell()","        content.text = \"Page \\(page.pageLabel)\"","        content.secondaryText = page.section","        content.image = thumbnail(for: page) ?? UIImage(systemName: \"doc\")","        content.imageProperties.reservedLayoutSize = CGSize(width: 48, height: 64)","        content.imageProperties.maximumSize = CGSize(width: 48, height: 64)","        cell.contentConfiguration = content","","        return cell","    }","","    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {","        onSelect(pages[indexPath.row])","    }","","    \/\/ MARK: Thumbnails","","    \/\/\/ Returns the page's thumbnail if it's loaded, and otherwise starts","    \/\/\/ loading it.","    private func thumbnail(for page: PSEPage) -> UIImage? {","        guard let resource = page.effectiveScreenshotURL else {","            return nil","        }","","        if requested.insert(resource).inserted {","            loadImage(resource) { [weak self] image in","                self?.thumbnails[resource] = image","                self?.tableView.reloadData()","            }","        }","","        return thumbnails[resource]","    }","","    \/\/\/ Loads an absolute URL with URLSession, and an edition resource","    \/\/\/ through the source, which works for downloaded and streamed","    \/\/\/ editions alike.","    private func loadImage(_ resource: String, completion: @escaping (UIImage?) -> Void) {","        if resource.hasPrefix(\"http\"), let url = URL(string: resource) {","            URLSession.shared.dataTask(with: url) { data, _, _ in","                DispatchQueue.main.async { completion(data.flatMap(UIImage.init(data:))) }","            }.resume()","        } else if let data = source.resourceManager.cachedData(for: resource) {","            DispatchQueue.main.async { completion(UIImage(data: data)) }","        } else {","            _ = source.resourceManager.dataTask(for: resource) { data in","                DispatchQueue.main.async { completion(data.flatMap(UIImage.init(data:))) }","            }","        }","    }","}"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"inlineContent":[{"text":"Open it from your reader screen, ","type":"text"},{"type":"codeVoice","code":"ReaderScreenViewController"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader","isActive":true,"type":"reference"},{"text":". Add a button to the class:","type":"text"}],"type":"paragraph"},{"code":["\/\/ In ReaderScreenViewController:","private lazy var pagesButton = UIBarButtonItem(","    image: UIImage(systemName: \"square.grid.2x2\"),","    style: .plain,","    target: self,","    action: #selector(showPages)",")"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"addChrome()"},{"text":", add it to the toolbar:","type":"text"}],"type":"paragraph"},{"code":["toolbarItems?.insert(pagesButton, at: 0)"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"inlineContent":[{"text":"And present the browser, jumping the reader to the page the user picks:","type":"text"}],"type":"paragraph"},{"code":["\/\/\/ Tags the browser's jumps, so the reader screen can tell them from swipes.","struct PageBrowserJump {}","","extension ReaderScreenViewController {","","    @objc func showPages() {","        guard let source else {","            return","        }","","        let browser = PageBrowserViewController(source: source) { [weak self] page in","            self?.dismiss(animated: true)","            self?.reader.scrollTo(page: page, source: PageBrowserJump())","        }","        present(UINavigationController(rootViewController: browser), animated: true)","    }","}"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"inlineContent":[{"text":"The sections below refine it: richer thumbnails, sections, article cards,","type":"text"},{"text":" ","type":"text"},{"text":"and highlighting the pages on screen.","type":"text"}],"type":"paragraph"},{"text":"Thumbnails","type":"heading","anchor":"Thumbnails","level":2},{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/effectiveScreenshotURL","isActive":true,"type":"reference"},{"text":" is a page’s thumbnail: its rendered","type":"text"},{"text":" ","type":"text"},{"text":"screenshot when the edition supplies one, and otherwise an image derived","type":"text"},{"text":" ","type":"text"},{"text":"from a PDF page’s content. It’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" for pages with neither.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The reference comes in one of two forms, which ","type":"text"},{"type":"codeVoice","code":"loadImage(_:completion:)"},{"text":" ","type":"text"},{"text":"above handles. Absolute URLs, which screenshots usually are, load with","type":"text"},{"text":" ","type":"text"},{"text":"your app’s usual image loader. Anything else is an edition resource: load","type":"text"},{"text":" ","type":"text"},{"text":"it through the source’s ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEditionSource\/resourceManager","isActive":true,"type":"reference"},{"text":", which reads","type":"text"},{"text":" ","type":"text"},{"text":"it from disk for a downloaded edition, and fetches and caches it for a","type":"text"},{"text":" ","type":"text"},{"text":"streamed one. That keeps one implementation working for every kind of","type":"text"},{"text":" ","type":"text"},{"text":"source.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEditionResourceManager\/dataTask(for:completion:)","isActive":true,"type":"reference"},{"text":" returns a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDataTask","isActive":true,"type":"reference"},{"text":". In a grid whose cells load their own images, keep it in","type":"text"},{"text":" ","type":"text"},{"text":"the cell and cancel it when the cell is reused, as you would a","type":"text"},{"text":" ","type":"text"},{"code":"URLSessionDataTask","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Article cards show the article’s lead image instead.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEArticle\/leadAsset()","isActive":true,"type":"reference"},{"text":" picks it: the flagged lead video or image,","type":"text"},{"text":" ","type":"text"},{"text":"else the first image or video, else the article’s landscape image. Each","type":"text"},{"text":" ","type":"text"},{"text":"asset lists candidate URLs; use the first one the resource manager can","type":"text"},{"text":" ","type":"text"},{"text":"resolve:","type":"text"}],"type":"paragraph"},{"code":["func cardImage(for article: PSEArticle, in source: PSEEditionSource) -> String? {","    let candidates: [String]","    switch article.leadAsset() {","    case .image(let image): candidates = image.URLs","    case .video(let video): candidates = video.videoImageURLs","    default:                candidates = []","    }","    return candidates.first { source.resourceManager.resolve(resource: $0) != nil }","}"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"text":"Labels","type":"heading","anchor":"Labels","level":2},{"inlineContent":[{"text":"Label pages with ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/pageLabel","isActive":true,"type":"reference"},{"text":", as the browser above does: it’s","type":"text"},{"text":" ","type":"text"},{"text":"the publisher’s printed label, such as A1 or B12, where the edition has","type":"text"},{"text":" ","type":"text"},{"text":"one, and the page number otherwise. ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/The-Edition-Model#Friendly-Page-Labels","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"explains labels; for a label covering both pages of a spread, see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Labeling-Spreads","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Grouping Into Sections","type":"heading","anchor":"Grouping-Into-Sections","level":2},{"inlineContent":[{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEdition\/pageBrowserSections","isActive":true,"type":"reference"},{"text":" is the edition’s own section list for a","type":"text"},{"text":" ","type":"text"},{"text":"browser. Each ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPageBrowserSection","isActive":true,"type":"reference"},{"text":" has a ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"num","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"color","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"num"},{"type":"text","text":" is the index in "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEdition\/pages","isActive":true,"type":"reference"},{"type":"text","text":" where the section starts. It’s"},{"type":"text","text":" "},{"type":"text","text":"an index, not a printed page number."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"color"},{"type":"text","text":" is the matching section’s theme color, as a hex string, when the"},{"type":"text","text":" "},{"type":"text","text":"edition has one."}]}]}]},{"inlineContent":[{"text":"Skip entries with empty titles. Some editions number their sections","type":"text"},{"text":" ","type":"text"},{"text":"inconsistently, so check that the starts are in range and increasing, and","type":"text"},{"text":" ","type":"text"},{"text":"otherwise fall back to the pages themselves: walk ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEdition\/pages","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"start a group whenever ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/section","isActive":true,"type":"reference"},{"text":" changes, colored with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/sectionColor","isActive":true,"type":"reference"},{"text":". The prebuilt browser does the same.","type":"text"}],"type":"paragraph"},{"code":["struct BrowserSection {","    let title: String","    let color: String?","    var pages: [PSEPage]","}","","func browserSections(for edition: PSEEdition) -> [BrowserSection] {","    let pages = edition.pages ?? []","    let starts = (edition.pageBrowserSections ?? []).filter {","        $0.title?.isEmpty == false && pages.indices.contains($0.num)","    }","    let increasing = zip(starts, starts.dropFirst()).allSatisfy { $0.num < $1.num }","","    if starts.isEmpty == false, increasing {","        return starts.enumerated().map { index, start in","            let lower = index == 0 ? 0 : start.num","            let upper = index + 1 < starts.count ? starts[index + 1].num : pages.count","            return BrowserSection(title: start.title ?? \"\", color: start.color,","                                  pages: Array(pages[lower..<upper]))","        }","    }","","    var sections: [BrowserSection] = []","    for page in pages {","        if let name = page.section, name != sections.last?.title {","            sections.append(BrowserSection(title: name, color: page.sectionColor, pages: [page]))","        } else if sections.isEmpty == false {","            sections[sections.count - 1].pages.append(page)","        }","    }","    return sections","}"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"inlineContent":[{"text":"Filter advert pages out when you display a section’s pages, not before you","type":"text"},{"text":" ","type":"text"},{"text":"group them, so the section starts still line up with the edition’s pages.","type":"text"}],"type":"paragraph"},{"text":"Pages and Articles","type":"heading","anchor":"Pages-and-Articles","level":2},{"inlineContent":[{"text":"Choose what the browser shows by ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/type","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/level","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Page thumbnails."}],"type":"strong"},{"type":"text","text":" The edition’s pages as laid out: PDF pages"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"replica_pdf_page"},{"type":"text","text":") and web pages ("},{"type":"codeVoice","code":"webview"},{"type":"text","text":") in a classic PDF edition,"},{"type":"text","text":" "},{"type":"text","text":"and section fronts ("},{"type":"codeVoice","code":"templateSection"},{"type":"text","text":") in a responsive one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Article cards."}],"type":"strong"},{"type":"text","text":" Pages whose "},{"type":"codeVoice","code":"level"},{"type":"text","text":" is "},{"type":"codeVoice","code":"article"},{"type":"text","text":", one card per page,"},{"type":"text","text":" "},{"type":"text","text":"titled with the page’s article headline"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"page.articles?.first?.headline"},{"type":"text","text":") and illustrated with its lead asset."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No adverts."}],"type":"strong"},{"type":"text","text":" Skip pages whose "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/isAdvertPage","isActive":true,"type":"reference"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]}]},{"inlineContent":[{"text":"A classic PDF edition can carry its stories as article pages too. When the","type":"text"},{"text":" ","type":"text"},{"text":"edition has PDF pages (","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPage\/isPDF","isActive":true,"type":"reference"},{"text":") and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEEdition\/pagesHaveArticles()","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", offer a toggle between pages","type":"text"},{"text":" ","type":"text"},{"text":"and articles, as the prebuilt browser does.","type":"text"}],"type":"paragraph"},{"text":"Navigating and Staying in Sync","type":"heading","anchor":"Navigating-and-Staying-in-Sync","level":2},{"inlineContent":[{"text":"The browser jumps with ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEditionReaderViewController\/scrollTo(page:source:)","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Its ","type":"text"},{"code":"PageBrowserJump","type":"codeVoice"},{"text":" token reaches the reader screen’s","type":"text"},{"text":" ","type":"text"},{"code":"willScrollTo(pageIndex:pagingMode:source:)","type":"codeVoice"},{"text":", so you can tell jumps from","type":"text"},{"text":" ","type":"text"},{"text":"the browser apart from swipes; see ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader#Navigating","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To highlight the pages on screen when the browser opens, pass it the","type":"text"},{"text":" ","type":"text"},{"text":"current spread’s pages:","type":"text"}],"type":"paragraph"},{"syntax":"swift","showLineNumbers":false,"code":["let onScreen = reader.currentPageSpread()?.0.pages() ?? []"],"copyToClipboard":true,"type":"codeListing","lineAnnotations":[],"wrap":0},{"inlineContent":[{"text":"A browser that stays visible beside the reader, such as a sidebar on","type":"text"},{"text":" ","type":"text"},{"text":"iPad, updates its highlight from the reader screen’s ","type":"text"},{"code":"updateChrome()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which runs whenever the reader settles. The reader reports spread","type":"text"},{"text":" ","type":"text"},{"text":"indices, and double-page mode pairs pages, so go between a page and its","type":"text"},{"text":" ","type":"text"},{"text":"spread with the edition’s helpers; see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/The-Edition-Model#Pages-and-Spreads","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Fetching-the-Archive","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader"],"anchor":"Your-Reader","title":"Your Reader"}],"topicSections":[{"anchor":"Sections","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPageBrowserSection"],"title":"Sections"}],"sections":[],"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Buildi