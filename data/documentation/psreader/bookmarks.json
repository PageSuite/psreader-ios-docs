yntax":"swift","type":"codeListing","lineAnnotations":[]},{"inlineContent":[{"type":"text","text":"In the prebuilt reader, the settings menu’s “Clear edition data” row"},{"type":"text","text":" "},{"type":"text","text":"removes every bookmark along with the downloads; see"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Downloads-and-Offline-Reading#Download-Settings-in-the-Prebuilt-Reader","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","type":"reference"},{"text":" covers the rest of the manager: listing","type":"text"},{"text":" ","type":"text"},{"text":"and opening saved items, and observing changes.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmarkManager","type":"reference"},{"text":" doesn’t hold replica bookmarks, which","type":"text"},{"text":" ","type":"text"},{"text":"the legacy replica system keeps, so","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmarkManager\/removeAllBookmarks()","type":"reference"},{"text":" leaves them in place.","type":"text"}]}],"name":"Replica"},{"type":"heading","anchor":"Bookmarks-From-the-Legacy-SDK","text":"Bookmarks From the Legacy SDK","level":2},{"inlineContent":[{"type":"text","text":"The prebuilt Bookmarks screen lists the legacy SDK’s bookmarks itself,"},{"type":"text","text":" "},{"type":"text","text":"as replica content, when its type includes replica bookmarks, and opens"},{"type":"text","text":" "},{"type":"text","text":"them in the replica reader. Apps that use the prebuilt screens leave out"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmarkManager\/migrateLegacyPageBookmarks(hooks:)","isActive":true},{"type":"text","text":", the custom"},{"type":"text","text":" "},{"type":"text","text":"UI’s migration call. Pages saved for offline reading with the legacy SDK"},{"type":"text","text":" "},{"type":"text","text":"have no prebuilt screen. See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Migrating-From-the-Legacy-Core-SDK#With-the-Prebuilt-Screens","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"title":"Showing Bookmarks","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/BookmarksViewController"],"anchor":"Showing-Bookmarks"},{"title":"Configuring the Bookmarks Screen","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/BookmarksConfiguration"],"anchor":"Configuring-the-Bookmarks-Screen"}],"metadata":{"modules":[{"name":"PSReader"}],"title":"Bookmarks","roleHeading":"Guide","role":"collectionGroup"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Bookmarks"},"abstract":[{"text":"Let users save articles and pages from the prebuilt reader, and reopen them from a Bookmarks screen, even offline.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","references":{"doc://com.pagesuite.PSReader/documentation/PSReader/BookmarksViewController/additionalSafeAreaInsets":{"url":"\/documentation\/psreader\/bookmarksviewcontroller\/additionalsafeareainsets","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Extra insets the bookmarks grid keeps clear, on top of the safe area."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"additionalSafeAreaInsets","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preci