{"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselViewController","interfaceLanguage":"swift"},"relationshipsSections":[{"identifiers":["doc:\/\/com.pagesuite.PSReader\/objc(cs)UIViewController"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"},{"identifiers":["doc:\/\/com.pagesuite.PSReader\/objc(pl)NSCoding","doc:\/\/com.pagesuite.PSReader\/objc(pl)NSExtensionRequestHandling","doc:\/\/com.pagesuite.PSReader\/objc(pl)NSObject","doc:\/\/com.pagesuite.PSReader\/s7CVarArgP","doc:\/\/com.pagesuite.PSReader\/s28CustomDebugStringConvertibleP","doc:\/\/com.pagesuite.PSReader\/s23CustomStringConvertibleP","doc:\/\/com.pagesuite.PSReader\/SQ","doc:\/\/com.pagesuite.PSReader\/SH","doc:\/\/com.pagesuite.PSReader\/s8SendableP","doc:\/\/com.pagesuite.PSReader\/s16SendableMetatypeP","doc:\/\/com.pagesuite.PSReader\/objc(pl)UIActivityItemsConfigurationProviding","doc:\/\/com.pagesuite.PSReader\/objc(pl)UIAppearanceContainer","doc:\/\/com.pagesuite.PSReader\/objc(pl)UIContentContainer","doc:\/\/com.pagesuite.PSReader\/objc(pl)UIFocusEnvironment","doc:\/\/com.pagesuite.PSReader\/objc(pl)UIPasteConfigurationSupporting","doc:\/\/com.pagesuite.PSReader\/objc(pl)UIResponderStandardEditActions","doc:\/\/com.pagesuite.PSReader\/objc(pl)UIStateRestoring","doc:\/\/com.pagesuite.PSReader\/5UIKit23UITraitChangeObservableP","doc:\/\/com.pagesuite.PSReader\/objc(pl)UITraitEnvironment","doc:\/\/com.pagesuite.PSReader\/objc(pl)UIUserActivityRestoring"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CarouselViewController"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"mentions":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Change-Log","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Choosing-an-Integration","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Updating-the-SDK"],"kind":"mentions"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"code":"CarouselViewController","type":"codeVoice"},{"text":" serves as the central UI component of the SDK, offering","type":"text"},{"text":" ","type":"text"},{"text":"users seamless navigation between multiple content sources such as archives of","type":"text"},{"text":" ","type":"text"},{"text":"editions on PageSuite’s current system, legacy replica editions, bookmarked","type":"text"},{"text":" ","type":"text"},{"text":"content, and downloaded editions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The interface supports two levels of paging, sections and subsections, with","type":"text"},{"text":" ","type":"text"},{"text":"horizontal ribbons, allowing quick and intuitive browsing through publications.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The view controller can be configured via a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselConfiguration"},{"text":" object.","type":"text"},{"text":" ","type":"text"},{"text":"Utilize this configuration to align the visual presentation, navigation behavior,","type":"text"},{"text":" ","type":"text"},{"text":"theming, branding, and various delegate interactions (e.g., sharing, paywalls,","type":"text"},{"text":" ","type":"text"},{"text":"advertisements, and media playback).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The content in the carousel can be:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"An archive of editions on PageSuite’s current system (classic PDF or"},{"type":"text","text":" "},{"type":"text","text":"responsive)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"An archive of legacy replica editions."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A dynamic archive loaded from an app shortcode."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Local bookmarks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Local downloads."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Usage","level":2,"text":"Usage","type":"heading"},{"inlineContent":[{"text":"The recommended approach uses a ","type":"text"},{"inlineContent":[{"type":"text","text":"dynamic archive"}],"type":"strong"},{"text":" that loads content from a","type":"text"},{"text":" ","type":"text"},{"text":"shortcode configured in the PageSuite portal:","type":"text"}],"type":"paragraph"},{"code":["let globalConfig = GlobalConfiguration(","    apiKey: \"API_KEY\",","    accountGUID: \"ACCOUNT_GUID\"",")","","let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .dynamicArchive(\"Editions\", shortcode: \"SHORTCODE\")","    ]",")","","present(carousel, animated: true)"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"inlineContent":[{"text":"You can also configure sections manually to combine multiple content sources:","type":"text"}],"type":"paragraph"},{"code":["let carousel = CarouselViewController(","    globalConfig: globalConfig,","    sections: [","        .subsections(\"Editions\", [","            .init(name: \"Daily\", type: .feedArchive(guid: \"DAILY_GUID\")),","            .init(name: \"Weekend\", type: .feedArchive(guid: \"WEEKEND_GUID\"))","        ]),","        .section(.init(name: \"Bookmarks\", type: .bookmarks(type: .all))),","        .section(.init(name: \"Downloads\", type: .downloads(type: .all)))","    ]",")"],"showLineNumbers":false,"type":"codeListing","syntax":"swift","lineAnnotations":[],"wrap":0,"copyToClipboard":true},{"inlineContent":[{"text":"The carousel relies on the call to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/initialize(apiKey:completion:)"},{"text":" ","type":"text"},{"text":"your app makes at launch; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Getting-Started#Initialize-the-SDK"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Getting-Started","isActive":true}],"type":"paragraph"}],"style":"note","type":"aside","name":"See Also"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Setting-Up-the-Carousel","isActive":true}],"type":"paragraph"}],"style":"note","type":"aside","name":"See Also"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/GlobalConfiguration","isActive":true}],"type":"paragraph"}],"style":"note","type":"aside","name":"See Also"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/CarouselConfiguration","isActive":true}],"type":"paragraph"}],"style":"note","type":"aside","name":"See Also"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader"]]},"sections":[],"variants":[{"paths":["\/documentation\/psreader\/carouselviewcontroller"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"type":"text","text":"The primary view controller provided by the SDK for presenting digital publication"},{"type":"text","text":" "},{"ty