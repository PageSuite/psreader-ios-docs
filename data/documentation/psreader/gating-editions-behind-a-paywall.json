{"kind":"article","seeAlsoSections":[{"generated":true,"title":"Adding Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Advert-Pages","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics"],"anchor":"Adding-Features"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"PSReader"}],"roleHeading":"Guide","role":"article","title":"Gating Editions Behind a Paywall"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/gating-editions-behind-a-paywall"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/gating-editions-behind-a-paywall"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt UI asks a paywall delegate before it opens or downloads an"},{"type":"text","text":" "},{"type":"text","text":"edition, and shows your paywall screen when the answer is no. The core SDK"},{"text":" ","type":"text"},{"type":"text","text":"has no such hook: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/openEditionSource(onProgress:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager","type":"reference","isActive":true},{"text":" open and download whatever you ask for. In a custom","type":"text"},{"text":" ","type":"text"},{"text":"UI, you check the user’s entitlement before each of those calls and show","type":"text"},{"text":" ","type":"text"},{"text":"your paywall however you like.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the prebuilt UI? See "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywalls","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Check before you create your reader screen, "},{"type":"codeVoice","code":"ReaderScreenViewController"},{"type":"text","text":" "},{"text":"from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader"},{"text":", since it opens the edition as soon as it","type":"text"},{"text":" ","type":"text"},{"text":"loads:","type":"text"}]},{"code":["\/\/ In your edition list's view controller:","func open(_ published: PSEPublished) async {","    guard await SubscriptionManager.shared.requestAccess(from: self) else {","        return","    }","","    let reader = UINavigationController(","        rootViewController: ReaderScreenViewController(published: published)","    )","    reader.modalPresentationStyle = .fullScreen","    present(reader, animated: true)","}"],"lineAnnotations":[],"copyToClipboard":true,"syntax":"swift","type":"codeListing","wrap":0,"showLineNumbers":false},{"type":"paragraph","inlineContent":[{"code":"SubscriptionManager","type":"codeVoice"},{"text":" stands for your app’s own entitlement check. Its","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"requestAccess(from:)"},{"type":"text","text":" shows your paywall when the user needs one and"},{"type":"text","text":" "},{"type":"text","text":"returns whether they have access; "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall#Showing-Your-Paywall","isActive":true},{"text":" sketches","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run the check on every path that opens an edition: your archive, a"},{"type":"text","text":" "},{"type":"text","text":"“continue reading” list, search results, bookmarks, and links resolved"},{"type":"text","text":" "},{"type":"text","text":"with "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/published(forEditionGUID:)","type":"reference","isActive":true},{"type":"text","text":". Run it before a"},{"type":"text","text":" "},{"type":"text","text":"download starts, too."}]},{"anchor":"Showing-Your-Paywall","level":2,"type":"heading","text":"Showing Your Paywall"},{"type":"paragraph","inlineContent":[{"text":"Your paywall can be any screen; it doesn’t need to conform to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController","type":"reference","isActive":true},{"type":"text","text":". Wrapping it in an "},{"type":"codeVoice","code":"async"},{"type":"text","text":" method keeps each"},{"type":"text","text":" "},{"type":"text","text":"check to one line:"}]},{"showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"wrap":0,"type":"codeListing","code":["@MainActor","final class SubscriptionManager {","    static let shared = SubscriptionManager()","","    private(set) var isSubscribed = false","","    \/\/\/ Returns whether the user has access, showing the paywall first if needed.","    func requestAccess(from presenter: UIViewController) async -> Bool {","        if isSubscribed {","            return true","        }","","        return await withCheckedContinuation { continuation in","            let paywall = SubscribeViewController { granted in","                continuation.resume(returning: granted)","            }","            presenter.present(paywall, animated: true)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The paywall has to report exactly once, however it closes: a","type":"text"},{"text":" ","type":"text"},{"text":"continuation that never resumes leaves the open waiting for good, and one","type":"text"},{"text":" ","type":"text"},{"text":"that resumes twice crashes. Reporting from ","type":"text"},{"code":"viewDidDisappear(_:)","type":"codeVoice"},{"text":" covers","type":"text"},{"text":" ","type":"text"},{"text":"your buttons and a swipe down the sheet in one place:","type":"text"}]},{"showLineNumbers":false,"syntax":"swift","copyToClipboard":true,"lineAnnotations":[],"wrap":0,"type":"codeListing","code":["final class SubscribeViewController: UIViewController {","    private var onFinish: ((Bool) -> Void)?","    private var didGrantAccess = false","","    init(onFinish: @escaping (Bool) -> Void) {","        self.onFinish = onFinish","        super.init(nibName: nil, bundle: nil)","    }","","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","","    @objc func subscribeTapped() {","        \/\/ After the purchase or sign-in succeeds:","        didGrantAccess = true","        dismiss(animated: true)","    }","","    @objc func notNowTapped() {","        dismiss(animated: true)","    }","","    override func viewDidDisappear(_ animated: Bool) {","        super.viewDidDisappear(animated)","        guard isBeingDismissed else {","            return","        }","        onFinish?(didGrantAccess)","        onFinish = nil   \/\/ Report once.","    }","}"]},{"inlineContent":[{"type":"text","text":"Base "},{"type":"codeVoice","code":"isSubscribed"},{"type":"text","text":" on entitlement state your app has stored, not on a"},{"type":"text","text":" "},{"type":"text","text":"network call at the moment of opening. Downloaded editions open offline,"},{"type":"text","text":" "},{"type":"text","text":"and a check that needs the network would lock the user out of them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If your app also shows prebuilt screens, the same paywall can serve them"},{"type":"text","text":" "},{"type":"text","text":"by conforming to "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController","isActive":true,"type":"reference"},{"type":"text","text":" too; see"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywalls#Building-the-Paywall-Screen","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Deciding-per-Edition","text":"Deciding per Edition","type":"heading"},{"inlineContent":[{"text":"Supplements and free titles can skip the paywall. Decide before you ask","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for access:"}],"type":"paragraph"},{"code":["func open(_ published: PSEPublished) async {","    if !isFree(published) {","        guard await SubscriptionManager.shared.requestAccess(from: self) else {","            return","        }","    }","","    let reader = UINavigationController(","        rootViewController: ReaderScreenViewController(published: published)","    )","    reader.modalPresentationStyle = .fullScreen","    present(reader, animated: true)","}","","func isFree(_ published: PSEPublished) -> Bool {","    published.isSupplement","        || published.applicationGUID == \"PUBLICATION_GUID\"   \/\/ A free title.","}"],"copyToClipboard":true,"wrap":0,"type":"codeListing","lineAnnotations":[],"syntax":"swift","showLineNumbers":false},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/applicationGUID","isActive":true},{"text":" holds the edition’s publication GUID","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Identifiers","isActive":true},{"text":"). It’s empty on an edition resolved with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/published(forEditionGUID:)","isActive":true},{"text":", so for search results","type":"text"},{"text":" ","type":"text"},{"text":"and links, decide from the publication GUID they carry, as the sections","type":"text"},{"text":" ","type":"text"},{"text":"below do.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The check also decides whether a lapsed subscriber can still read the"},{"type":"text","text":" "},{"type":"text","text":"editions they downloaded. To let them, skip it when"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager\/isDownloaded(published:)","isActive":true},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Gating-Downloads","text":"Gating Downloads"},{"type":"paragraph","inlineContent":[{"text":"Check before a download starts. The download button from","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","isActive":true},{"text":" also cancels and removes downloads, which","type":"text"},{"text":" ","type":"text"},{"text":"need no check, so ask only when a tap starts one. In ","type":"text"},{"type":"codeVoice","code":"DownloadButton"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"add a property for the check:","type":"text"}]},{"code":["\/\/\/ Asked before a tap starts a download; returns whether it may start.","var canStartDownload: (() async -> Bool)?"],"showLineNumbers":false,"wrap":0,"syntax":"swift","copyToClipboard":true,"type":"codeListing","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"And replace its action, so a tap that starts a download waits for the"},{"type":"text","text":" "},{"type":"text","text":"answer:"}]},{"code":["@objc private func toggleDownload() {","    Task {","        switch PSEDownloadManager.shared.state(for: published) {","        case .notDownloaded, .errored, .cancelled, .deleted:","            \/\/ This tap starts a download.","            if let canStartDownload, await canStartDownload() == false {","                return","            }","        default:","            \/\/ This tap cancels or removes one.","            break","        }","","        do {","            \/\/ Queues, cancels or deletes, depending on the current state.","            try PSEDownloadManager.shared.toggleDownloadState(for: published)","        } catch {","            onError?(error)","        }","    }","}"],"showLineNumbers":false,"wrap":0,"syntax":"swift","copyToClipboard":true,"type":"codeListing","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"text":"Then in your reader screen’s ","type":"text"},{"code":"addChrome()","type":"codeVoice"},{"text":", ask your paywall:","type":"text"}]},{"code":["downloadButton.canStartDownload = { [weak self] in","    guard let self else {","        return false","    }","    return await SubscriptionManager.shared.requestAccess(from: self)","}"],"showLineNumbers":false,"wrap":0,"syntax":"swift","copyToClipboard":true,"type":"codeListing","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the same check on the buttons in your archive’s cells. To let"},{"type":"text","text":" "},{"type":"text","text":"everyone read online but keep downloads for subscribers, check here and"},{"type":"text","text":" "},{"type":"text","text":"not before opening. Anything else that downloads for the user, such as"},{"type":"text","text":" "},{"type":"text","text":"downloading each new edition as it’s published, needs the same check."}]},{"type":"heading","text":"Gating Search Results","anchor":"Gating-Search-Results","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResult","type":"reference"},{"type":"text","text":" names its edition before anything loads: its"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResult\/applicationId","type":"reference"},{"type":"text","text":" holds the publication GUID, and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResult\/editionId","type":"reference"},{"type":"text","text":" the edition GUID. Check before you resolve the"},{"type":"text","text":" "},{"type":"text","text":"edition, at the top of the method that opens a result in"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen#Opening-a-Result","type":"reference"},{"type":"text","text":":"}]},{"code":["func open(_ result: SearchResult) async throws {","    if result.applicationId != \"PUBLICATION_GUID\" {   \/\/ A free title.","        guard await SubscriptionManager.shared.requestAccess(from: self) else {","            return","        }","    }","","    \/\/ Resolve the edition and open it in your reader screen.","}"],"showLineNumbers":false,"wrap":0,"syntax":"swift","copyToClipboard":true,"type":"codeListing","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Links work the same way: decide from the publication GUID your link or"},{"type":"text","text":" "},{"type":"text","text":"notification carries, before you resolve its edition GUID. See"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition#Routing-Links-and-Notifications","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":2,"text":"Gating Bookmarks","anchor":"Gating-Bookmarks","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmark\/editionSource(mode:among:onProgress:)","isActive":true},{"text":" opens a bookmark’s","type":"text"},{"text":" ","type":"text"},{"text":"own edition when it can, downloaded or online, which gives the user the","type":"text"},{"text":" ","type":"text"},{"text":"whole edition. Check first, deciding from the bookmark’s","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmark\/published","isActive":true},{"text":" entry when you need the edition:","type":"text"}]},{"copyToClipboard":true,"showLineNumbers":false,"syntax":"swift","wrap":0,"code":["func open(_ bookmark: PSEBookmark) async throws {","    guard await SubscriptionManager.shared.requestAccess(from: self) else {","        return","    }","","    let (source, openingPage) = try await bookmark.editionSource()","","    let reader = UINavigationController(","        rootViewController: ReaderScreenViewController(source: source, openingPage: openingPage)","    )","    reader.modalPresentationStyle = .fullScreen","    present(reader, animated: true)","}"],"type":"codeListing","lineAnnotations":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prebuilt bookmarks screen doesn’t ask the paywall delegate at all. To"},{"type":"text","text":" "},{"type":"text","text":"let lapsed subscribers keep their saved items without the rest of each"},{"type":"text","text":" "},{"type":"text","text":"edition, open a bookmarks edition for them instead. It’s built from the"},{"type":"text","text":" "},{"type":"text","text":"saved content, one page per bookmark, and reads offline:"}]},{"copyToClipboard":true,"showLineNumbers":false,"syntax":"swift","wrap":0,"code":["let mode: PSEBookmarkOpenMode = SubscriptionManager.shared.isSubscribed","    ? .preferSourceEdition","    : .alwaysBookmarksEdition","let (source, openingPage) = try await bookmark.editionSource(mode: mode)"],"type":"codeListing","lineAnnotations":[]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall"},"abstract":[{"type":"text","text":"Check the user’s entitlement before your own screens open or download an edition, and show your paywall when they need one."}],"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/PSEPublished/openEditionSource(onProgress:)":{"url":"\/documentation\/psreader\/psepublished\/openeditionsource(onprogress:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Opens a reader-ready source for this edition: the downloaded copy if"},{"type":"text","text":" "},{"type":"text","text":"there is one, otherwise a network stream."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"openEditionSource","kind":"identifier"},{"text":"(","kind":"text"},{"text":"onProgress","kind":"externalParam"},{"text":": ((","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"PSEEditionSource","kind":"typeIdentifier","preciseIdentifier":"s:8PSReader16PSEEditionSourceP"}],"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/openEditionSource(onProgress:)","role":"symbol","title":"openEditionSource(onProgress:)"},"doc://com.pagesuite.PSReader/documentation/PSReader/Building-a-Search-Screen":{"abstract":[{"type":"text","text":"Build your own search screen that searches your publications’ editions with the SDK’s search service and opens results in your own reader screen."}],"type":"topic","role":"collectionGroup","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","url":"\/documentation\/psreader\/building-a-search-screen","title":"Building a Search Screen","kind":"article"},"doc://com.pagesuite.PSReader/documentation/PSReader/Handling-Media-and-Link-Taps":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps","url":"\/documentation\/psreader\/handling-media-and-link-taps","abstract":[{"text":"Respond to taps on the images, videos, embeds, hotspots, and links in the pages your own reader screen hosts.","type":"text"}],"type":"topic","title":"Handling Media and Link Taps","kind":"article","role":"collectionGroup"},"doc://com.pagesuite.PSReader/documentation/PSReader/SearchResult":{"url":"\/documentation\/psreader\/searchresult","kind":"symbol","role":"symbol","abstract":[{"text":"A single search result returned by the PageSuite search API.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SearchResult"}],"navigatorTitle":[{"text":"SearchResult","kind":"identifier"}],"title":"SearchResult","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResult"},"doc://com.pagesuite.PSReader/documentation/PSReader/Handling-Advert-Pages":{"abstract":[{"type":"text","text":"Let the reader in your own reader screen render advert pages, or serve them from your own ad stack, and place any banners in your chrome."}],"type"