{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/psreader\/gating-editions-behind-a-paywall"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/psreader\/gating-editions-behind-a-paywall"]}],"seeAlsoSections":[{"generated":true,"title":"Adding Features","identifiers":["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Bookmark-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Share-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Listen-Button","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-Comment-Buttons","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Advert-Pages","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Handling-Media-and-Link-Taps","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Reporting-Analytics"],"anchor":"Adding-Features"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"The prebuilt UI asks a paywall delegate before it opens or downloads an","type":"text"},{"text":" ","type":"text"},{"text":"edition, and shows your paywall screen when the answer is no. The core SDK","type":"text"},{"text":" ","type":"text"},{"text":"has no such hook: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/openEditionSource(onProgress:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager"},{"text":" open and download whatever you ask for. In a custom","type":"text"},{"text":" ","type":"text"},{"text":"UI, you check the user’s entitlement before each of those calls and show","type":"text"},{"text":" ","type":"text"},{"text":"your paywall however you like.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Using the prebuilt UI? See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywalls","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Check before you create your reader screen, "},{"code":"ReaderScreenViewController","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Hosting-the-Reader","isActive":true},{"type":"text","text":", since it opens the edition as soon as it"},{"type":"text","text":" "},{"type":"text","text":"loads:"}],"type":"paragraph"},{"code":["\/\/ In your edition list's view controller:","func open(_ published: PSEPublished) async {","    guard await SubscriptionManager.shared.requestAccess(from: self) else {","        return","    }","","    let reader = UINavigationController(","        rootViewController: ReaderScreenViewController(published: published)","    )","    reader.modalPresentationStyle = .fullScreen","    present(reader, animated: true)","}"],"lineAnnotations":[],"syntax":"swift","copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"code":"SubscriptionManager","type":"codeVoice"},{"type":"text","text":" stands for your app’s own entitlement check. Its"},{"type":"text","text":" "},{"code":"requestAccess(from:)","type":"codeVoice"},{"type":"text","text":" shows your paywall when the user needs one and"},{"type":"text","text":" "},{"type":"text","text":"returns whether they have access; "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall#Showing-Your-Paywall","isActive":true},{"type":"text","text":" sketches"},{"type":"text","text":" "},{"type":"text","text":"it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Run the check on every path that opens an edition: your archive, a"},{"type":"text","text":" "},{"type":"text","text":"“continue reading” list, search results, bookmarks, and links resolved"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/published(forEditionGUID:)","isActive":true},{"type":"text","text":". Run it before a"},{"type":"text","text":" "},{"type":"text","text":"download starts, too."}],"type":"paragraph"},{"text":"Showing Your Paywall","anchor":"Showing-Your-Paywall","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Your paywall can be any screen; it doesn’t need to conform to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController","isActive":true},{"type":"text","text":". Wrapping it in an "},{"code":"async","type":"codeVoice"},{"type":"text","text":" method keeps each"},{"type":"text","text":" "},{"type":"text","text":"check to one line:"}],"type":"paragraph"},{"code":["@MainActor","final class SubscriptionManager {","    static let shared = SubscriptionManager()","","    private(set) var isSubscribed = false","","    \/\/\/ Returns whether the user has access, showing the paywall first if needed.","    func requestAccess(from presenter: UIViewController) async -> Bool {","        if isSubscribed {","            return true","        }","","        return await withCheckedContinuation { continuation in","            let paywall = SubscribeViewController { granted in","                continuation.resume(returning: granted)","            }","            presenter.present(paywall, animated: true)","        }","    }","}"],"lineAnnotations":[],"syntax":"swift","copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"type":"text","text":"The paywall has to report exactly once, however it closes: a"},{"type":"text","text":" "},{"type":"text","text":"continuation that never resumes leaves the open waiting for good, and one"},{"type":"text","text":" "},{"type":"text","text":"that resumes twice crashes. Reporting from "},{"code":"viewDidDisappear(_:)","type":"codeVoice"},{"type":"text","text":" covers"},{"type":"text","text":" "},{"type":"text","text":"your buttons and a swipe down the sheet in one place:"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","copyToClipboard":true,"wrap":0,"code":["final class SubscribeViewController: UIViewController {","    private var onFinish: ((Bool) -> Void)?","    private var didGrantAccess = false","","    init(onFinish: @escaping (Bool) -> Void) {","        self.onFinish = onFinish","        super.init(nibName: nil, bundle: nil)","    }","","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","","    @objc func subscribeTapped() {","        \/\/ After the purchase or sign-in succeeds:","        didGrantAccess = true","        dismiss(animated: true)","    }","","    @objc func notNowTapped() {","        dismiss(animated: true)","    }","","    override func viewDidDisappear(_ animated: Bool) {","        super.viewDidDisappear(animated)","        guard isBeingDismissed else {","            return","        }","        onFinish?(didGrantAccess)","        onFinish = nil   \/\/ Report once.","    }","}"],"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"type":"text","text":"Base "},{"code":"isSubscribed","type":"codeVoice"},{"type":"text","text":" on entitlement state your app has stored, not on a"},{"type":"text","text":" "},{"type":"text","text":"network call at the moment of opening. Downloaded editions open offline,"},{"text":" ","type":"text"},{"text":"and a check that needs the network would lock the user out of them.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If your app also shows prebuilt screens, the same paywall can serve them","type":"text"},{"type":"text","text":" "},{"type":"text","text":"by conforming to "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController","isActive":true},{"type":"text","text":" too; see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Paywalls#Building-the-Paywall-Screen","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Deciding per Edition","anchor":"Deciding-per-Edition"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supplements and free titles can skip the paywall. Decide before you ask"},{"type":"text","text":" "},{"type":"text","text":"for access:"}]},{"lineAnnotations":[],"syntax":"swift","code":["func open(_ published: PSEPublished) async {","    if !isFree(published) {","        guard await SubscriptionManager.shared.requestAccess(from: self) else {","            return","        }","    }","","    let reader = UINavigationController(","        rootViewController: ReaderScreenViewController(published: published)","    )","    reader.modalPresentationStyle = .fullScreen","    present(reader, animated: true)","}","","func isFree(_ published: PSEPublished) -> Bool {","    published.isSupplement","        || published.applicationGUID == \"PUBLICATION_GUID\"   \/\/ A free title.","}"],"copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEPublished\/applicationGUID"},{"text":" holds the edition’s publication GUID","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Identifiers"},{"text":"). It’s empty on an edition resolved with","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/FeedEditionService\/published(forEditionGUID:)"},{"text":", so for search results","type":"text"},{"text":" ","type":"text"},{"text":"and links, decide from the publication GUID they carry, as the sections","type":"text"},{"text":" ","type":"text"},{"text":"below do.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The check also decides whether a lapsed subscriber can still read the","type":"text"},{"text":" ","type":"text"},{"text":"editions they downloaded. To let them, skip it when","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEDownloadManager\/isDownloaded(published:)"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Gating-Downloads","text":"Gating Downloads"},{"inlineContent":[{"text":"Check before a download starts. The download button from","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Adding-a-Download-Button"},{"text":" also cancels and removes downloads, which","type":"text"},{"text":" ","type":"text"},{"text":"need no check, so ask only when a tap starts one. In ","type":"text"},{"code":"DownloadButton","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"add a property for the check:","type":"text"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","code":["\/\/\/ Asked before a tap starts a download; returns whether it may start.","var canStartDownload: (() async -> Bool)?"],"copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"text":"And replace its action, so a tap that starts a download waits for the","type":"text"},{"text":" ","type":"text"},{"text":"answer:","type":"text"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","code":["@objc private func toggleDownload() {","    Task {","        switch PSEDownloadManager.shared.state(for: published) {","        case .notDownloaded, .errored, .cancelled, .deleted:","            \/\/ This tap starts a download.","            if let canStartDownload, await canStartDownload() == false {","                return","            }","        default:","            \/\/ This tap cancels or removes one.","            break","        }","","        do {","            \/\/ Queues, cancels or deletes, depending on the current state.","            try PSEDownloadManager.shared.toggleDownloadState(for: published)","        } catch {","            onError?(error)","        }","    }","}"],"copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"text":"Then in your reader screen’s ","type":"text"},{"code":"addChrome()","type":"codeVoice"},{"text":", ask your paywall:","type":"text"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","code":["downloadButton.canStartDownload = { [weak self] in","    guard let self else {","        return false","    }","    return await SubscriptionManager.shared.requestAccess(from: self)","}"],"copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"text":"Set the same check on the buttons in your archive’s cells. To let","type":"text"},{"text":" ","type":"text"},{"text":"everyone read online but keep downloads for subscribers, check here and","type":"text"},{"text":" ","type":"text"},{"text":"not before opening. Anything else that downloads for the user, such as","type":"text"},{"text":" ","type":"text"},{"text":"downloading each new edition as it’s published, needs the same check.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Gating-Search-Results","text":"Gating Search Results"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResult"},{"text":" names its edition before anything loads: its","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResult\/applicationId"},{"text":" holds the publication GUID, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResult\/editionId"},{"text":" the edition GUID. Check before you resolve the","type":"text"},{"text":" ","type":"text"},{"text":"edition, at the top of the method that opens a result in","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Building-a-Search-Screen#Opening-a-Result"},{"text":":","type":"text"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","code":["func open(_ result: SearchResult) async throws {","    if result.applicationId != \"PUBLICATION_GUID\" {   \/\/ A free title.","        guard await SubscriptionManager.shared.requestAccess(from: self) else {","            return","        }","    }","","    \/\/ Resolve the edition and open it in your reader screen.","}"],"copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"text":"Links work the same way: decide from the publication GUID your link or","type":"text"},{"text":" ","type":"text"},{"text":"notification carries, before you resolve its edition GUID. See","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Opening-an-Edition#Routing-Links-and-Notifications"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Gating-Bookmarks","text":"Gating Bookmarks"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmark\/editionSource(mode:among:onProgress:)"},{"text":" opens a bookmark’s","type":"text"},{"text":" ","type":"text"},{"text":"own edition when it can, downloaded or online, which gives the user the","type":"text"},{"text":" ","type":"text"},{"text":"whole edition. Check first, deciding from the bookmark’s","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PSEBookmark\/published"},{"text":" entry when you need the edition:","type":"text"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","code":["func open(_ bookmark: PSEBookmark) async throws {","    guard await SubscriptionManager.shared.requestAccess(from: self) else {","        return","    }","","    let (source, openingPage) = try await bookmark.editionSource()","","    let reader = UINavigationController(","        rootViewController: ReaderScreenViewController(source: source, openingPage: openingPage)","    )","    reader.modalPresentationStyle = .fullScreen","    present(reader, animated: true)","}"],"copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false},{"inlineContent":[{"text":"The prebuilt bookmarks screen doesn’t ask the paywall delegate at all. To","type":"text"},{"text":" ","type":"text"},{"text":"let lapsed subscribers keep their saved items without the rest of each","type":"text"},{"text":" ","type":"text"},{"text":"edition, open a bookmarks edition for them instead. It’s built from the","type":"text"},{"text":" ","type":"text"},{"text":"saved content, one page per bookmark, and reads offline:","type":"text"}],"type":"paragraph"},{"lineAnnotations":[],"syntax":"swift","code":["let mode: PSEBookmarkOpenMode = SubscriptionManager.shared.isSubscribed","    ? .preferSourceEdition","    : .alwaysBookmarksEdition","let (source, openingPage) = try await bookmark.editionSource(mode: mode)"],"copyToClipboard":true,"wrap":0,"type":"codeListing","showLineNumbers":false}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader","doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Custom-UI"]]},"abstract":[{"text":"Check the user’s entitlement before your own screens open or download an edition, and show your paywall when they need one.","type":"text"}],"identifier":{"url":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/Gating-Editions-Behind-a-Paywall","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"PSReader"}],"roleHeading":"Guide","title":"Gating Editions Behind a Paywall","role":"article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"references":{"doc://com.pagesuite.PSReader/documentation/PSReader/PaywallViewController":{"navigatorTitle":[{"kind":"identifier","text":"PaywallViewController"}],"role":"symbol","title":"PaywallViewController","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallViewController"}],"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/PaywallViewController","abstract":[{"text":"A view controller protocol used by the SDK to present paywalls when","type":"text"},{"text":" ","type":"text"},{"text":"accessing restricted content.","type":"text"}],"type":"topic","url":"\/documentation\/psreader\/paywallviewcontroller"},"doc://com.pagesuite.PSReader/documentation/PSReader/SearchResult/editionId":{"identifier":"doc:\/\/com.pagesuite.PSReader\/documentation\/PSReader\/SearchResult\/editionId","title":"editionId","url":"\/documentation\/psreader\/searchresult\/editionid","abstract":[{"type":"text","text":"The edition identifier."}],"type":"topic","fragments":[{"kind":"keyword","tex